{
  "name": "rotli",
  "private": true,
  "version": "0.6.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun scripts/sync-excalidraw-fonts.mjs && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:mac": "bash scripts/predmg-clean.sh && bun run tauri build --bundles app",
    "release": "bash scripts/release.sh",
    "test": "bun test src",
