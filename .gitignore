node_modules
dist
public/fonts
src-tauri/target
_review
*.log
.DS_Store
scripts/.icon

# secret hygiene (voz-style) — signing/notarization material never gets committed.
# The updater private key lives OUTSIDE the repo (~/.rotli-updater.key); *.key
# below is belt-and-suspenders so a stray copy can't be staged.
*.p12
*.p8
*.cer
*.key
.env
.env.*
secrets.*
**/.rotli/
**/.breve-secrets
*.pem
*.mobileprovision
*.provisionprofile
*.keychain
*.keychain-db

# Capture sessions and local deployment overrides are never source assets.
.railway/
.hyperframes/

# CARL ephemeral session state (runtime; the hook recreates it) — carl.json IS tracked
.carl/sessions/

# Project MCP wiring is tracked and portable. Machine-specific MCP overrides
# belong in user-level Claude/Codex configuration, not this repository.

# tool caches + build metadata — generated, never tracked (new tools bring their
# ignore entries with them; policy: docs/development/adding-things.md)
.eslintcache
*.tsbuildinfo
coverage/
playwright-report/
test-results/
.claude/*
!.claude/skills
/tmp/
dist-release
.eval-local-chat/
