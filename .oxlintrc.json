{
  // Wired into `bun run lint` as lint:oxlint (migrated from ESLint 2026-07-31 —
  // eslint/typescript-eslint/eslint-plugin-react-hooks removed; same rule set,
  // ~90x faster syntax pass, type-aware pass via the oxlint-tsgolint sidecar).
  // Scoped by the CLI invocation to src/, e2e/, scripts/, breve-runtime/,
  // playwright.config.ts, and vite.config.ts. scripts/ joined 2026-08-13 after
  // its measured six findings (three unused omission bindings and three sorts
  // without explicit comparators) were fixed. src-tauri/ remains Clippy-owned.
  //
  // breve-runtime/ JOINED the lint scope 2026-08-01. Its long-standing deferral
  // (76 findings, last re-measured 2026-07-17) is retired: the debt was paid,
  // not waived. The 71 `any`s became real types — the wire shapes Breve does not
  // own now live in breve-runtime/scripts/wire-types.ts — and typing them
  // surfaced two real latent crashes (see CONTRIBUTING.md's lint paragraph).
  //
  // typescript-eslint's naming-convention has no oxlint equivalent; the same
  // identifier-casing invariant is held by scripts/check-naming.mjs (check:naming).
  //
  // The `correctness` category is ON as of 2026-08-01 — measured first, exactly
  // as this config demands. The measurement (correctness=error over src/, e2e/,
  // playwright.config.ts) found 80 findings across 9 rules; 62 were fixed and
  // the rules adopted, 18 are one deferred rule, recorded below. Everything
  // else in the category is at zero and now guards for free. Propose additions
  // in a PR; the config must not grow silently.
  "plugins": ["typescript", "react"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // ── correctness-category adjustments (measured 2026-08-01) ───────────────
    // DEFERRED — 18 findings, every one the `await expect(...).rejects/.resolves`
    // idiom in bun:test. oxlint is literally right (bun's matcher enforces
    // eagerly and returns a non-thenable, verified with a probe), but the
    // `await` is the portable jest/vitest spelling and is what keeps these
    // assertions enforcing if bun ever aligns with jest and returns a promise.
    // Stripping it from 18 locked/secure-refusal and revision-conflict
    // assertions to satisfy a linter trades a real safety margin for tidiness.
    "typescript/await-thenable": "off",
    // ADOPTED with `allow: ["string"]`. All 13 findings were deliberate
    // code-point iteration (`[...text]`), which is this repo's documented
    // contract — noteSlugify mirrors Rust's 60-Unicode-scalar cap and
    // derive.test.ts asserts 200 emoji truncate to 140 code points. The allow
    // keeps the real bug class (spreading a Promise, function, or class
    // instance) while permitting the intended string behavior.
    "typescript/no-misused-spread": ["error", { "allow": ["string"] }],
    // Type-aware (require `--type-aware` + oxlint-tsgolint; without the flag
    // they silently no-op — the flag lives in the lint:oxlint script).
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-explicit-any": "error",
    // bun:test exposes test() and it() as aliases; the suite standardized on
    // test() (2026-07-18 sweep — 14 it()-only files converted, 0 mixed). One
    // spelling, mechanically held.
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          { "name": "bun:test", "importNames": ["it"], "message": "use test(), not it() — the suite's one spelling" }
        ]
      }
    ],
    // React rules never fire in e2e/ (no React there), so one flat config
    // covers both file groups without overrides.
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error"
  }
}
