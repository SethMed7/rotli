#!/usr/bin/env bash
# Fast pre-commit guards — STAGED content only, so per-commit latency stays low
# (CONTRIBUTING's condition for ever adding a hook). Born from review learnings
# (Seth, 2026-07-30): formatting drift and conflict markers kept reaching PRs.
# Checks the INDEX blobs (`git show :file`), not the working tree, so a
# partial stage (`git add -p`) is judged on exactly what will be committed
# (Greptile P1, PR #8). Full enforcement remains `bun run lint` + CI;
# bypass: git commit --no-verify.
set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACM || true)
[ -z "$staged" ] && exit 0

while IFS= read -r f; do
  case "$f" in
    *.ts | *.tsx)
      if ! git show ":$f" | bunx prettier --stdin-filepath "$f" --check >/dev/null 2>&1; then
        echo "✗ pre-commit: the STAGED content of $f is not Prettier-formatted."
        echo "  bunx prettier --write \"$f\" && git add \"$f\"   (or: bun run format)"
        exit 1
      fi
      ;;
  esac
  # conflict markers must never land (a resolved-merge leftover shipped once)
  if git show ":$f" 2>/dev/null | grep -qE '^(<{7}|={7}|>{7})( |$)'; then
    echo "✗ pre-commit: conflict markers in the staged content of $f."
    exit 1
  fi
done <<<"$staged"
