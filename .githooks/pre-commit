#!/usr/bin/env bash
# Fast pre-commit guards — STAGED content only, so per-commit latency stays low
# (CONTRIBUTING's condition for ever adding a hook). Born from review learnings
# (the maintainer, 2026-07-30): formatting drift and conflict markers kept reaching PRs.
# Checks the INDEX blobs (`git show :file`), not the working tree, so a
# partial stage (`git add -p`) is judged on exactly what will be committed
# (Greptile P1, PR #8). Full enforcement remains `bun run lint` + CI;
# bypass: git commit --no-verify.
set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACM || true)
[ -z "$staged" ] && exit 0

while IFS= read -r f; do
  case "$f" in
    # formatter-owned trees only — the same scope as format:check. breve-runtime/
    # keeps hand-aligned column tables and is deliberately outside oxfmt's reach
    # (measured 2026-07-31: 49/50 differing files there were never formatter-clean).
    src/*.ts | src/*.tsx | e2e/*.ts | scripts/*.ts | playwright.config.ts)
      # oxfmt's --check can't read stdin, so format the index blob and compare.
      if ! cmp -s <(git show ":$f") <(git show ":$f" | bun run --silent oxfmt -c .oxfmtrc.json --stdin-filepath "$f" 2>/dev/null); then
        echo "✗ pre-commit: the STAGED content of $f is not oxfmt-formatted."
        echo "  bun run oxfmt -c .oxfmtrc.json \"$f\" && git add \"$f\"   (or: bun run format)"
        exit 1
      fi
      ;;
  esac
  # conflict markers must never land (a resolved-merge leftover shipped once).
  #
  # NOT `grep -q`. Under `set -o pipefail` that was a silent false negative on
  # every file over ~64KB: -q exits the instant it matches, `git show` then dies
  # of SIGPIPE with 141, and pipefail makes the whole pipeline non-zero — so a
  # FOUND marker read as "clean". Measured 2026-08-07 under bash: 32/64KB caught,
  # 128KB and up missed. It skipped exactly the files most likely to carry a bad
  # merge — corpus.rs (476KB), organizer.rs (204KB), workspace.rs (139KB),
  # lib/tauri.ts (73KB). Redirecting instead of -q makes grep read to EOF, so
  # `git show` is never signalled. Regression: scripts/check-hook.test.ts.
  if git show ":$f" 2>/dev/null | grep -E '^(<{7}|={7}|>{7})( |$)' >/dev/null; then
    echo "✗ pre-commit: conflict markers in the staged content of $f."
    exit 1
  fi
done <<<"$staged"
