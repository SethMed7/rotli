{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rotli",
  "version": "0.18.2",
  "identifier": "com.rotli.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "rotli",
        "width": 980,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 19,
          "y": 24
        },
        "visible": true,
        "maximized": true
      },
      {
        "label": "capture",
        "url": "index.html?window=capture",
        "title": "rotli capture",
        "width": 640,
        "height": 280,
        "resizable": false,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true
      },
      {
        "label": "quick",
        "url": "index.html?window=quick",
        "title": "rotli quick note",
        "width": 460,
        "height": 620,
        "minWidth": 360,
        "minHeight": 380,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 24
        },
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' data:; media-src 'self' asset: http://asset.localhost blob: data:; frame-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' data:; media-src 'self' asset: http://asset.localhost blob: data:; frame-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Seth Medina (TEAMID0000)",
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1NjIwM0VERDJBODhEQ0YKUldUUGphalM3UU5pTmI3MkxjT0tWZE5zaE4xMEt1NTRLMEp1M3UzSE44TVp3VUJSZTdHS2doSWoK",
      "endpoints": [
        "https://github.com/SethMed7/rotli-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
