{
  "categories": {
    "defaults": "Rotli's own default for a host word, in the module that supplies the host words",
    "rotli-name": "a name that belongs to Rotli whatever app runs it: the Rotli theme family and syntax palette, the Rotli studio, Rotli's link format, What's new in Rotli",
    "rotli-project": "Rotli the open-source project: its GitHub repository, the share line, the feedback issue",
    "maintainers": "a promise or history from Rotli's maintainers, which stays theirs under a host",
    "standalone-only": "shown only by the standalone build: the updater, the Finder Quick Action, Breve's scheduler and login item, which a host build never runs",
    "web-only": "Rotli Web, Rotli Helper and Rotli for Mac: shown only by the web build and its helper, which no host ships",
    "dev-only": "shown only in development builds (Rotli (dev), the agent card)",
    "model-read": "text a model reads (prompts, tool descriptions and results); rewording it needs the model evals (AGENTS.md)",
    "cli-mcp": "the headless rotli CLI, its MCP server and the agent bridge, which never read host words (host-seams.md, The welcome note)",
    "vault-format": "written into the vault or naming its format (folder names like Trash (Rotli), MAP.md, the format version), shared by every app that opens it",
    "demo-data": "the browser twin's synthetic demo notes, not the shell",
    "keyed": "a sentence another part recognises by its words (a Rust↔TS twin, a saved transcript, a comparison in code); it stays fixed so the match holds",
    "parity-pinned": "a TS↔Rust shared constant pinned in scripts/fixtures/parity.json; still Rotli's under a host (host-seams.md, What a host still sees)"
  },
