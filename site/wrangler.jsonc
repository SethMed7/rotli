{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rotli-site",
  "compatibility_date": "2026-08-05",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "rotli.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
