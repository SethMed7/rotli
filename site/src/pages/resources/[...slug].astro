---
// /resources/: the Resources dropdown's entries as a page, for anyone without script (the header
// label's own link) and for the footer. The list is the dropdown's (src/nav.ts `resourceItems`),
// so the two never differ. The guides were here until 2026-10-06; they are blog posts tagged Guide
// now, and their old addresses redirect to them (astro.config.mjs `redirects`, site/Caddyfile).
import WritingList from '../../components/WritingList.astro';
import WritingPage from '../../components/WritingPage.astro';
import { resourceItems } from '../../nav';
import { ogImage } from '../../og';
import { site } from '../../site';
import { publishedWriting } from '../../writing';

export async function getStaticPaths() {
  return site.showsFullSite ? [{ params: { slug: undefined } }] : [];
}

const hasPosts = (await publishedWriting('post')).length > 0;
const items = resourceItems({ hasPosts }).map((item) => ({
  href: item.href,
  title: item.label,
  description: item.description,
  meta: item.status,
  external: item.external,
}));
---

<WritingPage
  title="Resources — rotli"
  description="The blog and its guides, the developer reference, the roadmap, and every release."
  canonicalPath="/resources/"
  {...ogImage('resources')}
  section="resources"
  heading="Resources"
  lede="The blog and its guides, the developer reference, the roadmap, and every release."
  wide
>
  <WritingList items={items} empty="" />
</WritingPage>
