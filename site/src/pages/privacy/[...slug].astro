---
// /privacy/: the full privacy policy in plain language: what rotli does with
// data, what connects to the internet and when, and why it is built that way.
// PRIVACY.md at the repository root is the source of truth for the product;
// this page restates it for visitors and adds this website's own practices.
// When PRIVACY.md changes (a new data class, destination, retention behavior,
// or control), update this page in the same change.
// It reads like a blog post (the owner, 2026-10-06: "Privacy page design should match blog
// styles"): WritingPage's `article` layout, the title and the lede beside the night scene, the
// left rail with the tree and the meter, and "More from rotli" at the end, with the posts about
// privacy and the Download spot. Share is Copy link alone: a policy is pointed to, not posted.
import aiChat from '../../../../src/assets/characters/filled/cocoa/ai_chat.webp';
import knowledge from '../../../../src/assets/characters/filled/cocoa/knowledge_system.webp';
import { MORE_POSTS } from '../../blog';
import SecureScene from '../../components/SecureScene.astro';
import WritingPage from '../../components/WritingPage.astro';
import { ogImage } from '../../og';
import { availablePromos, RAIL_PROMOS } from '../../promos';
import { GITHUB_URL, site } from '../../site';
import { morePostCard, publishedWriting } from '../../writing';

export function getStaticPaths() {
  return site.showsFullSite ? [{ params: { slug: undefined } }] : [];
}

const UPDATED = 'October 6, 2026';

// The end of the page: the posts about privacy, newest first, and the spots for the two things this
// page describes, the Mac app and Rotli Web (each only in builds that offer it).
const related = (await publishedWriting('post'))
  .filter((post) => post.data.tags.includes('Privacy'))
  .slice(0, MORE_POSTS)
  .map((post) => morePostCard(post, false));
const promos = availablePromos()
  .filter((promo) => promo.id === 'download' || promo.id === 'web')
  .slice(0, RAIL_PROMOS);

const toc = [
  { slug: 'promise', text: 'Our privacy promise' },
  { slug: 'your-notes', text: 'Your notes stay yours' },
  { slug: 'network', text: 'What connects to the internet' },
  { slug: 'ai', text: 'AI and your notes' },
  { slug: 'connect', text: 'How rotli connects to AI' },
  { slug: 'web', text: 'Rotli Web and Rotli Helper' },
  { slug: 'website', text: 'This website' },
  { slug: 'retention', text: 'Keeping and deleting' },
  { slug: 'changes', text: 'Changes to this page' },
];

// The promise's matrix (the owner, 2026-10-06: "you choose who and what sees anything and what
// they see"): who may read and who may change a note you wrote, by kind of note. It restates
// docs/design/ai-visibility-matrix.md and docs/decisions/2026-09-29-ai-body-edit-permission.md
// for a visitor, and PRIVACY.md stays the product's source of truth. Every row is a note a
// person wrote, the default for every note; a note a chat or agent made is editable by AI and is
// said once in the text below. `no` cells are the refusals, marked in words and weight, never by
// colour alone. On a phone each row becomes a block that names its column in every cell.
type Cell = { text: string; no?: boolean };
const who = ['On-device model', 'Connected AI', 'The Librarian'] as const;
const whoNote = ['runs on your Mac', 'Claude Code, Codex, Cursor', 'files notes in the background'] as const;
const matrix: { kind: string; how: string; cells: [Cell, Cell, Cell] }[] = [
  {
    kind: 'A note you wrote',
    how: 'Every note, by default',
    cells: [
      { text: 'Reads it. Rewrites it only if you allow it' },
      { text: 'Reads it. Rewrites it only if you allow it' },
      { text: 'Fills in the details at the top. Never your words' },
    ],
  },
  {
    kind: 'Secure note',
    how: 'Right-click → Mark secure',
    cells: [
      { text: 'Reads it, unless you turn that off. Rewrites it only if you allow it' },
      { text: 'Never sees it, not even the title', no: true },
      { text: 'Leaves it alone', no: true },
    ],
  },
  {
    kind: 'Locked note',
    how: 'Right-click → Lock',
    cells: [
      { text: 'Reads it. Never changes it', no: true },
      { text: 'Reads it. Never changes it', no: true },
      { text: 'Leaves it alone', no: true },
    ],
  },
];
---

<WritingPage
  title="Privacy — rotli"
  description="How rotli handles your notes: no account, no analytics, files on your computer, and AI only on your terms. What connects to the internet, and why."
  canonicalPath="/privacy/"
  {...ogImage('privacy')}
  section="privacy"
  heading="Privacy"
  lede="rotli is built so there is nothing about you to collect. This page explains exactly what it does with your data, what connects to the internet, and why it works that way."
  meta={[`Updated ${UPDATED}`]}
  article={{ url: `${site.url}/privacy/`, share: 'link', noun: 'page', more: related, promos }}
  toc={toc}
  progress
>
  <div slot="cover" class="night band-night">
    <p class="night-caption">
      <span class="inked">Secure notes stay home.</span> A model on your own Mac may read them. Remote models,
      the clouds outside, never see them, and no model can edit a note you lock.
    </p>
    <div class="dome-frame"><SecureScene /></div>
  </div>

  <h2 id="promise">Our privacy promise</h2>
  <p class="promise-lede">
    You choose which AI tools rotli uses, and, note by note, what each one may read and what it may change.
    rotli enforces your choice in the app, before anything reaches a model.
  </p>
  <div class="promise-matrix">
    <table role="table">
      <caption>Who may read and change a note you wrote</caption>
      <thead role="rowgroup">
        <tr role="row">
          <th scope="col" role="columnheader">Note</th>
          {who.map((name, i) => (
            <th scope="col" role="columnheader">
              {name}
              <small>{whoNote[i]}</small>
            </th>
          ))}
        </tr>
      </thead>
      <tbody role="rowgroup">
        {matrix.map((row) => (
          <tr role="row">
            <th scope="row" role="rowheader">
              <b>{row.kind}</b>
              <small>{row.how}</small>
            </th>
            {row.cells.map((cell, i) => (
              <td role="cell" data-who={who[i]} data-no={cell.no ? '' : undefined}>
                {cell.text}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <ul class="promise-points">
    <li>
      <strong>Secure notes.</strong> A remote model never sees them: not the title, a snippet, or a word of the
      text. A model on your Mac can read them, since it can't send anything anywhere. You can turn that off for
      one note from its menu, or for the whole vault in Settings → Security. Nothing turns it on for a remote model.
    </li>
    <li>
      <strong>Locked notes.</strong> No AI of any kind changes them, on your Mac or connected. Every model can
      still read them: locking protects the words, it doesn't hide them.
    </li>
    <li>
      <strong>Notes you write.</strong> AI can't rewrite a note you wrote until you turn on <em>Let AI edit the
      text</em> for that note, from its menu. Ask AI adds a passage only when you click Insert, and leaves your
      words as they were. Notes a chat makes for you stay open to AI.
    </li>
    <li>
      <strong>The Librarian.</strong> It fills in the details at the top of a note (an area, a summary, tags,
      and links) and may move the file into its area's folder. It never changes your words, and it skips secure
      and locked notes.
    </li>
    <li>
      <strong>Everything else.</strong> There's no account and no analytics. Your notes are files in a folder you
      choose, on your computer. You choose which AI tools connect, and rotli never holds their logins. Nothing
      leaves without a reason you can see: an update check, a chat you start, or a web search you ask for.
    </li>
  </ul>
  <p class="promise-note">
    Secure and locked are rules for AI, not encryption. <a href="#ai">How they work</a>.
  </p>

  <h2 id="your-notes">Your notes stay yours</h2>
  <img class="spot" src={knowledge.src} width="512" height="512" alt="" loading="lazy" decoding="async" />
  <p>
    rotli reads and writes the folder you pick: notes, chats, attachments, and anything else you keep there.
    Its own settings and search indexes live in a hidden <code>.rotli</code> folder inside it, or in the
    app's settings on your Mac, and it can rebuild them at any time. Main and named views are arrangements
    of the same files, not copies. Passwords and keys you give rotli go into the macOS Keychain, never into
    your notes or settings files.
  </p>
  <p>
    <strong>Why:</strong> a notes app should never be the only way to reach your notes. Because everything is
    an ordinary file, you can open it in another app, back it up however you already back things up, or
    delete rotli and keep every word. There is no copy on a server for anyone to lose, leak, or lock you out of.
  </p>

  <h2 id="network">What connects to the internet, and when</h2>
  <p>rotli has no analytics or account server to talk to. It goes online only for things you can see:</p>
  <ul>
    <li>
      <strong>Updates.</strong> The Mac app checks for a new version shortly after it opens, a few times a
      day, and when you press Check for updates. It asks rotli.co first, with its version, macOS, and chip
      type in the address, which is how we count Macs per version; rotli.co redirects the app to the release
      page on GitHub, and the app asks GitHub directly if rotli.co doesn't answer. The request carries no account,
      identifier, vault, or note data. Nothing downloads until you choose Install, and Settings → General
      turns the automatic check off.
    </li>
    <li>
      <strong>A chat you start with connected AI.</strong> rotli runs the Claude Code, Codex, or Cursor app you
      already have signed in on your Mac. That app sends the conversation and the context it needs to its
      provider, under that provider's terms. rotli never sees or stores your provider login.
    </li>
    <li>
      <strong>A web search or page you ask for.</strong> Only the query or address needed for that request is sent.
    </li>
  </ul>
  <p>
    Features still in development, such as scheduled briefs and remote agents, are switched off in released
    builds. When one ships, this page will say what it connects to before it does.
  </p>
  <p>
    <strong>Why:</strong> every connection is a place your data could go, so rotli keeps the list short and
    tied to something you did. Adding a new destination, telemetry, or an account service is a deliberate,
    reviewed change, not something that slips in with an update.
  </p>

  <h2 id="ai">AI and your notes</h2>
  <img class="spot" src={aiChat.src} width="512" height="512" alt="" loading="lazy" decoding="async" />
  <p>
    AI in rotli is optional, and you can leave it off entirely. If you use it,
    an <strong>on-device model</strong> runs on your Mac and works without a network.{' '}
    <strong>Connected AI</strong> means the tools you already use, like Claude Code or Codex, and rotli labels them as remote.
  </p>
  <p>
    What each one may read and change, note by note, is in <a href="#promise">the table at the top of this
    page</a>, with secure notes, locked notes, and the switch that lets AI edit a note you wrote.
  </p>
  <p>
    Secure is an AI access rule, not encryption. A secure note is still a plain file on your disk, protected
    the way your other files are, by your Mac account and FileVault. Boards don't have a secure setting yet,
    so keep secrets out of them.
  </p>
  <p>
    <strong>Why:</strong> AI is useful with context and risky with the wrong context. Deciding per note means
    you can let a model help with your plans without ever handing it your salary review. The rule is enforced
    by the app, not left to the model to respect.
  </p>

  <h2 id="connect">How rotli connects to AI tools</h2>
  <p>
    Connected AI works through the command-line tools the AI companies publish: Claude Code from Anthropic,
    Codex from OpenAI, and Cursor's agent. You install one in Terminal and sign in to it yourself, the way
    its maker describes. rotli then runs that tool on your Mac and passes it your message, just as you could
    from Terminal.
  </p>
  <p>
    rotli never signs in on your behalf, never reads the tool's login files, and never stores its
    credentials. There is no rotli server in between and no shared account. The tool's own company handles
    the request under its own terms. On-device models skip all of this: they run on your Mac and need no
    network.
  </p>
  <p>
    <strong>Why:</strong> using each company's own published tool keeps your plan working the way it was
    sold to you, and keeps rotli out of the middle. rotli can switch between tools without ever holding a key
    to any of them. The install commands are on <a href="/features/connected-ai/">the AI tools’ feature page</a>.
  </p>

  <h2 id="web">Rotli Web and Rotli Helper</h2>
  <p>
    Rotli Web, at <code>rotli.co/app</code>, keeps every note as a file in a folder on your computer. In
    Chrome, Edge, or Arc it writes to that folder directly. In Firefox, Zen, or Brave, <strong>Rotli Helper</strong>,
    a small program you install yourself, reads and writes the one folder you pick with your computer's own
    folder picker. It listens only on your own computer, starts when you log in, and removes itself with its
    installer's uninstall option. Safari and phones aren't supported yet: they can't reach a folder on your
    computer.
  </p>
  <p>
    The page's security policy lets it load only its own files and connect to nothing but Rotli Helper on
    your computer. Pairing uses a code in the part of the address browsers never send to a server. Unsaved
    typing is held briefly in your browser so a refresh can't lose it, then written to your folder and
    cleared. The one way out is a chat you start: the Helper runs your own AI tool, which contacts its
    provider, and secure notes are refused before it runs.
  </p>
  <p>
    <strong>Why:</strong> a web app usually means your notes live on someone's server. Rotli Web is built the
    other way around: the page is just the editor, and your folder stays on your computer.
  </p>

  <h2 id="website">This website</h2>
  <p>
    rotli.co sets no cookies and runs no analytics, ads, or third-party scripts. Fonts, images, and the film
    are served from this site. The one exception is the Launch Llama badge in the footer, an image loaded
    from Launch Llama's own server, so that service sees a request from your browser when a page shows it.
    The star count beside the GitHub link is read from GitHub once, when the site is built, so your browser
    never contacts GitHub to show it; GitHub sees you only if you follow the link.
    Our hosting and DNS providers, Railway and Cloudflare, process standard request details such as your IP
    address to deliver pages.
  </p>
  <p>
    <strong>The email list.</strong> The footer's “Hear when it’s ready” list is optional. Only when you
    submit it, the address you type is sent to Resend, our email provider, and kept there as a contact on
    rotli's list, so we can email you when there's news about rotli. Every email has an unsubscribe link,
    handled by Resend; one click takes you off. Your address isn't used for anything else, and nothing else
    is collected or shared. Until the list opens, the form says so and the address is not kept or passed on.
  </p>
  <p>
    <strong>Roadmap votes.</strong> A vote on the <a href="/roadmap/">roadmap</a> adds one to that item's
    count, and the count is all we keep: no record of who voted, or when. So that you vote once per item, your
    browser remembers which items you voted for in its own storage on your computer (local storage, not a
    cookie, and never sent anywhere); clearing this site's data forgets it. To stop repeat votes and spam,
    the site briefly holds a scrambled key made from your IP address and the day, never the address itself.
    It lives only in the server's memory, changes every day, and is gone when the server restarts.
  </p>
  <p>
    <strong>Feature requests.</strong> A request keeps what you type in the form: a title, a description,
    and an email address only if you give one, so we can follow up, plus when it arrived. It's stored in a small database on our
    host, Railway, read only by the person building rotli, and never published; if an idea makes the
    roadmap, it's written there in our own words. Your email is never added to the list above. To have a
    request deleted, send another one saying so.
  </p>
  <p>
    <strong>Why:</strong> a site about keeping your work private shouldn't watch you read it.
  </p>

  <h2 id="retention">Keeping and deleting</h2>
  <p>
    There is no rotli server holding your notes, so there is nothing for us to keep or delete. You decide how
    long your files exist and where they are backed up. Services you deliberately send something to, like
    an AI provider or a website you search, keep it under their own policies.
  </p>

  <h2 id="changes">Changes to this page</h2>
  <p>
    This page describes rotli as it works today. It changes whenever a kind of data, a destination, a
    retention rule, or a control changes, and the product's own record of it is
    {site.sourcePublic ? (
      <>
        {' '}<a href={`${GITHUB_URL}/blob/main/PRIVACY.md`} rel="noopener">PRIVACY.md</a> in the source code, with its full history.
      </>
    ) : (
      ' the PRIVACY.md file kept with the source code.'
    )}{' '}
    It is a plain description of how the software works, not legal advice.
  </p>
</WritingPage>

<style>
  /* The promise: a lead line, the matrix, five plain points, and one note. It opens the article,
     so its heading starts at the top of the column, level with the rail's title. */
  :global(.writing.is-article .prose) > #promise {
    margin-top: 0;
  }
  .promise-lede {
    font-size: var(--step-lede);
    line-height: 1.5;
  }
  /* The matrix: its own full-width block below any floated companion, a strong rule over the
     header and hairlines between rows. A refusal reads in weight and in words; the accent ink on
     it measures 5.7:1 on the page ground. */
  .promise-matrix {
    clear: both;
    margin: 1.75rem 0 1.5rem;
  }
  .promise-matrix table {
    width: 100%;
    margin: 0;
    border-collapse: collapse;
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .promise-matrix caption {
    padding-bottom: 0.75rem;
    color: var(--text);
    font-size: 0.92rem;
    font-weight: 600;
    text-align: left;
  }
  .promise-matrix th,
  .promise-matrix td {
    padding: 0.8rem 0.9rem 0.8rem 0;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }
  .promise-matrix thead th {
    border-top: 1px solid var(--border-strong);
    border-bottom-color: var(--border-strong);
    color: var(--text);
    font-size: 0.86rem;
    font-weight: 600;
  }
  .promise-matrix th small {
    display: block;
    margin-top: 0.15rem;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 400;
  }
  .promise-matrix tbody th {
    width: 24%;
    color: var(--text);
  }
  .promise-matrix tbody th b {
    display: block;
    font-weight: 600;
  }
  .promise-matrix td[data-no] {
    color: var(--accent-text);
    font-weight: 600;
  }
  /* On a phone each note is a block: its name, then one line per reader, each naming its
     column (the label comes from the cell's data-who; the table keeps its roles). */
  @media (max-width: 640px) {
    .promise-matrix thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .promise-matrix tr {
      display: block;
      padding: 0.9rem 0;
      border-bottom: 1px solid var(--border);
    }
    .promise-matrix tbody tr:first-child {
      border-top: 1px solid var(--border-strong);
    }
    .promise-matrix th,
    .promise-matrix td {
      display: block;
      width: auto;
      padding: 0;
      border: 0;
    }
    .promise-matrix tbody th {
      width: auto;
      margin-bottom: 0.5rem;
    }
    .promise-matrix td {
      display: grid;
      grid-template-columns: 8.5rem minmax(0, 1fr);
      gap: 0.75rem;
      padding: 0.3rem 0;
    }
    .promise-matrix td::before {
      content: attr(data-who);
      color: var(--text-muted);
      font-weight: 400;
    }
  }
  .promise-points {
    display: grid;
    gap: 0.6rem;
  }
  .promise-note {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  /* The story film's night, as the head's picture (WritingPage `article`, the `cover` slot): a
     rounded frame like a post's picture, the caption in the open sky at the top and the dome of
     "on this Mac" standing on the frame's floor below it. The frame clips (ArticleCover's
     overflow), so the remote-AI clouds that drift in never leave it, and the caption keeps its own
     ground, so the stars never sit under the words. The night and its caption are there at once,
     still like a post's picture; only the scene inside plays, once (SecureScene's own reveal). The sky and its Ocean stars come from
     .band-night (Base.astro), like the landing's PrivacyBrief; only the colour is set here.
     Measured: the caption's --deep-muted on the night --deep is 8.6:1, its inked phrase
     --deep-text 15.7:1. */
  .night {
    box-sizing: border-box;
    display: grid;
    gap: 0.5rem;
    height: 100%;
    padding: clamp(1.25rem, 2.5vw, 1.75rem) clamp(1.25rem, 2.5vw, 1.75rem) 0;
    background-color: var(--deep);
    color: var(--deep-text);
  }
  .night-caption {
    justify-self: start;
    max-width: 32rem;
    margin: 0;
    background-color: var(--deep);
    box-shadow: 0 0 0 0.4rem var(--deep);
    color: var(--deep-muted);
    font-size: 1rem;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .night-caption .inked {
    color: var(--deep-text);
    font-weight: 600;
  }
  /* The dome on the frame's floor, centred, never taller than about half the first window, so the
     frame stays a picture beside the words and not a wall. */
  .dome-frame {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: 0;
  }
  .dome-frame :global(.scene) {
    width: 100%;
    max-width: min(100%, calc(min(20rem, 42svh) * 720 / 560));
  }
  /* The promise's matrix breaks out of the words like a post's table (blog/article.css), only
     where the middle has room for it; on a narrow middle it keeps the measure. */
  @container article-prose (min-width: 48.5rem) {
    :global(.writing.is-article .prose) > .promise-matrix {
      max-width: min(100%, var(--measure) + 10rem);
    }
  }
  /* The companion beside a section, the way the app shows it. */
  /* The column's right edge, not the middle track's: every block of the article is centred at the
     measure (blog/article.css), and a float's auto margins are zero, so it is placed by hand. */
  :global(.writing.is-article .prose) > .spot {
    float: right;
    width: 132px;
    height: 132px;
    margin: 0 max(0px, (100% - var(--measure)) / 2) 1rem 1.5rem;
    shape-outside: circle(48%);
  }
  @media (max-width: 560px) {
    :global(.writing.is-article .prose) > .spot {
      width: 96px;
      height: 96px;
    }
  }
</style>
