---
import Base from '../layouts/Base.astro';
import mark from '../../../src/assets/characters/_logo.svg?raw';
import SunsetScene from '../components/SunsetScene.astro';
import { DOWNLOAD_HREF, WEB_APP_PATH, site } from '../site';

// One page for every missing path, set where the story film ends: the sunset fills the
// window, no header or footer, one way home. The hint under the headline is chosen in the
// browser from the path itself: /app when Rotli Web is not switched on here, /helper for the
// helper's pages, else the plain truth.
const also = [
  ...(site.downloadsEnabled ? [{ href: DOWNLOAD_HREF, label: 'Download for Mac' }] : []),
  ...(site.webAppEnabled ? [{ href: WEB_APP_PATH, label: 'Open Rotli Web' }] : []),
  ...(site.showsFullSite ? [{ href: '/resources/', label: 'Resources' }] : []),
];
---

<Base
  title="Page not found — rotli"
  description="That page is not part of rotli's website."
  canonicalPath="/404/"
  noindex
>
  <main id="content" class="not-found" data-web-app={site.webAppEnabled ? 'on' : 'off'}>
    <SunsetScene full>
      <div class="lost" data-reveal>
        <a class="brand" href="/" aria-label="rotli home"><span set:html={mark} aria-hidden="true"></span><b>rotli</b></a>
        <p class="code">404</p>
        <h1>This note <span class="inked">wandered off.</span></h1>
        <p class="hint" data-hint="default">The page you followed is not here, but rotli still is.</p>
        <p class="hint" data-hint="app" hidden>
          Rotli Web is not switched on at this address yet. Everything it will do, the Mac app does today.
        </p>
        <p class="hint" data-hint="helper" hidden>
          {
            site.showsFullSite ? (
              <>
                Looking for Rotli Helper? <a href="/resources/rotli-helper/">What it is and how to install it</a>.
              </>
            ) : (
              'Rotli Helper is not published at this address yet.'
            )
          }
        </p>
        <p class="path"><code data-path></code></p>
        <a class="button primary home" href="/">Take me home</a>
        {
          also.length > 0 && (
            <nav class="also" aria-label="Where to go instead">
              {also.map((link, i) => (
                <>
                  {i > 0 && <span aria-hidden="true"> · </span>}
                  <a href={link.href}>{link.label}</a>
                </>
              ))}
            </nav>
          )
        }
      </div>
    </SunsetScene>
  </main>

  <script>
    const main = document.querySelector<HTMLElement>('.not-found');
    const path = window.location.pathname;
    const kind = path.startsWith('/app') && main?.dataset.webApp !== 'on' ? 'app' : path.startsWith('/helper') ? 'helper' : 'default';
    for (const hint of document.querySelectorAll<HTMLElement>('[data-hint]')) hint.hidden = hint.dataset.hint !== kind;
    const code = document.querySelector<HTMLElement>('[data-path]');
    if (code && path !== '/404/' && path !== '/404.html') code.textContent = path;
  </script>

  <style>
    .lost {
      display: grid;
      justify-items: center;
      gap: 0.6rem;
      padding: 0 var(--gutter);
      text-align: center;
    }
    .brand {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: clamp(1.5rem, 5vh, 3rem);
      color: var(--text);
      font-family: var(--font-wordmark);
      font-size: 1.5rem;
      text-decoration: none;
    }
    .brand :global(svg) {
      width: 30px;
      height: 30px;
    }
    .code {
      margin: 0;
      color: var(--text);
      font-weight: 600;
      letter-spacing: 0.12em;
      font-size: 0.85rem;
    }
    h1 {
      margin: 0;
      font-size: var(--step-display);
      font-weight: 600;
      line-height: 1;
      letter-spacing: -0.045em;
      text-wrap: balance;
    }
    /* Muted ink is too faint on the sky; the sunset reads in the page's ink. */
    .hint {
      max-width: 34rem;
      margin: 0.6rem 0 0;
      color: var(--text);
      font-size: var(--step-lede);
      line-height: 1.5;
    }
    .hint a,
    .also a {
      color: var(--text);
      font-weight: 600;
      text-underline-offset: 0.2em;
    }
    .path {
      margin: 0;
      min-height: 1.4em;
      color: var(--text);
      font-size: 0.9rem;
      opacity: 0.8;
    }
    .path code:empty {
      display: none;
    }
    .home {
      margin-top: 1.25rem;
    }
    .also {
      margin: 0.75rem 0 0;
      color: var(--text);
      font-size: 0.92rem;
    }
  </style>
</Base>
