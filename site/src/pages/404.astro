---
import Base from '../layouts/Base.astro';
import mark from '../../../src/assets/characters/_logo.svg?raw';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { DOWNLOAD_HREF, ROADMAP_URL, WEB_APP_PATH, site } from '../site';

// One page for every missing path. The hint under the headline is chosen in
// the browser from the path itself: /app when Rotli Web is not switched on
// here, /helper for the helper's pages, else the plain truth.
const links = [
  { href: '/', label: 'Home', note: 'The site, from the top.' },
  ...(site.downloadsEnabled
    ? [{ href: DOWNLOAD_HREF, label: 'Download Rotli', note: 'The Mac app, a .dmg.' }]
    : []),
  ...(site.webAppEnabled
    ? [{ href: WEB_APP_PATH, label: 'Rotli Web', note: 'Your vault, in a browser.' }]
    : []),
  ...(site.sourcePublic ? [{ href: ROADMAP_URL, label: 'Roadmap', note: 'What is next.' }] : []),
];
---

<Base
  title="Page not found — rotli"
  description="That page is not part of rotli's website."
  canonicalPath="/404/"
  noindex
>
  <SiteHeader />
  <main class="not-found" data-web-app={site.webAppEnabled ? 'on' : 'off'}>
    <div class="mark" aria-hidden="true" set:html={mark} />
    <p class="code">404</p>
    <h1>This note wandered off.</h1>
    <p class="hint" data-hint="default">The page you followed is not here, but rotli still is.</p>
    <p class="hint" data-hint="app" hidden>
      Rotli Web is not switched on at this address yet. Everything it will do, the Mac app does today.
    </p>
    <p class="hint" data-hint="helper" hidden>
      The helper's pages are not published here yet. Rotli Web shows the pairing steps once it is on.
    </p>
    <p class="path"><code data-path></code></p>
    <nav class="ways" aria-label="Where to go instead">
      {
        links.map((link) => (
          <a href={link.href}>
            <strong>{link.label}</strong>
            <span>{link.note}</span>
          </a>
        ))
      }
    </nav>
  </main>
  <SiteFooter />

  <script>
    const main = document.querySelector<HTMLElement>('.not-found');
    const path = window.location.pathname;
    const kind = path.startsWith('/app') && main?.dataset.webApp !== 'on' ? 'app' : path.startsWith('/helper') ? 'helper' : 'default';
    for (const hint of document.querySelectorAll<HTMLElement>('[data-hint]')) hint.hidden = hint.dataset.hint !== kind;
    const code = document.querySelector<HTMLElement>('[data-path]');
    if (code && path !== '/404/' && path !== '/404.html') code.textContent = path;
  </script>

  <style>
    .not-found {
      min-height: calc(100vh - 12rem);
      display: grid;
      place-content: center;
      justify-items: center;
      gap: 0.6rem;
      padding: 4rem 1.5rem 5rem;
      text-align: center;
    }
    .mark {
      width: 84px;
      height: 84px;
      margin-bottom: 0.5rem;
      color: var(--text);
      opacity: 0.85;
    }
    .mark :global(svg) {
      width: 100%;
      height: 100%;
    }
    .code {
      margin: 0;
      color: var(--accent-text);
      font-weight: 600;
      letter-spacing: 0.12em;
      font-size: 0.85rem;
    }
    h1 {
      margin: 0;
      font-family: var(--font-display);
      font-size: clamp(2rem, 7vw, 3.6rem);
      line-height: 1.08;
      letter-spacing: -0.01em;
    }
    .hint {
      max-width: 34rem;
      margin: 0.4rem 0 0;
      color: var(--text-muted);
      font-size: 1.05rem;
      line-height: 1.5;
    }
    .path {
      margin: 0;
      min-height: 1.4em;
      color: var(--text-muted);
      font-size: 0.85rem;
    }
    .path code:empty {
      display: none;
    }
    .ways {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
      gap: 0.6rem;
      width: min(100%, 44rem);
      margin-top: 1.6rem;
    }
    .ways a {
      display: grid;
      gap: 0.2rem;
      padding: 0.9rem 1rem;
      border: 1px solid var(--border);
      border-radius: 0.9rem;
      background: var(--surface);
      color: var(--text);
      text-decoration: none;
      text-align: left;
      transition: border-color 120ms ease, background-color 120ms ease;
    }
    .ways a:hover,
    .ways a:focus-visible {
      border-color: var(--accent-text);
      background: color-mix(in srgb, var(--accent-text) 8%, var(--surface));
      outline: none;
    }
    .ways strong {
      font-weight: 600;
    }
    .ways span {
      color: var(--text-muted);
      font-size: 0.9rem;
    }
  </style>
</Base>
