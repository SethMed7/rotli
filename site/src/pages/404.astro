---
import Base from '../layouts/Base.astro';
import { mark } from '../mark';
import walkingBody from '../../../src/assets/characters/concepts/layers/walking-body.webp';
import walkingLine from '../../../src/assets/characters/concepts/layers/walking-line.webp';
import QuokkaScene from '../components/QuokkaScene.astro';
import { site } from '../site';

// One page for every missing path: the note that wandered off, one way home, and along the
// bottom of the window a small game on the footer's beach (no header or footer): the quokka
// runs, jumps the rocks, bushes, logs, and sandcastles, and ducks under the gulls and low
// branches, a little faster each stretch, and the score is how far it got (src/runner/). It
// starts only when Play is pressed; "Take me home" and the other ways in stay above it,
// usable before, during, and after a run. Without script the beach is the footer's quokka
// scenery instead. The words are few (the owner, 2026-10-05: "simplify the text"): a line
// under the headline appears only for /app and /helper, chosen in the browser from the path.
const also = site.showsFullSite
  ? [
      { href: '/download/', label: 'Try rotli' },
      { href: '/resources/', label: 'Resources' },
    ]
  : [];
---

<Base
  title="Page not found — rotli"
  description="That page is not part of rotli's website."
  canonicalPath="/404/"
  noindex
>
  <main id="content" class="not-found" data-web-app={site.webAppEnabled ? 'on' : 'off'}>
    <div class="lost" data-reveal>
      <a class="brand" href="/" aria-label="rotli home"><span set:html={mark} aria-hidden="true"></span><b>rotli</b></a>
      <p class="code">404</p>
      <h1>This note <span class="inked">wandered off.</span></h1>
      <p class="hint" data-hint="app" hidden>Rotli Web is not switched on at this address yet.</p>
      <p class="hint" data-hint="helper" hidden>
        {
          site.showsFullSite ? (
            <>
              Looking for Rotli Helper? <a href="/blog/rotli-helper/">Here is how to install it</a>.
            </>
          ) : (
            'Rotli Helper is not published at this address yet.'
          )
        }
      </p>
      <a class="button primary home" href="/">Take me home</a>
      {
        also.length > 0 && (
          <nav class="also" aria-label="Where to go instead">
            {also.map((link, i) => (
              <>
                {i > 0 && <span aria-hidden="true"> · </span>}
                <a href={link.href}>{link.label}</a>
              </>
            ))}
          </nav>
        )
      }
    </div>
    <section
      class="runner"
      data-runner
      data-body={walkingBody.src}
      data-line={walkingLine.src}
      tabindex="-1"
      aria-labelledby="runner-title"
      aria-describedby="runner-help"
    >
      <canvas aria-hidden="true"></canvas>
      <p class="runner-score" aria-hidden="true">
        <span><span data-score>0</span> m</span>
        <span class="runner-level">Level <span data-level>1</span></span>
        <span class="runner-best">Best <span data-best>0</span> m</span>
      </p>
      <div class="runner-overlay" data-overlay>
        <h2 id="runner-title" data-overlay-title>Help the quokka home</h2>
        <p data-overlay-note hidden></p>
        <p class="runner-hint" id="runner-help">
          <span class="for-keys">Space or ↑ to jump, ↓ to duck.</span>
          <span class="for-touch">Tap to jump. Swipe down to duck.</span>
        </p>
        <button class="button primary" type="button" data-play>Play</button>
      </div>
      <p class="visually-hidden" aria-live="polite" data-announce></p>
    </section>
    <QuokkaScene />
  </main>

  <script>
    import { mountRunner } from '../runner/stage';

    const runner = document.querySelector<HTMLElement>('[data-runner]');
    if (runner) mountRunner(runner);
    const main = document.querySelector<HTMLElement>('.not-found');
    const path = window.location.pathname;
    const kind = path.startsWith('/app') && main?.dataset.webApp !== 'on' ? 'app' : path.startsWith('/helper') ? 'helper' : 'default';
    for (const hint of document.querySelectorAll<HTMLElement>('[data-hint]')) hint.hidden = hint.dataset.hint !== kind;
  </script>

  <style>
    /* The words in the middle of the window, the scenery along its bottom edge. */
    .not-found {
      display: grid;
      grid-template-rows: 1fr auto;
      min-height: 100svh;
    }
    /* The game takes the scenery's place when script runs; without it, the scenery stays.
       Tall enough for a jump and what flies over it (the owner, 2026-10-05: "make the game
       taller"), and never so tall on a phone that the world shrinks to a few steps wide. */
    .runner {
      display: none;
      position: relative;
      height: min(clamp(300px, 50svh, 460px), 86vw);
      border-top: 1px solid var(--border);
      outline: none;
    }
    :global(.js) .runner {
      display: block;
    }
    :global(.js) .not-found > :global(.scenery-wrap) {
      display: none;
    }
    .runner:focus-visible {
      outline: 2px solid var(--accent-text);
      outline-offset: -2px;
    }
    .runner canvas {
      display: block;
      width: 100%;
      height: 100%;
      touch-action: manipulation;
      cursor: pointer;
    }
    /* During a run a swipe on the stage is the game's (a swipe down ducks), not a scroll. */
    .runner[data-state='running'] canvas {
      touch-action: none;
    }
    /* The score, the level, and the best run show only during a run: before one there is
       nothing to count, and after one the overlay says it. */
    .runner:not([data-state='running']):not([data-state='paused']) .runner-score {
      visibility: hidden;
    }
    .runner:not([data-has-best='true']) .runner-best {
      display: none;
    }
    .runner-level {
      color: var(--text-muted);
      font-weight: 500;
      transition: color 300ms ease-out;
    }
    .runner-level:global(.is-up) {
      color: var(--accent-text);
    }
    .runner-overlay .runner-hint {
      color: var(--text-muted);
    }
    .runner-hint .for-touch,
    .runner[data-state='over'] .runner-hint {
      display: none;
    }
    @media (pointer: coarse) {
      .runner-hint .for-touch {
        display: inline;
      }
      .runner-hint .for-keys {
        display: none;
      }
    }
    .runner-score {
      position: absolute;
      top: 0.75rem;
      right: var(--gutter);
      display: flex;
      gap: 1rem;
      margin: 0;
      color: var(--ink);
      font-size: 1.05rem;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
    }
    .runner-best {
      color: var(--text-muted);
      font-weight: 500;
    }
    /* Start, pause, and the result sit on the sky, above the sand line, never on the quokka. */
    .runner-overlay {
      position: absolute;
      inset: 0 0 46% 0;
      display: grid;
      align-content: center;
      justify-items: center;
      gap: 0.5rem;
      padding: 1rem var(--gutter);
      text-align: center;
    }
    .runner-overlay[hidden] {
      display: none;
    }
    .runner-overlay h2 {
      margin: 0;
      font-size: var(--step-h3);
      font-weight: 600;
      letter-spacing: -0.02em;
    }
    .runner-overlay p {
      max-width: 30rem;
      margin: 0 0 0.4rem;
      color: var(--text);
      font-size: 0.95rem;
    }
    .runner-overlay .button {
      min-height: 44px;
    }
    .lost {
      align-self: center;
      padding-block: clamp(2rem, 6vh, 4rem) clamp(1.5rem, 4vh, 3rem);
      display: grid;
      justify-items: center;
      gap: 0.6rem;
      padding: 0 var(--gutter);
      text-align: center;
    }
    .brand {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: clamp(1.5rem, 5vh, 3rem);
      color: var(--text);
      font-family: var(--font-wordmark);
      font-size: 1.5rem;
      text-decoration: none;
    }
    .brand :global(svg) {
      width: 30px;
      height: 30px;
    }
    .code {
      margin: 0;
      color: var(--text);
      font-weight: 600;
      letter-spacing: 0.12em;
      font-size: 0.85rem;
    }
    h1 {
      margin: 0;
      font-size: var(--step-display);
      font-weight: 600;
      line-height: 1;
      letter-spacing: -0.045em;
      text-wrap: balance;
    }
    .hint {
      max-width: 34rem;
      margin: 0.6rem 0 0;
      color: var(--text);
      font-size: var(--step-lede);
      line-height: 1.5;
    }
    .hint a,
    .also a {
      color: var(--text);
      font-weight: 600;
      text-underline-offset: 0.2em;
    }
    /* On touch each way in gets a 44px-tall hit area without moving the line. */
    @media (pointer: coarse) {
      .also a {
        display: inline-block;
        padding: 0.8rem 0;
        margin: -0.8rem 0;
      }
    }
    .home {
      margin-top: 1.25rem;
    }
    .also {
      margin: 0.75rem 0 0;
      color: var(--text);
      font-size: 0.92rem;
    }
  </style>
</Base>
