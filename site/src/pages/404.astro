---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found — rotli"
  description="That page is not part of rotli's website."
  canonicalPath="/404/"
  noindex
>
  <main class="not-found">
    <p class="code">404</p>
    <h1>This note wandered off.</h1>
    <p>The page you followed is not here, but rotli still is.</p>
    <a href="/">Back to rotli</a>
  </main>

  <style>
    .not-found {
      min-height: 100vh;
      display: grid;
      place-content: center;
      justify-items: center;
      gap: 0.75rem;
      padding: 2rem;
      text-align: center;
    }

    .code {
      margin: 0;
      color: var(--accent-text);
      font-weight: 600;
    }

    h1 {
      margin: 0;
      font-family: var(--font-display);
      font-size: clamp(2rem, 8vw, 4rem);
      line-height: 1.1;
    }

    p {
      margin: 0;
      color: var(--text-muted);
    }

    a {
      margin-top: 1rem;
      padding: 0.7rem 1.4rem;
      border-radius: 0.7rem;
      background: var(--accent-text);
      color: var(--on-accent);
      font-weight: 500;
      text-decoration: none;
    }
  </style>
</Base>
