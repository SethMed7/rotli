---
// /roadmap/: ROADMAP.md at the repository root, rendered at build time (src/roadmap.ts),
// so the page and the file can never disagree: the build fails on a missing or
// repeated id, and astro.config.mjs checks the built page against the file. Only
// the three public sections show (In the work, Planned, Ideas); the rest stays in
// the file. People take part two ways, both through the site's sidecar
// (site/server/roadmap.ts): a vote per item (one per browser, remembered in
// localStorage) and a request form. Until the sidecar's database is configured the
// probe answers 503 and the page says voting and requests open soon.
import RoadmapMock from '../../components/RoadmapMock.astro';
import WritingPage from '../../components/WritingPage.astro';
import { codeParts, REQUEST_LIMITS, publicRoadmap, SIZES } from '../../roadmap';
import { readRoadmapFile } from '../../roadmap-file';
import { ROADMAP_URL, site } from '../../site';

export function getStaticPaths() {
  return site.showsFullSite ? [{ params: { slug: undefined } }] : [];
}

const [work, planned, ideas] = publicRoadmap(readRoadmapFile());
const ledes: Record<string, string> = {
  [work.slug]: 'Being built now, in development builds. Not released, so not done.',
  [planned.slug]: 'Decided, not started.',
  [ideas.slug]: 'Not decided yet. Votes here help decide what comes next.',
};
const plain = (text: string) => text.replaceAll('`', '');
---

<WritingPage
  title="Roadmap — rotli"
  description="What is being built for rotli, what is planned, and what is still an idea. Vote for what you want, or ask for something new."
  canonicalPath="/roadmap/"
  section="roadmap"
  heading="What’s next for rotli"
  lede="What’s being built, what’s decided, and what’s still an idea. Vote for what you want to see, or ask for something new."
  meta={['Direction, not a promise', 'No dates']}
  markdownPath="/roadmap/index.md"
  wide
>
  <div slot="after" class="roadmap" data-roadmap>
    <div class="roadmap-key">
      <p class="sizes">
        <span class="key-label">Size</span>
        {
          SIZES.map(({ size, meaning }) => (
            <span>
              <b>{size}</b> {meaning}
            </span>
          ))
        }
      </p>
      <p class="participation" id="participation-note" role="status" data-roadmap-note>
        Voting and requests open soon.
      </p>
    </div>

    <section class="roadmap-section" aria-labelledby={work.slug}>
      <h2 id={work.slug}>{work.title}</h2>
      <p class="section-note">{ledes[work.slug]}</p>
      <ul class="work-grid">
        {
          work.items.map((item) => (
            <li class="work-card" data-roadmap-item={item.id}>
              <RoadmapMock id={item.id} />
              <div class="card-body">
                <h3>{codeParts(item.title).map((part) => (part.code ? <code>{part.text}</code> : part.text))}</h3>
                <p>{codeParts(item.summary).map((part) => (part.code ? <code>{part.text}</code> : part.text))}</p>
                <div class="card-foot">
                  {item.size && <span class="size" title="How big it is">Size {item.size}</span>}
                  <button
                    type="button"
                    class="vote"
                    data-vote={item.id}
                    data-title={plain(item.title)}
                    aria-pressed="false"
                    aria-describedby="participation-note"
                    disabled
                  >
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3.5 13 10.5H3Z" /></svg>
                    <span data-vote-label>Vote</span>
                    <span class="count" data-vote-count />
                    <span class="visually-hidden"> for {plain(item.title)}</span>
                  </button>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    {
      [planned, ideas].map((section) => (
        <section class="roadmap-section" aria-labelledby={section.slug}>
          <h2 id={section.slug}>{section.title}</h2>
          <p class="section-note">{ledes[section.slug]}</p>
          <ul class="calm-list">
            {section.items.map((item) => (
              <li data-roadmap-item={item.id}>
                <div class="calm-text">
                  <h3>{codeParts(item.title).map((part) => (part.code ? <code>{part.text}</code> : part.text))}</h3>
                  <p>{codeParts(item.summary).map((part) => (part.code ? <code>{part.text}</code> : part.text))}</p>
                </div>
                <span class="size">{item.size ? `Size ${item.size}` : ''}</span>
                <button
                  type="button"
                  class="vote"
                  data-vote={item.id}
                  data-title={plain(item.title)}
                  aria-pressed="false"
                  aria-describedby="participation-note"
                  disabled
                >
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M8 3.5 13 10.5H3Z" />
                  </svg>
                  <span data-vote-label>Vote</span>
                  <span class="count" data-vote-count />
                  <span class="visually-hidden"> for {plain(item.title)}</span>
                </button>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section class="roadmap-section request" id="request" aria-labelledby="request-title">
      <h2 id="request-title">Ask for something</h2>
      <p class="section-note">
        Missing something? Say what you want rotli to do and what you’d use it for. Requests are read by the person
        building rotli and are never published; if one makes the list, it appears above in our own words.
      </p>
      <p class="request-sent" id="request-sent" tabindex="-1">Thanks. Your request is in.</p>
      <form
        class="request-form"
        action="/api/roadmap/request"
        method="post"
        data-request
        aria-labelledby="request-title"
      >
        <div class="field">
          <label for="request-title-input">What should rotli do?</label>
          <input
            id="request-title-input"
            name="title"
            type="text"
            required
            minlength={REQUEST_LIMITS.title.min}
            maxlength={REQUEST_LIMITS.title.max}
            autocomplete="off"
            aria-describedby="request-title-error"
          />
          <p class="field-error" id="request-title-error" data-error-for="title"></p>
        </div>
        <div class="field">
          <label for="request-description">Tell us more</label>
          <p class="field-hint" id="request-description-hint">What would you use it for? What do you do today instead?</p>
          <textarea
            id="request-description"
            name="description"
            rows="5"
            required
            minlength={REQUEST_LIMITS.description.min}
            maxlength={REQUEST_LIMITS.description.max}
            aria-describedby="request-description-hint request-description-error"></textarea>
          <p class="field-error" id="request-description-error" data-error-for="description"></p>
        </div>
        <div class="field">
          <label for="request-email">Email <span class="optional">(optional)</span></label>
          <p class="field-hint" id="request-email-hint">Only to follow up on this request. It doesn’t join any list.</p>
          <input
            id="request-email"
            name="email"
            type="email"
            maxlength="254"
            autocomplete="email"
            aria-describedby="request-email-hint request-email-error"
          />
          <p class="field-error" id="request-email-error" data-error-for="email"></p>
        </div>
        <div class="trap" aria-hidden="true">
          <label>Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <p class="consent">
          We keep what you send, and your email if you give one, so we can read it and reply. Nothing here is shared
          or published. <a href="/privacy/#website">How the site handles it</a>
        </p>
        <div class="form-foot">
          <button class="button primary" type="submit">Send request</button>
          <p class="form-status" role="status" data-request-status></p>
        </div>
      </form>
    </section>

    <p class="source">
      {
        site.sourcePublic ? (
          <>
            This page is built from <a href={ROADMAP_URL} rel="noopener">ROADMAP.md</a> in rotli’s source, which has
            the full detail behind every item.
          </>
        ) : (
          'This page is built from the roadmap file kept with rotli’s source.'
        )
      }
    </p>
  </div>
</WritingPage>

<script>
  // Votes and requests (site/server/roadmap.ts). Off until the probe answers 200 with
  // { live: true }: astro preview (404), a stopped sidecar (Caddy's plain 503), and an
  // unconfigured one (503 JSON) all leave the page in its "opens soon" state. A browser
  // votes once per item; the marker is the list of ids in localStorage, nothing else.
  const STORE = 'rotli.roadmap.voted';
  const root = document.querySelector<HTMLElement>('[data-roadmap]');
  const note = document.querySelector<HTMLElement>('[data-roadmap-note]');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('button[data-vote]')];
  const form = document.querySelector<HTMLFormElement>('[data-request]');
  const formStatus = form?.querySelector<HTMLElement>('[data-request-status]') ?? null;

  function readVoted(): Set<string> {
    try {
      const raw: unknown = JSON.parse(localStorage.getItem(STORE) ?? '[]');
      return new Set(Array.isArray(raw) ? raw.filter((id): id is string => typeof id === 'string') : []);
    } catch {
      return new Set();
    }
  }
  function saveVoted(voted: Set<string>) {
    try {
      localStorage.setItem(STORE, JSON.stringify([...voted]));
    } catch {
      // Private windows may refuse storage; the vote still counted on the server.
    }
  }
  const voted = readVoted();
  const counts = new Map<string, number>();

  function paint(button: HTMLButtonElement) {
    const id = button.dataset.vote ?? '';
    const title = button.dataset.title ?? '';
    const mine = voted.has(id);
    const count = counts.get(id) ?? 0;
    button.setAttribute('aria-pressed', String(mine));
    const label = button.querySelector('[data-vote-label]');
    if (label) label.textContent = mine ? 'Voted' : 'Vote';
    const shown = button.querySelector('[data-vote-count]');
    if (shown) shown.textContent = String(count);
    const votes = `${count} ${count === 1 ? 'vote' : 'votes'}`;
    button.setAttribute('aria-label', mine ? `You voted for ${title}, ${votes}` : `Vote for ${title}, ${votes}`);
  }

  function say(text: string) {
    if (!note) return;
    note.textContent = text;
    note.hidden = text === '';
  }

  function setLive(live: boolean) {
    root?.setAttribute('data-state', live ? 'live' : 'off');
    for (const button of buttons) {
      button.disabled = !live;
      if (live) {
        button.removeAttribute('aria-describedby');
        paint(button);
      }
    }
    if (live) say('');
    if (form && !live) {
      for (const control of form.elements) (control as HTMLInputElement).disabled = true;
      if (formStatus) formStatus.textContent = 'Requests open soon.';
    }
  }

  async function vote(button: HTMLButtonElement) {
    const id = button.dataset.vote ?? '';
    if (voted.has(id) || button.getAttribute('aria-busy') === 'true') return;
    button.setAttribute('aria-busy', 'true');
    try {
      const res = await fetch('/api/roadmap/vote', {
        method: 'POST',
        headers: { 'content-type': 'application/json', accept: 'application/json' },
        body: JSON.stringify({ id }),
      });
      const body = (await res.json().catch(() => ({}))) as { ok?: boolean; count?: number; error?: string };
      if (!res.ok || body.ok !== true) throw new Error(body.error || 'That vote did not go through. Try again in a moment.');
      if (typeof body.count === 'number') counts.set(id, body.count);
      voted.add(id);
      saveVoted(voted);
      say('');
    } catch (error) {
      say(error instanceof Error ? error.message : 'That vote did not go through. Try again in a moment.');
    } finally {
      button.removeAttribute('aria-busy');
      paint(button);
    }
  }

  for (const button of buttons) button.addEventListener('click', () => void vote(button));

  // The request form: the browser's own checks without script; with it, the same limits
  // said beside each field, then a JSON post that stays on the page.
  const messages: Record<string, (field: HTMLInputElement | HTMLTextAreaElement) => string> = {
    title: (field) =>
      field.value.trim().length === 0
        ? 'Give it a short title.'
        : `A short title, ${field.minLength} to ${field.maxLength} characters.`,
    description: (field) =>
      field.value.trim().length === 0
        ? 'Say a little more about it.'
        : `A little more, please: at least ${field.minLength} characters.`,
    email: () => 'That email address does not look right.',
  };

  function showError(name: string, text: string) {
    if (!form) return;
    const field = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;
    const slot = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
    if (slot) slot.textContent = text;
    field?.setAttribute('aria-invalid', text ? 'true' : 'false');
  }

  function check(): boolean {
    if (!form) return false;
    let first: HTMLElement | null = null;
    for (const name of ['title', 'description', 'email']) {
      const field = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;
      const value = field.value.trim();
      const bad =
        (field.required && value.length === 0) ||
        (value.length > 0 && field.minLength > 0 && value.length < field.minLength) ||
        (field.type === 'email' && value.length > 0 && !field.checkValidity());
      showError(name, bad ? messages[name](field) : '');
      if (bad && !first) first = field;
    }
    first?.focus();
    return first === null;
  }

  if (form) {
    form.noValidate = true;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!check()) return;
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const fields = Object.fromEntries(
        [...new FormData(form)].filter((entry): entry is [string, string] => typeof entry[1] === 'string'),
      );
      if (submit) submit.disabled = true;
      form.setAttribute('data-state', 'sending');
      if (formStatus) formStatus.textContent = 'Sending…';
      try {
        const res = await fetch('/api/roadmap/request', {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify(fields),
        });
        const body = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string; field?: string };
        if (!res.ok || body.ok !== true) {
          if (body.field) showError(body.field, body.error ?? '');
          throw new Error(body.error || 'That did not go through. Try again in a moment.');
        }
        form.reset();
        form.setAttribute('data-state', 'done');
        if (formStatus) formStatus.textContent = 'Thanks. Your request is in.';
      } catch (error) {
        form.setAttribute('data-state', 'error');
        if (formStatus) {
          formStatus.textContent = error instanceof Error ? error.message : 'That did not go through. Try again in a moment.';
        }
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  }

  fetch('/api/roadmap/votes', { headers: { accept: 'application/json' }, cache: 'no-store' })
    .then(async (res) => (res.ok ? ((await res.json()) as { live?: boolean; votes?: Record<string, number> }) : { live: false }))
    .then((probe) => {
      if (probe.live !== true) return setLive(false);
      for (const [id, count] of Object.entries(probe.votes ?? {})) if (typeof count === 'number') counts.set(id, count);
      setLive(true);
    })
    .catch(() => setLive(false));
</script>

<style>
  /* The size key and the voting state, one line under the head's rule. */
  .roadmap-key {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
  }
  .sizes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  .sizes b {
    color: var(--text);
    font-weight: 600;
  }
  .key-label {
    color: var(--text);
    font-weight: 600;
  }
  .participation {
    margin: 0;
    color: var(--text);
    font-size: 0.92rem;
    font-weight: 500;
  }
  .participation[hidden] {
    display: none;
  }

  .roadmap-section {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }
  .roadmap-section > h2 {
    margin: 0;
    font-size: var(--step-h3);
    font-weight: 600;
    letter-spacing: -0.02em;
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
  }
  .section-note {
    max-width: 40rem;
    margin: 0.35rem 0 1.5rem;
    color: var(--text-muted);
    line-height: 1.55;
  }
  .roadmap h3 {
    margin: 0;
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .roadmap code {
    padding: 0.05em 0.3em;
    border-radius: 0.3rem;
    background: var(--surface-2);
    font-size: 0.92em;
    overflow-wrap: anywhere;
  }

  /* In the work: cards, each with its drawing on top. */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18.5rem), 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .work-card {
    display: flex;
    flex-direction: column;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-frame);
    background: var(--surface);
  }
  .card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.1rem 1.2rem 1.2rem;
  }
  .card-body p {
    flex: 1;
    margin: 0;
    color: var(--text-muted);
    line-height: 1.55;
  }
  .card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  /* Planned and Ideas: a calm list, hairlines between rows. */
  .calm-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .calm-list li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 6rem auto;
    gap: 0.5rem 1.5rem;
    align-items: center;
    margin: 0;
    padding: 1.1rem 0;
    border-top: 1px solid var(--border);
  }
  .calm-list li:last-child {
    border-bottom: 1px solid var(--border);
  }
  .calm-text p {
    max-width: 46rem;
    margin: 0.2rem 0 0;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .size {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* The vote control: one quiet pill; the count is the figure, the arrow the act. */
  .vote {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-width: 6.5rem;
    min-height: 44px;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 140ms ease-out, border-color 140ms ease-out;
  }
  .vote svg {
    width: 0.85rem;
    height: 0.85rem;
    fill: currentColor;
  }
  .vote:hover:not(:disabled) {
    background: var(--surface-2);
  }
  .vote[aria-pressed='true'] {
    border-color: var(--accent-text);
    background: var(--tint);
    color: var(--accent-text);
    cursor: default;
  }
  .vote[aria-busy='true'] {
    cursor: progress;
  }
  .vote:disabled {
    color: var(--text-muted);
    cursor: not-allowed;
  }
  .count {
    min-width: 1.5ch;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .count:empty {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .vote {
      transition: none;
    }
  }

  /* The request form. */
  .request {
    max-width: 40rem;
  }
  .request-form {
    display: grid;
    gap: 1.1rem;
  }
  .field label {
    display: block;
    font-weight: 600;
  }
  .optional {
    color: var(--text-muted);
    font-weight: 400;
  }
  .field-hint {
    margin: 0.15rem 0 0;
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  .field input,
  .field textarea {
    display: block;
    width: 100%;
    min-height: 44px;
    margin-top: 0.45rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--border-strong);
    border-radius: 0.6rem;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
  }
  .field textarea {
    resize: vertical;
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 1px;
  }
  .field [aria-invalid='true'] {
    border-color: var(--accent-text);
  }
  .field input:disabled,
  .field textarea:disabled {
    background: var(--surface-2);
    color: var(--text-muted);
    cursor: not-allowed;
  }
  .field-error {
    margin: 0.35rem 0 0;
    color: var(--accent-text);
    font-size: 0.92rem;
    font-weight: 500;
  }
  .field-error:empty {
    display: none;
  }
  .trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .consent {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .consent a,
  .source a {
    color: var(--accent-text);
    text-underline-offset: 0.2em;
  }
  .form-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }
  .form-foot .button {
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .form-foot .button:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }
  .form-status {
    margin: 0;
    color: var(--text);
  }
  .request-form[data-state='error'] .form-status {
    color: var(--accent-text);
    font-weight: 500;
  }
  /* A request posted without script lands on #request-sent. */
  .request-sent {
    display: none;
    margin: 0 0 1.25rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--accent-text);
    border-radius: 0.6rem;
    color: var(--text);
    font-weight: 500;
  }
  .request-sent:target {
    display: block;
  }

  .source {
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  @media (max-width: 700px) {
    .calm-list li {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .calm-text {
      grid-column: 1 / -1;
    }
  }
</style>
