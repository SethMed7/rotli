---
// /features/ and /features/<id>/: the capability catalog and one page per capability, all from
// src/features.ts, so the catalog, the pages, their Markdown twin (/features/index.md), and
// /llms.txt list the same things with the same status. /features/ opens on the page's one
// headline (the link card in src/og.ts restates it) and the catalog under it: tiles grouped by
// area, filtered in place with script, a plain grouped list without. A tile opens the
// capability's own page (FeatureDetail.astro), which can be linked and indexed on its own.
// The landing page's tour shows the main parts up close and ends on "See every feature", here.
// Platforms are /download/'s to explain; how Rotli Helper works is its guide's.
import Base from '../../layouts/Base.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Catalog from '../../components/features/Catalog.astro';
import FeatureDetail from '../../components/features/FeatureDetail.astro';
import { areaOf, visibleFeatures, type Feature } from '../../features';
import { ogImage } from '../../og';
import { DOCS_AND_SHEETS, site } from '../../site';

export function getStaticPaths() {
  if (!site.showsFullSite) return [];
  return [
    { params: { slug: undefined }, props: { feature: undefined } },
    ...visibleFeatures().map((feature) => ({ params: { slug: feature.id }, props: { feature } })),
  ];
}

const { feature } = Astro.props as { feature: Feature | undefined };
---

{
  feature ? (
    <Base
      title={`${feature.name} — rotli features`}
      description={feature.line}
      canonicalPath={`/features/${feature.id}/`}
      noindex={!site.indexable}
      {...ogImage('features')}
    >
      <SiteHeader current="features" />
      <main id="content">
        <FeatureDetail feature={feature} area={areaOf(feature)} />
      </main>
      <SiteFooter />
    </Base>
  ) : (
    <Base
      title="Features — rotli"
      description={`Everything rotli does, in one catalog: the Markdown editor, tasks and links, chat with your notes, the Librarian, Docs and Sheets (${DOCS_AND_SHEETS.inline}), boards, and the privacy rules around them.`}
      canonicalPath="/features/"
      noindex={!site.indexable}
      markdownPath="/features/index.md"
      {...ogImage('features')}
    >
      <SiteHeader current="features" />
      <main id="content">
        <header class="wrap page-head">
          <h1>Everything rotli does, in plain files.</h1>
          <p>
            Every part of rotli, grouped by what it is for. Open one to see what it does, how to use it, and where it
            stops.
          </p>
          <p class="legend">
            <b>Shipped</b> is in the app today. <b>{DOCS_AND_SHEETS.status}</b> is usable and still being finished.{' '}
            <b>Coming soon</b> is in the next release.
            {site.showsExperiments && <> <b>In development</b> runs in development builds only.</>}
          </p>
        </header>
        <Catalog />
      </main>
      <SiteFooter />
    </Base>
  )
}

<style>
  .page-head {
    padding-top: clamp(3rem, 7vw, 5rem);
    padding-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
  }
  h1 {
    max-width: 16ch;
    margin: 0;
    font-size: var(--step-display);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }
  p {
    max-width: 38rem;
    margin: 1.4rem 0 0;
    color: var(--text-muted);
    font-size: var(--step-lede);
    line-height: 1.55;
  }
  .legend {
    margin-top: 0.9rem;
    font-size: 0.95rem;
  }
  .legend b {
    color: var(--text);
    font-weight: 600;
  }
</style>
