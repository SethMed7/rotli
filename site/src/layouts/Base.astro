---
import { jsonLd } from '../agents';
import { PLATFORMS } from '../site';
interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  /** schema.org facts for this page (src/agents.ts), emitted as JSON-LD. */
  structuredData?: Record<string, unknown>[];
  /** The page's Markdown twin, declared for agents (src/agents.ts). */
  markdownPath?: string;
}

const {
  title = 'rotli — write like a person, let AI do the filing',
  description = `A free workspace built on plain Markdown files you own, with no account. Write however you think; the Librarian files, tags, and links your notes in the background. ${PLATFORMS.availability}`,
  canonicalPath = Astro.url.pathname,
  image = '/social-card.png',
  imageAlt = 'rotli — write like a person, let AI do the filing',
  noindex = false,
  structuredData,
  markdownPath,
} = Astro.props as Props;
const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(canonicalPath, siteUrl).href;
const socialImageUrl = new URL(image, siteUrl).href;
---

<html lang="en" data-family="rotli" data-mode="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalUrl} />
    {markdownPath && <link rel="alternate" type="text/markdown" href={markdownPath} />}
    {structuredData && <script type="application/ld+json" is:inline set:html={jsonLd(structuredData)} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rotli" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="theme-color" content="#f8f2e9" />
    <meta name="application-name" content="Rotli" />
    <meta name="apple-mobile-web-app-title" content="Rotli" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <!-- data-os: /download/ leads with the visitor's own system (iPads report a
         Mac user agent, so touch points rule them out). -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var ua = navigator.userAgent;
        var touch = navigator.maxTouchPoints > 1;
        root.classList.add('js');
        var mac = /Macintosh/.test(ua) && !touch;
        root.dataset.os = mac
          ? 'mac'
          : /Windows/.test(ua)
            ? 'windows'
            : /Android|iPhone|iPad|Macintosh/.test(ua)
              ? 'mobile'
              : /Linux|X11|CrOS/.test(ua)
                ? 'linux'
                : 'other';
      })();
    </script>
    <style is:global>
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/GeneralSans-Regular.woff2') format('woff2');
        font-weight: 400;
        font-display: swap;
      }
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/GeneralSans-Medium.woff2') format('woff2');
        font-weight: 500;
        font-display: swap;
      }
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/GeneralSans-Semibold.woff2') format('woff2');
        font-weight: 600;
        font-display: swap;
      }
      @font-face {
        font-family: 'Baloo 2';
        src: url('/fonts/Baloo2-600.ttf') format('truetype');
        font-weight: 600;
        font-display: swap;
      }

      :root {
        --font-body: 'General Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
        --font-wordmark: 'Baloo 2', var(--font-body);
        --page-max: 76rem;
        --copy-max: 68ch;
        --ground: #f8f2e9;
        --surface: #fbf6ee;
        --surface-2: #f1e7d8;
        --tint: #f2d6c2;
        --text: #3a3028;
        --muted-ink: #6e6155;
        --border: #e2d3c1;
        --border-strong: #cdb8a1;
        --accent: #c97e62;
        --accent-ink: #8f4e37;
        --on-accent: #ffffff;
        /* Text on a --text ground (the primary button, the skip link): it switches with the
           inks in the privacy passage, never fading through the button it sits on. */
        --on-text: #f8f2e9;
        /* Muted and accent text read their ink, except in the moment the privacy passage
           crosses over, when they lean onto --text to keep its contrast (src/passage.ts). */
        --text-muted: color-mix(in srgb, var(--text) calc(var(--passage-lean) * 100%), var(--muted-ink));
        --accent-text: color-mix(in srgb, var(--text) calc(var(--passage-lean) * 100%), var(--accent-ink));
        /* GitHub's star gold, for the header's star and count. GitHub's own (Primer's
           base.color.yellow.2: #eac54f by day, #e3b341 by night) is 1.5:1 on this ground, so the
           day value is that gold darkened until its text passes: 5.17:1 on --ground. The night
           value is GitHub's own, 9.31:1 on the night ground. It leans like accent text. */
        --github-star-ink: #8a5d00;
        --github-star: color-mix(in srgb, var(--text) calc(var(--passage-lean) * 100%), var(--github-star-ink));
        --deep: #241d18;
        --deep-surface: #302720;
        --deep-text: #f1e7da;
        --deep-muted: #c6b7a7;
        --deep-border: #4b3c31;
        --selection: #f2d6c2;
        /* The film's island (rotli-studio/motion kit): the shore and its scenery. */
        --sea: #7fcfc6;
        --sea-deep: #3fa3a6;
        --sea-line: #e9fbf6;
        --sand: #f1e3c4;
        --olive: #8d9a76;
        --olive-bright: #a9b78f;
        --limestone: #e6d3ad;
        --lake: #f0a7a0;
        --wood: #b98b62;
        --wood-dark: #8d6547;
        --lantern: #8fb9c9;
        /* The ink of the drawn scenes: the art's own line colour. Scenes use it instead of --text
           so a drawing keeps its lines when the page passes into another environment. */
        --ink: #3a3028;
        /* The app's Cocoa companion body (scripts/build-character-fills.mjs): the footer quokkas. */
        --cocoa: #c6845f;
        /* The app's editor paper in Rotli Light: the ground behind product captures. */
        --capture-ground: #ffffff;
        --swatch-rotli-light: #f8f2e9;
        --swatch-rotli-light-accent: #c97e62;
        --swatch-rotli-dark: #241d18;
        --swatch-rotli-dark-accent: #c97e62;
        --swatch-paper-light: #fafaf9;
        --swatch-paper-light-accent: #161616;
        --swatch-paper-dark: #161616;
        --swatch-paper-dark-accent: #e9e7e2;
        --swatch-ocean-light: #dfebf3;
        --swatch-ocean-light-accent: #2e6e91;
        --swatch-ocean-dark: #0e171d;
        --swatch-ocean-dark-accent: #70b2d7;
        --swatch-grove-light: #e3eee4;
        --swatch-grove-light-accent: #427a55;
        --swatch-grove-dark: #101814;
        --swatch-grove-dark-accent: #82be96;
        --swatch-iris-light: #e9e4f2;
        --swatch-iris-light-accent: #6b58a5;
        --swatch-iris-dark: #15121d;
        --swatch-iris-dark-accent: #ad9ae3;
        --swatch-blossom-light: #f5e4ea;
        --swatch-blossom-light-accent: #a8456d;
        --swatch-blossom-dark: #1d1217;
        --swatch-blossom-dark-accent: #e89ab8;
        --swatch-midnight-light: #f0f2f5;
        --swatch-midnight-light-accent: #364152;
        --swatch-midnight-dark: #050607;
        --swatch-midnight-dark-accent: #cfd5dc;
      }

      :root {
        color-scheme: light;
      }
      /* The privacy passage (src/passage.ts): while the landing's privacy band is the focal
         passage, the whole page, header, menus, and buttons included, steps into the app's
         Ocean Dark environment (src/styles/themes.css; border-strong and selection derived the
         way base.css derives them) and steps back out when the visitor leaves it either way.
         Lowest pair at rest: muted text on the night --surface-2 at 6.75:1 (on the ground
         8.60:1). The --deep-* night of .band-night already matches, so the band and the page
         become one sky. */
      :root[data-passage='ocean-dark'] {
        color-scheme: dark;
        --ground: #0e171d;
        --surface: #152229;
        --surface-2: #1c2d35;
        --tint: #213843;
        --text: #e7f0f4;
        --muted-ink: #a1b6c0;
        --border: #263a43;
        --border-strong: color-mix(in srgb, #e7f0f4 24%, #263a43);
        --accent: #70b2d7;
        --accent-ink: #86c2e0;
        --github-star-ink: #e3b341;
        --on-accent: #0e171d;
        --on-text: #0e171d;
        --selection: #213843;
      }
      /* The crossfade runs on the tokens themselves, registered so they can be animated on the
         root: every surface that reads them (the ground, the header, menus, buttons, borders)
         changes in the same frame, on one clock. The grounds ease over 900 ms; the inks switch
         whole just past halfway, when the ground is mid-tone and both inks read alike (text
         fading through a ground fading the other way vanishes in the middle); muted and accent
         text lean onto --text around the switch. src/passage.ts holds the same numbers and
         scripts/site-interactions.test.ts measures every frame (never under 3:1). */
      @property --ground { syntax: '<color>'; inherits: true; initial-value: #f8f2e9; }
      @property --surface { syntax: '<color>'; inherits: true; initial-value: #fbf6ee; }
      @property --surface-2 { syntax: '<color>'; inherits: true; initial-value: #f1e7d8; }
      @property --tint { syntax: '<color>'; inherits: true; initial-value: #f2d6c2; }
      @property --border { syntax: '<color>'; inherits: true; initial-value: #e2d3c1; }
      @property --border-strong { syntax: '<color>'; inherits: true; initial-value: #cdb8a1; }
      @property --selection { syntax: '<color>'; inherits: true; initial-value: #f2d6c2; }
      @property --text { syntax: '<color>'; inherits: true; initial-value: #3a3028; }
      @property --muted-ink { syntax: '<color>'; inherits: true; initial-value: #6e6155; }
      @property --accent { syntax: '<color>'; inherits: true; initial-value: #c97e62; }
      @property --accent-ink { syntax: '<color>'; inherits: true; initial-value: #8f4e37; }
      @property --github-star-ink { syntax: '<color>'; inherits: true; initial-value: #8a5d00; }
      @property --on-accent { syntax: '<color>'; inherits: true; initial-value: #ffffff; }
      @property --on-text { syntax: '<color>'; inherits: true; initial-value: #f8f2e9; }
      @property --text-muted { syntax: '<color>'; inherits: true; initial-value: #6e6155; }
      @property --accent-text { syntax: '<color>'; inherits: true; initial-value: #8f4e37; }
      @property --github-star { syntax: '<color>'; inherits: true; initial-value: #8a5d00; }
      @property --passage-lean { syntax: '<number>'; inherits: true; initial-value: 0; }
      :root {
        /* Also a plain value, so muted and accent text keep their colours in a browser
           without @property (the lean animation then simply never runs). */
        --passage-lean: 0;
        --passage-ms: 900ms;
        --passage-ease: cubic-bezier(0.65, 0, 0.35, 1);
        --passage-ink-at: 459ms;
      }
      :root.passage-fading {
        transition-property:
          --ground, --surface, --surface-2, --tint, --border, --border-strong, --selection,
          --text, --muted-ink, --accent, --accent-ink, --on-accent, --on-text, --github-star-ink;
        transition-duration:
          var(--passage-ms), var(--passage-ms), var(--passage-ms), var(--passage-ms), var(--passage-ms),
          var(--passage-ms), var(--passage-ms), 0s, 0s, 0s, 0s, 0s, 0s, 0s;
        transition-delay:
          0s, 0s, 0s, 0s, 0s, 0s, 0s, var(--passage-ink-at), var(--passage-ink-at), var(--passage-ink-at),
          var(--passage-ink-at), var(--passage-ink-at), var(--passage-ink-at), var(--passage-ink-at);
        transition-timing-function: var(--passage-ease);
        animation: passage-lean var(--passage-ms) linear;
      }
      @keyframes passage-lean {
        0% { --passage-lean: 0; }
        30% { --passage-lean: 1; }
        70% { --passage-lean: 1; }
        100% { --passage-lean: 0; }
      }
      /* While the tokens move, nothing else chases them on its own clock (a button's 140 ms
         hover fade would smear its switch); reveals keep moving. */
      :root.passage-fading :where(body *) {
        transition-property: opacity, transform, background-size !important;
      }
      /* The night sky spreads past the band: the band's own stars, over the whole page while
         the passage lasts, faded in and out on the same clock (bands with their own ground
         cover it). */
      body::before {
        content: '';
        position: fixed;
        inset: 0;
        z-index: -1;
        background: url('/night-stars-ocean.svg') 0 0 / 480px 480px;
        opacity: 0;
        transition: opacity var(--passage-ms) var(--passage-ease);
        pointer-events: none;
      }
      :root[data-passage='ocean-dark'] body::before {
        opacity: 1;
      }
      /* The band's edges are feathered into the page's padding above and below it, so a day
         page meets its night as dusk, not a cut. In the night the feather is the ground's own
         colour and disappears. It covers only the neighbours' empty section padding. */
      [data-passage] {
        position: relative;
      }
      [data-passage]::before,
      [data-passage]::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        height: calc(var(--section-space) * 0.75);
        pointer-events: none;
      }
      [data-passage]::before {
        bottom: 100%;
        background: linear-gradient(to bottom, transparent, var(--deep));
      }
      [data-passage]::after {
        top: 100%;
        background: linear-gradient(to top, transparent, var(--deep));
      }
      @media (prefers-reduced-motion: reduce) {
        :root.passage-fading {
          transition: none;
          animation: none;
        }
      }
      * {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      body {
        margin: 0;
        min-width: 20rem;
        background: var(--ground);
        color: var(--text);
        font-family: var(--font-body);
        font-size: 17px;
        line-height: 1.62;
      }
      a {
        color: inherit;
      }
      button,
      input,
      select,
      textarea {
        font: inherit;
      }
      button {
        color: inherit;
      }
      img,
      svg {
        display: block;
        max-width: 100%;
      }
      h1,
      h2,
      h3 {
        text-wrap: balance;
      }
      p {
        text-wrap: pretty;
      }
      :where(a, button, summary):focus-visible {
        outline: 2px solid var(--accent-text);
        outline-offset: 3px;
      }
      ::selection {
        background: var(--selection);
        color: var(--text);
      }
      /* Scroll reveal: blocks below the fold rise in as they enter the viewport.
         Only when scripting is on (the `js` class), never under reduced motion. */
      .js [data-reveal] {
        opacity: 0;
        transform: translateY(12px);
        transition: opacity 640ms cubic-bezier(0.2, 0.7, 0.2, 1), transform 640ms cubic-bezier(0.2, 0.7, 0.2, 1);
      }
      .js [data-reveal].is-visible {
        opacity: 1;
        transform: none;
      }
      /* A list with data-stagger reveals its items one after another. */
      .js [data-stagger] > * {
        opacity: 0;
        transform: translateY(14px);
        transition: opacity 560ms cubic-bezier(0.2, 0.7, 0.2, 1), transform 560ms cubic-bezier(0.2, 0.7, 0.2, 1);
      }
      .js [data-stagger].is-visible > * {
        opacity: 1;
        transform: none;
      }
      .js [data-stagger].is-visible > :nth-child(2) { transition-delay: 70ms; }
      .js [data-stagger].is-visible > :nth-child(3) { transition-delay: 140ms; }
      .js [data-stagger].is-visible > :nth-child(4) { transition-delay: 210ms; }
      .js [data-stagger].is-visible > :nth-child(5) { transition-delay: 280ms; }
      .js [data-stagger].is-visible > :nth-child(6) { transition-delay: 350ms; }
      .js [data-stagger].is-visible > :nth-child(n + 7) { transition-delay: 420ms; }
      @media (prefers-reduced-motion: reduce) {
        .js [data-reveal],
        .js [data-stagger] > * {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }
      .skip-link {
        position: fixed;
        top: 0.75rem;
        left: 0.75rem;
        z-index: 100;
        padding: 0.65rem 0.9rem;
        border-radius: 0.5rem;
        background: var(--text);
        color: var(--on-text);
        text-decoration: none;
        transform: translateY(-160%);
      }
      .skip-link:focus {
        transform: translateY(0);
      }

      /* Layout rhythm: one page width, one gutter, one section spacing, one
         type scale. Sections use .wrap and these steps instead of their own. */
      :root {
        --gutter: clamp(1.25rem, 4vw, 2.5rem);
        --section-space: clamp(4.5rem, 9vw, 7.5rem);
        --header-height: 68px;
        --radius-frame: 0.9rem;
        --step-display: clamp(2.9rem, 6.6vw, 5.9rem);
        --step-h2: clamp(2.1rem, 4.2vw, 3.5rem);
        --step-h3: clamp(1.3rem, 1.9vw, 1.55rem);
        --step-lede: clamp(1.1rem, 1.5vw, 1.28rem);
      }
      .wrap {
        width: min(100% - 2 * var(--gutter), var(--page-max));
        margin-inline: auto;
      }
      /* Section grammar shared by the landing chapters: one heading scale, one
         lede measure, one vertical rhythm. A band changes the ground for a
         chapter (flat colour, full bleed); it never adds a card. */
      .section {
        padding-block: var(--section-space);
      }
      .band-warm {
        background: var(--surface-2);
      }
      /* The film's hand-inked clay line under the phrase that matters. It draws in once when
         its block is revealed (or with the hero's entrance); reduced motion shows it drawn. */
      .inked {
        padding-bottom: 0.06em;
        background: url('/ink-underline.svg') no-repeat left 100% / 100% 0.2em;
      }
      .js [data-reveal] .inked {
        background-size: 0% 0.2em;
        transition: background-size 900ms cubic-bezier(0.65, 0, 0.25, 1) 350ms;
      }
      .js [data-reveal].is-visible .inked {
        background-size: 100% 0.2em;
      }
      @media (prefers-reduced-motion: reduce) {
        .js [data-reveal] .inked {
          background-size: 100% 0.2em;
          transition: none;
        }
      }
      .band-deep {
        background: var(--deep);
        color: var(--deep-text);
      }
      /* Night, in the app's Ocean Dark environment (src/styles/themes.css): add it beside
         .band-deep and the --deep-* tokens, and the colours the night scene borrows
         (SecureScene.astro) take Ocean's values. Stars and the underline get blue twins. */
      .band-night {
        --deep: #0e171d;
        --deep-surface: #152229;
        --deep-text: #e7f0f4;
        --deep-muted: #a1b6c0;
        --deep-border: #263a43;
        --tint: #213843;
        --accent: #70b2d7;
        --accent-text: #86c2e0;
        --olive: #8cc4a5;
        --olive-bright: #8cc4a5;
        --text: #0e171d;
        background-image: url('/night-stars-ocean.svg');
        background-size: 480px 480px;
      }
      .band-night .inked {
        background-image: url('/ink-underline-ocean.svg');
      }
      .section-title {
        margin: 0;
        font-size: var(--step-h2);
        font-weight: 600;
        line-height: 1.04;
        letter-spacing: -0.035em;
      }
      .section-lede {
        max-width: 38rem;
        margin: 1.1rem 0 0;
        color: var(--text-muted);
        font-size: var(--step-lede);
        line-height: 1.55;
      }
      .band-deep .section-lede {
        color: var(--deep-muted);
      }
      .section-head {
        margin-bottom: clamp(2.5rem, 5vw, 4rem);
      }
      /* In-page anchors land below the pinned header. */
      [id] {
        scroll-margin-top: calc(var(--header-height) + 1.5rem);
      }

      /* Site chrome: one header, one footer, one button grammar. Markup lives in
         src/components/SiteHeader.astro and SiteFooter.astro. */
      .site-header-bar {
        position: sticky;
        top: 0;
        z-index: 30;
        background: var(--ground);
        border-bottom: 1px solid var(--border);
      }
      .site-header,
      .site-footer {
        width: min(100% - 2 * var(--gutter), var(--page-max));
        margin-inline: auto;
      }
      .site-header {
        min-height: var(--header-height);
        display: flex;
        align-items: center;
        gap: 2rem;
      }
      .brand,
      .footer-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        min-height: 44px;
        color: var(--text);
        text-decoration: none;
      }
      .brand-mark {
        width: 28px;
        line-height: 0;
      }
      .wordmark,
      .footer-brand b {
        font-family: var(--font-wordmark);
        font-size: 1.5rem;
        font-weight: 600;
        letter-spacing: -0.015em;
      }
      .primary-nav {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: clamp(1rem, 2.2vw, 2rem);
        margin-inline: auto;
      }
      .primary-nav > a,
      .nav-dropdown-fallback,
      .nav-dropdown-toggle {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        color: var(--text-muted);
        font-size: 0.92rem;
        text-decoration: none;
      }
      .primary-nav > a:hover,
      .primary-nav > a[aria-current='page'],
      .nav-dropdown-fallback:hover,
      .nav-dropdown-toggle:hover,
      .nav-dropdown-toggle[aria-expanded='true'],
      .nav-dropdown.is-current > * {
        color: var(--text);
      }
      .primary-nav > a[aria-current='page'],
      .nav-dropdown.is-current > .nav-dropdown-fallback,
      .nav-dropdown.is-current > .nav-dropdown-toggle {
        text-decoration: underline;
        text-decoration-color: var(--accent-text);
        text-decoration-thickness: 2px;
        text-underline-offset: 0.5rem;
      }
      /* Resources: a disclosure (SiteHeader.astro). The fallback link shows
         without script; with it (the `js` class) the button takes its place. */
      .nav-dropdown {
        position: relative;
      }
      .nav-dropdown-toggle {
        display: none;
        gap: 0.3rem;
        padding: 0;
        border: 0;
        background: none;
        cursor: pointer;
      }
      .js .nav-dropdown-fallback {
        display: none;
      }
      .js .nav-dropdown-toggle {
        display: inline-flex;
      }
      .nav-dropdown-toggle svg {
        width: 0.75rem;
        height: 0.75rem;
        transition: transform 140ms ease-out;
      }
      .nav-dropdown-toggle[aria-expanded='true'] svg {
        transform: rotate(180deg);
      }
      .nav-dropdown-panel {
        position: absolute;
        top: calc(100% + 1rem);
        left: 50%;
        z-index: 40;
        width: 19rem;
        padding: 0.45rem;
        border: 1px solid var(--border-strong);
        border-radius: 0.8rem;
        background: var(--surface);
        transform: translateX(-50%);
      }
      .nav-dropdown-panel[hidden] {
        display: none;
      }
      .nav-dropdown-panel ul {
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .nav-dropdown-panel a {
        display: grid;
        gap: 0.1rem;
        min-height: 44px;
        padding: 0.6rem 0.75rem;
        border-radius: 0.5rem;
        color: var(--text);
        text-decoration: none;
      }
      .nav-dropdown-panel a:hover,
      .nav-dropdown-panel a:focus-visible {
        background: var(--surface-2);
      }
      .nav-dropdown-panel a:focus-visible {
        outline-offset: -2px;
      }
      .nav-dropdown-panel a[aria-current='page'] {
        background: var(--tint);
      }
      .nav-dropdown-panel b {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        font-size: 0.94rem;
        font-weight: 600;
      }
      .nav-dropdown-panel span {
        color: var(--text-muted);
        font-size: 0.84rem;
        line-height: 1.4;
      }
      /* A status beside a page's name, in the dropdown and the Menu. Text, not a chip. */
      .nav-dropdown-panel small,
      .nav-menu-group small {
        color: var(--text-muted);
        font-size: 0.78rem;
        font-weight: 500;
      }
      .header-actions {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        margin-left: auto;
      }
      .primary-nav + .header-actions {
        margin-left: 0;
      }
      /* GitHub with its star count (SiteHeader.astro): a plain link, no border or fill. The
         mark in ink, the star and the count in GitHub's star gold, at the header button's
         height so the hit area is generous; hover underlines the count. */
      .github-link {
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0 0.25rem;
        border-radius: 0.5rem;
        color: var(--text);
        font-size: 0.9rem;
        font-weight: 600;
        line-height: 1;
        text-decoration: none;
        white-space: nowrap;
      }
      .github-mark {
        flex: none;
        width: 20px;
        height: 20px;
      }
      .github-stars {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        color: var(--github-star);
      }
      .github-star {
        flex: none;
        width: 15px;
        height: 15px;
      }
      .github-count {
        font-variant-numeric: tabular-nums;
        text-decoration: underline transparent 1.5px;
        text-underline-offset: 0.25em;
        transition: text-decoration-color 140ms ease-out;
      }
      .github-link:hover .github-count {
        text-decoration-color: currentColor;
      }
      .header-actions > .github-link {
        margin-right: 0.45rem;
      }
      .nav-menu-panel > .menu-github small {
        color: var(--text-muted);
        font-size: 0.78rem;
        font-weight: 500;
      }
      .button {
        min-height: 50px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.72rem 1.3rem;
        border-radius: 0.7rem;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        transition: transform 120ms ease-out, background-color 140ms ease-out, border-color 140ms ease-out;
      }
      .button:active {
        transform: translateY(1px);
      }
      .button.primary {
        background: var(--text);
        color: var(--on-text);
        border: 1px solid var(--text);
      }
      .button.primary:hover {
        background: var(--accent-text);
        border-color: var(--accent-text);
        color: var(--on-accent);
      }
      .button.secondary {
        background: transparent;
        color: var(--text);
        border: 1px solid var(--border-strong);
      }
      .button.secondary:hover {
        background: var(--surface-2);
      }
      .button.pending,
      .button.pending:hover,
      .button.pending:active {
        transform: none;
        cursor: default;
        opacity: 0.82;
      }
      /* The way in (SiteActions.astro): one primary button, or the pending label. */
      .site-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
      }
      .site-header .button {
        min-height: 40px;
        padding: 0.45rem 0.95rem;
        border-radius: 0.6rem;
        font-size: 0.88rem;
      }

      /* Below 1080px the sections fold into Menu; below 560px the actions do too. */
      .nav-menu {
        display: none;
        position: relative;
      }
      .nav-menu summary {
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        padding: 0.45rem 0.9rem;
        border: 1px solid var(--border-strong);
        border-radius: 0.6rem;
        color: var(--text);
        font-size: 0.88rem;
        font-weight: 600;
        cursor: pointer;
        list-style: none;
      }
      .nav-menu summary::-webkit-details-marker {
        display: none;
      }
      .nav-menu[open] summary,
      .nav-menu summary:hover {
        background: var(--surface-2);
      }
      .nav-menu-panel {
        position: absolute;
        top: calc(100% + 0.5rem);
        right: 0;
        min-width: 15rem;
        max-height: calc(100dvh - var(--header-height) - 1rem);
        overflow-y: auto;
        display: grid;
        gap: 0.15rem;
        padding: 0.5rem;
        border: 1px solid var(--border-strong);
        border-radius: 0.8rem;
        background: var(--surface);
      }
      .nav-menu-panel > a,
      .nav-menu-group > a {
        min-height: 44px;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding-inline: 0.75rem;
        border-radius: 0.5rem;
        color: var(--text);
        text-decoration: none;
      }
      .nav-menu-panel > a:hover,
      .nav-menu-group > a:hover {
        background: var(--surface-2);
      }
      .nav-menu-panel > a[aria-current='page'],
      .nav-menu-group > a[aria-current='page'] {
        background: var(--tint);
      }
      /* The dropdown's pages, listed under its name and set in from the rail. */
      .nav-menu-group {
        display: grid;
        gap: 0.15rem;
        margin: 0.2rem 0;
        padding: 0.35rem 0;
        border-block: 1px solid var(--border);
      }
      .nav-menu-label {
        margin: 0;
        padding: 0.2rem 0.75rem 0.1rem;
        color: var(--text-muted);
        font-size: 0.82rem;
        font-weight: 600;
      }
      .nav-menu-group > a {
        padding-left: 1.4rem;
      }
      .nav-menu-panel > .button,
      .nav-menu-panel > .menu-github {
        display: none;
      }
      .nav-menu-panel > .button {
        margin-top: 0.4rem;
      }

      .site-footer {
        padding-block: clamp(3rem, 6vw, 4.5rem) 2rem;
        border-top: 1px solid var(--border);
        color: var(--text-muted);
        font-size: 0.92rem;
      }
      .footer-top {
        display: grid;
        grid-template-columns: minmax(14rem, 1fr) minmax(0, 1.6fr);
        gap: 2.5rem clamp(2rem, 6vw, 5rem);
      }
      .footer-lead p {
        max-width: 22rem;
        margin: 0.6rem 0 0;
        line-height: 1.55;
      }
      .footer-brand span {
        width: 24px;
        line-height: 0;
      }
      .footer-brand b {
        font-size: 1.3rem;
      }
      .footer-groups {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
        gap: 2rem;
      }
      .footer-group h2 {
        margin: 0 0 0.4rem;
        color: var(--text);
        font-size: 0.92rem;
        font-weight: 600;
        letter-spacing: 0;
      }
      .footer-group ul {
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .footer-group a {
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        text-decoration: none;
      }
      .footer-group a:hover {
        color: var(--text);
        text-decoration: underline;
        text-underline-offset: 0.25em;
      }
      .footer-bottom {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem 2rem;
        margin-top: clamp(2.5rem, 5vw, 3.5rem);
        padding-top: 1.5rem;
        border-top: 1px solid var(--border);
        font-size: 0.86rem;
      }
      .footer-bottom p {
        margin: 0;
      }
      .footer-maker {
        display: inline-flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.25rem;
      }
      /* The maker's X mark: a drawn X (not the platform's artwork) in a 44px target. */
      .footer-x {
        display: inline-grid;
        place-items: center;
        width: 44px;
        height: 44px;
        margin-block: -12px;
        border-radius: 0.5rem;
        color: var(--text-muted);
      }
      .footer-x:hover {
        color: var(--text);
        background: var(--surface-2);
      }
      .footer-x svg {
        width: 16px;
        height: 16px;
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
      }
      .footer-badges {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;
      }
      .footer-badge {
        display: block;
        flex: none;
        line-height: 0;
      }
      .footer-badge img {
        width: auto;
        height: 44px;
      }
      /* The "coming soon" list's sign-up, under the tagline: one field and one button. */
      .subscribe {
        max-width: 26rem;
        margin-top: 1.75rem;
      }
      .subscribe h2 {
        margin: 0;
        color: var(--text);
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: 0;
      }
      .footer-lead .subscribe-note {
        margin: 0.2rem 0 0.75rem;
      }
      .subscribe-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      .subscribe input[type='email'] {
        flex: 1 1 12rem;
        min-width: 0;
        min-height: 44px;
        padding: 0.55rem 0.8rem;
        border: 1px solid var(--border-strong);
        border-radius: 0.6rem;
        background: var(--surface);
        color: var(--text);
        font-size: 1rem;
      }
      .subscribe input[type='email']::placeholder {
        color: var(--text-muted);
        opacity: 1;
      }
      .subscribe input[type='email']:focus-visible {
        outline: 2px solid var(--accent-text);
        outline-offset: 1px;
      }
      .subscribe input[aria-invalid='true'] {
        border-color: var(--accent-text);
      }
      .subscribe .button {
        flex: none;
        min-height: 44px;
        padding: 0.45rem 1rem;
        border-radius: 0.6rem;
        font-size: 0.92rem;
      }
      .subscribe .button:disabled {
        cursor: progress;
        opacity: 0.82;
      }
      .footer-lead .subscribe-status {
        margin: 0.5rem 0 0;
        color: var(--text);
      }
      .footer-lead .subscribe-status:empty {
        display: none;
      }
      .subscribe[data-state='closed'] .subscribe-status {
        color: var(--text);
        font-weight: 500;
      }
      .subscribe[data-state='error'] .subscribe-status {
        color: var(--accent-text);
        font-weight: 500;
      }
      .subscribe[data-state='done'] .subscribe-row {
        display: none;
      }
      /* Only bots fill this in (site/server/subscribe.ts); people never see it. */
      .subscribe-trap {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
      @media (max-width: 1080px) {
        .primary-nav {
          display: none;
        }
        .nav-menu {
          display: block;
        }
        .site-header .header-actions {
          margin-left: auto;
        }
      }

      @media (max-width: 760px) {
        .footer-top {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 560px) {
        .site-header {
          gap: 0.75rem;
        }
        .header-actions > .header-download,
        .header-actions > .github-link {
          display: none;
        }
        .nav-menu-panel > .button,
        .nav-menu-panel > .menu-github {
          display: flex;
        }
        .footer-groups {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <slot />
    <script>
      import { watchPassages } from '../passage';
      watchPassages();
      // Scroll reveal (the [data-reveal] and [data-stagger] styles above): a
      // block rises in once as it enters the viewport, then rests; a staggered
      // list brings its items in one after another. Section heads below the
      // fold reveal too; one already on screen (a reload mid-page) is left
      // alone, or it would fade out and back in. Without script, or under
      // reduced motion, everything is simply visible.
      document
        .querySelectorAll<HTMLElement>('main .section-head:not([data-reveal])')
        .forEach((head) => {
          if (head.getBoundingClientRect().top > window.innerHeight) head.setAttribute('data-reveal', '');
        });
      const blocks = document.querySelectorAll<HTMLElement>('[data-reveal], [data-stagger]');
      if (blocks.length > 0 && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        blocks.forEach((block) => observer.observe(block));
      } else {
        blocks.forEach((block) => block.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
