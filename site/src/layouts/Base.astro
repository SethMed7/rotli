---
interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = 'Rotli — room to think, files you keep',
  description = 'A calm, local-first Mac workspace for notes, tasks, links, and optional AI conversations. One folder you own, with no account required.',
  canonicalPath = Astro.url.pathname,
  image = '/social-card.png',
  noindex = false,
} = Astro.props as Props;
const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(canonicalPath, siteUrl).href;
const socialImageUrl = new URL(image, siteUrl).href;
---

<html lang="en" data-family="rotli" data-mode="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rotli" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="Rotli — room to think, files you keep" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/GeneralSans-Regular.woff2') format('woff2');
        font-weight: 400;
        font-display: swap;
      }
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/GeneralSans-Medium.woff2') format('woff2');
        font-weight: 500;
        font-display: swap;
      }
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/GeneralSans-Semibold.woff2') format('woff2');
        font-weight: 600;
        font-display: swap;
      }
      @font-face {
        font-family: 'Baloo 2';
        src: url('/fonts/Baloo2-600.ttf') format('truetype');
        font-weight: 600;
        font-display: swap;
      }

      :root {
        --font-body: 'General Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
        --font-wordmark: 'Baloo 2', var(--font-body);
        --page-max: 76rem;
        --copy-max: 68ch;
        --ground: #f8f2e9;
        --surface: #ffffff;
        --surface-2: #f1e7d8;
        --tint: #f2d6c2;
        --text: #3a3028;
        --text-muted: #6e6155;
        --border: #e2d3c1;
        --border-strong: #cdb8a1;
        --accent: #c97e62;
        --accent-text: #8f4e37;
        --on-accent: #ffffff;
        --deep: #241d18;
        --deep-surface: #302720;
        --deep-text: #f1e7da;
        --deep-muted: #c6b7a7;
        --deep-border: #4b3c31;
        --success: #5f6b49;
        --selection: #f2d6c2;
        --quokka-field: #f3e8da;
        --swatch-rotli-light: #f8f2e9;
        --swatch-rotli-dark: #241d18;
        --swatch-paper-light: #fafaf9;
        --swatch-paper-dark: #161616;
        --swatch-ocean-light: #dfebf3;
        --swatch-ocean-dark: #0e171d;
        --swatch-grove-light: #e3eee4;
        --swatch-grove-dark: #101814;
        --swatch-iris-light: #e9e4f2;
        --swatch-iris-dark: #15121d;
        --swatch-midnight-light: #f0f2f5;
        --swatch-midnight-dark: #050607;
        --hero-ground: #fafaf9;
        --hero-text: #161616;
        --hero-accent: #62625f;
        --hero-action: #161616;
        --hero-action-text: #ffffff;
        --hero-shot: #ffffff;
        --hero-hover-wash: #f2f2f0;
        --hero-copy: #62625f;
        --hero-muted: #62625f;
        --hero-caption: #62625f;
        --hero-border: #ddddda;
        --hero-shot-border: #ddddda;
      }

      :root {
        color-scheme: light;
      }
      * {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      body {
        margin: 0;
        min-width: 20rem;
        background: var(--ground);
        color: var(--text);
        font-family: var(--font-body);
        font-size: 17px;
        line-height: 1.62;
        transition: background-color 180ms ease-out, color 180ms ease-out;
      }
      a {
        color: inherit;
      }
      button,
      input,
      select,
      textarea {
        font: inherit;
      }
      button {
        color: inherit;
      }
      img,
      svg {
        display: block;
        max-width: 100%;
      }
      h1,
      h2,
      h3 {
        text-wrap: balance;
      }
      p {
        text-wrap: pretty;
      }
      :where(a, button):focus-visible {
        outline: 2px solid var(--accent-text);
        outline-offset: 3px;
      }
      ::selection {
        background: var(--selection);
        color: var(--text);
      }
      .skip-link {
        position: fixed;
        top: 0.75rem;
        left: 0.75rem;
        z-index: 100;
        padding: 0.65rem 0.9rem;
        border-radius: 0.5rem;
        background: var(--text);
        color: var(--ground);
        text-decoration: none;
        transform: translateY(-160%);
      }
      .skip-link:focus {
        transform: translateY(0);
      }

      /* Site chrome: one header, one footer, one button grammar. Markup lives in
         src/components/SiteHeader.astro and SiteFooter.astro. */
      .site-header,
      .site-footer {
        width: min(100% - 3rem, var(--page-max));
        margin-inline: auto;
      }
      .site-header {
        min-height: 76px;
        display: flex;
        align-items: center;
        gap: 2rem;
        position: relative;
        z-index: 20;
        border-bottom: 1px solid var(--border);
      }
      .brand,
      .footer-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        color: var(--text);
        text-decoration: none;
      }
      .brand-mark {
        width: 30px;
        line-height: 0;
      }
      .wordmark,
      .footer-brand b {
        font-family: var(--font-wordmark);
        font-size: 1.55rem;
        font-weight: 600;
        letter-spacing: -0.015em;
      }
      .primary-nav {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: clamp(1.1rem, 2.5vw, 2.2rem);
        margin-inline: auto;
      }
      .primary-nav a,
      .github-link {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        color: var(--text-muted);
        font-size: 0.9rem;
        text-decoration: none;
      }
      .primary-nav a:hover,
      .primary-nav a[aria-current='page'],
      .github-link:hover {
        color: var(--text);
      }
      .primary-nav a[aria-current='page'] {
        text-decoration: underline;
        text-decoration-color: var(--accent);
        text-underline-offset: 0.45rem;
      }
      .header-actions {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        margin-left: auto;
      }
      .primary-nav + .header-actions {
        margin-left: 0;
      }
      .github-link {
        gap: 0.45rem;
        padding-inline: 0.35rem;
      }
      .github-link svg {
        width: 18px;
        height: 18px;
      }
      .button {
        min-height: 50px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.72rem 1.25rem;
        border-radius: 0.7rem;
        font-weight: 600;
        text-decoration: none;
        transition: transform 120ms ease-out, background-color 140ms ease-out, border-color 140ms ease-out;
      }
      .button:active {
        transform: translateY(1px);
      }
      .button.primary {
        background: var(--text);
        color: var(--ground);
        border: 1px solid var(--text);
      }
      .button.primary:hover {
        background: var(--accent-text);
        border-color: var(--accent-text);
        color: var(--on-accent);
      }
      .button.secondary {
        background: transparent;
        color: var(--text);
        border: 1px solid var(--border-strong);
      }
      .button.secondary:hover {
        background: var(--surface);
      }
      .button.pending,
      .button.pending:hover,
      .button.pending:active {
        transform: none;
        cursor: default;
        opacity: 0.82;
      }
      .site-footer {
        min-height: 8rem;
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 2rem;
        align-items: center;
        border-top: 1px solid var(--border);
        color: var(--text-muted);
        font-size: 0.86rem;
      }
      .footer-brand span {
        width: 23px;
        line-height: 0;
      }
      .footer-brand b {
        font-size: 1.25rem;
        color: var(--text);
      }
      .site-footer p {
        margin: 0;
      }
      .site-footer nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0 1.25rem;
      }
      .site-footer nav a {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        text-decoration: none;
      }
      .site-footer nav a:hover {
        color: var(--text);
      }
      @media (max-width: 1080px) {
        .primary-nav {
          display: none;
        }
      }

      @media (max-width: 760px) {
        .site-footer {
          grid-template-columns: 1fr;
          gap: 0.5rem;
          padding-block: 2rem;
        }
      }

      @media (max-width: 560px) {
        .site-header,
        .site-footer {
          width: min(100% - 1.5rem, var(--page-max));
        }
        .site-header {
          gap: 0.75rem;
        }
        .github-link {
          min-width: 44px;
          justify-content: center;
          padding-inline: 0;
        }
        .github-link span {
          position: absolute;
          width: 1px;
          height: 1px;
          padding: 0;
          margin: -1px;
          overflow: hidden;
          clip: rect(0, 0, 0, 0);
          white-space: nowrap;
          border: 0;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <slot />
  </body>
</html>
