---
interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const {
  title = 'Rotli — room to think, files you keep',
  description = 'A calm, local-first Mac workspace for notes, tasks, links, and optional AI conversations. One folder you own, with no account required.',
  canonicalPath = Astro.url.pathname,
  image = '/social-card.png',
  imageAlt = 'Rotli — room to think, files you keep',
  noindex = false,
} = Astro.props as Props;
const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(canonicalPath, siteUrl).href;
const socialImageUrl = new URL(image, siteUrl).href;
---

<html lang="en" data-family="rotli" data-mode="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rotli" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="theme-color" content="#f8f2e9" />
    <meta name="application-name" content="Rotli" />
    <meta name="apple-mobile-web-app-title" content="Rotli" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <!-- data-platform: SiteActions leads with the browser on anything but a Mac
         (iPads report a Mac user agent, so touch points rule them out). -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var mac = /Macintosh/.test(navigator.userAgent) && !(navigator.maxTouchPoints > 1);
        root.dataset.platform = mac ? 'mac' : 'other';
      })();
    </script>
    <style is:global>
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/GeneralSans-Regular.woff2') format('woff2');
        font-weight: 400;
        font-display: swap;
      }
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/GeneralSans-Medium.woff2') format('woff2');
        font-weight: 500;
        font-display: swap;
      }
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/GeneralSans-Semibold.woff2') format('woff2');
        font-weight: 600;
        font-display: swap;
      }
      @font-face {
        font-family: 'Baloo 2';
        src: url('/fonts/Baloo2-600.ttf') format('truetype');
        font-weight: 600;
        font-display: swap;
      }

      :root {
        --font-body: 'General Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
        --font-wordmark: 'Baloo 2', var(--font-body);
        --page-max: 76rem;
        --copy-max: 68ch;
        --ground: #f8f2e9;
        --surface: #fbf6ee;
        --surface-2: #f1e7d8;
        --tint: #f2d6c2;
        --text: #3a3028;
        --text-muted: #6e6155;
        --border: #e2d3c1;
        --border-strong: #cdb8a1;
        --accent: #c97e62;
        --accent-text: #8f4e37;
        --on-accent: #ffffff;
        --deep: #241d18;
        --deep-surface: #302720;
        --deep-text: #f1e7da;
        --deep-muted: #c6b7a7;
        --deep-border: #4b3c31;
        --success: #5f6b49;
        --selection: #f2d6c2;
        --quokka-field: #f3e8da;
        --swatch-rotli-light: #f8f2e9;
        --swatch-rotli-light-accent: #c97e62;
        --swatch-rotli-dark: #241d18;
        --swatch-rotli-dark-accent: #c97e62;
        --swatch-paper-light: #fafaf9;
        --swatch-paper-light-accent: #161616;
        --swatch-paper-dark: #161616;
        --swatch-paper-dark-accent: #e9e7e2;
        --swatch-ocean-light: #dfebf3;
        --swatch-ocean-light-accent: #2e6e91;
        --swatch-ocean-dark: #0e171d;
        --swatch-ocean-dark-accent: #70b2d7;
        --swatch-grove-light: #e3eee4;
        --swatch-grove-light-accent: #427a55;
        --swatch-grove-dark: #101814;
        --swatch-grove-dark-accent: #82be96;
        --swatch-iris-light: #e9e4f2;
        --swatch-iris-light-accent: #6b58a5;
        --swatch-iris-dark: #15121d;
        --swatch-iris-dark-accent: #ad9ae3;
        --swatch-midnight-light: #f0f2f5;
        --swatch-midnight-light-accent: #364152;
        --swatch-midnight-dark: #050607;
        --swatch-midnight-dark-accent: #cfd5dc;
        /* The hero shares the Rotli Warm Light palette; one ground, no white band. */
        --hero-ground: var(--ground);
        --hero-text: var(--text);
        --hero-accent: var(--accent-text);
        --hero-action: var(--accent-text);
        --hero-action-text: var(--on-accent);
        --hero-shot: var(--surface-2);
        --hero-hover-wash: var(--surface-2);
        --hero-copy: var(--text-muted);
        --hero-muted: var(--text-muted);
        --hero-caption: var(--text-muted);
        --hero-border: var(--border-strong);
        --hero-shot-border: var(--border);
      }

      :root {
        color-scheme: light;
      }
      * {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      body {
        margin: 0;
        min-width: 20rem;
        background: var(--ground);
        color: var(--text);
        font-family: var(--font-body);
        font-size: 17px;
        line-height: 1.62;
        transition: background-color 180ms ease-out, color 180ms ease-out;
      }
      a {
        color: inherit;
      }
      button,
      input,
      select,
      textarea {
        font: inherit;
      }
      button {
        color: inherit;
      }
      img,
      svg {
        display: block;
        max-width: 100%;
      }
      h1,
      h2,
      h3 {
        text-wrap: balance;
      }
      p {
        text-wrap: pretty;
      }
      :where(a, button):focus-visible {
        outline: 2px solid var(--accent-text);
        outline-offset: 3px;
      }
      ::selection {
        background: var(--selection);
        color: var(--text);
      }
      /* Scroll reveal: blocks below the fold rise in as they enter the viewport.
         Only when scripting is on (the `js` class), never under reduced motion. */
      .js [data-reveal] {
        opacity: 0;
        transform: translateY(18px);
        transition: opacity 640ms cubic-bezier(0.2, 0.7, 0.2, 1), transform 640ms cubic-bezier(0.2, 0.7, 0.2, 1);
      }
      .js [data-reveal].is-visible {
        opacity: 1;
        transform: none;
      }
      @media (prefers-reduced-motion: reduce) {
        .js [data-reveal] {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }
      .skip-link {
        position: fixed;
        top: 0.75rem;
        left: 0.75rem;
        z-index: 100;
        padding: 0.65rem 0.9rem;
        border-radius: 0.5rem;
        background: var(--text);
        color: var(--ground);
        text-decoration: none;
        transform: translateY(-160%);
      }
      .skip-link:focus {
        transform: translateY(0);
      }

      /* Site chrome: one header, one footer, one button grammar. Markup lives in
         src/components/SiteHeader.astro and SiteFooter.astro. */
      .site-header,
      .site-footer {
        width: min(100% - 3rem, var(--page-max));
        margin-inline: auto;
      }
      .site-header {
        min-height: 76px;
        display: flex;
        align-items: center;
        gap: 2rem;
        position: relative;
        z-index: 20;
        border-bottom: 1px solid var(--border);
      }
      .brand,
      .footer-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        color: var(--text);
        text-decoration: none;
      }
      .brand-mark {
        width: 30px;
        line-height: 0;
      }
      .wordmark,
      .footer-brand b {
        font-family: var(--font-wordmark);
        font-size: 1.55rem;
        font-weight: 600;
        letter-spacing: -0.015em;
      }
      .primary-nav {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: clamp(1.1rem, 2.5vw, 2.2rem);
        margin-inline: auto;
      }
      .primary-nav a,
      .github-link {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        color: var(--text-muted);
        font-size: 0.9rem;
        text-decoration: none;
      }
      .primary-nav a:hover,
      .primary-nav a[aria-current='page'],
      .github-link:hover {
        color: var(--text);
      }
      .primary-nav a[aria-current='page'] {
        text-decoration: underline;
        text-decoration-color: var(--accent);
        text-underline-offset: 0.45rem;
      }
      .header-actions {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        margin-left: auto;
      }
      .primary-nav + .header-actions {
        margin-left: 0;
      }
      .github-link {
        gap: 0.45rem;
        padding-inline: 0.35rem;
      }
      .github-link svg {
        width: 18px;
        height: 18px;
      }
      .button {
        min-height: 50px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.72rem 1.25rem;
        border-radius: 0.7rem;
        font-weight: 600;
        text-decoration: none;
        transition: transform 120ms ease-out, background-color 140ms ease-out, border-color 140ms ease-out;
      }
      .button:active {
        transform: translateY(1px);
      }
      .button.primary {
        background: var(--text);
        color: var(--ground);
        border: 1px solid var(--text);
      }
      .button.primary:hover {
        background: var(--accent-text);
        border-color: var(--accent-text);
        color: var(--on-accent);
      }
      .button.secondary {
        background: transparent;
        color: var(--text);
        border: 1px solid var(--border-strong);
      }
      .button.secondary:hover {
        background: var(--surface);
      }
      .button.pending,
      .button.pending:hover,
      .button.pending:active {
        transform: none;
        cursor: default;
        opacity: 0.82;
      }
      /* The two ways in (SiteActions.astro). Off a Mac the browser leads and the
         download names the Mac; without script the Mac order stays. */
      .site-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
      }
      .action-download .for-other,
      :root[data-platform='other'] .action-download .for-mac {
        display: none;
      }
      :root[data-platform='other'] .action-download .for-other {
        display: inline;
      }
      :root[data-platform='other'] .action-web {
        order: -1;
        background: var(--text);
        color: var(--ground);
        border-color: var(--text);
      }
      :root[data-platform='other'] .action-web:hover {
        background: var(--accent-text);
        border-color: var(--accent-text);
        color: var(--on-accent);
      }
      :root[data-platform='other'] .action-download {
        background: transparent;
        color: var(--text);
        border-color: var(--border-strong);
      }
      :root[data-platform='other'] .action-download:hover {
        background: var(--surface);
      }
      .site-header .site-actions {
        gap: 0.5rem;
        flex-wrap: nowrap;
      }
      .site-header .button {
        min-height: 40px;
        padding: 0.45rem 0.95rem;
        border-radius: 0.6rem;
        font-size: 0.88rem;
        white-space: nowrap;
      }

      /* Below 1080px the sections fold into Menu; below 560px the actions do too. */
      .nav-menu {
        display: none;
        position: relative;
      }
      .nav-menu summary {
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        padding: 0.45rem 0.9rem;
        border: 1px solid var(--border-strong);
        border-radius: 0.6rem;
        color: var(--text);
        font-size: 0.88rem;
        font-weight: 600;
        cursor: pointer;
        list-style: none;
      }
      .nav-menu summary::-webkit-details-marker {
        display: none;
      }
      .nav-menu[open] summary,
      .nav-menu summary:hover {
        background: var(--surface);
      }
      .nav-menu-panel {
        position: absolute;
        top: calc(100% + 0.5rem);
        right: 0;
        min-width: 15rem;
        display: grid;
        gap: 0.15rem;
        padding: 0.5rem;
        border: 1px solid var(--border);
        border-radius: 0.8rem;
        background: var(--ground);
        box-shadow: 0 18px 40px -18px rgb(58 48 40 / 0.35);
      }
      .nav-menu-panel > a {
        min-height: 44px;
        display: flex;
        align-items: center;
        padding-inline: 0.75rem;
        border-radius: 0.5rem;
        color: var(--text);
        text-decoration: none;
      }
      .nav-menu-panel > a:hover {
        background: var(--surface);
      }
      .nav-menu-panel > a[aria-current='page'] {
        background: var(--surface-2);
      }
      .nav-menu-panel .site-actions {
        display: none;
        margin-top: 0.4rem;
        padding-top: 0.6rem;
        border-top: 1px solid var(--border);
        flex-direction: column;
      }

      .site-footer {
        min-height: 8rem;
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 2rem;
        align-items: center;
        border-top: 1px solid var(--border);
        color: var(--text-muted);
        font-size: 0.86rem;
      }
      .footer-brand span {
        width: 23px;
        line-height: 0;
      }
      .footer-brand b {
        font-size: 1.25rem;
        color: var(--text);
      }
      .site-footer p {
        margin: 0;
      }
      .footer-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem 1.25rem;
      }
      .site-footer nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0 1.25rem;
      }
      .site-footer nav a {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        text-decoration: none;
      }
      .site-footer nav a:hover {
        color: var(--text);
      }
      .launch-llama-badge {
        display: block;
        flex: none;
        line-height: 0;
      }
      @media (max-width: 1080px) {
        .primary-nav {
          display: none;
        }
        .nav-menu {
          display: block;
        }
        .site-header .header-actions {
          margin-left: auto;
        }
      }

      @media (max-width: 760px) {
        .site-footer {
          grid-template-columns: 1fr;
          gap: 0.5rem;
          padding-block: 2rem;
        }
        .footer-actions {
          align-items: flex-start;
          flex-direction: column;
        }
      }

      @media (max-width: 560px) {
        .site-header,
        .site-footer {
          width: min(100% - 1.5rem, var(--page-max));
        }
        .site-header {
          gap: 0.75rem;
        }
        .header-actions > .site-actions,
        .header-actions > .github-link {
          display: none;
        }
        .nav-menu-panel .site-actions {
          display: flex;
        }
        .github-link {
          min-width: 44px;
          justify-content: center;
          padding-inline: 0;
        }
        .github-link span {
          position: absolute;
          width: 1px;
          height: 1px;
          padding: 0;
          margin: -1px;
          overflow: hidden;
          clip: rect(0, 0, 0, 0);
          white-space: nowrap;
          border: 0;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <slot />
  </body>
</html>
