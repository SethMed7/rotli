---
// Base layout — mono brand tokens (Paper light / Charcoal dark), fonts, and a
// manual light/dark toggle (persisted in localStorage, applied pre-paint so
// there's no flash). Palette mirrors src/styles/themes.css paper + charcoal.
const {
  title = 'rotli — a local-first notes app for your Mac menu bar',
  description = 'A local-first notes app that lives in your Mac’s menu bar — summon it, write, dismiss it.',
} = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- apply the saved theme before first paint (no flash) -->
    <script is:inline>
      try {
        const t = localStorage.getItem('rotli-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <style is:global>
      /* ---- Fonts (copied from src/brand/fonts) ---- */
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/GeneralSans-Regular.woff2') format('woff2');
        font-weight: 400;
        font-display: swap;
      }
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/GeneralSans-Medium.woff2') format('woff2');
        font-weight: 500;
        font-display: swap;
      }
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/GeneralSans-Semibold.woff2') format('woff2');
        font-weight: 600;
        font-display: swap;
      }
      @font-face {
        font-family: 'Baloo 2';
        src: url('/fonts/Baloo2-600.ttf') format('truetype');
        font-weight: 600;
        font-display: swap;
      }

      /* ---- Paper (light) — the default ---- */
      :root {
        --ground: #fafaf9;
        --surface: #ffffff;
        --surface-2: #f5f5f4;
        --tint: #ececea;
        --text: #161616;
        --text-muted: #6b6b68;
        --border: #e6e6e3;
        --accent: #161616;
        --accent-text: #161616;
        --on-accent: #ffffff;

        --font-body: 'General Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
        --font-display: 'Baloo 2', var(--font-body);
        --maxw: 62rem;
      }

      /* ---- Charcoal (dark): follow the system, UNLESS the user forced light ---- */
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          --ground: #161616;
          --surface: #1f1e1c;
          --surface-2: #2a2825;
          --tint: #33312d;
          --text: #e9e7e2;
          --text-muted: #a8a49c;
          --border: #2e2c29;
          --accent: #e9e7e2;
          --accent-text: #e9e7e2;
          --on-accent: #161616;
        }
      }
      /* ---- Charcoal when the user explicitly chose dark (wins over the media) ---- */
      :root[data-theme='dark'] {
        --ground: #161616;
        --surface: #1f1e1c;
        --surface-2: #2a2825;
        --tint: #33312d;
        --text: #e9e7e2;
        --text-muted: #a8a49c;
        --border: #2e2c29;
        --accent: #e9e7e2;
        --accent-text: #e9e7e2;
        --on-accent: #161616;
      }

      * { box-sizing: border-box; }

      html {
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      body {
        margin: 0;
        background: var(--ground);
        color: var(--text);
        font-family: var(--font-body);
        font-weight: 400;
        line-height: 1.6;
        font-size: 17px;
      }

      a { color: inherit; }
      img { max-width: 100%; display: block; }

      /* the quokka mark + full-body characters ink with the theme (currentColor) */
      .logo-mark, .char { display: inline-block; line-height: 0; color: var(--text); }
      .logo-mark svg, .char svg { display: block; width: 100%; height: auto; }

      ::selection { background: var(--tint); color: var(--text); }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
