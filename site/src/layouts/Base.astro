---
interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = 'Rotli — room to think, files you keep',
  description = 'A calm, local-first Mac workspace for notes, editable files, boards, and AI conversations. One folder you own, with no account required.',
  canonicalPath = Astro.url.pathname,
  image = '/social-card.png',
  noindex = false,
} = Astro.props as Props;
const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(canonicalPath, siteUrl).href;
const socialImageUrl = new URL(image, siteUrl).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rotli" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="Rotli — room to think, files you keep" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      try {
        const root = document.documentElement;
        const families = ['rotli', 'paper', 'ocean', 'grove', 'iris', 'midnight'];
        const savedFamily = localStorage.getItem('rotli-site-family');
        const savedMode = localStorage.getItem('rotli-site-mode');
        root.dataset.family = families.includes(savedFamily) ? savedFamily : 'rotli';
        // The site opens in the Rotli light environment; the toggle's saved
        // choice wins, the operating system's appearance does not.
        root.dataset.mode = savedMode === 'dark' ? 'dark' : 'light';
      } catch (error) {}
    </script>
    <style is:global>
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/GeneralSans-Regular.woff2') format('woff2');
        font-weight: 400;
        font-display: swap;
      }
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/GeneralSans-Medium.woff2') format('woff2');
        font-weight: 500;
        font-display: swap;
      }
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/GeneralSans-Semibold.woff2') format('woff2');
        font-weight: 600;
        font-display: swap;
      }
      @font-face {
        font-family: 'Baloo 2';
        src: url('/fonts/Baloo2-600.ttf') format('truetype');
        font-weight: 600;
        font-display: swap;
      }

      :root {
        --font-body: 'General Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
        --font-wordmark: 'Baloo 2', var(--font-body);
        --page-max: 76rem;
        --copy-max: 68ch;
        --ground: #f8f2e9;
        --surface: #ffffff;
        --surface-2: #f1e7d8;
        --tint: #f2d6c2;
        --text: #3a3028;
        --text-muted: #6e6155;
        --border: #e2d3c1;
        --border-strong: #cdb8a1;
        --accent: #c97e62;
        --accent-text: #8f4e37;
        --on-accent: #ffffff;
        --deep: #241d18;
        --deep-surface: #302720;
        --deep-text: #f1e7da;
        --deep-muted: #c6b7a7;
        --deep-border: #4b3c31;
        --success: #5f6b49;
        --selection: #f2d6c2;
        --quokka-field: #f3e8da;
        --swatch-rotli-light: #f8f2e9;
        --swatch-rotli-dark: #241d18;
        --swatch-paper-light: #fafaf9;
        --swatch-paper-dark: #161616;
        --swatch-ocean-light: #dfebf3;
        --swatch-ocean-dark: #0e171d;
        --swatch-grove-light: #e3eee4;
        --swatch-grove-dark: #101814;
        --swatch-iris-light: #e9e4f2;
        --swatch-iris-dark: #15121d;
        --swatch-midnight-light: #f0f2f5;
        --swatch-midnight-dark: #050607;
        --hero-ground: #0b2f39;
        --hero-text: #f5fbfc;
        --hero-accent: #bfeaf0;
        --hero-action: #6ee0e8;
        --hero-action-text: #092a32;
        --hero-shot: #0d2026;
        --hero-wash: rgba(5, 29, 36, 0.58);
        --hero-hover-wash: rgba(5, 29, 36, 0.5);
        --hero-copy: rgba(238, 249, 251, 0.82);
        --hero-muted: rgba(238, 249, 251, 0.7);
        --hero-caption: rgba(238, 249, 251, 0.72);
        --hero-border: rgba(245, 251, 252, 0.56);
        --hero-shot-border: rgba(245, 251, 252, 0.42);
        --hero-shadow: rgba(2, 20, 26, 0.3);
      }

      :root[data-family='rotli'][data-mode='dark'] {
        --ground: #241d18;
        --surface: #2e2620;
        --surface-2: #392f28;
        --tint: #3e332b;
        --text: #f1e7da;
        --text-muted: #b7a593;
        --border: #493a30;
        --border-strong: #665142;
        --accent: #c97e62;
        --accent-text: #dda087;
        --on-accent: #241d18;
        --deep: #171310;
        --deep-surface: #211b17;
        --deep-text: #f7ede1;
        --deep-muted: #c7b7a6;
        --deep-border: #3d3129;
        --success: #a4b08d;
        --selection: #573f34;
        --quokka-field: #f1e7da;
      }

      :root[data-family='paper'][data-mode='light'] {
        --ground: #fafaf9;
        --surface: #ffffff;
        --surface-2: #f2f2f0;
        --tint: #e7e7e3;
        --text: #161616;
        --text-muted: #62625f;
        --border: #ddddda;
        --border-strong: #bdbdb8;
        --accent: #30302e;
        --accent-text: #161616;
        --on-accent: #ffffff;
        --deep: #161616;
        --deep-surface: #22211f;
        --deep-text: #efede8;
        --deep-muted: #b8b4ac;
        --deep-border: #3b3935;
        --success: #555d50;
        --selection: #e7e7e3;
        --quokka-field: #f0f0ed;
      }

      :root[data-family='paper'][data-mode='dark'] {
        --ground: #161616;
        --surface: #1f1e1c;
        --surface-2: #2a2825;
        --tint: #33312d;
        --text: #e9e7e2;
        --text-muted: #aaa69e;
        --border: #383631;
        --border-strong: #54514a;
        --accent: #e9e7e2;
        --accent-text: #ffffff;
        --on-accent: #161616;
        --deep: #0d0d0d;
        --deep-surface: #181716;
        --deep-text: #f3f1ec;
        --deep-muted: #b9b5ad;
        --deep-border: #34322e;
        --success: #b4bdad;
        --selection: #33312d;
        --quokka-field: #efede8;
      }

      :root[data-family='ocean'][data-mode='light'] {
        --ground: #f2f6f9;
        --surface: #ffffff;
        --surface-2: #e8f0f5;
        --tint: #dceaf2;
        --text: #18272f;
        --text-muted: #526873;
        --border: #cadbe4;
        --border-strong: #a8c2ce;
        --accent: #2e6e91;
        --accent-text: #285f7e;
        --on-accent: #ffffff;
        --deep: #0e171d;
        --deep-surface: #152229;
        --deep-text: #e7f0f4;
        --deep-muted: #a9bdc6;
        --deep-border: #2c424c;
        --success: #507b66;
        --selection: #dceaf2;
        --quokka-field: #e2edf3;
      }

      :root[data-family='ocean'][data-mode='dark'] {
        --ground: #0e171d;
        --surface: #152229;
        --surface-2: #1c2d35;
        --tint: #213843;
        --text: #e7f0f4;
        --text-muted: #a1b6c0;
        --border: #2a404a;
        --border-strong: #41606e;
        --accent: #70b2d7;
        --accent-text: #9acde7;
        --on-accent: #0e171d;
        --deep: #081014;
        --deep-surface: #101b20;
        --deep-text: #eff7fa;
        --deep-muted: #adc0c9;
        --deep-border: #263a43;
        --success: #8cc4a5;
        --selection: #213843;
        --quokka-field: #e4eef2;
      }

      :root[data-family='grove'][data-mode='light'] {
        --ground: #f2f6f2;
        --surface: #fcfefc;
        --surface-2: #e9f0ea;
        --tint: #dce8de;
        --text: #1d2c23;
        --text-muted: #5d6f64;
        --border: #cfddd1;
        --border-strong: #abc1b0;
        --accent: #427a55;
        --accent-text: #386c49;
        --on-accent: #ffffff;
        --deep: #101814;
        --deep-surface: #17221b;
        --deep-text: #e7efe9;
        --deep-muted: #acbcb0;
        --deep-border: #2d4033;
        --success: #427a55;
        --selection: #dce8de;
        --quokka-field: #e6eee7;
      }

      :root[data-family='grove'][data-mode='dark'] {
        --ground: #101814;
        --surface: #17221b;
        --surface-2: #1f2d24;
        --tint: #26382c;
        --text: #e7efe9;
        --text-muted: #a4b5a8;
        --border: #2c4032;
        --border-strong: #46644f;
        --accent: #82be96;
        --accent-text: #a8d4b6;
        --on-accent: #101814;
        --deep: #09100c;
        --deep-surface: #121b15;
        --deep-text: #eef5f0;
        --deep-muted: #afbeb2;
        --deep-border: #293a2f;
        --success: #82be96;
        --selection: #26382c;
        --quokka-field: #e5ede6;
      }

      :root[data-family='iris'][data-mode='light'] {
        --ground: #f5f3f9;
        --surface: #ffffff;
        --surface-2: #ebe7f2;
        --tint: #e3dcf0;
        --text: #282334;
        --text-muted: #696176;
        --border: #dad3e4;
        --border-strong: #bbb0cb;
        --accent: #6b58a5;
        --accent-text: #5e4c96;
        --on-accent: #ffffff;
        --deep: #15121d;
        --deep-surface: #1d1927;
        --deep-text: #eeeaf5;
        --deep-muted: #b6acc4;
        --deep-border: #393047;
        --success: #557462;
        --selection: #e3dcf0;
        --quokka-field: #ebe6f3;
      }

      :root[data-family='iris'][data-mode='dark'] {
        --ground: #15121d;
        --surface: #1d1927;
        --surface-2: #272132;
        --tint: #30283f;
        --text: #eeeaf5;
        --text-muted: #b2a8c1;
        --border: #372f45;
        --border-strong: #55486a;
        --accent: #ad9ae3;
        --accent-text: #c8b9ef;
        --on-accent: #15121d;
        --deep: #0c0a11;
        --deep-surface: #17131e;
        --deep-text: #f4f0f8;
        --deep-muted: #bbb0c8;
        --deep-border: #322a3e;
        --success: #8bb69a;
        --selection: #30283f;
        --quokka-field: #eae5f2;
      }

      :root[data-family='midnight'][data-mode='light'] {
        --ground: #f4f5f7;
        --surface: #ffffff;
        --surface-2: #e9ebef;
        --tint: #e0e3e8;
        --text: #181b20;
        --text-muted: #5e6570;
        --border: #d3d7dd;
        --border-strong: #adb4be;
        --accent: #364152;
        --accent-text: #2e3745;
        --on-accent: #ffffff;
        --deep: #050607;
        --deep-surface: #0b0d0f;
        --deep-text: #f1f3f5;
        --deep-muted: #acb2ba;
        --deep-border: #24292f;
        --success: #4f7160;
        --selection: #e0e3e8;
        --quokka-field: #e8ebef;
      }

      :root[data-family='midnight'][data-mode='dark'] {
        --ground: #050607;
        --surface: #0b0d0f;
        --surface-2: #121519;
        --tint: #191d22;
        --text: #f1f3f5;
        --text-muted: #a4aab2;
        --border: #252a30;
        --border-strong: #3d454f;
        --accent: #cfd5dc;
        --accent-text: #ffffff;
        --on-accent: #050607;
        --deep: #000000;
        --deep-surface: #08090a;
        --deep-text: #f5f6f7;
        --deep-muted: #adb2b8;
        --deep-border: #20252b;
        --success: #a4c5b2;
        --selection: #191d22;
        --quokka-field: #eceff2;
      }

      :root {
        color-scheme: light;
      }
      :root[data-mode='dark'] {
        color-scheme: dark;
      }
      * {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      body {
        margin: 0;
        min-width: 20rem;
        background: var(--ground);
        color: var(--text);
        font-family: var(--font-body);
        font-size: 17px;
        line-height: 1.62;
        transition: background-color 180ms ease-out, color 180ms ease-out;
      }
      a {
        color: inherit;
      }
      button,
      input,
      select,
      textarea {
        font: inherit;
      }
      button {
        color: inherit;
      }
      img,
      svg {
        display: block;
        max-width: 100%;
      }
      h1,
      h2,
      h3 {
        text-wrap: balance;
      }
      p {
        text-wrap: pretty;
      }
      :where(a, button):focus-visible {
        outline: 2px solid var(--accent-text);
        outline-offset: 3px;
      }
      ::selection {
        background: var(--selection);
        color: var(--text);
      }
      .skip-link {
        position: fixed;
        top: 0.75rem;
        left: 0.75rem;
        z-index: 100;
        padding: 0.65rem 0.9rem;
        border-radius: 0.5rem;
        background: var(--text);
        color: var(--ground);
        text-decoration: none;
        transform: translateY(-160%);
      }
      .skip-link:focus {
        transform: translateY(0);
      }

      /* Site chrome: one header, one footer, one button grammar. Markup lives in
         src/components/SiteHeader.astro and SiteFooter.astro. */
      .site-header,
      .site-footer {
        width: min(100% - 3rem, var(--page-max));
        margin-inline: auto;
      }
      .site-header {
        min-height: 76px;
        display: flex;
        align-items: center;
        gap: 2rem;
        position: relative;
        z-index: 20;
        border-bottom: 1px solid var(--border);
      }
      .brand,
      .footer-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        color: var(--text);
        text-decoration: none;
      }
      .brand-mark {
        width: 30px;
        line-height: 0;
      }
      .wordmark,
      .footer-brand b {
        font-family: var(--font-wordmark);
        font-size: 1.55rem;
        font-weight: 600;
        letter-spacing: -0.015em;
      }
      .primary-nav {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: clamp(1.1rem, 2.5vw, 2.2rem);
        margin-inline: auto;
      }
      .primary-nav a,
      .github-link {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        color: var(--text-muted);
        font-size: 0.9rem;
        text-decoration: none;
      }
      .primary-nav a:hover,
      .primary-nav a[aria-current='page'],
      .github-link:hover {
        color: var(--text);
      }
      .primary-nav a[aria-current='page'] {
        text-decoration: underline;
        text-decoration-color: var(--accent);
        text-underline-offset: 0.45rem;
      }
      .header-actions {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        margin-left: auto;
      }
      .primary-nav + .header-actions {
        margin-left: 0;
      }
      .github-link {
        gap: 0.45rem;
        padding-inline: 0.35rem;
      }
      .github-link svg {
        width: 18px;
        height: 18px;
      }
      .mode-toggle {
        min-width: 82px;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--surface);
        color: var(--text);
        cursor: pointer;
      }
      .mode-toggle:hover {
        background: var(--surface-2);
        border-color: var(--border-strong);
      }
      .mode-icon,
      .mode-icon svg {
        width: 17px;
        height: 17px;
      }
      .sun-path,
      .mode-toggle[data-mode='dark'] .moon-path {
        display: none;
      }
      .mode-toggle[data-mode='dark'] .sun-path {
        display: block;
      }
      .button {
        min-height: 50px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.72rem 1.25rem;
        border-radius: 0.7rem;
        font-weight: 600;
        text-decoration: none;
        transition: transform 120ms ease-out, background-color 140ms ease-out, border-color 140ms ease-out;
      }
      .button:active {
        transform: translateY(1px);
      }
      .button.primary {
        background: var(--text);
        color: var(--ground);
        border: 1px solid var(--text);
      }
      .button.primary:hover {
        background: var(--accent-text);
        border-color: var(--accent-text);
        color: var(--on-accent);
      }
      .button.secondary {
        background: transparent;
        color: var(--text);
        border: 1px solid var(--border-strong);
      }
      .button.secondary:hover {
        background: var(--surface);
      }
      .button.pending,
      .button.pending:hover,
      .button.pending:active {
        transform: none;
        cursor: default;
        opacity: 0.82;
      }
      .site-footer {
        min-height: 8rem;
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 2rem;
        align-items: center;
        border-top: 1px solid var(--border);
        color: var(--text-muted);
        font-size: 0.86rem;
      }
      .footer-brand span {
        width: 23px;
        line-height: 0;
      }
      .footer-brand b {
        font-size: 1.25rem;
        color: var(--text);
      }
      .site-footer p {
        margin: 0;
      }
      .site-footer nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0 1.25rem;
      }
      .site-footer nav a {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        text-decoration: none;
      }
      .site-footer nav a:hover {
        color: var(--text);
      }
      @media (max-width: 1080px) {
        .primary-nav {
          display: none;
        }
      }

      @media (max-width: 760px) {
        .site-footer {
          grid-template-columns: 1fr;
          gap: 0.5rem;
          padding-block: 2rem;
        }
      }

      @media (max-width: 560px) {
        .site-header,
        .site-footer {
          width: min(100% - 1.5rem, var(--page-max));
        }
        .site-header {
          gap: 0.75rem;
        }
        .github-link {
          min-width: 44px;
          justify-content: center;
          padding-inline: 0;
        }
        .github-link span,
        .mode-label {
          position: absolute;
          width: 1px;
          height: 1px;
          padding: 0;
          margin: -1px;
          overflow: hidden;
          clip: rect(0, 0, 0, 0);
          white-space: nowrap;
          border: 0;
        }
        .mode-toggle {
          min-width: 44px;
          width: 44px;
          padding: 0;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <slot />
    <script>
      // Appearance toggle for the shared site header (SiteHeader.astro).
      const root = document.documentElement;
      const modeButton = document.querySelector<HTMLButtonElement>('#mode-toggle');
      const modeLabel = modeButton?.querySelector<HTMLElement>('.mode-label');

      const syncMode = () => {
        const dark = root.dataset.mode === 'dark';
        if (modeLabel) modeLabel.textContent = dark ? 'Light' : 'Dark';
        modeButton?.setAttribute('aria-label', dark ? 'Use light appearance' : 'Use dark appearance');
        modeButton?.setAttribute('data-mode', dark ? 'dark' : 'light');
      };

      modeButton?.addEventListener('click', () => {
        root.dataset.mode = root.dataset.mode === 'dark' ? 'light' : 'dark';
        try {
          localStorage.setItem('rotli-site-mode', root.dataset.mode);
        } catch (error) {}
        syncMode();
      });

      syncMode();
    </script>
  </body>
</html>
