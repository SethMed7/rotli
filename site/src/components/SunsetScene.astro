---
// The story film's last shot as a page ground: flat bands of sunset sky, the sun half down
// behind the bay, the sand, and the quokka waving from the shore. Whatever goes in the slot
// sits over the sky; give it [data-reveal] and the sun settles and the quokka hops up when it
// is revealed. `full` fills the window (the 404 page). All of it is CSS on the film's palette
// (Base.astro tokens) except the quokka, which is the app's own character art.
import waving from '../../../src/assets/characters/filled/cocoa/waving.webp';

interface Props {
  /** Fill the whole window, the sky above and the shore at the bottom edge. */
  full?: boolean;
}

const { full = false } = Astro.props;
---

<div class:list={['sunset', { full }]}>
  <div class="sky">
    <slot />
  </div>
  <div class="shore" aria-hidden="true">
    <span class="sun sunset-sun"></span>
    <span class="sea"></span>
    <span class="sand"></span>
    <img class="quokka sunset-quokka" src={waving.src} width="512" height="512" alt="" loading={full ? "eager" : "lazy"} decoding="async" />
  </div>
</div>

<style>
  /* The film's sunset sky: flat bands, deepest at the top, palest at the horizon. */
  .sunset {
    position: relative;
    overflow: hidden;
    padding-top: var(--section-space);
    background: linear-gradient(
      var(--sunset-1) 0 18%,
      var(--sunset-2) 18% 36%,
      var(--sunset-3) 36% 54%,
      var(--sunset-4) 54% 72%,
      var(--sunset-5) 72% 100%
    );
  }
  .sky {
    position: relative;
    z-index: 1;
  }
  .full {
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: 100svh;
    padding-top: clamp(2rem, 6vh, 4rem);
  }
  .full .sky {
    display: grid;
    align-content: center;
  }

  /* The horizon. */
  .shore {
    position: relative;
    height: clamp(170px, 20vw, 250px);
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
  .sun {
    position: absolute;
    left: 50%;
    top: 0;
    width: clamp(120px, 12vw, 176px);
    aspect-ratio: 1;
    border: 3px solid var(--accent);
    border-radius: 50%;
    background: var(--sun);
    transform: translate(-50%, -38%);
  }
  .sea {
    position: absolute;
    inset: 0 0 auto;
    height: 58%;
    border-top: 10px solid var(--sea-deep);
    background:
      linear-gradient(90deg, transparent 0 46%, color-mix(in srgb, var(--sun) 55%, transparent) 46% 54%, transparent 54%) no-repeat
        50% 22px / 100% 8px,
      linear-gradient(90deg, transparent 0 47.5%, color-mix(in srgb, var(--sun) 45%, transparent) 47.5% 52.5%, transparent 52.5%)
        no-repeat 50% 44px / 100% 8px,
      var(--sea);
  }
  .sand {
    position: absolute;
    inset: auto 0 0;
    height: 42%;
    border-top: 3px solid var(--text);
    background: var(--sand);
  }
  .quokka {
    position: absolute;
    left: 50%;
    bottom: 14%;
    width: clamp(110px, 11vw, 150px);
    height: auto;
    transform: translateX(-190%);
  }
</style>

<style is:global>
  /* When the content over the sky is revealed ([data-reveal]), the sun settles and the
     quokka hops up onto the sand; reduced motion shows them at rest. Global on purpose: in a
     scoped style Astro leaves `:global(...)` untransformed inside `:has()`, and the browser
     drops the rule. Globally the slotted .is-visible is a plain descendant, and these rules
     key on the scene's own unique class names. */
  @media (prefers-reduced-motion: no-preference) {
    .js .sunset .sunset-sun {
      transition: transform 1400ms cubic-bezier(0.2, 0.7, 0.2, 1) 200ms;
    }
    .js .sunset:not(:has(.is-visible)) .sunset-sun {
      transform: translate(-50%, -80%);
    }
    .js .sunset .sunset-quokka {
      transition: transform 700ms cubic-bezier(0.34, 1.5, 0.64, 1) 700ms;
    }
    .js .sunset:not(:has(.is-visible)) .sunset-quokka {
      transform: translate(-190%, 120%);
    }
  }
</style>
