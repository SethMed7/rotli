---
// The scenery at the foot of every page (the footer) and of /subscribed/: a strip of Rottnest
// by day, with the sea and the far lighthouse, low scrub on the dunes, the sand, a pile of
// leaves, and the quokkas who live there, each doing its own thing (the owner's brief,
// 2026-10-05: "some sitting and eating, some playing in a corner"):
//
//   the sitter    up on its haunches by the pile, eating a leaf from its paws (listening pose)
//   the nibbler   standing, a paw at its mouth, chewing (thoughtful pose; wide screens)
//   the guard     minding the pile: it watches you, waves when you arrive, frowns when you
//                 reach for the leaves, and cheers when one reaches a friend (base rig)
//   the players   two in the right-hand corner, playing catch with a beach ball (base rig;
//                 the catcher reaches up in the cheering pose)
//   the stroller  now and then walking the dunes behind them, in profile (walking pose)
//
// Every pose is the app's own art, never redrawn: base.svg is rigged (head about the neck,
// eyes redrawn on top so they can follow you and blink, brows and mouths in the art's line
// weight for moods); waving.svg and celebrating.svg are swapped in whole (their outline is
// their body fill, and celebrating's confetti is dropped: src/quokka/art.ts); the sitter, nibbler, and stroller are the approved layered poses as
// masks (src/assets/characters/concepts/layers/), filled with the scene's tokens and split
// at the neck so heads can turn and dip. src/quokka/rig.ts holds every landmark.
//
// The visitor walks a person along the beach (the owner, 2026-10-05): it appears when the
// pointer comes onto the sand and walks to where the pointer is (a tap on a touch screen; the
// arrow keys from "Walk on the beach", the button before the band). Stopped at the leaf pile
// it picks a leaf up, stopped at a quokka with a leaf it hands it over (the quokka eats, the
// guard is pleased), and stopped by the two with the ball it joins their game of catch. The
// person is the drawing below (code, in the scene's ink and tokens, no particular person:
// a round face, a bucket hat, a shirt, and trousers). The older play stays alongside: a leaf
// can still be dragged off the pile (mouse, pen, or touch) and dropped on a quokka, or on the
// sand, where it is wasted and the guard is sad, and "Hand the quokkas a leaf" does that from
// the keyboard. src/quokka/scene.ts runs it all, only while the band is on screen and the tab
// is visible. Under reduced motion nothing moves on its own: the scene stands still until the
// visitor plays, and then the person steps straight to where it is sent. Without script the
// scene simply stands still and the buttons stay hidden. The band itself is decoration
// (aria-hidden) and holds no text or links.
import baseSvg from '../../../src/assets/characters/base.svg?raw';
import celebratingSvg from '../../../src/assets/characters/celebrating.svg?raw';
import wavingSvg from '../../../src/assets/characters/waving.svg?raw';
import listeningBody from '../../../src/assets/characters/concepts/layers/listening-body.webp';
import listeningLine from '../../../src/assets/characters/concepts/layers/listening-line.webp';
import thoughtfulBody from '../../../src/assets/characters/concepts/layers/thoughtful-body.webp';
import thoughtfulLine from '../../../src/assets/characters/concepts/layers/thoughtful-line.webp';
import walkingBody from '../../../src/assets/characters/concepts/layers/walking-body.webp';
import walkingLine from '../../../src/assets/characters/concepts/layers/walking-line.webp';
import { quokkaArt, tracedPose } from '../quokka/art';
import {
  BALL,
  CENTER_X,
  EYES,
  HEAD_CLIP_BOTTOM,
  INK_WIDTH,
  LAYERED,
  PAWS,
  TORSO_CLIP_TOP,
  TRACED_SCALE,
  VIEWBOX,
} from '../quokka/rig';

interface Props {
  /** How the quokkas greet the page: `happy` on /subscribed/. */
  mood?: 'happy';
}

const { mood } = Astro.props;
const art = quokkaArt(baseSvg);
const wave = tracedPose(wavingSvg);
const cheer = tracedPose(celebratingSvg);
const viewBox = `${VIEWBOX.x} ${VIEWBOX.y} ${VIEWBOX.width} ${VIEWBOX.height}`;
const ink = `stroke-width="${INK_WIDTH}"`;

// Moods replace the canonical smile: a patch over it, the philtrum, then the new mouth.
const mouthPatch = 'M528 400L562 400L592 418L652 418L684 400L720 400L724 432L692 474L650 498L594 498L552 474L524 432Z';
const leafAt = (x: number, y: number, angle: number, scale: number) =>
  `<use href="#qk-leaf" transform="translate(${x} ${y}) rotate(${angle}) scale(${scale}) translate(-6 0)"/>`;

/** A traced pose, whole: its outline filled with the body colour, the line on top. */
const traced = (name: string, pose: { transform: string }) =>
  `<g data-pose="${name}" visibility="hidden"><g transform="scale(${TRACED_SCALE}) ${pose.transform}"><use href="#qk-${name}-body" class="qk-fill"/><use href="#qk-${name}-line" class="qk-ink"/></g></g>`;

/** The rigged base quokka: head and body layers, live eyes and moods, and the two swaps. */
const eye = ({ x, y }: { x: number; y: number }) =>
  `<g class="qk-eye" data-eye><g data-eye-look><ellipse class="qk-ink" cx="${x}" cy="${y}" rx="28" ry="33"/><ellipse class="qk-fill" cx="${x + 1}" cy="${y - 12}" rx="14" ry="12"/></g></g>`;
const rig = (extra: string) =>
  [
    '<g data-rig>',
    '<g data-pose="base">',
    '<g clip-path="url(#qk-clip-torso)"><use href="#qk-body" class="qk-fill"/><use href="#qk-line" class="qk-ink"/></g>',
    '<g data-head>',
    '<g clip-path="url(#qk-clip-head)"><use href="#qk-body" class="qk-fill"/><use href="#qk-line" class="qk-ink"/></g>',
    '<g class="qk-live">',
    ...EYES.map(({ x, y }) => `<circle class="qk-fill" cx="${x}" cy="${y}" r="40"/>`),
    `<g class="qk-eyes">${EYES.map(eye).join('')}</g>`,
    `<path class="qk-line qk-x qk-x-happy" ${ink} d="${EYES.map(({ x, y }) => `M${x - 26} ${y + 8}Q${x} ${y - 26} ${x + 26} ${y + 8}`).join('')}"/>`,
    '</g>',
    `<path class="qk-fill qk-x qk-x-mad qk-x-sad" d="${mouthPatch}"/>`,
    `<path class="qk-line qk-x qk-x-mad qk-x-sad" ${ink} d="M622 406V428"/>`,
    `<path class="qk-line qk-x qk-x-mad" ${ink} d="M586 454Q604 440 622 448Q640 440 658 454M484 274L550 296M760 274L694 296"/>`,
    `<path class="qk-line qk-x qk-x-sad" ${ink} d="M584 466Q622 426 660 466M488 294L550 272M756 294L694 272"/>`,
    '</g>',
    `<g data-held visibility="hidden">${leafAt(PAWS.x, PAWS.y, -70, 2.4)}</g>`,
    '</g>',
    extra,
    '</g>',
  ].join('');

/** A layered pose: body and line masks filled with tokens, split at the neck, lids to blink,
 * and the leaf it may hold. */
type LayeredName = keyof typeof LAYERED;
const layeredRig = (name: LayeredName, holding: boolean) => {
  const pose = LAYERED[name];
  const layers = `<g mask="url(#qk-m-${name}-body)"><rect class="qk-fill" width="512" height="512"/></g><g mask="url(#qk-m-${name}-line)"><rect class="qk-ink" width="512" height="512"/></g>`;
  const lids = pose.eyes
    .map(
      ({ x, y, r }) =>
        `<ellipse class="qk-fill" cx="${x}" cy="${y}" rx="${r + 4}" ry="${r + 3}"/><path class="qk-line" stroke-width="5" d="M${x - r} ${y + 1}Q${x} ${y + r * 0.7} ${x + r} ${y + 1}"/>`,
    )
    .join('');
  return [
    '<g data-rig>',
    `<g clip-path="url(#qk-clip-${name}-body)">${layers}</g>`,
    '<g data-head>',
    `<g clip-path="url(#qk-clip-${name}-head)">${layers}</g>`,
    `<g data-lids visibility="hidden">${lids}</g>`,
    '</g>',
    `<g data-held${holding ? '' : ' visibility="hidden"'}>${leafAt(pose.leaf.x, pose.leaf.y, pose.leaf.angle, 1.7)}</g>`,
    '</g>',
  ].join('');
};
const layeredView = (name: LayeredName) => {
  const { view } = LAYERED[name];
  return `${view.x} ${view.y} ${view.width} ${view.height}`;
};
const layeredMasks = [
  { name: 'listening', body: listeningBody.src, line: listeningLine.src },
  { name: 'thoughtful', body: thoughtfulBody.src, line: thoughtfulLine.src },
  { name: 'walking', body: walkingBody.src, line: walkingLine.src },
] as const;
/** A quokka facing the other way: mirrored about its own centre line. */
const mirror = `matrix(-1 0 0 1 ${2 * CENTER_X} 0)`;
---

<div class="scenery-wrap">
  <button type="button" class="scenery-feed" data-walk aria-describedby="walk-help" hidden>Walk on the beach</button>
  <p class="visually-hidden" id="walk-help">
    The left and right arrow keys walk you along the beach. Stop at the leaves to pick one up, at a quokka to
    hand it over, or by the two with the ball to join their game.
  </p>
  <button type="button" class="scenery-feed" data-feed hidden>Hand the quokkas a leaf</button>
  <p class="visually-hidden" aria-live="polite" data-feed-status></p>
  <div class="scenery" aria-hidden="true" data-scenery data-start-mood={mood}>
    <svg class="scenery-defs" width="0" height="0" focusable="false">
      <defs>
        <path id="qk-line" d={art.line} fill-rule="evenodd"></path>
        <path id="qk-body" d={art.silhouette}></path>
        <path id="qk-wave-line" d={wave.line}></path>
        <path id="qk-wave-body" d={wave.silhouette}></path>
        <path id="qk-cheer-line" d={cheer.line}></path>
        <path id="qk-cheer-body" d={cheer.silhouette}></path>
        <clipPath id="qk-clip-head"><rect x="0" y="-200" width="1254" height={HEAD_CLIP_BOTTOM + 200}></rect></clipPath>
        <clipPath id="qk-clip-torso"><rect x="0" y={TORSO_CLIP_TOP} width="1254" height={1254 - TORSO_CLIP_TOP}></rect></clipPath>
        {
          layeredMasks.map(({ name, body, line }) => (
            <>
              <mask id={`qk-m-${name}-body`} maskUnits="userSpaceOnUse" x="0" y="0" width="512" height="512">
                <image href={body} width="512" height="512" />
              </mask>
              <mask id={`qk-m-${name}-line`} maskUnits="userSpaceOnUse" x="0" y="0" width="512" height="512">
                <image href={line} width="512" height="512" />
              </mask>
              <clipPath id={`qk-clip-${name}-head`}>
                <rect x="0" y="-100" width="512" height={LAYERED[name].seam + 112} />
              </clipPath>
              <clipPath id={`qk-clip-${name}-body`}>
                <rect x="0" y={LAYERED[name].seam - 12} width="512" height={524 - LAYERED[name].seam} />
              </clipPath>
            </>
          ))
        }
        <g id="qk-leaf">
          <path class="qk-leaf-blade" d="M0 0Q22-15 46 0Q22 15 0 0Z"></path>
          <path class="qk-leaf-rib" d="M5 0H38"></path>
        </g>
        <g id="qk-ball">
          <circle class="ball-a" r={BALL.r}></circle>
          <path class="ball-b" d={`M0 ${-BALL.r}A${BALL.r} ${BALL.r} 0 0 1 ${BALL.r * 0.64} ${BALL.r * 0.77}Q0 0 0 ${-BALL.r}Z`}></path>
          <path class="ball-c" d={`M0 ${-BALL.r}A${BALL.r} ${BALL.r} 0 0 0 ${-BALL.r * 0.64} ${BALL.r * 0.77}Q0 0 0 ${-BALL.r}Z`}></path>
          <circle class="ball-line" r={BALL.r} stroke-width={INK_WIDTH}></circle>
          <circle class="ball-cap" r="14"></circle>
        </g>
      </defs>
    </svg>

    <svg class="scenery-land" viewBox="0 0 1440 150" preserveAspectRatio="xMidYMax slice" focusable="false">
      <g class="cloud">
        <ellipse cx="236" cy="40" rx="46" ry="11"></ellipse>
        <ellipse cx="268" cy="33" rx="28" ry="11"></ellipse>
      </g>
      <g class="cloud">
        <ellipse cx="1004" cy="26" rx="36" ry="9"></ellipse>
        <ellipse cx="1028" cy="20" rx="22" ry="9"></ellipse>
      </g>
      <rect class="sea" x="0" y="98" width="1440" height="52"></rect>
      <path class="sea-edge" d="M0 98H1440"></path>
      <path class="waves" d="M150 110q8-4 16 0M520 106q8-4 16 0M720 112q8-4 16 0M1250 108q8-4 16 0"></path>
      <path class="far-isle" d="M1070 99C1110 86 1150 72 1196 70S1290 78 1340 99"></path>
      <g class="lighthouse">
        <path class="tower" d="M1189 72l3-34h10l3 34z"></path>
        <rect class="lamp" x="1192" y="29" width="10" height="9"></rect>
        <path class="cap" d="M1190 29q7-8 14 0z"></path>
      </g>
      <path class="dune dune-far" d="M-10 152V126C90 112 190 108 300 118S470 130 560 122 760 106 880 114 1080 130 1180 120 1360 110 1450 116V152Z"></path>
      <g class="scrub">
        <ellipse cx="96" cy="118" rx="32" ry="11"></ellipse>
        <ellipse cx="130" cy="113" rx="20" ry="9"></ellipse>
        <ellipse cx="392" cy="123" rx="26" ry="9"></ellipse>
        <ellipse cx="826" cy="112" rx="28" ry="10"></ellipse>
        <ellipse cx="856" cy="116" rx="17" ry="7"></ellipse>
        <ellipse cx="1124" cy="124" rx="24" ry="9"></ellipse>
        <ellipse cx="1330" cy="113" rx="30" ry="10"></ellipse>
      </g>
      <path class="dune dune-near" d="M-10 152V138C120 128 260 132 420 138S700 140 860 134 1160 128 1450 136V152Z"></path>
    </svg>
    <div class="scenery-sand"></div>

    <svg class="qk qk-layered qk-walker" viewBox={layeredView('walking')} focusable="false" data-quokka="walker" data-pose-kind="walking">
      <g data-flip set:html={layeredRig('walking', false)} />
    </svg>

    <svg class="person" viewBox="0 0 100 170" focusable="false" data-person>
      <g data-person-flip>
        <g data-person-body>
          <g data-person-arm="back">
            <path class="person-limb-line person-arm-line" d="M50 84V108"></path>
            <path class="person-sleeve" d="M50 84V108"></path>
            <circle class="person-hand" cx="50" cy="110" r="5.5"></circle>
          </g>
          <g data-person-leg="back">
            <path class="person-limb-line" d="M45 114V152"></path>
            <path class="person-trouser" d="M45 114V152"></path>
            <ellipse class="person-shoe" cx="49" cy="157" rx="9" ry="5.5"></ellipse>
          </g>
          <g data-person-leg="front">
            <path class="person-limb-line" d="M55 114V152"></path>
            <path class="person-trouser" d="M55 114V152"></path>
            <ellipse class="person-shoe" cx="59" cy="157" rx="9" ry="5.5"></ellipse>
          </g>
          <rect class="person-shirt" x="31" y="72" width="38" height="48" rx="14"></rect>
          <g class="person-head">
            <circle class="person-face" cx="51" cy="50" r="20"></circle>
            <circle class="person-cheek" cx="62" cy="56" r="3.4"></circle>
            <circle class="person-ink" cx="61" cy="47.5" r="2.6"></circle>
            <path class="person-line" d="M56 58q4.5 3.4 9 0"></path>
            <path class="person-hat" d="M35 40Q36 21 51 20.5Q66 21 67 40Z"></path>
            <path class="person-hat" d="M26 41.5Q51 34.5 76 41.5Q51 49 26 41.5Z"></path>
          </g>
          <g data-person-arm="front">
            <path class="person-limb-line person-arm-line" d="M50 84V108"></path>
            <path class="person-sleeve" d="M50 84V108"></path>
            <g data-person-leaf visibility="hidden">
              <use href="#qk-leaf" transform="translate(51 115) rotate(-35) scale(0.6)"></use>
            </g>
            <circle class="person-hand" cx="50" cy="110" r="5.5"></circle>
          </g>
        </g>
      </g>
    </svg>

    <svg class="food" viewBox="0 0 150 72" focusable="false" data-food>
      <ellipse class="food-shadow" cx="75" cy="66" rx="68" ry="6"></ellipse>
      <use href="#qk-leaf" transform="translate(8 62) rotate(-6)"></use>
      <use href="#qk-leaf" class="leaf-light" transform="translate(50 65) rotate(2)"></use>
      <use href="#qk-leaf" transform="translate(142 63) rotate(186)"></use>
      <use href="#qk-leaf" class="leaf-light" transform="translate(24 52) rotate(-18)"></use>
      <use href="#qk-leaf" transform="translate(124 52) rotate(198)"></use>
      <use href="#qk-leaf" transform="translate(50 40) rotate(-22)"></use>
      <use href="#qk-leaf" class="leaf-light" transform="translate(102 40) rotate(204)"></use>
      <use href="#qk-leaf" transform="translate(54 31) rotate(-6)"></use>
    </svg>

    <svg class="qk qk-layered qk-sitter" viewBox={layeredView('listening')} focusable="false" data-quokka="sitter" data-pose-kind="listening" data-mood={mood}>
      <g data-flip set:html={layeredRig('listening', true)} />
    </svg>
    <svg class="qk qk-layered qk-nibbler" viewBox={layeredView('thoughtful')} focusable="false" data-quokka="nibbler" data-pose-kind="thoughtful" data-mood={mood}>
      <g data-flip set:html={layeredRig('thoughtful', true)} />
    </svg>
    <svg class="qk qk-guard" viewBox={viewBox} focusable="false" data-quokka="guard" data-mood={mood}>
      <g data-flip set:html={rig(traced('wave', wave))} />
    </svg>
    <svg class="qk qk-player qk-player-a" viewBox={viewBox} focusable="false" data-quokka="player-a" data-mood={mood}>
      <g data-flip set:html={rig(traced('cheer', cheer))} />
    </svg>
    <svg class="qk qk-player qk-player-b" viewBox={viewBox} focusable="false" data-quokka="player-b" data-face="left" data-mood={mood}>
      <g data-flip transform={mirror} set:html={rig(traced('cheer', cheer))} />
    </svg>
    <svg class="ball" viewBox={`${-BALL.r - 10} ${-BALL.r - 10} ${2 * BALL.r + 20} ${2 * BALL.r + 20}`} focusable="false" data-ball>
      <use href="#qk-ball"></use>
    </svg>
    <svg class="carried-leaf" viewBox="-30 -20 60 40" focusable="false" data-carried visibility="hidden">
      <use href="#qk-leaf" transform="translate(-23 0) rotate(-20 23 0)"></use>
    </svg>
  </div>
</div>

<script>
  import '../quokka/scene';
</script>

<style is:global>
  /* Global, under .scenery: the rig is shared markup and <use> clones, which scoped
     selectors cannot reach. */
  .scenery-wrap {
    position: relative;
  }
  /* The keyboard's way to play: hidden until it has focus, then a small button over the
     scene's top-left corner (the scene has no words to cover there). */
  .scenery-feed {
    position: absolute;
    top: 0.75rem;
    left: var(--gutter);
    z-index: 2;
    min-height: 44px;
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--border-strong);
    border-radius: 0.6rem;
    background: var(--surface);
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    clip-path: inset(50%);
  }
  .scenery-feed:focus-visible {
    clip-path: none;
  }
  .scenery-feed[hidden] {
    display: none;
  }
  .scenery {
    --sand-height: clamp(38px, 4vw, 52px);
    --qk-height: clamp(96px, 8.6vw, 124px);
    position: relative;
    height: clamp(168px, 15vw, 212px);
    overflow: hidden;
    color: var(--ink);
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .scenery svg {
    max-width: none;
  }
  .scenery-defs {
    position: absolute;
    overflow: hidden;
  }
  .scenery-land {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: calc(100% - var(--sand-height));
  }
  .scenery-sand {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: var(--sand-height);
    background: var(--sand);
  }
  .scenery .cloud ellipse {
    fill: var(--surface-2);
  }
  .scenery .sea {
    fill: var(--sea);
  }
  .scenery .sea-edge {
    stroke: var(--sea-deep);
    stroke-width: 1.6;
  }
  .scenery .waves {
    fill: none;
    stroke: var(--sea-line);
    stroke-width: 2.5;
    stroke-linecap: round;
  }
  .scenery .far-isle {
    fill: var(--limestone);
    stroke: var(--ink);
    stroke-width: 1.6;
  }
  .scenery .tower {
    fill: var(--surface);
    stroke: var(--ink);
    stroke-width: 1.6;
  }
  .scenery .lamp {
    fill: var(--lantern);
    stroke: var(--ink);
    stroke-width: 1.6;
  }
  .scenery .cap {
    fill: var(--accent);
    stroke: var(--ink);
    stroke-width: 1.6;
  }
  .scenery .scrub ellipse {
    fill: var(--olive);
    stroke: var(--ink);
    stroke-width: 1.6;
  }
  .scenery .dune {
    stroke: var(--ink);
    stroke-width: 1.6;
  }
  .scenery .dune-far {
    fill: var(--limestone);
  }
  .scenery .dune-near {
    fill: var(--sand);
  }

  /* The cast on the sand, each at its own spot, all drawn to one scale: the base rig's
     1250-unit box is --qk-height tall, and a layered pose's 512-unit canvas is 1254/512 of
     those units (src/quokka/rig.ts), so its box is its view times --qk-height × 0.0019594. */
  .scenery .qk,
  .scenery .food,
  .scenery .ball,
  .scenery .carried-leaf {
    position: absolute;
    overflow: visible;
  }
  .scenery .qk {
    bottom: 10px;
    height: var(--qk-height);
    width: calc(var(--qk-height) * 0.68);
    translate: -50% 0;
  }
  .scenery .qk-sitter {
    left: 10%;
    bottom: 14px;
    height: calc(var(--qk-height) * 0.8935);
    width: calc(var(--qk-height) * 0.6976);
  }
  .scenery .qk-nibbler {
    left: 24%;
    bottom: 6px;
    height: calc(var(--qk-height) * 0.9288);
    width: calc(var(--qk-height) * 0.5682);
  }
  .scenery .food {
    left: 36%;
    bottom: 8px;
    width: clamp(78px, 6.8vw, 100px);
    height: auto;
    aspect-ratio: 150 / 72;
    translate: -50% 0;
    cursor: grab;
    touch-action: none;
  }
  .scenery .qk-guard {
    left: 50%;
    bottom: 4px;
  }
  .scenery .qk-player-a {
    left: 74%;
    bottom: 16px;
  }
  .scenery .qk-player-b {
