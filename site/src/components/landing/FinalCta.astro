---
// The closing invitation: one line and the two ways in, on the page's own ground. The
// footer's quokka beach (QuokkaScene.astro) right below is the page's one closing scene.
import { site } from '../../site';
import SiteActions from '../SiteActions.astro';
---

<section class="section final" aria-labelledby="final-title">
  <div class="wrap final-inner" data-reveal>
    <h2 class="section-title" id="final-title">A durable place for the work <span class="inked">you want to keep.</span></h2>
    <p class="section-lede">Write the way you think. rotli keeps it filed, in a folder that stays yours.</p>
    <SiteActions webLabel="Open in your browser" downloadLabel="Download for Mac" />
    <p class="final-meta">
      Your first vault opens with three short lessons{site.downloadsEnabled ? '. Free, no account.' : '.'}
    </p>
  </div>
</section>

<style>
  .final-inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .section-title {
    max-width: 16ch;
  }
  .section-lede {
    margin-inline: auto;
  }
  .final-inner :global(.site-actions) {
    justify-content: center;
    margin-top: 2rem;
  }
  .final-meta {
    margin: 1rem 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>
