---
// The closing invitation, set where the story film ends: sunset on the island. Flat bands of
// sunset sky behind one line and the two ways in, then the horizon (a sun half down, the bay,
// the sand) with the quokka waving from the shore. All of it is CSS on the film's palette
// (Base.astro tokens) except the quokka, which is the app's own character art.
import waving from '../../../../src/assets/characters/filled/cocoa/waving.webp';
import { site } from '../../site';
import SiteActions from '../SiteActions.astro';
---

<section class="final" aria-labelledby="final-title">
  <div class="wrap final-inner" data-reveal>
    <h2 class="section-title" id="final-title">A durable place for the work <span class="inked">you want to keep.</span></h2>
    <p class="section-lede">Warm enough to return to. Quiet enough to disappear. Local enough to stay yours.</p>
    <SiteActions webLabel="Open in your browser" downloadLabel="Download for Mac" />
    <p class="final-meta">
      Your first vault opens with nine short lessons{site.downloadsEnabled ? '. Free, no account.' : '.'}
    </p>
  </div>
  <div class="shore" aria-hidden="true">
    <span class="sun"></span>
    <span class="sea"></span>
    <span class="sand"></span>
    <img class="quokka" src={waving.src} width="512" height="512" alt="" loading="lazy" decoding="async" />
  </div>
</section>

<style>
  .final {
    position: relative;
    overflow: hidden;
    padding-top: var(--section-space);
    /* The film's sunset sky: flat bands, deepest at the top, palest at the horizon. */
    background: linear-gradient(
      var(--sunset-1) 0 18%,
      var(--sunset-2) 18% 36%,
      var(--sunset-3) 36% 54%,
      var(--sunset-4) 54% 72%,
      var(--sunset-5) 72% 100%
    );
  }
  .final-inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .section-title {
    max-width: 16ch;
  }
  /* Muted text is too faint on the sky; the sunset reads in the page's ink. */
  .section-lede,
  .final-meta {
    margin-inline: auto;
    color: var(--text);
  }
  .final-inner :global(.site-actions) {
    justify-content: center;
    margin-top: 2rem;
  }
  .final-inner :global(.button.secondary) {
    border-color: var(--text);
  }
  .final-inner :global(.button.secondary:hover) {
    background: var(--sunset-5);
  }
  .final-meta {
    margin: 1rem 0 0;
    font-size: 0.9rem;
  }

  /* The horizon. */
  .shore {
    position: relative;
    height: clamp(170px, 20vw, 250px);
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
  .sun {
    position: absolute;
    left: 50%;
    top: 0;
    width: clamp(120px, 12vw, 176px);
    aspect-ratio: 1;
    border: 3px solid var(--accent);
    border-radius: 50%;
    background: var(--sun);
    transform: translate(-50%, -38%);
  }
  .sea {
    position: absolute;
    inset: 0 0 auto;
    height: 58%;
    border-top: 10px solid var(--sea-deep);
    background:
      linear-gradient(90deg, transparent 0 46%, color-mix(in srgb, var(--sun) 55%, transparent) 46% 54%, transparent 54%) no-repeat
        50% 22px / 100% 8px,
      linear-gradient(90deg, transparent 0 47.5%, color-mix(in srgb, var(--sun) 45%, transparent) 47.5% 52.5%, transparent 52.5%)
        no-repeat 50% 44px / 100% 8px,
      var(--sea);
  }
  .sand {
    position: absolute;
    inset: auto 0 0;
    height: 42%;
    border-top: 3px solid var(--text);
    background: var(--sand);
  }
  .quokka {
    position: absolute;
    left: 50%;
    bottom: 14%;
    width: clamp(110px, 11vw, 150px);
    height: auto;
    transform: translateX(-190%);
  }

  /* When the band comes into view the sun settles and the quokka hops up onto the sand. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .final .sun {
      transition: transform 1400ms cubic-bezier(0.2, 0.7, 0.2, 1) 200ms;
    }
    :global(.js) .final:not(:has(.is-visible)) .sun {
      transform: translate(-50%, -80%);
    }
    :global(.js) .final .quokka {
      transition: transform 700ms cubic-bezier(0.34, 1.5, 0.64, 1) 700ms;
    }
    :global(.js) .final:not(:has(.is-visible)) .quokka {
      transform: translate(-190%, 120%);
    }
  }
</style>
