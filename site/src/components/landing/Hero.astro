---
// The landing hero: one promise, what rotli is, and two buttons side by side at one size (the
// owner, 2026-10-06: "our privacy policy should be more like a button matching the download"):
// "Our privacy promise", outlined with a lock, to /privacy/#promise, on the left, and "Download
// free" (to /download/, which offers the Mac app and Rotli Web) on the right (the owner, the
// same day: "Privacy promise goes on the left"). On a phone they stack full width in the same
// order, so what is seen first is what the keyboard and a screen reader reach first; the
// download still reads as the main action by its fill. "No account. Works offline." stays one quiet line under them. Where rotli runs
// is the download page's to say, not the hero's (the owner, 2026-10-05: less clutter). It fills the
// first screen on a faint tile of note, folder, and checklist icons (the same
// pattern as the link preview, public/social-card.svg) that fades out behind
// the words. Right below them the product film plays (FilmPlayer.astro): a real Rotli Web
// session on synthetic notes (write, the Library, search, chat, plain Markdown), silent,
// muted and once, resting on its last frame with "Watch again". `bun run capture:hero`
// records it; site/README.md ("Films") says what in it is fixture.
//
// Motion: on arrival the page lands in one short sequence (header and pattern
// fade in, the two headline lines slide up out of a mask, the rest rises in
// turn, the clay line inks itself under "the filing.", and the film rises last).
// Everything plays once and rests, is plain CSS (no script, no inline style, so
// the production CSP allows it), and reduced motion shows the finished state at
// once. Nothing is tied to the scroll (the owner, 2026-10-06: no scroll-scrub; the
// film's earlier scroll-linked settle left it half faded on arrival).
//
// The hand-off to the next band (the owner, 2026-10-06: "the transition from the hero to
// below the fold … can be a bit smoother"): the film sits across the boundary. Behind its
// lower half the page ground eases into the StatBand's warm ground, so the warm band has
// already begun when the film ends and there is no hard line or empty strip between them; the
// band's own top padding shrinks to match. The icon tile fades out before the hero's edge
// instead of being cut by it.
import { DOCS_AND_SHEETS, site } from '../../site';
import SiteActions from '../SiteActions.astro';
import { hero } from '../../films';
import FilmPlayer from '../FilmPlayer.astro';

---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-pattern" aria-hidden="true"></div>
  <div class="hero-copy">
    <h1 id="hero-title"><span class="line"><span>Write like a person.</span></span> <span class="line"><span>Let AI do <span class="inked">the filing.</span></span></span></h1>
    <p class="hero-lede">
      rotli is a free workspace built on plain Markdown files. Notes come first. Docs and Sheets
      ({DOCS_AND_SHEETS.inline}), chat, and boards sit in the same folder. There’s no account to make.
      AI is optional: it uses a model on your computer or the AI tools you already pay for.
    </p>
    <SiteActions>
      <a slot="before" class="button secondary hero-promise" href="/privacy/#promise">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="9" width="12" height="8.5" rx="2"></rect><path d="M7 9V6.5a3 3 0 0 1 6 0V9"></path></svg>
        Our privacy promise
      </a>
    </SiteActions>
    <p class="hero-meta">
      <span class="hero-cost">{site.downloadsEnabled ? 'No account. Works offline.' : 'Free. No account. The Mac alpha is in preparation.'}</span>
    </p>
  </div>
</section>

<div class="below-fold">
  <div class="wrap hero-film">
    <FilmPlayer src={hero.src} poster={hero.poster} label={hero.label} silent={hero.silent === true} captioned={hero.captioned === true} />
  </div>
</div>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: calc(62svh - var(--header-height));
    padding: clamp(3rem, 8vh, 5rem) var(--gutter) clamp(2rem, 6vh, 4rem);
    overflow: hidden;
    text-align: center;
  }
  /* The film across the boundary: a full-bleed strip whose ground eases from the page's into
     the next band's warm one behind the film's lower half (both are ground tokens, so the
     privacy passage recolours it like any band). The band below then starts on the same warm
     ground with less top padding, so the film's lower edge and the band's first words keep one
     section's rhythm between them. */
  .below-fold {
    background: linear-gradient(to bottom, var(--ground) 0%, var(--ground) 35%, var(--surface-2) 80%);
  }
  :global(.below-fold + .band-warm) {
    padding-top: calc(var(--section-space) * 0.85);
  }
  /* Decoration only: the faint icon tile, hidden behind the words and
     strongest toward the edges (a mask, not a light effect). It fades out over the hero's
     last fifth, so the hero's edge never cuts through a row of icons. */
  .hero-pattern {
    position: absolute;
    inset: 0;
    background-image: url('/hero-pattern.svg');
    background-size: 240px 240px;
    background-position: center top;
    mask-image:
      radial-gradient(ellipse 64% 60% at 50% 42%, transparent 40%, #000 95%),
      linear-gradient(to bottom, #000 72%, transparent 100%);
    mask-composite: intersect;
  }
  .hero-copy {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1.6rem;
    max-width: 52rem;
  }
  h1 {
    margin: 0;
    font-size: var(--step-display);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-wrap: initial;
  }
  .hero-lede {
    max-width: 40rem;
    margin: 0;
    color: var(--text-muted);
    font-size: var(--step-lede);
    line-height: 1.55;
  }
  .hero-copy :global(.site-actions) {
    justify-content: center;
    margin-top: 0.4rem;
  }
  /* What it costs, in one quiet line under the buttons. */
  .hero-meta {
    margin: -0.6rem 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .hero-cost {
    color: var(--text);
    font-weight: 600;
  }
  /* The two buttons share one row and one size (.button); on a phone they stack, full width,
     in the same order: the promise, then the download. */
  .hero-promise svg {
    flex: none;
  }
  @media (max-width: 520px) {
    .hero-copy :global(.site-actions) {
      flex-direction: column;
      justify-self: stretch;
    }
  }

  /* The entrance. Every animation fills backwards only, so once it ends the
     element rests on its ordinary styles. */
  h1 .line {
    display: block;
    overflow: hidden;
    /* Room for descenders inside the mask, given back below. */
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }
  h1 .line > span {
    display: block;
    text-wrap: balance;
  }
  h1 .inked {
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.site-header-bar) {
      animation: hero-fade 600ms ease-out backwards;
    }
    .hero-pattern {
      animation: hero-fade 1400ms ease-out 150ms backwards;
    }
    h1 .line > span {
      animation: hero-line 1000ms cubic-bezier(0.16, 1, 0.3, 1) 120ms backwards;
    }
    h1 .line + .line > span {
      animation-delay: 220ms;
    }
    .hero-lede {
      animation: hero-rise 900ms cubic-bezier(0.16, 1, 0.3, 1) 480ms backwards;
    }
    .hero-copy :global(.site-actions) {
      animation: hero-rise 900ms cubic-bezier(0.16, 1, 0.3, 1) 600ms backwards;
    }
    .hero-meta {
      animation: hero-fade 900ms ease-out 760ms backwards;
    }
    h1 .inked {
      animation: ink-draw 900ms cubic-bezier(0.65, 0, 0.25, 1) 1000ms backwards;
    }
  }
  @keyframes ink-draw {
    from {
      background-size: 0% 0.2em;
    }
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes hero-line {
    from {
      transform: translateY(108%);
    }
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  /* The film rises last in the arrival sequence, once, and rests. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-film {
      animation: hero-rise 1000ms cubic-bezier(0.16, 1, 0.3, 1) 880ms backwards;
    }
  }

</style>
