---
// The landing hero: one promise, one sentence, the two ways in. It fills the
// first screen on a faint tile of note, folder, and checklist icons (the same
// pattern as the link preview, public/social-card.svg) that fades out behind
// the words. Right below them the story film plays (FilmPlayer.astro): muted and once, with
// "Click for sound" to watch it from the top with its score. The app itself is shown by the
// episodes further down and the theme preview, so the hero carries no capture.
//
// Motion: on arrival the page lands in one short sequence (header and pattern
// fade in, the two headline lines slide up out of a mask, the rest rises in
// turn, and the film's clay line inks itself under "Files you keep."). As the visitor
// scrolls, the film settles into place. Everything plays once and rests,
// is plain CSS (no script, no inline style, so the production CSP allows it),
// and reduced motion shows the finished state at once.
import { site } from '../../site';
import SiteActions from '../SiteActions.astro';
import { story } from '../../films';
import FilmPlayer from '../FilmPlayer.astro';

---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-pattern" aria-hidden="true"></div>
  <div class="hero-copy">
    <h1 id="hero-title"><span class="line"><span>Room to think.</span></span> <span class="line"><span><span class="inked">Files you keep.</span></span></span></h1>
    <p class="hero-lede">
      The calm notes app for your Mac. Every note is a plain Markdown file in a folder you own, with
      AI only when you ask for it.
    </p>
    <SiteActions webLabel="Open in your browser" downloadLabel="Download for Mac" />
    <p class="hero-meta">
      {site.downloadsEnabled ? 'Free · No account · Works offline' : 'Mac alpha in preparation · Free · No account'}
    </p>
  </div>
</section>

<div class="wrap below-fold">
  <div class="hero-film">
    <FilmPlayer src={story.src} poster={story.poster} label={story.label} />
  </div>
</div>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: calc(62svh - var(--header-height));
    padding: clamp(3rem, 8vh, 5rem) var(--gutter) clamp(2rem, 6vh, 4rem);
    overflow: hidden;
    text-align: center;
  }
  /* Decoration only: the faint icon tile, hidden behind the words and
     strongest toward the edges (a mask, not a light effect). */
  .hero-pattern {
    position: absolute;
    inset: 0;
    background-image: url('/hero-pattern.svg');
    background-size: 240px 240px;
    background-position: center top;
    mask-image: radial-gradient(ellipse 64% 60% at 50% 42%, transparent 40%, #000 95%);
  }
  .hero-copy {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1.6rem;
    max-width: 48rem;
  }
  h1 {
    margin: 0;
    font-size: var(--step-display);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-wrap: initial;
  }
  .hero-lede {
    max-width: 34rem;
    margin: 0;
    color: var(--text-muted);
    font-size: var(--step-lede);
    line-height: 1.55;
  }
  .hero-copy :global(.site-actions) {
    justify-content: center;
    margin-top: 0.4rem;
  }
  .hero-meta {
    margin: -0.4rem 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  /* The entrance. Every animation fills backwards only, so once it ends the
     element rests on its ordinary styles. */
  h1 .line {
    display: block;
    overflow: hidden;
    /* Room for descenders inside the mask, given back below. */
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }
  h1 .line > span {
    display: block;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.site-header-bar) {
      animation: hero-fade 600ms ease-out backwards;
    }
    .hero-pattern {
      animation: hero-fade 1400ms ease-out 150ms backwards;
    }
    h1 .line > span {
      animation: hero-line 1000ms cubic-bezier(0.16, 1, 0.3, 1) 120ms backwards;
    }
    h1 .line + .line > span {
      animation-delay: 220ms;
    }
    .hero-lede {
      animation: hero-rise 900ms cubic-bezier(0.16, 1, 0.3, 1) 480ms backwards;
    }
    .hero-copy :global(.site-actions) {
      animation: hero-rise 900ms cubic-bezier(0.16, 1, 0.3, 1) 600ms backwards;
    }
    .hero-meta {
      animation: hero-fade 900ms ease-out 760ms backwards;
    }
    h1 .inked {
      animation: ink-draw 900ms cubic-bezier(0.65, 0, 0.25, 1) 1000ms backwards;
    }
  }
  @keyframes ink-draw {
    from {
      background-size: 0% 0.2em;
    }
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes hero-line {
    from {
      transform: translateY(108%);
    }
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  /* Scrolling down: the film rises and settles as it comes into view.
     Scroll-driven where the browser supports it; elsewhere it simply sits. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-film {
        animation: film-settle linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 35%;
      }
    }
  }
  @keyframes film-settle {
    from {
      opacity: 0.4;
      transform: translateY(56px) scale(0.965);
    }
  }

</style>
