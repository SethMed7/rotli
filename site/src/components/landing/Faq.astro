---
// Short answers to the questions a first visit raises. Every answer restates
// a claim made elsewhere on the site; nothing here may promise more.
import searching from '../../../../src/assets/characters/filled/cocoa/searching.webp';
import { site } from '../../site';

const questions = [
  {
    q: 'Is rotli free?',
    a: site.sourcePublic
      ? 'Yes. It is free, needs no account, and the source is open under the MIT license.'
      : 'Yes. It is free and needs no account.',
  },
  {
    q: 'Where do my notes live?',
    a: 'In one folder you choose, as plain Markdown files. rotli keeps its settings and search indexes in a hidden .rotli folder inside it, and can rebuild them at any time.',
  },
  {
    q: 'Does it work offline?',
    a: 'Yes. Writing, tasks, links, and search need no network. Chat works offline too when you use an on-device model.',
  },
  {
    q: 'Which AI can I use?',
    a: 'A model that runs on your Mac, or the tools you already use, like Claude Code and Codex, with Cursor for code chat. AI is optional; rotli is a complete workspace without it.',
  },
  {
    q: 'Can I leave?',
    a: 'Your notes never left. The folder opens in any Markdown editor, and deleting rotli leaves every file where it was.',
  },
  {
    q: 'What about Windows and Linux?',
    a: site.webAppEnabled
      ? 'Use Rotli Web in your browser today. Native Windows and Linux apps are planned.'
      : 'Native Windows and Linux apps are planned.',
  },
];
---

<section class="section faq" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq-grid">
    <header>
      <h2 class="section-title" id="faq-title">Questions, answered.</h2>
      <p class="section-lede">
        More in <a href="/resources/">Resources</a>, starting with <a href="/resources/getting-started/">Getting started</a>.
      </p>
      <!-- The quokka with its magnifying glass, and the questions it is looking into. Plays once. -->
      <div class="faq-scene" data-reveal aria-hidden="true">
        <svg viewBox="0 0 440 300" role="presentation">
          <g class="card k1">
            <rect x="26" y="40" width="96" height="70" rx="10" />
            <text x="74" y="90" text-anchor="middle">?</text>
          </g>
          <g class="card k2">
            <rect x="300" y="18" width="96" height="70" rx="10" />
            <text x="348" y="68" text-anchor="middle">?</text>
          </g>
          <g class="card k3">
            <rect x="318" y="150" width="84" height="62" rx="10" />
            <text x="360" y="194" text-anchor="middle">!</text>
          </g>
          <path class="trail" d="M122 96q40 30 70 70M300 72q-40 20-60 60" />
          <ellipse class="shadow" cx="215" cy="286" rx="70" ry="8" />
          <image class="quokka" href={searching.src} x="120" y="94" width="196" height="196" />
        </svg>
      </div>
    </header>
    <div class="faq-list">
      {questions.map((item) => (
        <details>
          <summary>
            <span>{item.q}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 5v14M5 12h14" /></svg>
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  /* The sunset band follows, so the questions keep a full section of room below them. */
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 2.5rem clamp(3rem, 8vw, 7rem);
    align-items: start;
  }
  .faq-scene {
    max-width: 26rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .faq-scene svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .card rect {
    fill: var(--surface);
    stroke: var(--text);
    stroke-width: 2.5;
  }
  .card text {
    fill: var(--accent-text);
    font-family: var(--font-body);
    font-size: 40px;
    font-weight: 600;
  }
  .card {
    transform-box: fill-box;
    transform-origin: center;
  }
  .k1 {
    transform: rotate(-8deg);
  }
  .k2 {
    transform: rotate(7deg);
  }
  .k3 {
    transform: rotate(-4deg);
  }
  .trail {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 2.5;
    stroke-dasharray: 6 8;
    stroke-linecap: round;
  }
  .shadow {
    fill: var(--border);
  }
  /* Once: the question cards float in, the answer last. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .faq-scene:global(.is-visible) .card {
      animation: float-in 900ms cubic-bezier(0.34, 1.4, 0.64, 1) 300ms backwards;
    }
    :global(.js) .faq-scene:global(.is-visible) .k2 {
      animation-delay: 480ms;
    }
    :global(.js) .faq-scene:global(.is-visible) .k3 {
      animation-delay: 900ms;
    }
  }
  @keyframes float-in {
    from {
      opacity: 0;
      transform: translateY(-24px) scale(0.8);
    }
  }
  .section-lede a {
    color: var(--accent-text);
    text-underline-offset: 0.2em;
  }
  .faq-list {
    border-top: 1px solid var(--border-strong);
  }
  details {
    border-bottom: 1px solid var(--border-strong);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.75rem;
    padding-block: 1.35rem;
    font-size: 1.15rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover span {
    color: var(--accent-text);
  }
  summary svg {
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--text-muted);
    transition: transform 160ms ease-out;
  }
  details[open] summary svg {
    transform: rotate(45deg);
  }
  details p {
    max-width: 38rem;
    margin: -0.35rem 2.5rem 1.6rem 0;
    color: var(--text-muted);
    line-height: 1.62;
  }
  @media (max-width: 860px) {
    .faq-grid {
      grid-template-columns: 1fr;
    }
    .faq-scene {
      max-width: 20rem;
    }
  }
</style>
