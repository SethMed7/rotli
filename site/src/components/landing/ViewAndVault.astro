---
// Write, the first step of "Write it down. rotli puts it away." (Overview.astro): one note seen
// two ways (the owner, 2026-10-06: "clarify view vs where it actually lives"). On the left, the
// note in your view, Main, under a folder you made; on the right, its one file in the vault; a
// dotted line between the two rows says they are the same file. The words are the product's
// own (docs/architecture/memex-data-contract.md, "One physical home, many views"): Main is a
// view of references and never owns or copies content, and with the Librarian on a new note's
// file starts in the Library intake, wiki/_inbox/. Drawn in HTML on the site's tokens, one
// image to assistive tech. No cards (the owner, 2026-10-07): two open lists under the same
// head as the other two steps' pictures. The two lists share one row height, so the two marked rows sit on
// one line and the dotted line can join them at any width; on a phone the lists stack and the
// line runs down between them.
import notes from '../../../../src/assets/characters/filled/cocoa/notes.webp';

const view = [
  { label: 'Today', kind: 'note', depth: 0 },
  { label: 'This week', kind: 'folder', depth: 0 },
  { label: 'Call with Dana', kind: 'note', depth: 1, here: true },
  { label: 'Q4 launch plan', kind: 'note', depth: 1 },
] as const;
const vault = [
  { label: 'wiki/', kind: 'folder', depth: 0 },
  { label: '_inbox/', kind: 'folder', depth: 1 },
  { label: 'dana-call.md', kind: 'file', depth: 2, here: true },
  { label: 'Projects/', kind: 'folder', depth: 1 },
] as const;
const icon = {
  note: 'M4 2.5h5.5L12 5v8.5H4z M9.5 2.5V5H12',
  file: 'M4 2.5h5.5L12 5v8.5H4z M9.5 2.5V5H12',
  folder: 'M2.5 4.5h4l1.2 1.5h5.8v7h-11z',
} as const;
---

<figure
  class="where"
  role="img"
  aria-label="One note seen two ways: in your view, Main, the note Call with Dana sits under the folder This week; in your vault, its file is wiki/_inbox/dana-call.md. A dotted line marks them as the same file."
>
  <div class="side">
    <div class="head">
      <div>
        <p class="side-label">In your view</p>
        <p class="path">
          Main
          <svg class="chevron" viewBox="0 0 12 12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 4.5 6 7.5l3-3" /></svg>
        </p>
      </div>
    </div>
    <ul class="rows">
      {
        view.map((row) => (
          <li class:list={['row', `depth-${row.depth}`, { here: 'here' in row }]}>
            <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"><path d={icon[row.kind]} /></svg>
            <span>{row.label}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="link" aria-hidden="true">
    <span class="link-label">same file</span>
    <span class="link-line"></span>
  </div>

  <div class="side">
    <div class="head">
      <div>
        <p class="side-label">In your vault</p>
        <p class="path"><code>Notes/</code>, the folder you chose</p>
      </div>
      <img class="quokka" src={notes.src} width="512" height="512" alt="" loading="lazy" decoding="async" />
    </div>
    <ul class="rows mono">
      {
        vault.map((row) => (
          <li class:list={['row', `depth-${row.depth}`, { here: 'here' in row }]}>
            <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"><path d={icon[row.kind]} /></svg>
            <span>{row.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</figure>

<style>
  /* Open lists on the band, no card (the owner, 2026-10-07): each side is a label and a line
     over one hairline, the same head the Librarian's before and after uses (Filing.astro, and
     --figure-head from Overview.astro), with the vault's quokka standing on its hairline. */
  .where {
    --row: 2.15rem;
    --rows-top: 0.6rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(4.5rem, 6.5rem) minmax(0, 1fr);
    margin: 0;
  }
  .side {
    min-width: 0;
  }
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem;
    box-sizing: border-box;
    height: var(--figure-head, 4rem);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-strong);
  }
  .head > div {
    min-width: 0;
  }
  .side-label {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }
  .path {
    margin: 0.3rem 0 0;
    overflow: hidden;
    color: var(--text-muted);
    font-size: 0.8rem;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .path code {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    color: var(--text);
  }
  .chevron {
    display: inline-block;
    width: 0.75rem;
    height: 0.75rem;
    margin-left: 0.15rem;
    vertical-align: -0.1em;
  }
  /* The rows' icons line up with the label above; a marked row's tint reaches past them. */
  .rows {
    margin: var(--rows-top) -0.5rem 0;
    padding: 0;
    font-size: 0.9rem;
    list-style: none;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    height: var(--row);
    padding: 0 0.5rem;
    border-radius: 0.4rem;
    white-space: nowrap;
  }
  .row span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .row svg {
    flex: none;
    width: 0.95rem;
    height: 0.95rem;
    color: var(--text-muted);
  }
  .depth-1 {
    padding-left: 1.5rem;
  }
  .depth-2 {
    padding-left: 2.5rem;
  }
  .mono {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.82rem;
  }
  /* The note itself, marked the same on both sides. */
  .here {
    background: var(--tint);
    font-weight: 600;
  }
  .here svg {
    color: var(--accent-text);
  }
  .quokka {
    flex: none;
    width: 56px;
    height: 56px;
    margin: 0 0.25rem calc(-0.75rem - 1px) 0;
  }

  /* The dotted line, level with the marked rows: under the head, the list's top margin, and two
     rows, then half a row. */
  .link {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    height: calc(var(--figure-head, 4rem) + var(--rows-top) + 2.5 * var(--row));
    padding: 0 0.15rem;
  }
  .link-label {
    margin-bottom: 0.3rem;
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .link-line {
    width: calc(100% + 0.6rem);
    margin-inline: -0.3rem;
    border-top: 2px dotted var(--accent);
  }

  /* On a phone the lists stack and the line runs down between them. */
  @media (max-width: 599px) {
    .where {
      grid-template-columns: minmax(0, 1fr);
    }
    .link {
      flex-direction: row;
      justify-content: flex-start;
      height: 3.2rem;
      padding: 0 0 0 2.4rem;
      gap: 0.6rem;
    }
    .link-line {
      order: -1;
      width: 0;
      height: calc(100% + 0.8rem);
      margin: -0.4rem 0;
      border-top: 0;
      border-left: 2px dotted var(--accent);
    }
    .link-label {
      margin: 0;
    }
  }
</style>
