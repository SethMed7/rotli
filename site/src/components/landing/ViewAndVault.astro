---
// Write, the first step of "Write it down. rotli puts it away." (Overview.astro): one note seen
// two ways (the owner, 2026-10-06: "clarify view vs where it actually lives"). On the left, the
// note in your view, Main, under a folder you made; on the right, its one file in the vault; a
// dotted line between the two rows says they are the same file. The words are the product's
// own (docs/architecture/memex-data-contract.md, "One physical home, many views"): Main is a
// view of references and never owns or copies content, and with the Librarian on a new note's
// file starts in the Library intake, wiki/_inbox/. Drawn in HTML on the site's tokens, one
// image to assistive tech. No cards (the owner, 2026-10-07): two open lists under the same
// head as the other two steps' pictures. Both lists are drawn as the app's sidebar tree (the
// owner, 2026-10-07: "match the design in the way we highlight active"): a chevron gutter on
// folders, a guide line under an open folder's children, and the open note in the app's quiet
// selection wash, starting at its own depth, its icon in the accent and its text unchanged. The
// two lists share one row height, so the two marked rows sit on one line and the dotted line
// joins them at any width, with "same file" set in the line; on a phone the lists stack and the
// line runs down between them.
import notes from '../../../../src/assets/characters/filled/cocoa/notes.webp';

type Row = { label: string; kind: 'note' | 'file' | 'folder'; depth: number; open?: boolean; here?: boolean };
const view: Row[] = [
  { label: 'Today', kind: 'note', depth: 0 },
  { label: 'This week', kind: 'folder', depth: 0, open: true },
  { label: 'Call with Dana', kind: 'note', depth: 1, here: true },
  { label: 'Q4 launch plan', kind: 'note', depth: 1 },
];
const vault: Row[] = [
  { label: 'wiki/', kind: 'folder', depth: 0, open: true },
  { label: '_inbox/', kind: 'folder', depth: 1, open: true },
  { label: 'dana-call.md', kind: 'file', depth: 2, here: true },
  { label: 'Projects/', kind: 'folder', depth: 1 },
];
const icon = {
  note: 'M4 2.5h5.5L12 5v8.5H4z M9.5 2.5V5H12',
  file: 'M4 2.5h5.5L12 5v8.5H4z M9.5 2.5V5H12',
  folder: 'M2.5 4.5h4l1.2 1.5h5.8v7h-11z',
} as const;
const chevron = { open: 'M3 4.5 6 7.5l3-3', closed: 'M4.5 3 7.5 6l-3 3' } as const;
---

<figure
  class="where"
  role="img"
  aria-label="One note seen two ways: in your view, Main, the note Call with Dana sits under the folder This week; in your vault, its file is wiki/_inbox/dana-call.md. A dotted line marks them as the same file."
>
  <div class="side">
    <div class="head">
      <div>
        <p class="side-label">In your view</p>
        <p class="path">
          Main
          <svg class="chevron" viewBox="0 0 12 12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 4.5 6 7.5l3-3" /></svg>
        </p>
      </div>
    </div>
    <ul class="rows">
      {
        view.map((row) => (
          <li class:list={['row', `depth-${row.depth}`, { here: row.here }]}>
            {Array.from({ length: row.depth }, (_, level) => (
              <span class:list={['guide', `up-${row.depth - level}`]} />
            ))}
            <span class="caret">
              {row.kind === 'folder' && (
                <svg viewBox="0 0 12 12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={row.open ? chevron.open : chevron.closed} /></svg>
              )}
            </span>
            <svg class="kind" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"><path d={icon[row.kind]} /></svg>
            <span class="name">{row.label}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="link" aria-hidden="true">
    <span class="link-line"><span class="dots"></span><span class="link-label">same file</span><span class="dots"></span></span>
  </div>

  <div class="side">
    <div class="head">
      <div>
        <p class="side-label">In your vault</p>
        <p class="path"><code>Notes/</code>, the folder you chose</p>
      </div>
      <img class="quokka" src={notes.src} width="512" height="512" alt="" loading="lazy" decoding="async" />
    </div>
    <ul class="rows mono">
      {
        vault.map((row) => (
          <li class:list={['row', `depth-${row.depth}`, { here: row.here }]}>
            {Array.from({ length: row.depth }, (_, level) => (
              <span class:list={['guide', `up-${row.depth - level}`]} />
            ))}
            <span class="caret">
              {row.kind === 'folder' && (
                <svg viewBox="0 0 12 12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={row.open ? chevron.open : chevron.closed} /></svg>
              )}
            </span>
            <svg class="kind" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"><path d={icon[row.kind]} /></svg>
            <span class="name">{row.label}</span>
            {row.here && <span class="reach" />}
          </li>
        ))
      }
    </ul>
  </div>
</figure>


<style>
  /* Open lists on the band, no card (the owner, 2026-10-07): each side is a label and a line
     over one hairline, the same head the Librarian's before and after uses (Filing.astro, and
     --figure-head from Overview.astro), with the vault's quokka standing on its hairline. */
  .where {
    --row: 2.15rem;
    --rows-top: 0.6rem;
    --pad: 0.5rem;
    --caret: 0.85rem;
    --gap: 0.45rem;
    --icon: 0.95rem;
    /* A child's icon sits under its parent's name, as in the app's sidebar. */
    --indent: calc(var(--icon) + var(--gap));
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(5.5rem, 7rem) minmax(0, 1fr);
    margin: 0;
  }
  .side {
    min-width: 0;
  }
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem;
    box-sizing: border-box;
    height: var(--figure-head, 4rem);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-strong);
  }
  .head > div {
    min-width: 0;
  }
  .side-label {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }
  .path {
    margin: 0.3rem 0 0;
    overflow: hidden;
    color: var(--text-muted);
    font-size: 0.8rem;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .path code {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    color: var(--text);
  }
  .chevron {
    display: inline-block;
    width: 0.75rem;
    height: 0.75rem;
    margin-left: 0.15rem;
    vertical-align: -0.1em;
  }
  /* The tree: the carets line up with the label above; each row starts at its own depth, so a
     marked row's wash starts there too, as in the app. */
  .rows {
    margin: var(--rows-top) calc(-1 * var(--pad)) 0;
    padding: 0;
    font-size: 0.9rem;
    list-style: none;
  }
  .row {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--gap);
    height: var(--row);
    padding: 0 var(--pad);
    border-radius: 0.5rem;
    color: var(--text);
    white-space: nowrap;
  }
  /* Inline styles are blocked by the site's CSP, so each depth is a class. */
  .depth-1 {
    margin-left: var(--indent);
  }
  .depth-2 {
    margin-left: calc(2 * var(--indent));
  }
  .caret {
    display: grid;
    flex: none;
    place-items: center;
    width: var(--caret);
    color: var(--text-muted);
  }
  .caret svg {
    width: 0.7rem;
    height: 0.7rem;
  }
  .kind {
    flex: none;
    width: var(--icon);
    height: var(--icon);
    color: var(--text-muted);
  }
  .name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* The guide line under an open folder's children, below that folder's caret. */
  .guide {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--pad) + var(--caret) / 2 - var(--indent));
    border-left: 1px solid var(--border-strong);
  }
  .guide.up-2 {
    left: calc(var(--pad) + var(--caret) / 2 - 2 * var(--indent));
  }
  .mono {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.82rem;
  }
  /* The note itself, marked the same on both sides, the way the app's sidebar marks the open
     note: the quiet wash, the icon in the accent, the words as they were. */
  .here {
    background: var(--selected-bg, var(--tint));
  }
  .here .kind {
    color: var(--accent-text);
  }
  /* The dotted line carries on across the vault's indent to the marked row. */
  .reach {
    position: absolute;
    top: 50%;
    right: 100%;
    width: calc(2 * var(--indent) + var(--pad));
    border-top: 2px dotted var(--accent);
    transform: translateY(-50%);
  }
  .quokka {
    flex: none;
    width: 56px;
    height: 56px;
    margin: 0 0.25rem calc(-0.75rem - 1px) 0;
  }

  /* The dotted line, level with the marked rows (under the head, the list's top margin, and two
     rows), with "same file" set in it. */
  .link {
    padding-top: calc(var(--figure-head, 4rem) + var(--rows-top) + 2 * var(--row));
  }
  .link-line {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    width: calc(100% + 2 * var(--pad));
    height: var(--row);
    margin-inline: calc(-1 * var(--pad));
  }
  .dots {
    flex: 1;
    min-width: 0.5rem;
    border-top: 2px dotted var(--accent);
  }
  .link-label {
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
  }

  /* On a phone the lists stack and the line runs down between them, its words beside it. */
  @media (max-width: 599px) {
    .where {
      grid-template-columns: minmax(0, 1fr);
    }
    .link {
      height: 3.2rem;
      /* Under the marked note's icon. */
      padding: 0 0 0 calc(var(--indent) + var(--caret) + var(--gap) + var(--icon) / 2 - 1px);
    }
    .link-line {
      position: relative;
      width: 0;
      height: calc(100% + 0.8rem);
      margin: -0.4rem 0;
      border-left: 2px dotted var(--accent);
    }
    .dots,
    .reach {
      display: none;
    }
    .link-label {
      position: absolute;
      top: 50%;
      left: 0.6rem;
      transform: translateY(-50%);
    }
  }
</style>
