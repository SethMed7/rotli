---
// Ask, the third step of "Write it down. rotli puts it away." (Overview.astro): a chat that
// finds the note it needs instead of reading the vault. Between the question and the answer
// sits the step a visitor never sees: the search runs on the visitor's own computer, and only
// the notes it found are read. That is the retrieval contract
// (docs/architecture/memex-data-contract.md, "Master memory retrieval"): the model gets a
// bounded table of contents, searches (search_memory, over corpus_search_ai, which in the Mac
// app answers from the derived Tantivy index in .rotli/search/), then reads only the notes it
// chose (read_memory); it never receives the whole vault. The chat is drawn as a thread, the
// app's own grammar (src/styles/memex.css .cmsg): your message a tinted bubble on the right,
// rotli's turn on the left (the owner, 2026-10-07: "a real chat thread with the AI response too
// on the left"), the search drawn as that turn's first step, in muted type, not as a control,
// then the reply in a quiet bubble, and the composer under it. Beside the chat, the vault it searched: the two notes it
// read lit among others it left closed, so "not the whole vault" is something you can see (the
// owner, 2026-10-07: the picture now spans the same width as the other two steps, with no card).
// Synthetic notes, the same ones the filing step uses. One image to assistive tech.
import aiChat from '../../../../src/assets/characters/filled/cocoa/ai_chat.webp';

// The vault the search ran over: the two notes it found, lit, among others it left closed.
const vault = [
  { path: 'wiki/Clients/dana-call.md', read: true },
  { path: 'wiki/Clients/discount-policy.md', read: true },
  { path: 'wiki/People/jo-park.md', read: false },
  { path: 'wiki/Projects/q4-launch-plan.md', read: false },
  { path: 'wiki/Research/pricing-ideas.md', read: false },
] as const;
const read = vault.filter((file) => file.read).length;
---

<figure
  class="ask"
  role="img"
  aria-label="A chat beside the vault it searched. Asked what Dana wanted, rotli searches the vault on this computer and reads two notes, Call with Dana and Discount policy, then answers from them; the rest of the vault is not read."
>
  <div class="state">
    <div class="state-head">
      <div>
        <p class="state-label">You ask</p>
        <p class="file">chats/dana-follow-up.md</p>
      </div>
    </div>
    <div class="chat">
      <div class="turn you">
        <p class="bubble">What did Dana want, and what’s left?</p>
      </div>
      <div class="turn ai">
        <p class="lookup">
          <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="7" cy="7" r="4.25"></circle><path d="m10.2 10.2 3.3 3.3"></path></svg>
          <span>Searched your vault on this computer and read {read} notes</span>
        </p>
        <p class="bubble">
          From <b>Call with Dana</b>: she’s fine with annual pricing and wants the deck on Friday. Still open: ask
          Jo about the discount; <b>Discount policy</b> has the current terms.
        </p>
      </div>
      <p class="composer">
        <span>Message rotli…</span>
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 12.5v-9M4.5 7 8 3.5 11.5 7" /></svg>
      </p>
    </div>
  </div>
  <div class="state found">
    <div class="state-head">
      <div>
        <p class="state-label">What it read</p>
        <p class="file plain">searched on this computer</p>
      </div>
      <img class="quokka" src={aiChat.src} width="512" height="512" alt="" loading="lazy" decoding="async" />
    </div>
    <ul class="vault">
      {
        vault.map((file) => (
          <li class:list={['vault-row', { read: file.read }]}>
            <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"><path d="M4 2.5h5.5L12 5v8.5H4z M9.5 2.5V5H12" /></svg>
            <span>{file.path}</span>
            {file.read && <span class="tag">read</span>}
          </li>
        ))
      }
      <li class="vault-rest">…and the rest of your vault, left closed</li>
    </ul>
  </div>
</figure>

<style>
  /* Two open columns split by one hairline, like the Librarian's before and after
     (Filing.astro): the chat on the left, the vault it searched on the right, with the two notes
     it read lit and the rest left closed. No cards (the owner, 2026-10-07). */
  .ask {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 0;
    margin: 0;
  }
  .state {
    min-width: 0;
    padding-right: clamp(1.25rem, 3.5vw, 3rem);
  }
  .state.found {
    padding-right: 0;
    padding-left: clamp(1.25rem, 3.5vw, 3rem);
    border-left: 1px solid var(--border-strong);
  }
  .state-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: var(--figure-head, 4rem);
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-strong);
  }
  .state-head > div {
    min-width: 0;
  }
  .state-label {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }
  .file {
    margin: 0.3rem 0 0;
    color: var(--text-muted);
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.8rem;
    overflow-wrap: anywhere;
  }
  .file.plain {
    font-family: inherit;
  }
  .quokka {
    flex: none;
    width: 56px;
    height: 56px;
    margin: 0 0.25rem calc(-0.75rem - 1px) 0;
  }

  /* A thread, as the app draws it (src/styles/memex.css .cmsg): yours on the right in the
     accent's bubble with its tail corner, rotli's on the left. */
  .chat {
    display: grid;
    gap: 1rem;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .chat p {
    margin: 0;
  }
  .turn {
    display: grid;
    gap: 0.5rem;
  }
  .turn.you {
    justify-items: end;
  }
  .turn.ai {
    justify-items: start;
  }
  .bubble {
    max-width: 85%;
    padding: 0.55rem 0.85rem;
    border-radius: 0.9rem;
  }
  .you .bubble {
    border-bottom-right-radius: 0.3rem;
    background: color-mix(in srgb, var(--accent) 20%, transparent);
  }
  .ai .bubble {
    max-width: 92%;
    border-bottom-left-radius: 0.3rem;
    background: var(--surface-2);
  }
  /* The first step of rotli's turn: what happened, in muted type, not a control. */
  .lookup {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    padding-left: 0.85rem;
    color: var(--text-muted);
    font-size: 0.82rem;
  }
  /* The composer under the thread, drawn, not a field. */
  .composer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 2.6rem;
    margin-top: 0.25rem;
    padding: 0 0.4rem 0 0.85rem;
    border: 1px solid var(--border-strong);
    border-radius: 0.9rem;
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  .composer svg {
    flex: none;
    box-sizing: border-box;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0.35rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
  }
  .lookup svg {
    flex: none;
    width: 0.9rem;
    height: 0.9rem;
    margin-top: 0.2em;
  }

  .vault {
    margin: 0 -0.5rem;
    padding: 0;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.8rem;
    list-style: none;
  }
  .vault-row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.15rem;
    padding: 0 0.5rem;
    border-radius: 0.4rem;
    color: var(--text-muted);
  }
  .vault-row span:first-of-type {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .vault-row svg {
    flex: none;
    width: 0.95rem;
    height: 0.95rem;
  }
  /* The notes it read, marked the way the app's sidebar marks an open note: the quiet wash,
     the icon in the accent, the words as they were. */
  .vault-row.read {
    background: var(--selected-bg, var(--tint));
    color: var(--text);
  }
  .vault-row.read svg {
    color: var(--accent-text);
  }
  .tag {
    margin-left: auto;
    color: var(--accent-text);
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 600;
  }
  .vault-rest {
    padding: 0.5rem 0.5rem 0;
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-style: italic;
  }

  @media (max-width: 800px) {
    .ask {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .state,
    .state.found {
      padding: 0;
      border-left: 0;
    }
  }
</style>
