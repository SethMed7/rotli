---
// Beyond Markdown: Docs (Word files through a Rotli-owned DOCX codec with a
// Univer editor) and Sheets (Excel workbooks, CSV in place too), both in the
// Mac app and both beta (DOCS_AND_SHEETS in src/site.ts), and Excalidraw boards. Then one line on Assets: where pasted images and the
// files chat makes are kept (the Folder chapter shows the vault itself). Status follows src/lib/featurePolicy.ts and the stable New
// chooser; the board is a real
// Excalidraw canvas drawn with its own tools in Rotli Web.
import { DOCS_AND_SHEETS } from '../../site';

const formats = [
  {
    title: 'Docs',
    status: `Mac app · ${DOCS_AND_SHEETS.status}`,
    body: 'Open and edit real Word files. rotli saves them back as .docx, keeps the parts it does not touch, and makes a one-time backup first. The editor is built on Univer.',
  },
  {
    title: 'Sheets',
    status: `Mac app · ${DOCS_AND_SHEETS.status}`,
    body: 'Open and edit Excel workbooks (.xlsx). CSV files open and edit in place too.',
  },
  {
    title: 'Boards',
    status: 'Mac and web',
    body: 'Sketch on an Excalidraw canvas saved as an ordinary .excalidraw file, in the Mac app or Rotli Web. On the Mac, chat can draw one for you from a diagram.',
  },
];

---

<div class="formats" data-reveal>
  <figure class="frame board">
    <img
      src="/shots/board.webp"
      width="1500"
      height="470"
      alt="An Excalidraw board in rotli titled Launch map, with Capture, Note, and Library boxes joined by arrows"
      loading="lazy"
      decoding="async"
    />
  </figure>
  <ul class="format-list" data-stagger>
    {formats.map((format) => (
      <li>
        <div class="format-head">
          <h3 class="format-title">{format.title}</h3>
          <span class="status">{format.status}</span>
        </div>
        <p>{format.body}</p>
      </li>
    ))}
  </ul>
</div>

<p class="assets-note" data-reveal>
  <b>Assets stay in the folder.</b> A pasted or dropped image, and every document or board you or a chat
  makes, is saved under <code>storage/</code> in your vault, ready to embed in any note. Assets is where you
  browse them all.
</p>

<style>
  .frame {
    margin: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-frame);
    overflow: hidden;
    background: var(--capture-ground);
  }
  .frame img {
    width: 100%;
    height: auto;
  }
  .formats {
    display: grid;
    gap: clamp(2rem, 4vw, 2.75rem);
  }
  .format-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem clamp(1.5rem, 4vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .format-list li {
    padding-top: 1.1rem;
    border-top: 1px solid var(--border-strong);
  }
  .format-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .format-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0;
  }
  .status {
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--accent-text);
    border-radius: 999px;
    color: var(--accent-text);
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .format-list p {
    margin: 0.5rem 0 0;
    color: var(--text-muted);
    line-height: 1.55;
  }
  .assets-note {
    max-width: 46rem;
    margin: clamp(2rem, 4vw, 2.75rem) 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border-strong);
    color: var(--text-muted);
    line-height: 1.6;
  }
  .assets-note b {
    color: var(--text);
    font-weight: 600;
  }
  .assets-note code {
    padding: 0.1rem 0.4rem;
    border-radius: 0.4rem;
    background: var(--surface-2);
    color: var(--text);
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.86rem;
  }
  @media (max-width: 860px) {
    .format-list {
      grid-template-columns: 1fr;
    }
  }
</style>
