---
// Two kinds of notes: the way a person writes, and the way an AI finds things again. The
// comparison is plain HTML on the site's tokens (not a capture): the same file twice, as typed
// and as filed, set straight on the band with no card around either. The Librarian adds only
// its frontmatter fields (area, summary, tags, links; see docs/architecture/memex-data-contract.md)
// above the words, which stay byte for byte as written: the added lines carry a "+" and a tint,
// the body is marked unchanged. `area` is a flat top-level area, as the contract requires (only
// People/<group> may nest). Synthetic people and text. Two columns side by side; one after the
// other, in reading order, on narrow widths.
//
// It plays the filing once when it comes into view (the owner, 2026-10-05: "more motion and
// alive like it actually happens"; the timing is src/filingTimeline.ts): the note is typed, the
// same words appear on the right, the added lines arrive above them one by one like a live
// diff, and it rests with the words marked unchanged. Replay plays it again. The markup is the
// finished state, so without script or under reduced motion nothing moves. Both bodies keep
// their full text at every moment: the play hides characters, never removes them.
const typed = ['call w/ dana re pricing', '', 'she’s ok w/ annual. wants the', 'deck fri?? ask jo about the', 'discount thing'];
const filed = [
  { key: 'area', value: 'Clients' },
  { key: 'summary', value: 'Dana agrees to annual pricing and wants the deck on Friday.' },
  { key: 'tags', value: '[pricing, annual, deck]' },
  { key: 'links', value: '["[[Discount policy]]", "[[Jo Park]]"]' },
];
---

<section class="section band-warm two-kinds" id="two-kinds" aria-labelledby="two-kinds-title">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <h2 class="section-title" id="two-kinds-title">You write for yourself. <span class="inked">AI reads differently.</span></h2>
      <p class="section-lede">
        An AI finds a note again by its area, tags, and links. In rotli you just write, and the Librarian fills
        those in at the top of the file.
      </p>
    </header>

    <figure class="pair" data-filing>
      <div class="state" role="group" aria-labelledby="typed-label">
        <p class="state-label" id="typed-label">As you write it</p>
        <p class="file">dana-call.md</p>
        <pre class="lines"><code class="body" data-typed>{typed.join('\n')}</code></pre>
      </div>
      <div class="state filed" role="group" aria-labelledby="filed-label">
        <p class="state-label" id="filed-label">After the Librarian</p>
        <p class="file">dana-call.md</p>
        <div class="diff">
          <p class="note-mark added-mark">Added by the Librarian</p>
          <pre class="lines added"><code><span class="row fence">---</span>{
              filed.map((field) => (
                <span class="row"><b>{field.key}:</b> {field.value}</span>
              ))
            }<span class="row fence">---</span></code></pre>
          <div class="kept">
            <p class="note-mark kept-mark">
              <svg class="check" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3.5 8.5 3 3 6-7" /></svg>
              Your words, unchanged
            </p>
            <pre class="lines kept-lines"><code class="body">{typed.join('\n')}</code></pre>
          </div>
        </div>
      </div>
      <figcaption>
        <span>The Librarian adds the fields at the top. Everything under them is exactly what you typed.</span>
        <button type="button" class="replay" data-replay hidden>
          <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2.75 8a5.25 5.25 0 1 0 1.6-3.78M2.75 2.5v2.75H5.5" /></svg>
          Replay
        </button>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  import { filingFrame, timeline, wordsLift, type FilingFrame } from '../../filingTimeline';

  // One clock, one frame loop, only while the comparison is on screen and the tab is visible.
  const figure = document.querySelector<HTMLElement>('[data-filing]');
  const calm = matchMedia('(prefers-reduced-motion: reduce)');
  if (figure && !calm.matches) {
    const typedCode = figure.querySelector<HTMLElement>('[data-typed]')!;
    const text = typedCode.textContent ?? '';
    const addedMark = figure.querySelector<HTMLElement>('.added-mark')!;
    const rows = [...figure.querySelectorAll<HTMLElement>('.added .row')];
    const kept = figure.querySelector<HTMLElement>('.kept')!;
    const replay = figure.querySelector<HTMLButtonElement>('[data-replay]')!;
    const total = timeline(text.length, rows.length).total;

    // The typed body: what's typed, the caret, and the rest kept in place but unseen, so the
    // column never changes height and its text is always whole.
    const done = document.createElement('span');
    const caret = document.createElement('span');
    const rest = document.createElement('span');
    caret.className = 'caret';
    rest.className = 'rest';
    typedCode.replaceChildren(done, caret, rest);

    // How tall each added line is, with the first carrying the mark above it and the last the
    // gap below it: the words below are lifted by whatever hasn't opened yet.
    let heights: number[] = [];
    const measure = () => {
      kept.style.transform = '';
      const start = addedMark.getBoundingClientRect().top;
      const tops = rows.map((row) => row.getBoundingClientRect().top);
      const end = kept.getBoundingClientRect().top;
      heights = rows.map((_, k) => (k + 1 < rows.length ? tops[k + 1] : end) - (k === 0 ? start : tops[k]));
    };

    const paint = (frame: FilingFrame) => {
      done.textContent = text.slice(0, frame.typed);
      rest.textContent = text.slice(frame.typed);
      caret.hidden = !frame.caret;
      addedMark.style.opacity = String(frame.rows[0] ?? 1);
      rows.forEach((row, k) => {
        const open = frame.rows[k];
        row.style.opacity = String(open);
        row.style.clipPath = open >= 1 ? '' : `inset(0 0 ${((1 - open) * 100).toFixed(1)}% 0)`;
      });
      kept.style.opacity = String(frame.words);
      kept.style.transform = frame.done ? '' : `translateY(${(-wordsLift(frame.rows, heights)).toFixed(1)}px)`;
      kept.style.setProperty('--mark', String(frame.mark));
      figure.dataset.state = frame.done ? 'done' : 'playing';
    };

    let elapsed = 0;
    let last = 0;
    let raf = 0;
    let onScreen = false;
    let started = false;
    const loop = (now: number) => {
      elapsed += Math.min(100, now - last);
      last = now;
      paint(filingFrame(elapsed, text.length, rows.length));
      raf = elapsed < total ? requestAnimationFrame(loop) : 0;
    };
    const run = () => {
      if (raf || elapsed >= total || !onScreen || document.hidden) return;
      last = performance.now();
      raf = requestAnimationFrame(loop);
    };
    const hold = () => {
      cancelAnimationFrame(raf);
      raf = 0;
    };
    const play = () => {
      hold();
      measure();
      elapsed = 0;
      started = true;
      paint(filingFrame(0, text.length, rows.length));
      run();
    };

    // Before it plays, the comparison waits at its first frame.
    measure();
    paint(filingFrame(0, text.length, rows.length));
    figure.dataset.state = 'idle';

    new IntersectionObserver(
      ([entry]) => {
        onScreen = entry.isIntersecting;
        const arrived = entry.intersectionRatio >= 0.35 || entry.intersectionRect.height >= innerHeight * 0.5;
        if (!onScreen) hold();
        else if (!started && arrived) play();
        else if (started) run();
      },
      { threshold: [0, 0.35, 0.6] },
    ).observe(figure);
    document.addEventListener('visibilitychange', () => (document.hidden ? hold() : run()));
    // A new width reflows the lines: finish rather than lift the words by stale heights.
    window.addEventListener('resize', () => {
      if (!raf) return;
      hold();
      elapsed = total;
      paint(filingFrame(total, text.length, rows.length));
    });

    replay.hidden = false;
    replay.addEventListener('click', play);
  }
</script>

<style>
  .section-title {
    max-width: 22ch;
  }
  .section-lede {
    max-width: 40rem;
    font-size: 1.1rem;
    line-height: 1.65;
  }
  /* Two open columns on the band, split by one hairline: no card, no fill, no frame. Kept to a
     reading width, so the whole comparison sits in one window on a laptop. */
  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 0;
    max-width: 62rem;
    margin: 0;
  }
  .state {
    min-width: 0;
    padding-right: clamp(1.25rem, 3.5vw, 3rem);
  }
  .state.filed {
    padding-right: 0;
    padding-left: clamp(1.25rem, 3.5vw, 3rem);
    border-left: 1px solid var(--border-strong);
  }
  /* Data labels for the two states of one file, not section eyebrows. */
  .state-label {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }
  .file {
    margin: 0.3rem 0 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-strong);
    color: var(--text-muted);
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.8rem;
  }
  /* The file's own text: monospace because it is the literal file. */
  .lines {
    margin: 0;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.84rem;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .note-mark {
    margin: 0 0 0.3rem;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 600;
  }
  .added-mark {
    color: var(--accent-text);
  }
  /* What the Librarian added reads like added lines in a diff: each line on a tint with a "+"
     in its gutter, so the lines can arrive one at a time. The body below has neither. */
  .added {
    margin-inline: -0.6rem;
  }
  .added .row {
    position: relative;
    display: block;
    padding: 0 0.6rem 0 1.7rem;
    background: var(--tint);
  }
  .added .row:first-child {
    padding-top: 0.3rem;
    border-radius: 0.5rem 0.5rem 0 0;
  }
  .added .row:last-child {
    padding-bottom: 0.3rem;
    border-radius: 0 0 0.5rem 0.5rem;
  }
  .added .row::before {
    content: '+';
    position: absolute;
    left: 0.6rem;
    color: var(--accent-text);
    font-weight: 600;
  }
  .added b {
    color: var(--accent-text);
    font-weight: 600;
  }
  .fence {
    color: var(--text-muted);
  }
  /* Your words, unchanged: marked in ink, not a second fill. A tick and a rule beside the
     words come on as the play ends (--mark, 0 to 1; the markup's state is 1). */
  .kept {
    --mark: 1;
    margin-top: 1rem;
  }
  .kept-mark {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    color: color-mix(in srgb, var(--text) calc(var(--mark) * 100%), var(--muted-ink));
  }
  .check {
    flex: none;
    width: 0.85rem;
    height: 0.85rem;
    opacity: var(--mark);
    transform: scale(calc(0.6 + 0.4 * var(--mark)));
  }
  .kept-lines {
    position: relative;
    padding-left: 1.1rem;
  }
  .kept-lines::before {
    content: '';
    position: absolute;
    top: 0.2rem;
    bottom: 0.2rem;
    left: calc(0.425rem - 1px);
    width: 2px;
    border-radius: 1px;
    background: var(--text);
    transform: scaleY(var(--mark));
    transform-origin: top;
  }
  /* The typing caret on the left while the note is written; the untyped rest keeps its room. */
  /* The script makes these spans, so they carry no scope of their own. */
  .body :global(.caret) {
    display: inline-block;
    width: 0;
    height: 1.15em;
    margin-right: -2px;
    border-left: 2px solid var(--accent);
    vertical-align: text-bottom;
  }
  .body :global(.caret[hidden]) {
    display: none;
  }
  .body :global(.rest) {
    visibility: hidden;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    grid-column: 1 / -1;
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  /* Replay: quiet, a word and a turn arrow, but a full touch target. */
  .replay {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    margin-right: -0.6rem;
    padding: 0 0.6rem;
    border: 0;
    border-radius: 0.5rem;
    background: none;
    color: var(--text-muted);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .replay[hidden] {
    display: none;
  }
  .replay:hover {
    color: var(--text);
  }
  .replay:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 0;
  }
  .replay svg {
    width: 1rem;
    height: 1rem;
  }
  @media (max-width: 800px) {
    .pair {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .state,
    .state.filed {
      padding: 0;
      border-left: 0;
    }
  }
</style>
