---
// Two kinds of notes: the way a person writes, and the way an AI finds things again. The
// comparison is plain HTML on the site's tokens (not a capture): the same file twice, as typed
// and as filed, set straight on the band with no card around either. The Librarian adds only
// its frontmatter fields (area, summary, tags, links; see docs/architecture/memex-data-contract.md)
// above the words, which stay byte for byte as written: the added lines carry a "+" and a tint,
// the body is marked unchanged. `area` is a flat top-level area, as the contract requires (only
// People/<group> may nest). Synthetic people and text. Two columns side by side; one after the
// other, in reading order, on narrow widths.
const typed = ['call w/ dana re pricing', '', 'she’s ok w/ annual. wants the', 'deck fri?? ask jo about the', 'discount thing'];
const filed = [
  { key: 'area', value: 'Clients' },
  { key: 'summary', value: 'Dana agrees to annual pricing and wants the deck on Friday.' },
  { key: 'tags', value: '[pricing, annual, deck]' },
  { key: 'links', value: '["[[Discount policy]]", "[[Jo Park]]"]' },
];
---

<section class="section band-warm two-kinds" id="two-kinds" aria-labelledby="two-kinds-title">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <h2 class="section-title" id="two-kinds-title">You write for yourself. <span class="inked">AI reads differently.</span></h2>
      <p class="section-lede">
        You write fast and loose, in half sentences, and you know what you meant. An AI finds things again by
        title, tags, and links, and most apps leave you to add those. In rotli you just write. The Librarian
        files the note and fills in the frontmatter, the few fields at the top of the file. It never changes
        what you wrote, and no other AI does either unless you allow it for that note.
      </p>
    </header>

    <figure class="pair" data-reveal>
      <div class="state" role="group" aria-labelledby="typed-label">
        <p class="state-label" id="typed-label">As you write it</p>
        <p class="file">dana-call.md</p>
        <pre class="lines"><code class="body">{typed.join('\n')}</code></pre>
      </div>
      <div class="state filed" role="group" aria-labelledby="filed-label">
        <p class="state-label" id="filed-label">After the Librarian</p>
        <p class="file">dana-call.md</p>
        <p class="note-mark added-mark">Added by the Librarian</p>
        <pre class="lines added"><code><span class="row fence">---</span>{
            filed.map((field) => (
              <span class="row"><b>{field.key}:</b> {field.value}</span>
            ))
          }<span class="row fence">---</span></code></pre>
        <p class="note-mark">Your words, unchanged</p>
        <pre class="lines"><code class="body">{typed.join('\n')}</code></pre>
      </div>
      <figcaption>The Librarian adds the fields at the top. Everything under them is exactly what you typed.</figcaption>
    </figure>
  </div>
</section>

<style>
  .section-title {
    max-width: 22ch;
  }
  .section-lede {
    max-width: 40rem;
    font-size: 1.1rem;
    line-height: 1.65;
  }
  /* Two open columns on the band, split by one hairline: no card, no fill, no frame. */
  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 0;
    margin: 0;
  }
  .state {
    min-width: 0;
    padding-right: clamp(1.5rem, 4vw, 3.5rem);
  }
  .state.filed {
    padding-right: 0;
    padding-left: clamp(1.5rem, 4vw, 3.5rem);
    border-left: 1px solid var(--border-strong);
  }
  /* Data labels for the two states of one file, not section eyebrows. */
  .state-label {
    margin: 0;
    font-size: var(--step-h3);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .file {
    margin: 0.35rem 0 1.25rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--border-strong);
    color: var(--text-muted);
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.85rem;
  }
  /* The file's own text: monospace because it is the literal file. */
  .lines {
    margin: 0;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.92rem;
    line-height: 1.7;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .note-mark {
    margin: 0 0 0.35rem;
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .added-mark {
    color: var(--accent-text);
  }
  .lines + .note-mark {
    margin-top: 1.1rem;
  }
  /* What the Librarian added reads like added lines in a diff: a tint behind the rows
     and a "+" in the gutter. The body below them has neither. */
  .added {
    margin-inline: -0.6rem;
    padding: 0.35rem 0.6rem 0.35rem 1.7rem;
    border-radius: 0.5rem;
    background: var(--tint);
  }
  .added .row {
    position: relative;
    display: block;
  }
  .added .row::before {
    content: '+';
    position: absolute;
    left: -1.1rem;
    color: var(--accent-text);
    font-weight: 600;
  }
  .added b {
    color: var(--accent-text);
    font-weight: 600;
  }
  .fence {
    color: var(--text-muted);
  }
  figcaption {
    grid-column: 1 / -1;
    margin: 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  @media (max-width: 800px) {
    .pair {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
    .state,
    .state.filed {
      padding: 0;
      border-left: 0;
    }
  }
</style>
