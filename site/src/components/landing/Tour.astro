---
// A closer look: the deeper tour, driven by the scroll (the owner, 2026-10-05: "make this work
// with the scroll. I also don't like the cards in cards or the animations"). This overrides the
// earlier no-scroll-scrub preference for this one section, and it still never scrubs: it
// switches by step. On wide screens, with script, the list of parts and the preview are pinned
// under the header while a tall runway of per-part anchors scrolls behind them; the part whose
// anchor crosses the middle of the window is the one shown (the rules: src/tourSteps.ts). The
// preview changes by a calm crossfade, and under reduced motion it simply swaps. Each part's
// name is a real <button> in a heading that scrolls the page to that part's step; arrow keys,
// Home, and End move between the names. The page scrolls natively all the way through: nothing
// holds the wheel.
//
// Each part is one block in reading order (its name, one sentence, its preview), so on phones,
// on short windows, and without script the tour is a plain sequence with every preview under
// its words. Previews sit straight on the section ground with no frame around them: a real
// capture from public/shots/ (synthetic vaults; site/README.md says how each was made) on its
// own editor paper with one hairline, or a small drawing in the app's language where no
// capture is honest yet (Docs and Sheets; the Librarian's filing, in describeAppliedAction's
// words "Filed in" and "Tagged:"). The last part, Rotli Web and the Helper, replaces the
// ways-in chapter: its facts are held to docs/architecture/web-vault-connection.md and
// content/writing/posts/rotli-helper.md, and the command is the one Rotli Web's own setup
// screen gives. It renders only while WEB_APP_ENABLED, as that chapter did.
import { DOCS_AND_SHEETS, WEB_APP_PATH, site } from '../../site';

type Item = {
  id: string;
  title: string;
  status?: string;
  line: string;
  icon: string;
};

const items: Item[] = [
  {
    id: 'notes',
    title: 'Notes and Markdown',
    line: 'Tasks, tables, diagrams, and math render as you type, and Aa shows the plain Markdown underneath.',
    icon: 'M6 3.5h8l4 4V20.5H6zM14 3.5v4h4M9 12h6M9 15.5h6M9 9h2',
  },
  {
    id: 'docs',
    title: 'Docs and Sheets',
    status: DOCS_AND_SHEETS.status,
    line: 'Open and edit Word documents and Excel workbooks in the Mac app. They stay ordinary Word and Excel files.',
    icon: 'M4 4.5h16v15H4zM4 9.5h16M4 14.5h16M10 4.5v15',
  },
  {
    id: 'chat',
    title: 'Chat with your notes',
    line: 'Ask what shipped or what you decided last week, and get an answer from your own notes.',
    icon: 'M4.5 5.5h15v10h-8l-4.5 3.5v-3.5h-2.5z',
  },
  {
    id: 'boards',
    title: 'Boards',
    line: 'Sketch on an Excalidraw canvas, saved as an ordinary .excalidraw file, on the Mac or in Rotli Web.',
    icon: 'M3.5 6.5h7v6h-7zM15.5 13.5a3.5 3.5 0 1 0 0.01 0M10.5 9.5h3.5l2 2.5',
  },
  {
    id: 'librarian',
    title: 'The Librarian',
    line: 'Turn it on and new notes get tags, a summary, links, and a place in your Library, with your words left as they are.',
    icon: 'M3.5 6.5h6l2 2h9v11h-17zM9 14l2.2 2.2L15.5 12',
  },
  ...(site.webAppEnabled
    ? [
        {
          id: 'web',
          title: 'Rotli Web and the Helper',
          line: 'The same editor in your browser, while your notes stay in a folder on your computer.',
          icon: 'M12 3.5a8.5 8.5 0 1 0 0.01 0M3.5 12h17M12 3.5c-2.6 2.8-2.6 14.2 0 17M12 3.5c2.6 2.8 2.6 14.2 0 17',
        },
      ]
    : []),
];

const filings = [
  { note: 'Q4 launch plan', area: 'Projects', tags: 'launch, q4' },
  { note: 'Call with Maya', area: 'People', tags: 'maya, demo' },
  { note: 'Local-first reading list', area: 'Research', tags: 'reading' },
];
const sheet = [
  ['', 'A', 'B', 'C'],
  ['1', 'Item', 'Cost', 'Owner'],
  ['2', 'Demo video', '1,200', 'Maya'],
  ['3', 'Pricing page', '400', 'Jo'],
  ['4', 'Launch ads', '2,000', 'Dana'],
  ['5', 'Total', '3,600', ''],
];
// The chat capture's own answer (public/shots/chat.webp), drawn so it stays readable at the
// tour's size: the capture's text falls to about 10px there.
const answer = [
  { label: 'Shipped:', item: 'Mac beta' },
  { label: 'In progress:', item: 'Update pricing page' },
  { label: 'Still to do:', item: 'Record the demo (owner: Maya)' },
];
const command = 'curl -fsSL https://rotli.co/helper/install.sh | sh -s -- --open https://rotli.co/app/';
---


<section class="section band-warm tour" id="tour" aria-labelledby="tour-title">
  <div class="wrap">
    <header class="section-head">
      <h2 class="section-title" id="tour-title">A closer look.</h2>
      <p class="section-lede">Pick a part of the workspace to see what it does.</p>
    </header>

    <div class="tour-body" data-tour>
      <div class="tour-pin">
        {
          items.map((item, i) => (
            <div class:list={['tour-step', { 'is-active': i === 0 }]} id={`tour-step-${item.id}`} data-tour-step={item.id}>
              <h3 class="tour-name">
                <button type="button" id={`tour-button-${item.id}`} aria-controls={`tour-preview-${item.id}`}>
                  <svg class="tour-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d={item.icon} />
                  </svg>
                  <span class="tour-title">{item.title}</span>
                  {item.status && <span class="status">{item.status}</span>}
                </button>
              </h3>
              <div class="tour-line-wrap">
                <p class="tour-line">{item.line}</p>
              </div>
              <div class:list={['tour-preview', `preview-${item.id}`]} id={`tour-preview-${item.id}`}>
                {item.id === 'notes' && (
                  <img class="shot" src="/shots/render-note.webp" width="1512" height="1226" alt="A note called Launch week with tasks in three states, result buttons, a switch, a single choice, and a checklist panel" loading="lazy" decoding="async" />
                )}
                {item.id === 'chat' && (
                  <div class="mock chat" role="img" aria-label="A rotli chat answering “What did I already ship, and what’s next on my Q4 launch plan?” with shipped, in-progress, and still-to-do lists drawn from the notes">
                    <p class="mock-head">chats/q4-check-in.md</p>
                    <div class="chat-body">
                      <p class="ask">What did I already ship, and what’s next on my Q4 launch plan?</p>
                      {answer.map((part) => (
                        <div class="answer">
                          <p class="answer-h">{part.label}</p>
                          <p class="answer-item">{part.item}</p>
                        </div>
                      ))}
                      <p class="meta">11:41 AM</p>
                    </div>
                  </div>
                )}
                {item.id === 'boards' && (
                  <img class="shot" src="/shots/board.webp" width="1500" height="470" alt="An Excalidraw board in rotli titled Launch map, with Capture, Note, and Library boxes joined by arrows" loading="lazy" decoding="async" />
                )}
                {item.id === 'docs' && (
                  <div class="mock-pair" role="img" aria-label="A Word document called Launch brief beside an Excel workbook called Q4 budget, both open in rotli">
                    <div class="mock doc">
                      <p class="mock-head">launch-brief.docx</p>
                      <div class="doc-page">
                        <p class="doc-h">Launch brief</p>
                        <p>The Mac beta is out. Next is the demo video, then the pricing page.</p>
                        <p class="doc-h2">Who does what</p>
                        <p>Maya records the demo. Jo updates pricing.</p>
                      </div>
                    </div>
                    <div class="mock sheet">
                      <p class="mock-head">q4-budget.xlsx</p>
                      <p class="formula"><b>fx</b> =SUM(B2:B4)</p>
                      <table>
                        <tbody>
                          {sheet.map((row, r) => (
                            <tr class:list={{ total: r === sheet.length - 1 }}>
                              {row.map((cell, c) => (c === 0 || r === 0 ? <th>{cell}</th> : <td class:list={{ num: c === 2 && r > 1, picked: c === 2 && r === sheet.length - 1 }}>{cell}</td>))}
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                )}
                {item.id === 'librarian' && (
                  <div class="mock filing" role="img" aria-label="Three new notes, each filed by the Librarian into a Library area and tagged">
                    <p class="mock-head">Library</p>
                    <ol>
                      {filings.map((filing) => (
                        <li>
                          <span class="filing-note">{filing.note}</span>
                          <span class="filing-what">
                            <span class="pill">Filed in {filing.area}</span>
                            <span class="filing-tags">Tagged: {filing.tags}</span>
                          </span>
                        </li>
                      ))}
                    </ol>
                    <p class="mock-foot">Every note keeps its words exactly as you wrote them.</p>
                  </div>
                )}
                {item.id === 'web' && (
                  <div class="web">
                    <p>
                      Chrome, Edge, and Arc open the folder directly. Firefox, Zen, and Brave can’t, and no browser tab
                      can start the AI tools you already have, so Rotli Web talks to Rotli Helper on your own computer.
                      It serves the one folder you choose and answers only rotli.co. Safari and phones aren’t supported
                      yet. Run this once in Terminal:
                    </p>
                    <figure class="terminal">
                      <figcaption>
                        <b>Terminal</b>
                        <span>Mac and Linux</span>
                        <button type="button" class="copy" data-copy={command} hidden>Copy</button>
                      </figcaption>
                      <pre><code><span class="prompt" aria-hidden="true">$ </span>{command}</code></pre>
                    </figure>
                    <p class="more">On Windows, <a href="/blog/rotli-helper/">the Helper guide</a> has the PowerShell line.</p>
                    <p class="links">
                      <a href={WEB_APP_PATH}>Open Rotli Web <span aria-hidden="true">→</span></a>
                      <a href="/blog/rotli-web-and-your-mac/">Why it goes through Terminal <span aria-hidden="true">→</span></a>
                    </p>
                  </div>
                )}
              </div>
            </div>
          ))
        }
      </div>
      <div class="tour-runway" aria-hidden="true">
        {items.map((item) => <span class="tour-anchor" data-tour-anchor={item.id}></span>)}
      </div>
    </div>

    <p class="tour-more">
      <a class="button secondary" href="/features/">See every feature</a>
    </p>
  </div>
</section>

<script>
  import { INTENT_MS, LINE_SHARE, choose, createFollow, follow, settle, stepAt, stepScrollY } from '../../tourSteps';

  // Pinned only where the list and the preview both fit under the header; anywhere else (and
  // without script) the parts read as a plain sequence. The class is the one switch the styles
  // follow, so the script and the styles can't disagree, and a window resized across the line
  // switches live.
  const PINNED = '(min-width: 960px) and (min-height: 620px)';
  const tour = document.querySelector<HTMLElement>('[data-tour]');
  if (tour) {
    const steps = [...tour.querySelectorAll<HTMLElement>('[data-tour-step]')];
    const buttons = steps.map((step) => step.querySelector<HTMLButtonElement>('.tour-name button')!);
    const anchors = [...tour.querySelectorAll<HTMLElement>('[data-tour-anchor]')];
    const pinned = matchMedia(PINNED);
    const calm = matchMedia('(prefers-reduced-motion: reduce)');
    let state = createFollow();
    let intentTimer: number | undefined;

    const line = () => window.innerHeight * LINE_SHARE;
    const current = () => stepAt(anchors.map((a) => a.getBoundingClientRect()), line());
    const render = () => {
      const on = pinned.matches;
      tour.dataset.step = String(state.shown);
      steps.forEach((step, i) => step.classList.toggle('is-active', i === state.shown));
      buttons.forEach((button, i) => {
        if (on && i === state.shown) button.setAttribute('aria-current', 'true');
        else button.removeAttribute('aria-current');
      });
    };
    const update = (next: typeof state) => {
      if (next.shown === state.shown && next.intent === state.intent) return;
      state = next;
      render();
    };
    const release = () => {
      clearTimeout(intentTimer);
      if (state.intent !== null) update(settle(current()));
    };

    // The anchors only tell the page when the line crosses one; the rule above picks the part.
    const watch = new IntersectionObserver(() => update(follow(state, current())), {
      rootMargin: '-49% 0px -49% 0px',
    });
    window.addEventListener('scrollend', release);

    const apply = () => {
      tour.classList.toggle('is-pinned', pinned.matches);
      anchors.forEach((anchor) => (pinned.matches ? watch.observe(anchor) : watch.unobserve(anchor)));
      if (pinned.matches) state = settle(current());
      render();
    };
    pinned.addEventListener('change', apply);
    apply();

    // A name moves the page to its step: the pinned part's place on the runway, or, in the
    // plain sequence, the part itself.
    buttons.forEach((button, i) => {
      button.addEventListener('click', () => {
        const behavior: ScrollBehavior = calm.matches ? 'instant' : 'smooth';
        if (!pinned.matches) {
          steps[i].scrollIntoView({ behavior, block: 'start' });
          return;
        }
        const box = anchors[i].getBoundingClientRect();
        const top = stepScrollY({ top: box.top + window.scrollY, bottom: box.bottom + window.scrollY }, line());
        update(choose(i));
        clearTimeout(intentTimer);
        intentTimer = window.setTimeout(release, INTENT_MS);
        window.scrollTo({ top, behavior });
      });
      button.addEventListener('keydown', (event) => {
        const next =
          event.key === 'ArrowDown'
            ? buttons[(i + 1) % buttons.length]
            : event.key === 'ArrowUp'
              ? buttons[(i - 1 + buttons.length) % buttons.length]
              : event.key === 'Home'
                ? buttons[0]
                : event.key === 'End'
                  ? buttons[buttons.length - 1]
                  : null;
        if (!next) return;
        event.preventDefault();
        next.focus({ preventScroll: true });
      });
    });
  }

  // The Helper's install line: the Copy button stays hidden until script runs, so without it
  // the command is still plain, selectable text.
  document.querySelectorAll<HTMLButtonElement>('.tour button.copy[data-copy]').forEach((button) => {
    button.hidden = false;
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Press ⌘C';
        const code = button.closest('figure')?.querySelector('code');
        if (code) getSelection()?.selectAllChildren(code);
      }
      clearTimeout(timer);
      timer = window.setTimeout(() => (button.textContent = 'Copy'), 2000);
    });
  });
</script>

<style>
  /* The parts, as a plain sequence (phones, short windows, no script): each part's name, its
     sentence, and its preview under them, one after another. */
  .tour-pin {
    display: grid;
    gap: clamp(2.75rem, 7vw, 4rem);
  }
  .tour-name {
    margin: 0;
    font-size: inherit;
  }
  .tour-name button {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    width: 100%;
    min-height: 56px;
    padding: 0.5rem 0.25rem;
    border: 0;
    border-radius: 0.5rem;
    background: none;
    color: var(--text);
    font: inherit;
    font-size: var(--step-h3);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-align: left;
    cursor: pointer;
  }
  .tour-name button:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: -2px;
  }
  .tour-icon {
    flex: none;
    width: 40px;
    height: 40px;
    padding: 8px;
    border: 1px solid var(--border-strong);
    border-radius: 0.6rem;
  }
  .tour-title {
    min-width: 0;
  }
  .status {
    flex: none;
    padding: 0.05rem 0.5rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0;
  }
  .tour-line {
    max-width: 34rem;
    margin: 0;
    padding: 0.35rem 0.25rem 0 calc(40px + 1.15rem);
    color: var(--text-muted);
    line-height: 1.55;
  }

  /* The preview: the capture or drawing itself on the section ground. No frame around it. */
  .tour-preview {
    container-type: inline-size;
    display: flex;
    justify-content: center;
    margin-top: 1.5rem;
  }
  .shot {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--border-strong);
    border-radius: 0.7rem;
    background: var(--capture-ground);
  }

  /* Drawn previews share one panel language with the cards above: a surface and a hairline. */
  .mock {
    min-width: 0;
    border: 1px solid var(--border-strong);
    border-radius: 0.7rem;
    background: var(--surface);
    font-size: 0.88rem;
    line-height: 1.45;
  }
  .mock-head {
    margin: 0;
    padding: 0.6rem 0.9rem;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.78rem;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .filing .mock-head {
    color: var(--text);
    font-family: inherit;
    font-size: inherit;
    font-weight: 600;
  }
  .mock-pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 1rem;
    align-items: start;
    width: 100%;
    max-width: 44rem;
  }
  @container (max-width: 34rem) {
    .mock-pair {
      grid-template-columns: minmax(0, 1fr);
      max-width: 26rem;
    }
  }
  .doc {
    background: var(--capture-ground);
  }
  .doc-page {
    padding: 1rem 1.1rem 1.2rem;
  }
  .doc-page p {
    margin: 0 0 0.55rem;
  }
  .doc-h {
    font-size: 1.1rem;
    font-weight: 600;
  }
  .doc-page .doc-h2 {
    margin-top: 0.9rem;
    font-weight: 600;
  }
  .formula {
    margin: 0;
    padding: 0.4rem 0.9rem;
    border-bottom: 1px solid var(--border);
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.8rem;
  }
  .formula b {
    margin-right: 0.5rem;
    color: var(--text-muted);
    font-style: italic;
  }
  .sheet {
    overflow: hidden;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    background: var(--capture-ground);
    font-size: 0.82rem;
  }
  th,
  td {
    padding: 0.32rem 0.5rem;
    border: 1px solid var(--border);
    text-align: left;
    white-space: nowrap;
  }
  th {
    background: var(--surface-2);
    color: var(--text-muted);
    font-weight: 600;
    text-align: center;
  }
  tr:first-child th {
    border-top: 0;
  }
  tr > :first-child {
    border-left: 0;
  }
  tr > :last-child {
    border-right: 0;
  }
  tr:last-child > * {
    border-bottom: 0;
  }
  .num {
    text-align: right;
  }
  .total td {
    font-weight: 600;
  }
  /* The cell the formula bar is showing. */
  td.picked {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .filing {
    width: 100%;
    max-width: 30rem;
  }
  .filing ol {
    margin: 0;
    padding: 0 0.9rem;
    list-style: none;
  }
  .filing li {
    display: grid;
    gap: 0.35rem;
    padding: 0.8rem 0;
  }
  .filing li + li {
    border-top: 1px solid var(--border);
  }
  .filing-note {
    font-weight: 600;
  }
  .filing-what {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.75rem;
  }
  .pill {
    padding: 0.08rem 0.6rem;
    border-radius: 999px;
    background: var(--tint);
    color: var(--accent-text);
    font-size: 0.8rem;
    font-weight: 600;
  }
  .filing-tags {
    color: var(--text-muted);
    font-size: 0.82rem;
  }
  .mock-foot {
    margin: 0;
    padding: 0.6rem 0.9rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  /* Chat: a question and an answer that lists from the notes, on the editor's paper. */
  .chat {
    width: 100%;
    max-width: 34rem;
    background: var(--capture-ground);
  }
  .chat-body {
    display: grid;
    gap: 0.7rem;
    padding: 1rem 1.1rem 0.9rem;
  }
  .chat-body p {
    margin: 0;
  }
  .ask {
    justify-self: end;
    max-width: 85%;
    padding: 0.4rem 0.8rem;
    border-radius: 0.8rem;
    background: var(--tint);
  }
  .answer {
    display: grid;
    gap: 0.15rem;
  }
  .answer-h {
    font-weight: 600;
  }
  .answer-item {
    padding-left: 1rem;
    text-indent: -0.7rem;
  }
  .answer-item::before {
    content: '•';
    display: inline-block;
    width: 0.7rem;
    text-indent: 0;
  }
  .meta {
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  /* Rotli Web and the Helper: words, the install line, and where to go next. */
  .web {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    max-width: 38rem;
  }
  .web p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .web a {
    color: var(--accent-text);
    font-weight: 600;
    text-decoration: none;
  }
  .web a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .web .more {
    margin-top: 0.9rem;
  }
  .web .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin-top: 0.25rem;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 44px;
  }
  .terminal {
    margin: 1.1rem 0 0;
    overflow: hidden;
    border-radius: var(--radius-frame);
    background: var(--deep);
    color: var(--deep-text);
  }
  .terminal figcaption {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.35rem 0.5rem 0.35rem 1rem;
    border-bottom: 1px solid var(--deep-border);
    font-size: 0.86rem;
  }
  .terminal figcaption span {
    flex: 1;
    color: var(--deep-muted);
  }
  .copy {
    min-width: 5.5rem;
    min-height: 44px;
    padding: 0 0.9rem;
    border: 1px solid var(--deep-border);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--deep-text);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
