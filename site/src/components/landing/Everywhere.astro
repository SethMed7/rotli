---
// Ways in (the desktop app, on the Mac today, and Rotli Web), and how Rotli Web works: the page runs in the browser and the notes stay in a folder on
// the visitor's own computer. Chrome, Edge, and Arc open the folder themselves; Firefox, Zen, and
// Brave (and chat through the tools already installed) go through Rotli Helper, started with one
// line in Terminal, which serves that one folder on localhost to rotli.co only. Facts are held to
// docs/architecture/web-vault-connection.md and content/writing/resources/rotli-helper.md. The
// command is the one Rotli Web's own setup screen gives. Rendered only while WEB_APP_ENABLED is on.
import { DOWNLOAD_HREF, PLATFORMS, WEB_APP_PATH, site } from '../../site';

const ways = [
  {
    title: 'Desktop app',
    body: `The whole workspace: the editor, chat with on-device or connected AI, the Librarian, and ⌥Space from anywhere. On the Mac today; Windows and Linux apps are ${PLATFORMS.soon.toLowerCase()}.`,
    link: site.downloadsEnabled ? { href: DOWNLOAD_HREF, label: 'Download for Mac', external: true } : null,
  },
  {
    title: 'Rotli Web',
    body: 'The same editor, folders, tasks, and links in your browser. Your notes stay as files in a folder on your computer, never on a rotli server. Chrome, Edge, and Arc open the folder directly; Safari and phones aren’t supported yet.',
    link: { href: WEB_APP_PATH, label: 'Open Rotli Web', external: false },
  },
];
const command = 'curl -fsSL https://rotli.co/helper/install.sh | sh -s -- --open https://rotli.co/app/';
---

{
  site.webAppEnabled && (
    <section class="section everywhere" id="web" aria-labelledby="web-title">
      <div class="wrap">
        <header class="section-head">
          <h2 class="section-title" id="web-title">On your computer. In your browser.</h2>
          <p class="section-lede">
            Use the desktop app, or Rotli Web in your browser. Either way your notes stay in a folder on your
            computer. No account, and nothing for a rotli server to hold.
          </p>
        </header>
        <div class="web-grid">
          <ul class="ways" data-stagger>
            {ways.map((way) => (
              <li>
                <h3>{way.title}</h3>
                <p>{way.body}</p>
                {way.link && (
                  <a href={way.link.href} rel={way.link.external ? 'noopener' : undefined}>
                    {way.link.label} <span aria-hidden="true">→</span>
                  </a>
                )}
              </li>
            ))}
          </ul>
          <div class="helper" data-reveal>
            <h3>Rotli Helper connects the two.</h3>
            <p>
              Firefox, Zen, and Brave can’t open a folder, and no browser tab can start the AI tools you already
              have. So Rotli Web talks to a small Rotli Helper on your own computer (localhost). It serves the one
              folder you choose, answers only rotli.co, and starts itself when you log in. Run this once in
              Terminal:
            </p>
            <figure class="terminal">
              <figcaption>
                <b>Terminal</b>
                <span>Mac and Linux</span>
                <button type="button" class="copy" data-copy={command} hidden>Copy</button>
              </figcaption>
              <pre><code><span class="prompt" aria-hidden="true">$ </span>{command}</code></pre>
            </figure>
            <p class="more">On Windows, <a href="/resources/rotli-helper/">the Helper guide</a> has the PowerShell line.</p>
            <a class="why" href="/blog/rotli-web-and-your-mac/">
              Why Rotli Web talks to your computer through Terminal <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  // Copy buttons stay hidden until script runs, so without it the command is still plain, selectable text.
  document.querySelectorAll<HTMLButtonElement>('button.copy[data-copy]').forEach((button) => {
    button.hidden = false;
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Press ⌘C';
        const code = button.closest('figure')?.querySelector('code');
        if (code) getSelection()?.selectAllChildren(code);
      }
      clearTimeout(timer);
      timer = window.setTimeout(() => (button.textContent = 'Copy'), 2000);
    });
  });
</script>

<style>
  .web-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 2.5rem clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .ways {
    display: grid;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ways li,
  .helper {
    display: flex;
    flex-direction: column;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-strong);
  }
  h3 {
    margin: 0;
    font-size: var(--step-h3);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .ways p,
  .helper p {
    margin: 0.75rem 0 0;
    color: var(--text-muted);
    line-height: 1.62;
  }
  .ways p {
    margin-bottom: 0.75rem;
  }
  .ways a,
  .helper a {
    color: var(--accent-text);
    font-weight: 600;
    text-decoration: none;
  }
  .ways a {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.3rem;
    min-height: 44px;
  }
  .ways a:hover,
  .helper a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .terminal {
    margin: 1.25rem 0 0;
    overflow: hidden;
    border-radius: var(--radius-frame);
    background: var(--deep);
    color: var(--deep-text);
  }
  .terminal figcaption {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.35rem 0.5rem 0.35rem 1rem;
    border-bottom: 1px solid var(--deep-border);
    font-size: 0.86rem;
  }
  .terminal figcaption span {
    flex: 1;
    color: var(--deep-muted);
  }
  .copy {
    min-width: 5.5rem;
    min-height: 44px;
    padding: 0 0.9rem;
    border: 1px solid var(--deep-border);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--deep-text);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .copy:hover {
    border-color: var(--deep-muted);
  }
  .copy:focus-visible {
    outline: 2px solid var(--tint);
    outline-offset: 2px;
  }
  .terminal pre {
    margin: 0;
    padding: 0.9rem 1rem 1rem;
    overflow-x: auto;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.86rem;
    line-height: 1.7;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .prompt {
    color: var(--tint);
    user-select: none;
  }
  .helper .more {
    margin-top: 1rem;
  }
  .why {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.3rem;
    min-height: 44px;
    margin-top: 0.25rem;
  }
  @media (max-width: 900px) {
    .web-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
