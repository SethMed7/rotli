---
// Connecting AI: rotli runs each provider's own published command-line tool,
// which the visitor installs and signs in to in Terminal. rotli never signs in
// for them, reads the tool's login files, or stores its credentials
// (PRIVACY.md; src-tauri provider lane; src/ai/connectorGuides.ts for the
// exact commands). Rotli Web reaches the same tools through Rotli Helper,
// which runs them on the visitor's own computer. On-device models run on the
// Mac with no network.
import { site } from '../../site';

const tools = [
  {
    name: 'Claude Code',
    by: 'Anthropic',
    lines: ['npm install -g @anthropic-ai/claude-code', 'claude auth login'],
  },
  {
    name: 'Codex',
    by: 'OpenAI',
    lines: ['brew install codex', 'codex login'],
  },
  {
    name: 'Cursor',
    by: 'Cursor, for code questions',
    lines: ['curl https://cursor.com/install -fsS | bash', 'agent login'],
  },
];
---

<div class="connect" data-reveal>
  <div class="connect-copy">
    <h3>Bring the AI you already pay for.</h3>
    <p>
      Install your AI tool in Terminal and sign in, exactly as its maker describes. rotli then talks to that
      tool directly on your Mac, the same way you would from Terminal.
    </p>
    <ul class="promises" data-stagger>
      <li>rotli never signs in for you, never reads the tool’s login files, and never stores its credentials.</li>
      <li>It uses each company’s own published tool, so your plan is used the way that company intends. No workaround, no shared account.</li>
      <li>Prefer nothing leaving your Mac? Choose an on-device model instead; it works without a network.</li>
    </ul>
  </div>
  <div class="terminals">
    {tools.map((tool) => (
      <figure class="terminal">
        <figcaption>
          <b>{tool.name}</b>
          <span>{tool.by}</span>
        </figcaption>
        <pre><code>{tool.lines.map((line) => (
          <span class="line"><span class="prompt" aria-hidden="true">$ </span>{line}</span>
        ))}</code></pre>
      </figure>
    ))}
  </div>
</div>

{
  site.webAppEnabled && (
    <div class="helper" data-reveal>
      <div>
        <h4>In the browser, Rotli Helper does the connecting.</h4>
        <p>
          Rotli Web cannot start programs, so Rotli Helper, a small app you install on your own computer, runs
          the same tools for it. It listens only on your computer and refuses secure notes before anything runs.
        </p>
      </div>
      <figure class="terminal">
        <figcaption>
          <b>Rotli Helper</b>
          <span>Mac and Linux</span>
        </figcaption>
        <pre><code><span class="line"><span class="prompt" aria-hidden="true">$ </span>curl -fsSL https://rotli.co/helper/install.sh | sh</span></code></pre>
      </figure>
    </div>
  )
}

<style>
  .connect {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 2rem clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  h3 {
    margin: 0;
    font-size: var(--step-h3);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .connect-copy > p {
    max-width: 30rem;
    margin: 0.8rem 0 0;
    color: var(--text-muted);
    line-height: 1.62;
  }
  .promises {
    display: grid;
    gap: 0;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .promises li {
    position: relative;
    padding: 0.8rem 0 0.8rem 1.6rem;
    border-top: 1px solid var(--border-strong);
    line-height: 1.55;
  }
  .promises li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 1.25rem;
    width: 0.55rem;
    height: 0.3rem;
    border-left: 2px solid var(--accent-text);
    border-bottom: 2px solid var(--accent-text);
    transform: rotate(-45deg);
  }
  .terminals {
    display: grid;
    gap: 1rem;
  }
  .terminal {
    margin: 0;
    border-radius: var(--radius-frame);
    overflow: hidden;
    background: var(--deep);
    color: var(--deep-text);
  }
  .terminal figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--deep-border);
    font-size: 0.86rem;
  }
  .terminal figcaption span {
    color: var(--deep-muted);
  }
  .terminal pre {
    margin: 0;
    padding: 0.9rem 1rem 1rem;
    overflow-x: auto;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.86rem;
    line-height: 1.7;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .line {
    display: block;
  }
  .prompt {
    color: var(--tint);
    user-select: none;
  }
  .helper {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 1.5rem clamp(2rem, 6vw, 5rem);
    align-items: center;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: clamp(2rem, 4vw, 2.5rem);
    border-top: 1px solid var(--border-strong);
  }
  h4 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
  }
  .helper p {
    max-width: 30rem;
    margin: 0.5rem 0 0;
    color: var(--text-muted);
    line-height: 1.55;
  }
  @media (max-width: 860px) {
    .connect,
    .helper {
      grid-template-columns: 1fr;
    }
  }
</style>
