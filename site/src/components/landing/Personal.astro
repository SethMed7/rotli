---
// Make it yours: the theme studio (fourteen real captures from public/themes/). Once it is
// on screen it steps through them on its own at a calm pace, and it follows the visitor: a
// hovered or focused swatch shows at once and holds the cycle, a click pins it (the owner,
// 2026-10-05; the rules are src/themeCycle.ts). It never plays under reduced motion, off
// screen, or in a hidden tab, so a background tab does no work.
// Behind it, faintly, the story film's island by day (IslandScene.astro).
import IslandScene from '../IslandScene.astro';

// Swatch colours read the site swatch layer (Base.astro), which mirrors the
// app's per-environment ground and accent tokens. They are CSS rules keyed by
// data-swatch, never inline styles: production's CSP is `style-src 'self'`.
const families = [
  { id: 'rotli', name: 'Rotli', light: ['Warm Light', 'rotli-warm-light'], dark: ['Warm Dark', 'rotli-warm-dark'] },
  { id: 'paper', name: 'Paper & Charcoal', light: ['Paper', 'paper'], dark: ['Charcoal', 'charcoal'] },
  { id: 'ocean', name: 'Ocean', light: ['Ocean Light', 'ocean-light'], dark: ['Ocean Dark', 'ocean-dark'] },
  { id: 'grove', name: 'Grove', light: ['Grove Light', 'grove-light'], dark: ['Grove Dark', 'grove-dark'] },
  { id: 'iris', name: 'Iris', light: ['Iris Light', 'iris-light'], dark: ['Iris Dark', 'iris-dark'] },
  { id: 'blossom', name: 'Blossom', light: ['Blossom Light', 'blossom-light'], dark: ['Blossom Dark', 'blossom-dark'] },
  { id: 'midnight', name: 'Midnight', light: ['Midnight Light', 'midnight-light'], dark: ['Midnight', 'midnight'] },
] as const;

const stops = families.flatMap((family) =>
  (['light', 'dark'] as const).map((mode) => ({
    id: `${family.id}-${mode}`,
    family: family.name,
    environment: family[mode][0],
    screenshot: `/themes/${family[mode][1]}@2x.webp`,
  })),
);
const first = stops[0];
---

<section class="section band-warm personal" id="personal" aria-labelledby="personal-title">
  <div class="backdrop">
    <IslandScene faint />
  </div>
  <div class="wrap personal-inner">
    <header class="section-head">
      <h2 class="section-title" id="personal-title">Make it yours.</h2>
      <p class="section-lede">
        Seven theme families, each with a tuned light and dark environment. The calm grammar around
        your notes stays the same in every one.
      </p>
    </header>

    <div class="studio" data-reveal>
      <figure class="studio-shot">
        <img
          id="theme-shot"
          draggable="false"
          src={first.screenshot}
          width="2376"
          height="1485"
          alt={`The rotli workspace in the ${first.environment} environment`}
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          <span id="theme-family">{first.family}</span>
          <b id="theme-environment">{first.environment}</b>
        </figcaption>
      </figure>
      <!-- Narrow screens: the same fourteen environments as a carousel. -->
      <div class="studio-steps">
        <button type="button" class="carousel-step" data-theme-step="-1" aria-label="Previous theme">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m15 5-7 7 7 7" /></svg>
        </button>
        <p class="carousel-label" aria-live="off">
          <span class="carousel-count" id="theme-count">1 / {stops.length}</span>
          <span class="carousel-name" id="theme-name">{first.family} · {first.environment}</span>
        </p>
        <button type="button" class="carousel-step" data-theme-step="1" aria-label="Next theme">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m9 5 7 7-7 7" /></svg>
        </button>
      </div>
      <div class="studio-picker" role="group" aria-label="Preview a theme environment">
        <span class="picker-head">Light</span>
        <span class="picker-head">Dark</span>
        {families.map((family) => (
          <>
            {(['light', 'dark'] as const).map((mode) => {
              const stop = stops.find((candidate) => candidate.id === `${family.id}-${mode}`)!;
              return (
                <button
                  type="button"
                  class="swatch-button"
                  data-stop={stop.id}
                  data-shot={stop.screenshot}
                  data-family={stop.family}
                  data-environment={stop.environment}
                  aria-pressed={stop.id === first.id ? 'true' : 'false'}
                  aria-label={stop.environment}
                  title={stop.environment}
                >
                  <span class="swatch" data-swatch={stop.id} aria-hidden="true"></span>
                </button>
              );
            })}
            <span class="picker-name">{family.id === 'paper' ? 'Paper' : family.name}</span>
          </>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Theme studio: it plays on its own (src/themeCycle.ts), a swatch (wide screens) or the
  // carousel (narrow screens, with a swipe on the capture) takes over, and the capture and
  // caption follow. Steps it takes on its own are not announced; the visitor's are.
  import { createCycle, hover, leave, pin, resume, tick, wait, type Cycle } from '../../themeCycle';

  const studio = document.querySelector<HTMLElement>('.studio');
  const picker = document.querySelector<HTMLElement>('.studio-picker');
  const shot = document.querySelector<HTMLImageElement>('#theme-shot');
  const family = document.querySelector<HTMLElement>('#theme-family');
  const environment = document.querySelector<HTMLElement>('#theme-environment');
  const themeCount = document.querySelector<HTMLElement>('#theme-count');
  const themeName = document.querySelector<HTMLElement>('#theme-name');
  const label = document.querySelector<HTMLElement>('.carousel-label');
  const swatches = [...document.querySelectorAll<HTMLButtonElement>('.swatch-button')];
  const warmed = new Map<string, Promise<void>>();
  const warm = (index: number): Promise<void> => {
    const url = swatches[index]?.dataset.shot;
    if (!url) return Promise.resolve();
    let ready = warmed.get(url);
    if (!ready) {
      const image = new Image();
      image.src = url;
      ready = image.decode().catch(() => undefined);
      warmed.set(url, ready);
    }
    return ready;
  };
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  let cycle: Cycle = createCycle(swatches.length, performance.now(), false);
  let shown = 0;

  const render = (announce: boolean) => {
    const index = cycle.shown;
    const button = swatches[index];
    if (!button || index === shown) return;
    shown = index;
    label?.setAttribute('aria-live', announce ? 'polite' : 'off');
    if (shot && button.dataset.shot) {
      shot.src = button.dataset.shot;
      shot.alt = `The rotli workspace in the ${button.dataset.environment} environment`;
    }
    if (family) family.textContent = button.dataset.family ?? '';
    if (environment) environment.textContent = button.dataset.environment ?? '';
    if (themeCount) themeCount.textContent = `${index + 1} / ${swatches.length}`;
    if (themeName) themeName.textContent = `${button.dataset.family} · ${button.dataset.environment}`;
    swatches.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
    if (studio) studio.dataset.cycle = cycle.mode;
    void warm((index + 1) % swatches.length); // the next one is ready before it is asked for
  };
  const set = (next: Cycle, announce: boolean) => {
    cycle = next;
    if (studio) studio.dataset.cycle = cycle.mode;
    render(announce);
    schedule();
  };

  // One timeout, and only while the studio is on screen in a visible tab.
  let timer = 0;
  let onScreen = false;
  const running = () => onScreen && !document.hidden;
  function schedule() {
    window.clearTimeout(timer);
    timer = 0;
    if (!running()) return;
    const due = wait(cycle, performance.now());
    if (due === null) return;
    timer = window.setTimeout(async () => {
      timer = 0;
      const next = tick(cycle, performance.now());
      if (next === cycle) return schedule();
      await warm(next.shown); // never swap to a capture that is not there yet
      if (cycle.mode === 'auto') set(next, false);
      else schedule();
    }, due);
  }
  let revealed = false;
  if (studio && 'IntersectionObserver' in window) {
    new IntersectionObserver(
      (entries) => {
        onScreen = entries.some((entry) => entry.isIntersecting);
        if (onScreen && !revealed) {
          revealed = true;
          // It starts playing the first time it is seen, unless the visitor already chose.
          if (cycle.mode !== 'pinned') {
            cycle = { ...createCycle(swatches.length, performance.now(), !reduced.matches), shown: cycle.shown };
          }
          studio.dataset.cycle = cycle.mode;
        } else if (onScreen) {
          cycle = resume(cycle, performance.now());
        }
        schedule();
      },
      { threshold: 0.35 },
    ).observe(studio);
  }
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) cycle = resume(cycle, performance.now());
    schedule();
  });
  reduced.addEventListener('change', () => {
    if (reduced.matches && (cycle.mode === 'auto' || cycle.mode === 'held')) set({ ...cycle, mode: 'off' }, false);
  });

  swatches.forEach((button, index) => {
    button.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse' || event.pointerType === 'pen') set(hover(cycle, index), false);
    });
    button.addEventListener('focus', () => set(hover(cycle, index), true));
    button.addEventListener('click', () => set(pin(cycle, index), true));
  });
  picker?.addEventListener('pointerleave', () => set(leave(cycle, performance.now()), false));
  picker?.addEventListener('focusout', (event) => {
    if (!picker.contains(event.relatedTarget as Node | null)) set(leave(cycle, performance.now()), false);
  });
  document.querySelectorAll<HTMLButtonElement>('[data-theme-step]').forEach((button) => {
    button.addEventListener('click', () => set(pin(cycle, cycle.shown + Number(button.dataset.themeStep)), true));
  });
  let swipeFrom: number | null = null;
  shot?.addEventListener('pointerdown', (event) => (swipeFrom = event.clientX));
  shot?.addEventListener('pointerup', (event) => {
    if (swipeFrom === null) return;
    const dx = event.clientX - swipeFrom;
    swipeFrom = null;
    if (Math.abs(dx) > 40 && matchMedia('(max-width: 900px)').matches) set(pin(cycle, cycle.shown + (dx < 0 ? 1 : -1)), true);
  });
</script>

<style>
  /* The island sits behind the heading and the top of the theme studio. */
  .personal {
    position: relative;
    overflow: hidden;
  }
  .backdrop {
    position: absolute;
    top: clamp(1.5rem, 3vw, 2.5rem);
    right: 0;
    width: min(42vw, 600px);
    aspect-ratio: 610 / 244;
    pointer-events: none;
    mask-image: linear-gradient(to right, transparent, #000 30%);
  }
  .backdrop :global(.island) {
    height: 100%;
  }
  /* Below 1180px the backdrop's left edge reaches into the lede's line length (measured
     2026-10-05: at 768 and 1024 the lede ran over the hill), so the island steps out. */
  @media (max-width: 1179px) {
    .backdrop {
      display: none;
    }
  }
  .personal-inner {
    position: relative;
  }
  .studio {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) auto;
    gap: 2rem clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .studio-shot {
    margin: 0;
    min-width: 0;
  }
  .studio-shot img {
    width: 100%;
    height: auto;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-frame);
  }
  .studio-shot figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.9rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .studio-shot figcaption b {
    color: var(--text);
    font-weight: 600;
  }
  /* The orb picker: Light and Dark per family, the family name beneath.
     The orbs are the one place the site keeps a lit, rounded swatch (a
     deliberate exception to the flat rule, the owner's call, because they
     read as the themes themselves). */
  .studio-picker {
    display: grid;
    grid-template-columns: repeat(2, 2.75rem);
    column-gap: 0.9rem;
    row-gap: 0.3rem;
    justify-items: center;
    align-items: center;
  }
  .picker-head {
    margin-bottom: 0.35rem;
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .picker-name {
    grid-column: 1 / -1;
    margin-bottom: 0.7rem;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 600;
  }
  .picker-name:last-child {
    margin-bottom: 0;
  }
  .swatch-button {
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }
  .swatch-button:focus-visible {
    outline-offset: 2px;
  }
  .swatch {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--border-strong) 60%, transparent);
    background:
      radial-gradient(circle at 32% 28%, color-mix(in srgb, white 45%, var(--swatch-ground)) 0%, transparent 46%),
      radial-gradient(circle at 70% 74%, var(--swatch-accent) 0%, color-mix(in srgb, var(--swatch-accent) 55%, transparent) 30%, transparent 62%),
      var(--swatch-ground);
    box-shadow: inset 0 -6px 10px color-mix(in srgb, var(--deep) 14%, transparent);
  }
  .swatch-button[aria-pressed='true'] .swatch {
    outline: 2px solid var(--accent-text);
    outline-offset: 3px;
  }
  .swatch[data-swatch='rotli-light'] { --swatch-ground: var(--swatch-rotli-light); --swatch-accent: var(--swatch-rotli-light-accent); }
  .swatch[data-swatch='rotli-dark'] { --swatch-ground: var(--swatch-rotli-dark); --swatch-accent: var(--swatch-rotli-dark-accent); }
  .swatch[data-swatch='paper-light'] { --swatch-ground: var(--swatch-paper-light); --swatch-accent: var(--swatch-paper-light-accent); }
  .swatch[data-swatch='paper-dark'] { --swatch-ground: var(--swatch-paper-dark); --swatch-accent: var(--swatch-paper-dark-accent); }
  .swatch[data-swatch='ocean-light'] { --swatch-ground: var(--swatch-ocean-light); --swatch-accent: var(--swatch-ocean-light-accent); }
  .swatch[data-swatch='ocean-dark'] { --swatch-ground: var(--swatch-ocean-dark); --swatch-accent: var(--swatch-ocean-dark-accent); }
  .swatch[data-swatch='grove-light'] { --swatch-ground: var(--swatch-grove-light); --swatch-accent: var(--swatch-grove-light-accent); }
  .swatch[data-swatch='grove-dark'] { --swatch-ground: var(--swatch-grove-dark); --swatch-accent: var(--swatch-grove-dark-accent); }
  .swatch[data-swatch='iris-light'] { --swatch-ground: var(--swatch-iris-light); --swatch-accent: var(--swatch-iris-light-accent); }
  .swatch[data-swatch='iris-dark'] { --swatch-ground: var(--swatch-iris-dark); --swatch-accent: var(--swatch-iris-dark-accent); }
  .swatch[data-swatch='blossom-light'] { --swatch-ground: var(--swatch-blossom-light); --swatch-accent: var(--swatch-blossom-light-accent); }
  .swatch[data-swatch='blossom-dark'] { --swatch-ground: var(--swatch-blossom-dark); --swatch-accent: var(--swatch-blossom-dark-accent); }
  .swatch[data-swatch='midnight-light'] { --swatch-ground: var(--swatch-midnight-light); --swatch-accent: var(--swatch-midnight-light-accent); }
  .swatch[data-swatch='midnight-dark'] { --swatch-ground: var(--swatch-midnight-dark); --swatch-accent: var(--swatch-midnight-dark-accent); }

  .carousel-step {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }
  .carousel-step:hover {
    background: var(--ground);
  }
  .carousel-step svg {
    width: 20px;
    height: 20px;
  }
  .carousel-label {
    display: grid;
    margin: 0;
    text-align: center;
  }
  .carousel-count {
    color: var(--text-muted);
    font-size: 0.8rem;
  }
  .carousel-name {
    font-size: 0.95rem;
    font-weight: 600;
  }
  /* The theme carousel shows only where the orb picker would crowd the capture. */
  .studio-steps {
    display: none;
  }
  @media (max-width: 900px) {
    .studio {
      grid-template-columns: 1fr;
    }
    .studio {
      gap: 0;
    }
    .studio-picker,
    .studio-shot figcaption {
      display: none;
    }
    /* Previous, the theme's name, next: one row (the #156 review: without the columns
       they stacked into three rows at phone widths). */
    .studio-steps {
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr) 44px;
      align-items: center;
      gap: 0.75rem;
      max-width: 24rem;
      margin: 1rem auto 0;
    }
    .studio-shot img {
      touch-action: pan-y;
    }
  }
</style>
