---
// The landing page's privacy band: the promise in brief, pointing to the full
// policy at /privacy/. The quokka is the canonical line art (stays_local.svg,
// drawn in currentColor) in the band's light ink, standing in the bottom-right
// corner.
import staysLocal from '../../../../src/assets/characters/stays_local.svg?raw';

const facts = [
  { title: 'No account, no tracking', body: 'Nothing to sign up for. No analytics, ads, or crash uploads.' },
  { title: 'Files on your computer', body: 'Your notes are plain Markdown in a folder you choose.' },
  { title: 'AI only on your terms', body: 'rotli runs the AI tools you install yourself, never holding your keys. Secure notes never reach a remote model; locked notes can’t be edited by any.' },
];
---

<section class="section band-deep privacy" id="privacy" aria-labelledby="privacy-title">
  <div class="wrap privacy-inner" data-reveal>
    <h2 class="section-title" id="privacy-title">AI is invited in. It does not own the house.</h2>
    <p class="section-lede">
      rotli is built so there is nothing about you to collect, and AI only sees what you let it see.
    </p>
    <ul class="facts">
      {facts.map((fact) => (
        <li>
          <h3>{fact.title}</h3>
          <p>{fact.body}</p>
        </li>
      ))}
    </ul>
    <a class="button privacy-link" href="/privacy/">How privacy works in rotli</a>
  </div>
  <span class="quokka" set:html={staysLocal} aria-hidden="true"></span>
</section>

<style>
  .privacy {
    position: relative;
    overflow: hidden;
  }
  .privacy-inner {
    padding-bottom: 2rem;
  }
  .section-title {
    max-width: 18ch;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem clamp(1.5rem, 4vw, 3rem);
    max-width: 58rem;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .facts li {
    padding-top: 1.1rem;
    border-top: 1px solid var(--deep-border);
  }
  .facts h3 {
    margin: 0;
    font-size: 1.08rem;
    font-weight: 600;
  }
  .facts p {
    margin: 0.4rem 0 0;
    color: var(--deep-muted);
    line-height: 1.55;
  }
  .privacy-link {
    margin-top: clamp(2.5rem, 5vw, 3.25rem);
    border: 1px solid var(--deep-text);
    background: var(--deep-text);
    color: var(--deep);
  }
  .privacy-link:hover {
    border-color: var(--tint);
    background: var(--tint);
  }
  .privacy-link:focus-visible {
    outline-color: var(--tint);
  }
  /* Line art only, in the band's light ink; its feet rest on the bottom edge. */
  .quokka {
    position: absolute;
    right: max(var(--gutter), calc((100% - var(--page-max)) / 2));
    bottom: -0.25rem;
    width: clamp(120px, 13vw, 190px);
    color: var(--deep-text);
    line-height: 0;
  }
  .quokka :global(svg) {
    width: 100%;
    height: auto;
  }
  @media (max-width: 1100px) {
    .privacy-inner {
      padding-bottom: 9rem;
    }
  }
  @media (max-width: 860px) {
    .facts {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
