---
// The landing page's privacy band, staged like the story film's "secure stays home" shot: a
// night sky (Ocean Dark: the .band-night tokens in Base.astro), and on the right the dome of
// "on this Mac" with the quokka inside, a locked secure note beside it and the little on-device
// model that may read it. Two remote-AI clouds drift in, bump the dome, and back off. The scene
// plays once when the band comes into view; reduced motion shows it at rest. The promise and the
// link to it (/privacy/#promise, at the top of the full policy; the hero points there too) are
// the page text on the left. While the band is the focal passage, the whole page steps into its
// Ocean Dark too (data-passage, src/passage.ts) and back out on leaving.
import SecureScene from '../SecureScene.astro';

const facts = [
  { title: 'No tracking', body: 'No analytics, ads, or crash uploads.' },
  { title: 'Files on your computer', body: 'Your notes are plain Markdown in a folder you choose.' },
  {
    title: 'AI only on your terms',
    body: 'rotli runs the AI tools you install yourself and never holds your keys. Secure notes stay with the model on your Mac, and locked notes are never edited by AI.',
  },
];
---

<section class="section band-deep band-night privacy" id="privacy" aria-labelledby="privacy-title" data-passage="ocean-dark" data-passage-color="#0e171d">
  <svg class="moon" viewBox="0 0 80 80" aria-hidden="true">
    <circle class="moon-disc" cx="40" cy="40" r="36" />
    <circle class="moon-bite" cx="57" cy="27" r="32" />
  </svg>
  <div class="wrap privacy-grid">
    <div class="privacy-copy" data-reveal>
      <h2 class="section-title" id="privacy-title">Some notes <span class="inked">never leave this Mac.</span></h2>
      <p class="section-lede">
        Mark a note secure and only the model on your Mac can read it. Lock it and no AI can change
        it. There’s no account, and nothing about you to collect.
      </p>
      <ul class="facts" data-stagger>
        {facts.map((fact) => (
          <li>
            <h3>{fact.title}</h3>
            <p>{fact.body}</p>
          </li>
        ))}
      </ul>
      <a class="button privacy-link" href="/privacy/#promise">Read our privacy promise</a>
    </div>

    <SecureScene />
  </div>
</section>

<style>
  /* Night: Ocean Dark with a faint field of stars (both from .band-night). */
  .privacy {
    position: relative;
    padding-bottom: 0;
  }
  .privacy-grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: end;
  }
  .privacy-copy {
    padding-bottom: var(--section-space);
  }
  .section-title {
    max-width: 20ch;
  }
  .facts {
    display: grid;
    gap: 1.1rem;
    max-width: 34rem;
    margin: clamp(2rem, 4vw, 2.75rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .facts li {
    padding-top: 1rem;
    border-top: 1px solid var(--deep-border);
  }
  .facts h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
  }
  .facts p {
    margin: 0.35rem 0 0;
    color: var(--deep-muted);
    line-height: 1.55;
  }
  .privacy-link {
    margin-top: clamp(2rem, 4vw, 2.75rem);
    border: 1px solid var(--deep-text);
    background: var(--deep-text);
    color: var(--deep);
  }
  .privacy-link:hover {
    border-color: var(--accent);
    background: var(--accent);
  }
  .privacy-link:focus-visible {
    outline-color: var(--accent);
  }

  /* A crescent moon high over the scene, on wide screens where there is sky for it. */
  .moon {
    position: absolute;
    top: clamp(3rem, 8vw, 6rem);
    right: max(var(--gutter), calc((100% - var(--page-max)) / 2 + 3rem));
    width: clamp(56px, 5vw, 76px);
    height: auto;
  }
  .moon-disc {
    fill: var(--deep-text);
  }
  .moon-bite {
    fill: var(--deep);
  }
  @media (min-width: 1000px) {
    .privacy-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    }
  }
  @media (min-width: 1000px) {
    /* The scene runs a little wider than its column, toward the band's edge. */
    .privacy-grid :global(.scene) {
      margin-right: calc(-1 * min(var(--gutter), 3rem));
    }
  }
  @media (max-width: 999px) {
    .moon {
      display: none;
    }
    .privacy-copy {
      padding-bottom: 0;
    }
    .privacy-grid :global(.scene) {
      max-width: 36rem;
      margin-inline: auto;
      width: 100%;
    }
  }
</style>
