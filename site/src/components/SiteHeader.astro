---
// The one site header: brand, the site's pages (src/nav.ts), the GitHub mark
// while the source is public, and one Download button that opens /download/,
// which picks the right download for the visitor's system. It stays pinned to
// the top on a solid ground (flat: no blur, no shadow). Below 1080px the
// sections fold into a Menu disclosure. Styles live in Base.astro.
import mark from '../../../src/assets/characters/_logo.svg?raw';
import { primaryNav, type NavSection } from '../nav';
import { GITHUB_URL, site } from '../site';
import { publishedWriting } from '../writing';

interface Props {
  current?: NavSection;
  /** The coming-soon page shows the brand alone. */
  minimal?: boolean;
}

const { current } = Astro.props;
// The holding page (coming-soon) has no other pages to link to, so every page
// of that build (the 404 included) shows the brand alone.
const minimal = Astro.props.minimal === true || !site.showsFullSite;
const github = site.sourcePublic;
const links = primaryNav({ hasPosts: (await publishedWriting('post')).length > 0 });
---

<div class="site-header-bar">
  <header class="site-header">
    <a class="brand" href="/" aria-label="rotli home">
      <span class="brand-mark" set:html={mark} aria-hidden="true"></span>
      <span class="wordmark">rotli</span>
    </a>
    {
      !minimal && (
        <>
          <nav class="primary-nav" aria-label="Primary navigation">
            {links.map((link) => (
              <a href={link.href} aria-current={link.section && link.section === current ? 'page' : undefined}>
                {link.label}
              </a>
            ))}
          </nav>
          <div class="header-actions">
            {github && (
              <a class="github-link" href={GITHUB_URL} rel="noopener" aria-label="rotli on GitHub">
                <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
                </svg>
              </a>
            )}
            <a class="button primary header-download" href="/download/" aria-current={current === 'download' ? 'page' : undefined}>Download</a>
            <details class="nav-menu">
              <summary>Menu</summary>
              <nav class="nav-menu-panel" aria-label="Site sections">
                {links.map((link) => (
                  <a href={link.href} aria-current={link.section && link.section === current ? 'page' : undefined}>
                    {link.label}
                  </a>
                ))}
                {github && <a href={GITHUB_URL} rel="noopener">GitHub</a>}
                <a class="button primary" href="/download/">Download</a>
              </nav>
            </details>
          </div>
        </>
      )
    }
  </header>
</div>

<script>
  // Menu is a native <details>; close it on Escape, a click outside it, or
  // after choosing an in-page anchor (the page scrolls under a pinned header).
  const menu = document.querySelector<HTMLDetailsElement>('.nav-menu');
  if (menu) {
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.open = false;
      });
    });
  }
</script>
