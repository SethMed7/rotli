---
// The end of a blog post: "More from rotli" (WritingPage `article`). It began as a right-hand
// column; the owner, 2026-10-06: "remove the part on right ... stuff on right can go at end of
// blog in replace of sources since sources is already on left side". So it closes the article, on
// the reading column's edges at every width, in the place the article's own Sources list had on a
// wide screen (that list now lives in the left rail; article.css):
//   - "More posts": other posts as small cards, a thumbnail over the title and date (src/blog.ts
//     `morePosts`), in a row of up to three, side by side on a phone;
//   - two "From rotli" spots (src/promos.ts, rotli's own promotions only), side by side where
//     there is room.
// An announced post fills in only when there are too few published ones; it says "Coming soon"
// and is not a link (it has no page). Every picture is local; the spots are plain links.
import type { Thumbnail } from '../../og';
import type { Promo } from '../../promos';

export interface MorePost {
  title: string;
  /** Absent for an announced post. */
  href?: string;
  /** "Oct 2, 2026" and YYYY-MM-DD, for published posts. */
  date?: string;
  dateTime?: string;
  thumbnail?: Thumbnail;
  soon: boolean;
}

interface Props {
  posts: MorePost[];
  promos: Promo[];
}

const { posts, promos } = Astro.props;
const art = import.meta.glob<{ default: ImageMetadata }>('../../../../src/assets/characters/filled/cocoa/*.webp', {
  eager: true,
});
const poseImage = (pose: Promo['pose']) => {
  const image = art[`../../../../src/assets/characters/filled/cocoa/${pose}.webp`]?.default;
  if (!image) throw new Error(`src/promos.ts: no quokka art for the pose "${pose}"`);
  return image;
};
---

{
  (posts.length > 0 || promos.length > 0) && (
    <aside class="more" aria-labelledby="more-title" data-article-more>
      <h2 class="more-title" id="more-title">
        More from rotli
      </h2>
      {posts.length > 0 && (
        <section class="more-posts" aria-labelledby="more-posts-label" data-more-posts>
          <p class="more-label" id="more-posts-label">
            More posts
          </p>
          <ul>
            {posts.map((post) => {
              const inner = (
                <>
                  <span class:list={['thumb', { blank: !post.thumbnail }]}>
                    {post.thumbnail && (
                      <img
                        src={post.thumbnail.src}
                        srcset={post.thumbnail.srcset}
                        sizes="(max-width: 560px) 7.5rem, 15rem"
                        width={post.thumbnail.width}
                        height={post.thumbnail.height}
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                  </span>
                  <span class="post-copy">
                    <span class="post-title">{post.title}</span>
                    {post.soon ? (
                      <span class="post-meta soon-label">Coming soon</span>
                    ) : (
                      <time class="post-meta" datetime={post.dateTime}>
                        {post.date}
                      </time>
                    )}
                  </span>
                </>
              );
              return (
                <li data-more-post={post.soon ? 'soon' : 'published'}>
                  {post.href ? (
                    <a class="plain-link post" href={post.href}>
                      {inner}
                    </a>
                  ) : (
                    <div class="post">{inner}</div>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      )}
      {promos.length > 0 && (
        <ul class="promos" aria-label="From rotli" data-promos>
          {promos.map((promo) => {
            const image = poseImage(promo.pose);
            return (
              <li data-promo={promo.id}>
                <a class="plain-link promo" href={promo.href} rel={promo.external ? 'noopener' : undefined}>
                  <img
                    class="promo-art"
                    src={image.src}
                    width={image.width}
                    height={image.height}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="promo-copy">
                    <span class="promo-label">{promo.label}</span>
                    <span class="promo-title">
                      {promo.title}
                      {promo.external && (
                        <span class="external-mark" aria-hidden="true">
                          ↗
                        </span>
                      )}
                    </span>
                    <span class="promo-text">{promo.text}</span>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      )}
    </aside>
  )
}

<style>
  /* After the article, on the text's edges (WritingPage places it): a section after a rule. */
  .more {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: clamp(1.75rem, 3vw, 2.25rem);
    border-top: 1px solid var(--border-strong);
    font-size: 0.88rem;
  }
  .more-title {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .more-label {
    margin: 0 0 0.7rem;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 600;
  }
  .more-posts ul,
  .promos {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Up to three cards in a row (the column holds three at 12rem); one a row on a phone. */
  .more-posts ul {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr));
    gap: 1.1rem 1.25rem;
  }
  .promos {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 0.9rem 1rem;
  }
  /* A post: its picture over its title and date. */
  .post {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    color: var(--text);
    text-decoration: none;
  }
  .thumb {
    display: block;
    overflow: hidden;
    aspect-ratio: 1200 / 630;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius-frame) - 0.35rem);
    background: var(--surface-2);
  }
  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .post-copy {
    display: grid;
    gap: 0.2rem;
  }
  .post-title {
    font-weight: 600;
    line-height: 1.3;
    text-wrap: pretty;
  }
  a.post:hover .post-title {
    color: var(--accent-text);
  }
  .post-meta {
    color: var(--text-muted);
    font-size: 0.8rem;
  }
  .soon-label {
    font-weight: 600;
  }
  /* A spot: rotli's own promotion, labelled, on a quiet surface with a hairline: the one boxed
     thing in the section, so it never reads as the article. */
  .promo {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    align-items: start;
    gap: 0.75rem;
    height: 100%;
    box-sizing: border-box;
    padding: 0.85rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-frame);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition: border-color 140ms ease-out;
  }
  .promo:hover {
    border-color: var(--border-strong);
  }
  .promo-art {
    width: 3.25rem;
    height: auto;
  }
  .promo-copy {
    display: grid;
    gap: 0.15rem;
  }
  .promo-label {
    color: var(--text-muted);
    font-size: 0.74rem;
    font-weight: 600;
  }
  .promo-title {
    font-weight: 600;
    line-height: 1.3;
  }
  .promo:hover .promo-title {
    color: var(--accent-text);
  }
  .promo-text {
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.45;
    text-wrap: pretty;
  }
  @media (pointer: coarse) {
    .post {
      min-height: 44px;
    }
  }
  /* A phone: a post's picture beside its words, so three posts stay short. */
  @media (max-width: 560px) {
    .post {
      grid-template-columns: 7.5rem minmax(0, 1fr);
      align-items: start;
      gap: 0.75rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .promo {
      transition: none;
    }
  }
</style>
