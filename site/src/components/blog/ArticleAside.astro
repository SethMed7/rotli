---
// A blog post's right side (WritingPage `article`; the owner, 2026-10-06: "on right side we can
// make room for 1. ad spots 2. promoting other blogs"). One block in the article's grid:
//   - from 1280px wide it is the third column, beside the reading column: "More posts" (other
//     posts with a thumbnail, title, and date; src/blog.ts `morePosts`) and two "From rotli"
//     spots (src/promos.ts, rotli's own promotions only). It stays in view while the post
//     scrolls when the window is tall enough to hold it whole, and scrolls with the page when not;
//   - below 1280px it follows the article as "More from rotli": the same posts and one spot.
// An announced post fills in only when there are too few published ones; it says "Coming soon"
// and is not a link (it has no page). Every picture is local; the spots are plain links.
import type { Thumbnail } from '../../og';
import type { Promo } from '../../promos';

export interface MorePost {
  title: string;
  /** Absent for an announced post. */
  href?: string;
  /** "Oct 2, 2026" and YYYY-MM-DD, for published posts. */
  date?: string;
  dateTime?: string;
  thumbnail?: Thumbnail;
  soon: boolean;
}

interface Props {
  posts: MorePost[];
  promos: Promo[];
}

const { posts, promos } = Astro.props;
const art = import.meta.glob<{ default: ImageMetadata }>('../../../../src/assets/characters/filled/cocoa/*.webp', {
  eager: true,
});
const poseImage = (pose: Promo['pose']) => {
  const image = art[`../../../../src/assets/characters/filled/cocoa/${pose}.webp`]?.default;
  if (!image) throw new Error(`src/promos.ts: no quokka art for the pose "${pose}"`);
  return image;
};
---

{
  (posts.length > 0 || promos.length > 0) && (
    <aside class="more" aria-labelledby="more-title" data-article-more>
      <h2 class="more-title" id="more-title">
        More from rotli
      </h2>
      {posts.length > 0 && (
        <section class="more-posts" aria-labelledby="more-posts-label" data-more-posts>
          <p class="more-label" id="more-posts-label">
            More posts
          </p>
          <ul>
            {posts.map((post) => {
              const inner = (
                <>
                  <span class:list={['thumb', { blank: !post.thumbnail }]}>
                    {post.thumbnail && (
                      <img
                        src={post.thumbnail.src}
                        srcset={post.thumbnail.srcset}
                        sizes="8rem"
                        width={post.thumbnail.width}
                        height={post.thumbnail.height}
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                  </span>
                  <span class="post-copy">
                    <span class="post-title">{post.title}</span>
                    {post.soon ? (
                      <span class="post-meta soon-label">Coming soon</span>
                    ) : (
                      <time class="post-meta" datetime={post.dateTime}>
                        {post.date}
                      </time>
                    )}
                  </span>
                </>
              );
              return (
                <li data-more-post={post.soon ? 'soon' : 'published'}>
                  {post.href ? (
                    <a class="plain-link post" href={post.href}>
                      {inner}
                    </a>
                  ) : (
                    <div class="post">{inner}</div>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      )}
      {promos.length > 0 && (
        <ul class="promos" aria-label="From rotli" data-promos>
          {promos.map((promo) => {
            const image = poseImage(promo.pose);
            return (
              <li data-promo={promo.id}>
                <a
                  class="plain-link promo"
                  href={promo.href}
                  {...(promo.external ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  <img
                    class="promo-art"
                    src={image.src}
                    width={image.width}
                    height={image.height}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="promo-copy">
                    <span class="promo-label">{promo.label}</span>
                    <span class="promo-title">
                      {promo.title}
                      {promo.external && (
                        <>
                          <span aria-hidden="true"> ↗</span>
                          <span class="visually-hidden"> (opens in a new tab)</span>
                        </>
                      )}
                    </span>
                    <span class="promo-text">{promo.text}</span>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      )}
    </aside>
  )
}

<style>
  .more {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    font-size: 0.88rem;
  }
  .more-title {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .more-label {
    margin: 0 0 0.7rem;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 600;
  }
  .more-posts ul,
  .promos {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* A post: a small picture beside its title and date. */
  .post {
    display: grid;
    grid-template-columns: 5.25rem minmax(0, 1fr);
    align-items: start;
    gap: 0.75rem;
    color: var(--text);
    text-decoration: none;
  }
  .thumb {
    display: block;
    overflow: hidden;
    aspect-ratio: 1200 / 630;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius-frame) - 0.35rem);
    background: var(--surface-2);
  }
  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .post-copy {
    display: grid;
    gap: 0.2rem;
  }
  .post-title {
    font-weight: 600;
    line-height: 1.3;
    text-wrap: pretty;
  }
  a.post:hover .post-title {
    color: var(--accent-text);
  }
  .post-meta {
    color: var(--text-muted);
    font-size: 0.8rem;
  }
  .soon-label {
    font-weight: 600;
  }
  /* A spot: rotli's own promotion, labelled, on a quiet surface with a hairline: the one boxed
     thing on the side, so it never reads as the article. */
  .promo {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    align-items: start;
    gap: 0.75rem;
    padding: 0.85rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-frame);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition: border-color 140ms ease-out;
  }
  .promo:hover {
    border-color: var(--border-strong);
  }
  .promo-art {
    width: 3.25rem;
    height: auto;
  }
  .promo-copy {
    display: grid;
    gap: 0.15rem;
  }
  .promo-label {
    color: var(--text-muted);
    font-size: 0.74rem;
    font-weight: 600;
  }
  .promo-title {
    font-weight: 600;
    line-height: 1.3;
  }
  .promo:hover .promo-title {
    color: var(--accent-text);
  }
  .promo-text {
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.45;
    text-wrap: pretty;
  }
  @media (pointer: coarse) {
    .post {
      min-height: 44px;
    }
  }
  /* Beside the article: the section's heading is for screen readers (its parts are labelled). */
  @media (min-width: 1280px) {
    .more {
      align-self: start;
    }
    .more-title {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  /* Held in view only where the window is tall enough for all of it. */
  @media (min-width: 1280px) and (min-height: 760px) {
    .more {
      position: sticky;
      top: calc(var(--pinned) + 1.5rem);
    }
  }
  /* Under the article: a section after a rule, the posts and one spot. */
  @media (max-width: 1279.98px) {
    .more {
      max-width: 42rem;
      margin-top: clamp(3rem, 6vw, 4.5rem);
      padding-top: clamp(1.75rem, 3vw, 2.25rem);
      border-top: 1px solid var(--border-strong);
    }
    .more-posts ul {
      grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
      gap: 1.1rem 1.75rem;
    }
    .post {
      grid-template-columns: 7.5rem minmax(0, 1fr);
    }
    .promos > li + li {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .promo {
      transition: none;
    }
  }
</style>
