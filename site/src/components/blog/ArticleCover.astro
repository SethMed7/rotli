---
// The top of a blog post (WritingPage `article`; the owner, 2026-10-06: "the blog page headers, I
// still needed that cleaned up", then "it has a lot of awkward space, especially where the 'blog/'
// is"). Calm and on the article's own columns (WritingPage's --article-tracks), so the head lines
// up with what follows it:
//   - the post's illustration across the page's full width (the edges of the rails below), in a
//     rounded frame, short enough that the title is well inside the first window;
//   - under it one block from the page's left edge, the left rail's edge: "Blog /" small and quiet,
//     then the title, the summary (at the reading measure), one meta line (the author's mark and
//     name, the date, the reading time), and the topics as light outlined labels, in one tight
//     rhythm. Nothing sits alone in the rail's column and nothing is indented into empty space;
//   - a hairline across the page before the article begins.
// Nothing overlaps the picture at any width, nothing is pinned, and nothing moves. Below 901px it
// is one column on the text's edges: the picture (the phone crop below 700px), then the words. A
// post without art (`cover` undefined) is the same head without the picture.
import mark from '../../../../src/assets/characters/_logo.svg?raw';
import type { Banner } from '../../og';

interface Props {
  cover?: Banner;
  crumbs: { href: string; label: string }[];
  kicker?: string;
  heading: string;
  lede?: string;
  author: string;
  /** The date and reading time. */
  meta: string[];
  tags: string[];
}

const { cover, crumbs, kicker, heading, lede, author, meta, tags } = Astro.props;
---

<header class:list={['cover-head', { 'no-cover': !cover }]} data-article-cover>
  {
    cover && (
      <picture class="cover-art" data-article-art>
        <source
          media="(max-width: 700px)"
          srcset={cover.mobile}
          width={cover.mobileWidth}
          height={cover.mobileHeight}
        />
        <img
          src={cover.src}
          srcset={cover.srcset}
          sizes="(min-width: 1488px) 88rem, calc(100vw - 2 * clamp(1.25rem, 4vw, 2.5rem))"
          width={cover.width}
          height={cover.height}
          alt={cover.alt}
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    )
  }
  <div class="head-copy">
    {
      crumbs.length > 0 && (
        <nav class="crumbs" aria-label="Breadcrumb">
          {crumbs.map((crumb) => (
            <>
              <a href={crumb.href}>{crumb.label}</a>
              <span aria-hidden="true">/</span>
            </>
          ))}
        </nav>
      )
    }
    {kicker && <p class="kicker">{kicker}</p>}
    <h1>{heading}</h1>
    {lede && <p class="lede">{lede}</p>}
    <p class="byline">
      <span class="avatar" set:html={mark} aria-hidden="true" />
      <span class="author">{author}</span>
      {
        meta.map((part) => (
          <>
            <span class="dot" aria-hidden="true">·</span>
            <span>{part}</span>
          </>
        ))
      }
    </p>
    {
      tags.length > 0 && (
        <ul class="tags" aria-label="Topics">
          {tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
  </div>
</header>

<style>
  /* On the article's named tracks (WritingPage --article-tracks) at every width: the picture
     across all of them, the words from the page's left edge from 901px (the left rail's edge) and
     on the text's edges below that. */
  .cover-head {
    display: grid;
    grid-template-columns: var(--article-tracks);
    margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
    padding-bottom: clamp(1.5rem, 3vw, 2rem);
    border-bottom: 1px solid var(--border-strong);
  }
  /* The trail: small and quiet, straight above the title. */
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    margin: 0 0 0.6rem;
    color: var(--text-muted);
    font-size: 0.84rem;
  }
  .crumbs a {
    color: var(--text-muted);
    text-underline-offset: 0.2em;
  }
  .crumbs a:hover {
    color: var(--text);
  }
  @media (pointer: coarse) {
    .crumbs a {
      display: inline-block;
      padding: 0.7rem 0;
      margin: -0.7rem 0;
    }
  }
  /* The picture: the columns' full width, rounded with a hairline, short enough that the title
     is in the first window; its quokka and props (the scene's right half) stay in view. */
  .cover-art {
    grid-column: 1 / -1;
    display: block;
    overflow: hidden;
    margin-bottom: clamp(1.25rem, 2.5vw, 1.75rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-frame);
    background: var(--surface-2);
  }
  .cover-art img {
    display: block;
    width: 100%;
    /* Its height follows its width (cqi: the article's width), about 3.3 to 1 (the art is 2.4 to 1),
       so a wider page crops no more of the quokka; the window's height caps it (44svh, a little
       under the old 46svh), leaving the title, summary, and meta line room in the first window. */
    height: clamp(12rem, min(30cqi, 44svh), 27rem);
    object-fit: cover;
    /* Most of the crop comes off the sky, some off the sand: the quokka keeps its ears. */
    object-position: 100% 70%;
  }
  .head-copy {
    grid-column: text;
    min-width: 0;
  }
  .kicker {
    margin: 0 0 0.6rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  /* Title, then summary, then the meta line: three steps of size and strength. */
  h1 {
    max-width: 22em;
    margin: 0;
    font-size: clamp(2.1rem, 3.4vw, 3rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .lede {
    max-width: var(--measure);
    margin: 0.85rem 0 0;
    color: var(--text-muted);
    font-size: var(--step-lede);
    line-height: 1.55;
    text-wrap: pretty;
  }
  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.55rem;
    margin: 1.1rem 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .avatar {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    box-sizing: border-box;
    padding: 0.28rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--surface);
    color: var(--text);
    line-height: 0;
  }
  .avatar :global(svg) {
    width: 100%;
    height: 100%;
  }
  .author {
    color: var(--text);
    font-weight: 600;
  }
  /* Topics: light outlined labels, not links (the blog index filters by them). */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    padding: 0.14rem 0.6rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.4;
  }
  /* From 901px the words start on the page's left edge, the picture's and the left rail's, so the
     head reads as one block under the picture; the title wraps at about 22em and the summary
     keeps the reading measure. */
  @media (min-width: 901px) {
    .head-copy {
      grid-column: 1 / -1;
    }
  }
  /* Narrow screens: the "On this page" disclosure's own rules close the head. */
  @media (max-width: 900px) {
    .cover-head {
      padding-bottom: 0;
      border-bottom: 0;
    }
  }
  /* Phones: the phone crop, the quokka and its props centred. */
  @media (max-width: 700px) {
    .cover-art img {
      height: auto;
      aspect-ratio: 1300 / 900;
      max-height: 55svh;
      object-position: 50% 100%;
    }
  }
</style>
