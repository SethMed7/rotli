---
// A blog post's left rail (WritingPage `article`), after the claude.dev posts the owner pointed
// to, in the site's own type and tokens. Top to bottom (the owner, 2026-10-06: "clean up left
// screen ... sources on the left side ... share stuff should be lower"):
//   1. the post's short title (src/blog.ts `railTitle`);
//   2. "On this page" as a tree (h3 entries branch off their h2);
//   3. how far through the post the window is: a bar and a percent (src/reading.ts, the same
//      measure as every meter on the site);
//   4. Sources: a compact numbered list read from the post's own `## Sources` at build time
//      (src/sources.ts), publisher and short title linking out in a new tab. The article keeps
//      the full citations (no script, print, phones); the tree leaves out its "Sources" entry and
//      the block ends with a link to them, so the rail says "Sources" once;
//   5. Share, at the rail's foot: links with icons.
// It stays in view beside the text on wide screens, never taller than the window: when it would
// be, the sources list gives up height and scrolls inside itself (it keeps at least a few rows),
// and past that the whole rail scrolls, so nothing is ever cut off. Below 900px only Share
// remains, after the article: the tree becomes WritingPage's "On this page" disclosure, the meter
// a slim bar under the header, and the sources are the article's own list.
//
// Share is plain links (X, LinkedIn, an email) that carry the page's address and title and load
// nothing from those sites, plus two buttons that need script and appear only with it: Copy link
// and Copy Markdown, which copies the post's own Markdown twin (/blog/<slug>/index.md, the same
// origin, so the CSP's `connect-src 'self'` allows it). The icons are inline SVG on currentColor.
import { railTitle, tocTree, type TocItem } from '../../blog';
import type { Source } from '../../sources';
// The reading column and the figures (global, under .is-article): loaded only on pages with a rail.
import './article.css';

interface Props {
  title: string;
  toc: TocItem[];
  /** The post's `## Sources`, parsed (src/sources.ts); empty renders no Sources block. */
  sources: Source[];
  share: {
    url: string;
    title: string;
    /** The summary, for the email's body. */
    text: string;
    /** The post's Markdown twin, for Copy Markdown. */
    markdown: string;
  };
}

const { title, toc, sources, share } = Astro.props;
/** The article's own Sources heading, which the rail's block links to (and the tree then skips). */
const sourcesHeading = sources.length > 0 ? toc.find((item) => item.depth === 2 && /^sources$/i.test(item.text)) : undefined;
const tree = tocTree(toc.filter((item) => item !== sourcesHeading));
const enc = encodeURIComponent;
const ICONS = {
  x: '<path class="solid" d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.4l-5.8-7.59-6.64 7.59H.47l8.6-9.83L0 1.15h7.6l5.24 6.93Zm-1.29 19.5h2.04L6.49 3.24H4.3Z"/>',
  linkedin:
    '<path class="solid" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13Zm1.78 13.02H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/>',
  email: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/>',
  link: '<path d="M10 13.5a4.5 4.5 0 0 0 6.36 0l3-3a4.5 4.5 0 0 0-6.36-6.36l-1.25 1.25"/><path d="M14 10.5a4.5 4.5 0 0 0-6.36 0l-3 3a4.5 4.5 0 0 0 6.36 6.36l1.25-1.25"/>',
  markdown: '<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M6 15V9l3 3 3-3v6M17 9v6m-2.25-2.25L17 15l2.25-2.25"/>',
} as const;
const icon = (name: keyof typeof ICONS) =>
  `<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">${ICONS[name]}</svg>`;
const shareLinks = [
  { label: 'X', icon: 'x', href: `https://x.com/intent/post?text=${enc(share.title)}&url=${enc(share.url)}`, external: true },
  {
    label: 'LinkedIn',
    icon: 'linkedin',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(share.url)}`,
    external: true,
  },
  {
    label: 'Email',
    icon: 'email',
    href: `mailto:?subject=${enc(share.title)}&body=${enc(`${share.text}\n\n${share.url}`)}`,
    external: false,
  },
] as const;
---

<aside class="rail" aria-label="About this post" data-article-rail>
  <p class="rail-title">{railTitle(title)}</p>
  {
    tree.length > 1 && (
      <nav class="rail-toc" aria-label="On this page" data-toc>
        <p class="rail-label">On this page</p>
        <ul class="tree">
          {tree.map((item) => (
            <li>
              <a href={`#${item.slug}`}>{item.text}</a>
              {item.children.length > 0 && (
                <ul>
                  {item.children.map((child) => (
                    <li>
                      <a href={`#${child.slug}`}>{child.text}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>
    )
  }
  <div
    class="rail-progress"
    data-read-progress="rail"
    role="progressbar"
    aria-label="Position in this post"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
    hidden
  >
    <span class="read-track" aria-hidden="true"><span class="read-fill" data-read-fill></span></span>
    <span class="read-label" aria-hidden="true" data-read-percent>0%</span>
  </div>
  {
    sources.length > 0 && (
      <section class="rail-sources" aria-labelledby="rail-sources-label" data-rail-sources>
        <p class="rail-label" id="rail-sources-label">Sources</p>
        <ol class="sources">
          {sources.map((source) => (
            <li>
              <span class="source-number" aria-hidden="true">{source.number}</span>
              {source.url ? (
                <a class="source" href={source.url} target="_blank" rel="noopener noreferrer">
                  <span class="source-publisher">{source.publisher}</span>
                  <span class="source-title">{source.title}</span>
                </a>
              ) : (
                <span class="source">
                  <span class="source-publisher">{source.publisher}</span>
                  {source.title && <span class="source-title">{source.title}</span>}
                </span>
              )}
            </li>
          ))}
        </ol>
        {sourcesHeading && (
          <a class="sources-all" href={`#${sourcesHeading.slug}`}>
            Full citations
          </a>
        )}
      </section>
    )
  }
  <div class="rail-share" data-share>
    <p class="rail-label" id="share-label">Share</p>
    <ul aria-labelledby="share-label">
      {
        shareLinks.map((link) => (
          <li>
            <a
              href={link.href}
              data-share-link={link.label.toLowerCase()}
              {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <Fragment set:html={icon(link.icon)} />
              <span>{link.label}</span>
            </a>
          </li>
        ))
      }
      <li hidden data-copy-item>
        <button type="button" data-copy="link" data-copy-value={share.url}>
          <Fragment set:html={icon('link')} />
          <span>Copy link</span>
        </button>
      </li>
      <li hidden data-copy-item>
        <button type="button" data-copy="markdown" data-copy-src={share.markdown}>
          <Fragment set:html={icon('markdown')} />
          <span>Copy Markdown</span>
        </button>
      </li>
    </ul>
    <p class="share-status" role="status" data-share-status></p>
  </div>
</aside>

<script>
  // Copy link and Copy Markdown: shown only where the clipboard can be written. Markdown is
  // fetched from this site (the post's twin) and handed to the clipboard as a promise where the
  // browser takes one (Safari needs the write to start inside the click), else written once read.
  const status = document.querySelector<HTMLElement>('[data-share-status]');
  let clearStatus = 0;
  const say = (message: string) => {
    if (!status) return;
    status.textContent = message;
    window.clearTimeout(clearStatus);
    clearStatus = window.setTimeout(() => (status.textContent = ''), 4000);
  };
  const markdownOf = async (src: string) => {
    const response = await fetch(src, { headers: { Accept: 'text/markdown' } });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    return response.text();
  };
  if (navigator.clipboard && window.isSecureContext) {
    document.querySelectorAll<HTMLElement>('[data-copy-item]').forEach((item) => (item.hidden = false));
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
      button.addEventListener('click', async () => {
        try {
          if (button.dataset.copy === 'link') {
            await navigator.clipboard.writeText(button.dataset.copyValue ?? location.href);
            say('Link copied');
            return;
          }
          const src = button.dataset.copySrc ?? '';
          if (typeof ClipboardItem !== 'undefined' && navigator.clipboard.write) {
            const blob = markdownOf(src).then((text) => new Blob([text], { type: 'text/plain' }));
            await navigator.clipboard.write([new ClipboardItem({ 'text/plain': blob })]);
          } else {
            await navigator.clipboard.writeText(await markdownOf(src));
          }
          say('Markdown copied');
        } catch {
          say('Couldn’t copy. Try again, or open the Markdown from the page’s address with index.md.');
        }
      });
    });
  }
</script>

<style>
  /* In view beside the text, never taller than the window: the blocks keep their height, the
     sources list gives way and scrolls inside itself, and Share settles at the foot. */
  .rail {
    position: sticky;
    top: calc(var(--pinned) + 1.5rem);
    align-self: start;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    max-height: calc(100dvh - var(--pinned) - 3rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-right: 0.25rem;
    font-size: 0.88rem;
  }
  .rail > * {
    flex: none;
  }
  .rail-title {
    margin: 0;
    color: var(--text);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .rail-label {
    margin: 0 0 0.5rem;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 600;
  }
  /* The tree: one guide line down the left; h3 entries sit on their own, shorter guide. */
  .tree,
  .tree ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tree {
    border-left: 1px solid var(--border);
  }
  .tree ul {
    margin: 0 0 0.2rem 0.85rem;
    border-left: 1px solid var(--border);
  }
  .tree a {
    position: relative;
    display: block;
    padding: 0.22rem 0 0.22rem 0.85rem;
    color: var(--text-muted);
    line-height: 1.35;
    text-decoration: none;
    transition: color 140ms ease-out;
  }
  .tree ul a {
    font-size: 0.84rem;
  }
  .tree a:hover,
  .tree a[aria-current='location'] {
    color: var(--text);
  }
  .tree a[aria-current='location'] {
    font-weight: 600;
  }
  .tree a[aria-current='location']::before {
    content: '';
    position: absolute;
    top: 0.3rem;
    bottom: 0.3rem;
    left: -1px;
    width: 2px;
    border-radius: 1px;
    background: var(--accent-text);
  }
  .tree a:focus-visible {
    outline-offset: 1px;
  }
  /* How far through: a bar and the percent beside it. */
  .rail-progress {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
  }
  .rail-progress[hidden] {
    display: none;
  }
  .read-track {
    height: 4px;
    border-radius: 2px;
    background: var(--border);
    overflow: hidden;
  }
  .read-fill {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  .read-label {
    min-width: 4ch;
    color: var(--text);
    font-size: 0.82rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  /* Sources: the one block that gives up height when the window is short. It keeps a floor of a
     few rows and scrolls inside itself below that. */
  .rail > .rail-sources {
    display: flex;
    flex: 0 1 auto;
    flex-direction: column;
    min-height: 10rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border);
  }
  .sources {
    flex: 0 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    display: grid;
    align-content: start;
    gap: 0.55rem;
    margin: 0;
    padding: 0 0.25rem 0 0;
    list-style: none;
    scrollbar-width: thin;
    mask-image: linear-gradient(to bottom, black calc(100% - var(--sources-fade)), transparent);
  }
  /* While the list scrolls, its last visible line fades out to say there is more; at the end of
     the list (or when it all fits, and where scroll timelines are unsupported) nothing fades. */
  @property --sources-fade {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }
  @supports (animation-timeline: scroll()) {
    .sources {
      animation-name: sources-fade;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(self);
    }
  }
  @keyframes sources-fade {
    from,
    96% {
      --sources-fade: 1.75rem;
    }
    to {
      --sources-fade: 0px;
    }
  }
  .sources li {
    display: grid;
    grid-template-columns: 1.3rem minmax(0, 1fr);
    align-items: baseline;
  }
  .source-number {
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .source {
    display: grid;
    gap: 0.05rem;
    color: var(--text);
    line-height: 1.35;
    text-decoration: none;
  }
  .source-publisher {
    color: var(--text-muted);
    font-size: 0.78rem;
  }
  /* A long title keeps two lines; the link's name is still the whole title. */
  .source-title {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    font-size: 0.84rem;
  }
  a.source:hover .source-title {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .sources-all {
    align-self: flex-start;
    flex: none;
    margin-top: 0.7rem;
    color: var(--text-muted);
    font-size: 0.8rem;
    text-underline-offset: 0.2em;
  }
  .sources-all:hover {
    color: var(--text);
  }
  .rail-share {
    margin-top: auto;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border);
  }
  .rail-share ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rail-share li[hidden] {
    display: none;
  }
  .rail-share a,
  .rail-share button {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 1.9rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-muted);
    font: inherit;
    text-align: left;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: color 140ms ease-out;
  }
  .rail-share a:hover,
  .rail-share button:hover {
    color: var(--text);
  }
  .rail-share a:hover span,
  .rail-share button:hover span {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .rail-share :global(.icon) {
    flex: none;
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .rail-share :global(.icon .solid) {
    fill: currentColor;
    stroke: none;
  }
  .share-status {
    min-height: 1.3em;
    margin: 0.4rem 0 0;
    color: var(--text);
    font-size: 0.82rem;
  }
  .share-status:empty {
    margin: 0;
    min-height: 0;
  }
  @media (pointer: coarse) {
    .rail-share a,
    .rail-share button,
    .source {
      min-height: 44px;
    }
  }
  /* Narrow screens: Share after the article (WritingPage orders it), in a row; the rest moves
     to the disclosure, the slim bar, and the article's own Sources. */
  @media (max-width: 900px) {
    .rail {
      position: static;
      max-height: none;
      overflow: visible;
      margin-top: 2.5rem;
    }
    .rail-title,
    .rail-toc,
    .rail-progress,
    .rail > .rail-sources {
      display: none;
    }
    .rail-share {
      margin-top: 0;
      padding-top: 1.5rem;
      border-top-color: var(--border-strong);
    }
    .rail-share ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tree a,
    .rail-share a,
    .rail-share button {
      transition: none;
    }
  }
</style>
