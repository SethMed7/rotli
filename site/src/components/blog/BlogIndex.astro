---
// /blog/, after anthropic.com/news (the owner's "better layout and clarity, especially for
// what is new/big"), in rotli's warm look:
//   1. the featured story: the newest post, or the one marked `featured`, its picture large
//      beside its title, summary, date, and topics;
//   2. the next posts (up to three, src/blog.ts) in a row of smaller pictures;
//   3. "All posts": one dated row per post (date, topic, title, a one-line summary) between
//      hairlines, never boxes, with topic filters that need script and appear only with it,
//      so without script the whole list shows;
//   4. "Coming soon": announced posts, quieter and apart, never links.
// A post from the last 14 days, as of the build, wears "New" (src/blog.ts `isNew`). Pictures are
// the posts' thumbnails (src/og.ts), one 1200 × 630 shape with real sizes, so nothing shifts.
import type { Thumbnail } from '../../og';
import { topicKey, topicsOf } from '../../blog';

export interface BlogPost {
  href: string;
  title: string;
  description: string;
  /** "October 5, 2026", and the same date as YYYY-MM-DD for <time>. */
  date: string;
  dateTime: string;
  readTime: string;
  draft: boolean;
  tags: string[];
  isNew: boolean;
  thumbnail?: Thumbnail;
}

export interface UpcomingPost {
  title: string;
  description: string;
  thumbnail?: Thumbnail;
}

interface Props {
  featured?: BlogPost;
  secondary: BlogPost[];
  all: BlogPost[];
  upcoming: UpcomingPost[];
  empty: string;
}

const { featured, secondary, all, upcoming, empty } = Astro.props;
const topics = topicsOf(all);
const shortDate = (post: BlogPost) =>
  new Date(`${post.dateTime}T00:00:00Z`).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<div class="blog-index">
  {!featured && upcoming.length === 0 && <p class="empty">{empty}</p>}

  {
    featured && (
      <section class="featured" aria-labelledby="featured-title" data-featured>
        <a class="plain-link feature" href={featured.href}>
          {featured.thumbnail && (
            <span class="frame">
              <img
                src={featured.thumbnail.src}
                srcset={featured.thumbnail.srcset}
                sizes="(min-width: 1100px) 44rem, calc(100vw - 2.5rem)"
                width={featured.thumbnail.width}
                height={featured.thumbnail.height}
                alt={featured.thumbnail.alt}
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </span>
          )}
          <span class="feature-copy">
            <span class="meta">
              {featured.isNew && <span class="new">New</span>}
              {featured.draft && <span class="new draft">Draft</span>}
              <time datetime={featured.dateTime}>{featured.date}</time>
              <span aria-hidden="true">·</span>
              <span>{featured.readTime}</span>
            </span>
            <h2 id="featured-title">{featured.title}</h2>
            <span class="summary">{featured.description}</span>
            {featured.tags.length > 0 && (
              <span class="tags">
                {featured.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </span>
            )}
            <span class="cue" aria-hidden="true">
              Read the post <b>→</b>
            </span>
          </span>
        </a>
      </section>
    )
  }

  {
    secondary.length > 0 && (
      <section class="secondary" aria-label="More recent posts" data-secondary>
        <ul class="row">
          {secondary.map((post) => (
            <li>
              <a class="plain-link tile" href={post.href}>
                {post.thumbnail && (
                  <span class="frame">
                    <img
                      src={post.thumbnail.src}
                      srcset={post.thumbnail.srcset}
                      sizes="(min-width: 1100px) 24rem, (min-width: 700px) 45vw, calc(100vw - 2.5rem)"
                      width={post.thumbnail.width}
                      height={post.thumbnail.height}
                      alt={post.thumbnail.alt}
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                )}
                <span class="meta">
                  {post.isNew && <span class="new">New</span>}
                  {post.draft && <span class="new draft">Draft</span>}
                  {post.tags[0] && <span class="topic">{post.tags[0]}</span>}
                  <time datetime={post.dateTime}>{post.date}</time>
                </span>
                <h3>{post.title}</h3>
                <span class="summary">{post.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    all.length > 0 && (
      <section class="archive" aria-labelledby="all-posts-title" data-archive>
        <div class="archive-head">
          <h2 id="all-posts-title" class="section-title">
            All posts
          </h2>
          {topics.length > 1 && (
            <div class="filters" role="group" aria-label="Show posts about" data-topic-filters hidden>
              <button type="button" aria-pressed="true" data-topic="">
                All
              </button>
              {topics.map((topic) => (
                <button type="button" aria-pressed="false" data-topic={topicKey(topic)}>
                  {topic}
                </button>
              ))}
            </div>
          )}
        </div>
        <ol class="list" data-post-list>
          {all.map((post) => (
            <li data-topics={post.tags.map(topicKey).join(' ')}>
              <time class="list-date" datetime={post.dateTime}>
                {shortDate(post)}
              </time>
              <span class="list-topic">{post.tags[0] ?? 'Post'}</span>
              <span class="list-copy">
                <a class="plain-link list-title" href={post.href}>
                  {post.title}
                </a>
                {post.isNew && <span class="new">New</span>}
                {post.draft && <span class="new draft">Draft</span>}
                <span class="list-summary">{post.description}</span>
              </span>
            </li>
          ))}
        </ol>
        <p class="filter-status" role="status" data-filter-status />
      </section>
    )
  }

  {
    upcoming.length > 0 && (
      <section class="upcoming" aria-labelledby="coming-soon-title" data-upcoming>
        <h2 id="coming-soon-title" class="section-title">
          Coming soon
        </h2>
        <ul class="soon">
          {upcoming.map((post) => (
            <li>
              {post.thumbnail && (
                <span class="frame">
                  <img
                    src={post.thumbnail.src}
                    srcset={post.thumbnail.srcset}
                    sizes="12rem"
                    width={post.thumbnail.width}
                    height={post.thumbnail.height}
                    alt={post.thumbnail.alt}
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              )}
              <span class="soon-copy">
                <span class="soon-title">{post.title}</span>
                <span class="soon-summary">{post.description}</span>
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</div>

<script>
  // The topic filters: shown only with script. A choice narrows the list to posts with that
  // topic, says how many in the status line, and keeps the choice in the address (?topic=…)
  // so a filtered list can be shared and the back button returns to it.
  const filters = document.querySelector<HTMLElement>('[data-topic-filters]');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-post-list] > li')];
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  if (filters && rows.length > 0) {
    const buttons = [...filters.querySelectorAll<HTMLButtonElement>('button[data-topic]')];
    const apply = (topic: string, announce: boolean) => {
      const known = buttons.some((button) => button.dataset.topic === topic) ? topic : '';
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.topic === known)));
      let shown = 0;
      for (const row of rows) {
        const match = known === '' || (row.dataset.topics ?? '').split(' ').includes(known);
        row.hidden = !match;
        if (match) shown += 1;
      }
      if (status && announce) {
        const label = buttons.find((button) => button.dataset.topic === known)?.textContent?.trim() ?? '';
        status.textContent = known === '' ? `All ${shown} posts` : `${shown} ${shown === 1 ? 'post' : 'posts'} about ${label}`;
      }
    };
    filters.hidden = false;
    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        const topic = button.dataset.topic ?? '';
        const url = new URL(location.href);
        if (topic) url.searchParams.set('topic', topic);
        else url.searchParams.delete('topic');
        history.replaceState(null, '', url);
        apply(topic, true);
      }),
    );
    apply(new URL(location.href).searchParams.get('topic') ?? '', false);
  }
</script>

<style>
  /* One picture grammar: the scene at its own 1200 × 630 shape, a rounded frame with a hairline. */
  .frame {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-frame);
    background: var(--surface-2);
  }
  .frame img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.6rem;
    color: var(--text-muted);
    font-size: 0.88rem;
  }
  /* "New": a small solid label in the text's own ink, so it reads at a glance without another
     colour. Draft shares its shape, outlined. */
  .new {
    display: inline-block;
    padding: 0.12rem 0.55rem;
    border-radius: 999px;
    background: var(--text);
    color: var(--on-text);
    font-size: 0.76rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.01em;
  }
  .new.draft {
    border: 1px solid var(--border-strong);
    background: var(--ground);
    color: var(--text);
  }
  .topic {
    color: var(--text);
    font-weight: 600;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .tag {
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--text);
    font-size: 0.82rem;
    font-weight: 500;
  }

  /* 1. The featured story: the picture large, the words beside its middle. */
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    color: var(--text);
    text-decoration: none;
  }
  .feature-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.95rem;
  }
  .blog-index .feature h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .feature .summary {
    color: var(--text-muted);
    font-size: 1.06rem;
    line-height: 1.6;
    text-wrap: pretty;
  }
  .cue {
    color: var(--accent-text);
    font-size: 0.95rem;
    font-weight: 600;
  }
  .cue b {
    display: inline-block;
    transition: transform 140ms ease-out;
  }
  .feature:hover h2,
  .tile:hover h3 {
    color: var(--accent-text);
  }
  .feature:hover .cue b {
    transform: translateX(3px);
  }

  /* 2. The next posts: a row of smaller pictures under the feature. */
  .secondary {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .row li {
    margin: 0;
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    color: var(--text);
    text-decoration: none;
  }
  .tile .frame {
    margin-bottom: 0.4rem;
  }
  .blog-index .tile h3 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .tile .summary {
    color: var(--text-muted);
    font-size: 0.96rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  /* A lone post in the row lies on its side, its picture beside its words, so the row is not
     two empty columns. */
  @media (min-width: 900px) {
    .row:has(> li:only-child) {
      grid-template-columns: minmax(0, 1fr);
    }
    .row > li:only-child .tile {
      display: grid;
      grid-template-columns: minmax(0, 22rem) minmax(0, 32rem);
      grid-template-rows: auto auto 1fr;
      align-content: start;
      gap: 0.6rem clamp(1.5rem, 3vw, 2.5rem);
    }
    .row > li:only-child .frame {
      grid-row: 1 / span 3;
      margin: 0;
    }
  }

  /* 3. All posts: a dated list between hairlines. */
  .archive,
  .upcoming {
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
  }
  .upcoming .section-title {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-strong);
  }
  .archive-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-strong);
  }
  .blog-index .section-title {
    margin: 0;
    font-size: var(--step-h3);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .filters[hidden] {
    display: none;
  }
  .filters button {
    min-height: 2.25rem;
    padding: 0.3rem 0.95rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--ground);
    color: var(--text);
    font: inherit;
    font-size: 0.88rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color 140ms ease-out,
      color 140ms ease-out;
  }
  .filters button:hover {
    background: var(--surface-2);
  }
  .filters button[aria-pressed='true'] {
    border-color: var(--text);
    background: var(--text);
    color: var(--on-text);
  }
  @media (pointer: coarse) {
    .filters button {
      min-height: 44px;
    }
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .list li {
    display: grid;
    grid-template-columns: 8.5rem 8rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--border);
  }
  .list li[hidden] {
    display: none;
  }
  .list-date {
    color: var(--text-muted);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }
  .list-topic {
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .list-copy {
    display: block;
  }
  .list-title {
    color: var(--text);
    font-size: 1.12rem;
    font-weight: 600;
    line-height: 1.35;
    text-decoration: none;
  }
  .list-title:hover {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .list-copy .new {
    margin-left: 0.5rem;
    vertical-align: 0.12em;
  }
  .list-summary {
    display: block;
    margin-top: 0.3rem;
    color: var(--text-muted);
    font-size: 0.96rem;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .filter-status {
    margin: 0.75rem 0 0;
    color: var(--text-muted);
    font-size: 0.88rem;
  }
  .filter-status:empty {
    display: none;
  }

  /* 4. Coming soon: quieter, apart, and not links. */
  .soon {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1.5rem 2rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .soon li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    align-items: start;
    gap: 1rem;
    margin: 0;
  }
  .soon .frame img {
    opacity: 0.85;
  }
  .soon-copy {
    display: grid;
    gap: 0.3rem;
  }
  .soon-title {
    color: var(--text);
    font-weight: 600;
    line-height: 1.3;
  }
  .soon-summary {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .empty {
    color: var(--text-muted);
  }

  @media (max-width: 1100px) {
    .row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    .feature {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 700px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
    .list li {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0.35rem 0.9rem;
    }
    .list-copy {
      grid-column: 1 / -1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cue b,
    .filters button {
      transition: none;
    }
  }
</style>
