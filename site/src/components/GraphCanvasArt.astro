---
// The Graph and Canvas drawing (ROADMAP.md item `canvas`): the graph on the left, one hovered
// note and its links lit and a secure note a hollow ring, a canvas on the right, cards joined by
// lines, two in a group, one a note card. Shared by the roadmap's card (roadmap/RoadmapMock.astro)
// and the feature's page (features/FeatureArt.astro), so the two never drift. Decorative here:
// each caller labels or hides it.
---

<svg class="gc" viewBox="0 0 260 112">
  <g>
    <line class="gc-edge" x1="22" y1="24" x2="62" y2="12" />
    <line class="gc-edge lit" x1="62" y1="12" x2="96" y2="44" />
    <line class="gc-edge lit" x1="96" y1="44" x2="48" y2="70" />
    <line class="gc-edge lit" x1="96" y1="44" x2="88" y2="98" />
    <line class="gc-edge" x1="48" y1="70" x2="18" y2="96" />
    <line class="gc-edge" x1="22" y1="24" x2="48" y2="70" />
    <circle class="gc-node" cx="22" cy="24" r="4" />
    <circle class="gc-node" cx="62" cy="12" r="4" />
    <circle class="gc-node lit" cx="96" cy="44" r="6" />
    <circle class="gc-node" cx="48" cy="70" r="4" />
    <circle class="gc-node" cx="88" cy="98" r="4" />
    <circle class="gc-node secure" cx="18" cy="96" r="4" />
  </g>
  <line class="gc-divider" x1="128" y1="4" x2="128" y2="108" />
  <g>
    <rect class="gc-group" x="146" y="4" width="110" height="62" rx="6" />
    <rect class="gc-card" x="154" y="14" width="44" height="22" rx="4" />
    <rect class="gc-text" x="160" y="22" width="30" height="4" rx="2" />
    <rect class="gc-card" x="204" y="36" width="44" height="22" rx="4" />
    <rect class="gc-text" x="210" y="44" width="26" height="4" rx="2" />
    <line class="gc-edge" x1="198" y1="25" x2="204" y2="47" />
    <line class="gc-edge" x1="226" y1="58" x2="212" y2="80" />
    <rect class="gc-card note" x="168" y="80" width="66" height="28" rx="4" />
    <rect class="gc-text strong" x="174" y="86" width="30" height="4" rx="2" />
    <rect class="gc-text" x="174" y="94" width="50" height="3.5" rx="1.75" />
    <rect class="gc-text" x="174" y="100" width="40" height="3.5" rx="1.75" />
  </g>
</svg>

<style>
  /* SVG takes the tokens through classes; presentation attributes cannot read var(). */
  .gc {
    display: block;
    width: 100%;
    height: auto;
  }
  .gc-edge {
    stroke: var(--border-strong);
    stroke-width: 1.3;
  }
  .gc-edge.lit {
    stroke: var(--accent);
  }
  .gc-node {
    fill: var(--text-muted);
  }
  .gc-node.lit {
    fill: var(--accent);
  }
  .gc-node.secure {
    fill: var(--surface);
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }
  .gc-divider {
    stroke: var(--border);
  }
  .gc-group {
    fill: none;
    stroke: var(--border-strong);
    stroke-dasharray: 3 3;
  }
  .gc-card {
    fill: var(--surface-2);
    stroke: var(--border-strong);
  }
  .gc-card.note {
    fill: var(--surface);
  }
  .gc-text {
    fill: var(--border-strong);
  }
  .gc-text.strong {
    fill: var(--text-muted);
  }
</style>
