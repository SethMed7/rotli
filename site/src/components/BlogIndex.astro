---
// /blog/: the latest readable post as the feature (its thumbnail large beside its title,
// summary, date, and reading time), then every other post in a grid, coming-soon ones last.
// Thumbnails are the posts' own scenes (src/og.ts `postThumbnail`, rendered by
// `bun run build:brand-images`), one aspect ratio everywhere: real images with their size, so
// nothing shifts as they load, and lazy below the fold. Entries are open: a picture with its
// words under it, never a box. A coming-soon post is not a link; its picture carries the label.
import type { Thumbnail } from '../og';

export interface BlogEntry {
  /** Absent for a post that is announced but not readable yet. */
  href?: string;
  title: string;
  description: string;
  /** The date and reading time, or the draft label. */
  meta: string[];
  thumbnail?: Thumbnail;
}

interface Props {
  /** The newest readable post, if there is one. */
  featured?: BlogEntry;
  /** The rest: readable posts newest first, then the announced ones. */
  rest: BlogEntry[];
  empty: string;
}

const { featured, rest, empty } = Astro.props;
const gridTitle = rest.every((entry) => !entry.href) ? 'Coming soon' : featured ? 'More posts' : 'Posts';
---

<div class="blog-index">
{!featured && rest.length === 0 && <p class="empty">{empty}</p>}

{
  featured && (
    <section class="featured" aria-labelledby="featured-title">
      <a class="plain-link feature" href={featured.href}>
        {featured.thumbnail && (
          <span class="frame">
            <img
              src={featured.thumbnail.src}
              srcset={featured.thumbnail.srcset}
              sizes="(min-width: 960px) 44rem, calc(100vw - 2.5rem)"
              width={featured.thumbnail.width}
              height={featured.thumbnail.height}
              alt={featured.thumbnail.alt}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </span>
        )}
        <span class="feature-copy">
          <h2 id="featured-title">{featured.title}</h2>
          <span class="summary">{featured.description}</span>
          <span class="meta">
            {featured.meta.map((part, index) => (
              <>
                {index > 0 && <span aria-hidden="true">·</span>}
                <span>{part}</span>
              </>
            ))}
          </span>
          <span class="cue" aria-hidden="true">
            Read the post <b>→</b>
          </span>
        </span>
      </a>
    </section>
  )
}

{
  rest.length > 0 && (
    <section class="more" aria-labelledby="more-title">
      <h2 id="more-title" class="more-title">
        {gridTitle}
      </h2>
      <ul class="grid">
        {rest.map((entry) => {
          const picture = entry.thumbnail && (
            <span class="frame">
              <img
                src={entry.thumbnail.src}
                srcset={entry.thumbnail.srcset}
                sizes="(min-width: 1080px) 24rem, (min-width: 700px) 45vw, calc(100vw - 2.5rem)"
                width={entry.thumbnail.width}
                height={entry.thumbnail.height}
                alt={entry.thumbnail.alt}
                loading="lazy"
                decoding="async"
              />
              {!entry.href && <span class="badge">Coming soon</span>}
            </span>
          );
          return (
            <li>
              {entry.href ? (
                <a class="plain-link tile" href={entry.href}>
                  {picture}
                  <h3>{entry.title}</h3>
                  <span class="summary">{entry.description}</span>
                  <span class="meta">{entry.meta.join(' · ')}</span>
                </a>
              ) : (
                <div class="tile upcoming">
                  {picture}
                  {!entry.thumbnail && <span class="status">Coming soon</span>}
                  <h3>{entry.title}</h3>
                  <span class="summary">{entry.description}</span>
                </div>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  )
}
</div>

<style>
  /* The index sits inside the article column's .prose, whose heading margins it does not want. */
  /* One picture grammar: the scene at its own 1200 × 630 shape, a rounded frame with a hairline. */
  .frame {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-frame);
    background: var(--surface-2);
  }
  .frame img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    transition: transform 320ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  a:hover .frame img {
    transform: scale(1.025);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    color: var(--text-muted);
    font-size: 0.88rem;
  }

  /* The feature: picture and words side by side, words beside the picture's middle. */
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    color: var(--text);
    text-decoration: none;
  }
  .feature-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
  }
  .blog-index .feature h2 {
    margin: 0;
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .feature .summary {
    color: var(--text-muted);
    font-size: 1.06rem;
    line-height: 1.6;
    text-wrap: pretty;
  }
  .cue {
    margin-top: 0.3rem;
    color: var(--accent-text);
    font-size: 0.95rem;
    font-weight: 600;
  }
  .cue b {
    display: inline-block;
    transition: transform 140ms ease-out;
  }
  .feature:hover h2,
  .tile:hover h3 {
    color: var(--accent-text);
  }
  .feature:hover .cue b {
    transform: translateX(3px);
  }

  /* The rest: a grid of open entries under a small heading (and a hairline after the feature). */
  .featured + .more {
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid var(--border-strong);
  }
  .blog-index .more-title {
    margin: 0 0 clamp(1.5rem, 3vw, 2.25rem);
    font-size: var(--step-h3);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: clamp(2.25rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .grid li {
    margin: 0;
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    height: 100%;
    color: var(--text);
    text-decoration: none;
  }
  .tile .frame {
    margin-bottom: 0.6rem;
  }
  .blog-index .tile h3 {
    margin: 0;
    font-size: 1.22rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .tile .summary {
    color: var(--text-muted);
    line-height: 1.55;
    text-wrap: pretty;
  }
  .tile .meta {
    margin-top: auto;
    padding-top: 0.3rem;
  }
  /* Announced, not yet written: the label sits on the picture, which rests a little quieter. */
  .badge,
  .status {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--ground);
    color: var(--text);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
  }
  .status {
    align-self: flex-start;
  }
  .upcoming .frame img {
    opacity: 0.8;
  }
  .empty {
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .feature {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .frame img,
    .cue b {
      transition: none;
    }
    a:hover .frame img {
      transform: none;
    }
  }
</style>
