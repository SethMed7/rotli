---
// The one site footer: brand, a short tagline, and links. Both default to the
// site-wide policy in src/nav.ts; the holding page passes its own.
import mark from '../../../src/assets/characters/_logo.svg?raw';
import { footerLinks, footerTagline } from '../nav';

interface FooterLink {
  href: string;
  label: string;
}

interface Props {
  tagline?: string;
  links?: FooterLink[];
}

const { tagline = footerTagline, links = footerLinks() } = Astro.props;
---

<footer class="site-footer">
  <a class="footer-brand" href="/" aria-label="Rotli home"><span set:html={mark} aria-hidden="true"></span><b>rotli</b></a>
  <p>{tagline}</p>
  <div class="footer-actions">
    {links.length > 0 && (
      <nav aria-label="Footer navigation">
        {links.map((link) => (
          <a href={link.href} rel={link.href.startsWith('http') ? 'noopener' : undefined}>{link.label}</a>
        ))}
      </nav>
    )}
    <a
      class="launch-llama-badge"
      href="https://tools.launchllama.co?utm_source=badge&utm_medium=referral"
      target="_blank"
      rel="noopener noreferrer"
    >
      <img
        src="https://tools.launchllama.co/featured-badge.png?v=2"
        alt="Featured on Launch Llama Tools"
        width="200"
        height="52"
      />
    </a>
  </div>
</footer>
