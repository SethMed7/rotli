---
// The one site footer: brand and tagline, link columns from src/nav.ts, and a
// quiet closing row for the maker line and the two directory badges. The
// holding page passes its own tagline and an empty link list, which leaves the
// brand, tagline, and closing row.
import mark from '../../../src/assets/characters/_logo.svg?raw';
import { footerGroups, footerTagline, type FooterGroup } from '../nav';
import { site } from '../site';
import { publishedWriting } from '../writing';

interface FooterLink {
  href: string;
  label: string;
}

interface Props {
  tagline?: string;
  /** Replaces the link columns with one flat list (an empty list shows none). */
  links?: FooterLink[];
}

const { tagline = footerTagline, links } = Astro.props;
// A coming-soon build has no pages behind the columns; it shows none.
const groups: FooterGroup[] = !site.showsFullSite
  ? []
  : links === undefined
    ? footerGroups({ hasPosts: (await publishedWriting('post')).length > 0 })
    : links.length > 0
      ? [{ title: 'Links', links }]
      : [];
const external = (href: string) => href.startsWith('http');
---

<footer class="site-footer">
  <div class="footer-top">
    <div class="footer-lead">
      <a class="footer-brand" href="/" aria-label="rotli home"><span set:html={mark} aria-hidden="true"></span><b>rotli</b></a>
      <p>{tagline}</p>
    </div>
    {
      groups.length > 0 && (
        <nav class="footer-groups" aria-label="Footer navigation">
          {groups.map((group) => (
            <div class="footer-group">
              <h2>{group.title}</h2>
              <ul>
                {group.links.map((link) => (
                  <li>
                    <a href={link.href} rel={external(link.href) ? 'noopener' : undefined}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      )
    }
  </div>
  <div class="footer-bottom">
    <p>Designed and built by Seth Medina.</p>
    <div class="footer-badges">
      <a
        class="footer-badge"
        href="https://tools.launchllama.co?utm_source=badge&utm_medium=referral"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          src="https://tools.launchllama.co/featured-badge.png?v=2"
          alt="Featured on Launch Llama Tools"
          width="200"
          height="52"
          loading="lazy"
          decoding="async"
        />
      </a>
      <a
        class="footer-badge"
        href="https://www.founder.best/products/rotli?ref=founderbest"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          src="https://www.founder.best/api/badge/rotli/light"
          alt="Rotli - Featured on Founder.best"
          width="250"
          height="54"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
  </div>
</footer>
