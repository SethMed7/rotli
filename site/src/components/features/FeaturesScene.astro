---
// The picture at the top of /features/ (the owner, 2026-10-06: "put some imagery at the top of
// features page"): the quokka at its desk with its laptop, and around it three windows of the
// app in the feature pages' panel language (a surface, a hairline, a file name on top): a note
// with its tasks in three states, a chat answering from that note, and a board mapping the
// launch (the board is the real capture, public/shots/board.webp; the note and the chat are
// drawn in HTML from the same synthetic launch vault as the captures, so their words stay
// legible at any size, where a shrunken capture would not).
//
// Plain images, HTML, and CSS: nothing moves, no script, no inline style (the production CSP
// drops it). Sizes are in container units, so the whole scene scales as one picture and never
// spills out of its column. Decoration only: the headline beside it says the same in words, so
// it is hidden from assistive technology. On a phone the board steps out and the note and the
// chat take the width, so what is left stays readable.
import aiChat from '../../../../src/assets/characters/filled/cocoa/ai_chat.webp';
---

<div class="fscene" aria-hidden="true">
  <div class="frame">
    <div class="win note">
      <p class="win-name">launch-week.md</p>
      <div class="win-body">
        <p class="note-title">Launch week</p>
        <p class="note-sub">This week</p>
        <ul class="tasks">
          <li class="done"><span class="box"></span>Ship the Mac beta</li>
          <li class="doing"><span class="box"></span>Update the pricing page</li>
          <li><span class="box"></span>Record the demo</li>
        </ul>
      </div>
    </div>
    <div class="win chat">
      <p class="win-name">Chat · Q4 launch plan</p>
      <div class="win-body">
        <p class="ask">What did I ship, and what’s next?</p>
        <p class="answer"><b>Shipped:</b> the Mac beta.</p>
        <p class="answer"><b>Next:</b> record the demo with Maya.</p>
      </div>
    </div>
    <div class="win board">
      <p class="win-name">launch-map.excalidraw</p>
      <img src="/shots/board.webp" width="750" height="235" alt="" decoding="async" />
    </div>
    <div class="desk">
      <img class="quokka" src={aiChat.src} width="512" height="512" alt="" decoding="async" />
      <svg class="table" viewBox="0 0 400 60" role="presentation">
        <rect class="top" x="2" y="2" width="396" height="13" rx="5"></rect>
        <rect class="edge" x="10" y="15" width="380" height="6"></rect>
        <rect class="leg" x="34" y="21" width="12" height="39"></rect>
        <rect class="leg" x="354" y="21" width="12" height="39"></rect>
      </svg>
    </div>
  </div>
</div>

<style>
  /* One coordinate box: every piece placed in percentages of it and sized in container units
     (cqi, a hundredth of its width), so the composition holds at every width. */
  .fscene {
    container-type: inline-size;
    width: 100%;
  }
  .frame {
    position: relative;
    aspect-ratio: 10 / 8;
  }
  .win {
    position: absolute;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: 0.7rem;
    background: var(--capture-ground);
    color: var(--text);
  }
  .win p {
    margin: 0;
  }
  .win-name {
    flex: none;
    padding: 1.4cqi 2.4cqi;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: max(0.66rem, 2.3cqi);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .win-body {
    display: grid;
    align-content: start;
    gap: 1.6cqi;
    padding: 2.8cqi 3.2cqi;
    font-size: max(0.72rem, 2.9cqi);
    line-height: 1.35;
  }

  /* The note, at the back on the left: its title and its tasks, drawn as the editor draws them. */
  .note {
    top: 0;
    left: 0;
    width: 56%;
  }
  .note-title {
    font-size: 1.45em;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .note-sub {
    margin-top: 0.4em;
    font-weight: 600;
  }
  .tasks {
    display: grid;
    gap: 1.2cqi;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tasks li {
    display: flex;
    align-items: center;
    gap: 0.55em;
    white-space: nowrap;
  }
  .box {
    flex: none;
    width: 1em;
    height: 1em;
    border: 1.5px solid var(--border-strong);
    border-radius: 0.22em;
  }
  .done {
    color: var(--text-muted);
    text-decoration: line-through;
  }
  .done .box {
    border-color: var(--accent);
    background: var(--accent);
  }
  .doing .box {
    border-color: var(--accent);
    background: linear-gradient(90deg, var(--tint) 50%, transparent 50%);
  }

  /* The chat, in front on the right: the question, and the answer from the note. */
  .chat {
    top: 14%;
    right: 0;
    width: 50%;
  }
  .ask {
    justify-self: end;
    max-width: 92%;
    padding: 0.45em 0.75em;
    border-radius: 0.9em;
    background: var(--tint);
  }
  .answer b {
    font-weight: 600;
  }

  /* The board, low on the left: the launch map's three boxes, the real capture. */
  .board {
    top: 60%;
    left: 3%;
    width: 50%;
  }
  .board img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The desk, front right, with the quokka at it, standing in front of the windows. */
  .desk {
    position: absolute;
    right: 4%;
    bottom: 0;
    width: 42%;
    display: grid;
    justify-items: center;
  }
  .quokka {
    width: 74%;
    height: auto;
    margin-bottom: -15%;
  }
  .table {
    display: block;
    width: 100%;
    height: auto;
  }
  .top {
    fill: var(--wood);
    stroke: var(--ink);
    stroke-width: 2.5;
  }
  .edge,
  .leg {
    fill: var(--wood-dark);
  }

  /* A phone: the board steps out; the note and the chat take the width, the chat just under
     the note's tasks, and the desk sits low on the left. */
  @container (max-width: 30rem) {
    .frame {
      aspect-ratio: 10 / 10.5;
    }
    .note {
      width: 74%;
    }
    .chat {
      top: 44%;
      width: 68%;
    }
    .board {
      display: none;
    }
    .desk {
      left: 0;
      right: auto;
      width: 40%;
    }
  }
</style>
