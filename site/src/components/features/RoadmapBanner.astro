---
// The catalog's close (the owner, 2026-10-07: "a banner style graphic" in place of the one
// line that pointed at the roadmap): one framed panel like the landing page's close
// (landing/Closing.astro), with a two-tone headline, one line, a button to /roadmap/, and on
// the right the roadmap's own picture cut down to a strip (RoadmapScene.astro): the quokka with
// its magnifying glass on the sand (fading in from the words' side) beside the signpost, whose three boards name the roadmap's
// three kinds of item. Drawn in SVG with the site's tokens, so it follows the theme. The words
// carry the meaning; the art is hidden from assistive technology. On narrow screens the art
// steps below the words instead of beside them.
import searching from '../../../../src/assets/characters/filled/cocoa/searching.webp';
import { VOTING_OPEN } from '../../roadmap';
---

<section class="roadmap-banner" aria-labelledby="roadmap-banner-title">
  <div class="panel">
    <div class="copy">
      <h2 id="roadmap-banner-title">
        <span class="strong">Wondering what comes next?</span>
        <span class="soft">{VOTING_OPEN ? 'Vote for it on the roadmap.' : 'See it on the roadmap.'}</span>
      </h2>
      <p class="line">
        {
          VOTING_OPEN
            ? 'See what is being built and what is planned, vote for what you want, or ask for something new.'
            : 'See what is being built and what is planned, or ask for something new.'
        }
      </p>
      <a class="button primary" href="/roadmap/">See the roadmap</a>
    </div>
    <div class="art" aria-hidden="true">
      <svg viewBox="0 0 640 420" role="presentation" focusable="false" preserveAspectRatio="xMaxYMax slice">
        <defs>
          <linearGradient id="roadmap-banner-fade" gradientUnits="userSpaceOnUse" x1="40" x2="260" y1="0" y2="0">
            <stop offset="0" stop-color="#fff" stop-opacity="0" />
            <stop offset="1" stop-color="#fff" stop-opacity="1" />
          </linearGradient>
          <mask id="roadmap-banner-ground" maskUnits="userSpaceOnUse" x="-900" y="0" width="1560" height="430">
            <rect x="-900" y="0" width="1560" height="430" fill="url(#roadmap-banner-fade)" />
          </mask>
        </defs>
        <g mask="url(#roadmap-banner-ground)">
          <path class="dune" d="M-900 318C-500 306-200 326 120 312S520 304 650 318V430H-900Z" />
          <path class="sand" d="M-900 372C-500 362-160 380 160 368S560 360 650 372V430H-900Z" />
        </g>

        <g class="post">
          <ellipse class="mound" cx="500" cy="392" rx="54" ry="10" />
          <rect class="pole" x="491" y="70" width="18" height="322" rx="5" />
          <path class="board b1" d="M400 92h172l30 28-30 28H400z" />
          <text class="label on-dark" x="418" y="128">Building</text>
          <path class="board b2" d="M590 172H426l-30 28 30 28h164z" />
          <text class="label" x="440" y="208">Planned</text>
          <path class="board b3" d="M400 252h150l30 28-30 28H400z" />
          <text class="label" x="418" y="288">Ideas</text>
        </g>

        <image class="quokka" href={searching.src} x="70" y="96" width="340" height="340" />
      </svg>
    </div>
  </div>
</section>

<style>
  .roadmap-banner {
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
  }
  /* One frame, the warm band's colour, the art clipped by its edge. */
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-frame);
    background: var(--surface-2);
  }
  /* The words sit above the art, whose ground runs on under them; the art never takes a click. */
  .copy {
    position: relative;
    z-index: 1;
    display: grid;
    align-content: center;
    justify-items: start;
    padding: clamp(2.25rem, 5vw, 4rem) clamp(1.5rem, 5vw, 4rem);
  }
  h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3.2vw, 2.75rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.035em;
  }
  h2 span {
    display: block;
    text-wrap: balance;
  }
  .soft {
    color: var(--text-muted);
  }
  .line {
    max-width: 32rem;
    margin: 1rem 0 0;
    color: var(--text-muted);
    font-size: var(--step-lede);
    line-height: 1.55;
  }
  .button {
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }

  .art {
    position: relative;
    min-height: 18rem;
    pointer-events: none;
  }
  /* Anchored bottom right; the ground runs on past the art's left edge, under the words, and
     fades out before it reaches them. */
  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .dune,
  .sand {
    stroke: var(--ink);
    stroke-width: 4.5;
    stroke-linejoin: round;
  }
  .dune {
    fill: var(--limestone);
  }
  .sand {
    fill: var(--sand);
  }
  .pole,
  .board,
  .mound {
    stroke: var(--ink);
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .pole {
    fill: var(--wood);
    stroke-width: 6;
  }
  .board {
    stroke-width: 6;
  }
  .b1 {
    fill: var(--accent);
  }
  .b2 {
    fill: var(--lantern);
  }
  .b3 {
    fill: var(--olive-bright);
  }
  .mound {
    fill: var(--limestone);
    stroke-width: 4.5;
  }
  .label {
    fill: var(--ink);
    font-family: inherit;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .label.on-dark {
    fill: var(--capture-ground);
  }

  /* Narrow: the words first, then the art as a strip along the bottom of the frame. */
  @media (max-width: 820px) {
    .panel {
      grid-template-columns: minmax(0, 1fr);
    }
    .copy {
      padding-bottom: 0.5rem;
    }
    .art {
      min-height: 15rem;
    }
  }
</style>
