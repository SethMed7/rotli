---
// One capability in the catalog: the whole tile is the link to its page, so a click, a tap,
// or Enter opens it. A bare line icon in the ink, level with the name's first line, then the
// name, one sentence, and one plain availability line ("Available on Mac and Web",
// `availabilityOf` in src/features.ts). No box anywhere (the owner, 2026-10-06: "remove cards
// around all of the icons and the dot by shipped"): a hairline above, like the guides' index,
// and on hover only the name underlines. The catalog's filter reads the data attributes;
// nothing here needs script.
import { areaOf, availabilityOf, featurePath, type Feature } from '../../features';

interface Props {
  feature: Feature;
  /** Name and availability only, for "More in …" under a feature's page. */
  compact?: boolean;
}

const { feature, compact = false } = Astro.props;
const area = areaOf(feature);
const available = availabilityOf(feature);
const search = [
  feature.name,
  feature.line,
  feature.keywords ?? '',
  ...(feature.sections ?? []).map((section) => section.title),
  area.name,
  available,
]
  .join(' ')
  .toLowerCase();
---

<li class:list={['tile', { compact }]} data-feature={feature.id} data-area={feature.area} data-search={search}>
  <a href={featurePath(feature)}>
    <svg
      class="icon"
      viewBox="0 0 24 24"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d={feature.icon} />
    </svg>
    <h3 class="name">{feature.name}</h3>
    {!compact && <p class="line">{feature.line}</p>}
    <p class="availability" data-status={feature.status.toLowerCase().replace(/\s+/g, '-')}>{available}</p>
  </a>
</li>

<style>
  .tile {
    display: flex;
    min-width: 0;
    border-top: 1px solid var(--border-strong);
  }
  .tile[hidden] {
    display: none;
  }
  a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto 1fr auto;
    gap: 0.35rem 0.85rem;
    width: 100%;
    padding: 1.25rem 0 1.4rem;
    color: var(--text);
    text-decoration: none;
  }
  a:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }
  /* The icon sits on the name's first line: the name is 1.08rem at line-height 1.3, so its
     line box is about 1.4rem tall, and a 22px icon centred in it starts ~0.1rem down. */
  .icon {
    grid-row: 1 / span 3;
    width: 22px;
    height: 22px;
    margin-top: 0.12rem;
    color: var(--text);
  }
  .name {
    margin: 0;
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  a:hover .name {
    text-decoration-line: underline;
  }
  .line {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .availability {
    margin: 0.35rem 0 0;
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.45;
  }
  .compact a {
    grid-template-rows: auto auto;
  }
  .compact .icon {
    grid-row: 1 / span 2;
  }
</style>
