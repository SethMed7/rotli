---
// The site's one way in, defined once: "Try now", to /download/, which offers the Mac app
// and Rotli Web and leads with the visitor's own system (the owner, 2026-10-05: "Try now"
// instead of "Download"). Direct DMG links live only on that page. A deployment that offers
// neither (no downloads, no Rotli Web) says so instead of linking to an empty page.
import { site } from '../site';

const offered = site.downloadsEnabled || site.webAppEnabled;
---

<div class="site-actions">
  {
    offered ? (
      <a class="button primary action-try" href="/download/">
        Try now
      </a>
    ) : (
      <span class="button primary pending" aria-disabled="true">
        Mac alpha coming soon
      </span>
    )
  }
</div>
