---
// The way in, defined once (WAY_IN in src/site.ts): "Download free", to /download/, which
// offers the Mac app and Rotli Web and leads with the visitor's own system. The header's button
// says the same (the owner, 2026-10-06). One that offers neither says so instead of linking to an
// empty page. Direct DMG links live only on /download/. A page may pass a secondary button
// after it (the hero's privacy promise); it sits in the same row, at the same size.
import { WAY_IN } from '../site';
---

<div class="site-actions">
  {
    WAY_IN.offered ? (
      <a class="button primary action-try" href={WAY_IN.href}>
        {WAY_IN.label}
      </a>
    ) : (
      <span class="button primary pending" aria-disabled="true">
        Mac alpha coming soon
      </span>
    )
  }
  <slot />
</div>
