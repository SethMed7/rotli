---
// An index of writing: title, one line, and an optional date or label.
interface Item {
  href: string;
  title: string;
  description: string;
  meta?: string;
}

interface Props {
  items: Item[];
  empty: string;
}

const { items, empty } = Astro.props;
---

{
  items.length === 0 ? (
    empty && <p class="empty">{empty}</p>
  ) : (
    <ul class="writing-list">
      {items.map((item) => (
        <li class="writing-item">
          <a class="plain-link" href={item.href}>
            <strong>{item.title}</strong>
            <span>{item.description}</span>
            {item.meta && <small>{item.meta}</small>}
            <em aria-hidden="true">Read <b>→</b></em>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  /* Two columns of plain entries on the grid: a hairline above each, no box. */
  .writing-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 0 clamp(2rem, 5vw, 4rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .writing-list .writing-item {
    margin: 0;
    border-top: 1px solid var(--border-strong);
  }
  .writing-list a {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    height: 100%;
    padding: 1.4rem 0 1.8rem;
    color: var(--text);
    text-decoration: none;
  }
  .writing-list strong {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }
  .writing-list span {
    color: var(--text-muted);
    line-height: 1.55;
  }
  .writing-list small {
    color: var(--text-muted);
    font-size: 0.84rem;
  }
  .writing-list em {
    margin-top: auto;
    padding-top: 0.6rem;
    color: var(--accent-text);
    font-size: 0.92rem;
    font-style: normal;
    font-weight: 600;
  }
  .writing-list b {
    display: inline-block;
    transition: transform 140ms ease-out;
  }
  .writing-list a:hover strong {
    color: var(--accent-text);
  }
  .writing-list a:hover b {
    transform: translateX(3px);
  }
  .empty {
    color: var(--text-muted);
  }
</style>
