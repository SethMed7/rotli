---
// "On this page" for /roadmap/: a link per group, each with how many items it holds. From
// 901px it is a column in a post's rail (blog/article.css) beside the groups, pinned under the
// header as you read, with the group in view marked (aria-current, a bar and the text's weight,
// so colour is never the only sign).
// Narrower, the same links wrap as a row of chips under the head, in the flow (a pinned bar
// would cover the list on a phone). The marking is script; without it the links still jump.
import { ROADMAP_URL, site } from '../../site';

interface Props {
  links: { slug: string; label: string; count?: number }[];
}

const { links } = Astro.props;
---

<nav class="road-nav" aria-label="On this page" data-roadmap-nav>
  <p class="nav-title">On this page</p>
  <ul>
    {
      links.map((link) => (
        <li>
          <a href={`#${link.slug}`}>
            <span>{link.label}</span>
            {link.count !== undefined && (
              <span class="nav-count">
                {link.count}
                <span class="visually-hidden"> items</span>
              </span>
            )}
          </a>
        </li>
      ))
    }
  </ul>
  {
    site.sourcePublic && (
      <a class="nav-source" href={ROADMAP_URL} rel="noopener">
        Roadmap source
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M6 3.5h6.5V10M12.5 3.5 4 12" />
        </svg>
      </a>
    )
  }
</nav>

<script>
  // Mark the group being read: the last one whose heading has passed under the pinned header.
  const nav = document.querySelector<HTMLElement>('[data-roadmap-nav]');
  const links = nav ? [...nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')] : [];
  const targets = links
    .map((link) => document.getElementById(link.hash.slice(1)))
    .filter((target): target is HTMLElement => target !== null);
  let frame = 0;
  function mark() {
    frame = 0;
    const line = (parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-height')) || 68) + 96;
    let current = -1;
    targets.forEach((target, index) => {
      if (target.getBoundingClientRect().top <= line) current = index;
    });
    // At the very bottom the last group is the one being read, however short it is.
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) current = targets.length - 1;
    links.forEach((link, index) => {
      if (index === current) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
  }
  if (targets.length > 0) {
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(mark);
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    mark();
  }
</script>

<style>
  .road-nav {
    font-size: 0.92rem;
  }
  .nav-title {
    margin: 0 0 0.6rem;
    color: var(--text-muted);
    font-size: 0.84rem;
    font-weight: 600;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    color: var(--text);
    text-decoration: none;
  }
  ul a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-weight: 500;
  }
  ul a:hover {
    background: var(--surface-2);
  }
  ul a:focus-visible,
  .nav-source:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 2px;
  }
  .nav-count {
    color: var(--text-muted);
    font-size: 0.84rem;
    font-variant-numeric: tabular-nums;
  }
  ul a[aria-current='true'] {
    border-color: var(--text);
    font-weight: 600;
  }
  /* Narrower, the head's own "Roadmap source" line is a few lines above. */
  .nav-source {
    display: none;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    margin-top: 0.5rem;
    color: var(--accent-text);
    font-weight: 600;
  }
  .nav-source svg {
    width: 0.8rem;
    height: 0.8rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Wide: a column of plain links on a hairline rail, pinned under the header. */
  @media (min-width: 901px) {
    .road-nav {
      position: sticky;
      top: calc(var(--header-height) + 2rem);
      align-self: start;
    }
    ul {
      flex-direction: column;
      gap: 0;
      border-left: 1px solid var(--border);
    }
    ul a {
      display: flex;
      justify-content: space-between;
      min-height: 40px;
      margin-left: -1px;
      padding: 0.4rem 0.25rem 0.4rem 0.95rem;
      border: 0;
      border-left: 2px solid transparent;
      border-radius: 0;
      color: var(--text-muted);
    }
    ul a:hover {
      background: none;
      color: var(--text);
    }
    ul a[aria-current='true'] {
      border-left-color: var(--accent-text);
      color: var(--text);
    }
    .nav-source {
      display: inline-flex;
      margin-top: 1rem;
      padding-left: 0.95rem;
    }
  }
</style>
