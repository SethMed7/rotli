---
// "Ask for something" on /roadmap/: the feature-request form, posted to the site's sidecar
// (site/server/roadmap.ts, which enforces the same limits from src/roadmap.ts). Beside it, what
// happens to a request, in the words of /privacy/'s "This website" section. No email is needed;
// one is asked for only to follow up. States, all on the form's data-state and said in words:
//   off      the sidecar isn't live (the page's probe): every field disabled, "Requests open soon."
//   ready    the browser's own checks without script; with it, each field's limit said beside it,
//            focus on the first field to fix
//   sending  the button waits ("Sending…")
//   done     the form gives way to a thank-you block, focused, with "Send another"
//   error    the sidecar's reason, on the field it names when it names one
// A request posted without script is redirected to #request-sent, the same thank-you block.
import { REQUEST_LIMITS } from '../../roadmap';
---

<div class="request-layout">
  <div class="request-main">
    <div class="request-sent" id="request-sent" tabindex="-1" data-request-done>
      <p class="sent-title">Thanks. Your request is in.</p>
      <p>
        The person building rotli reads every one. If it makes the roadmap, it shows up on this page in our own
        words.
      </p>
      <a href="#request" data-request-again>Send another</a>
    </div>
    <form class="request-form" action="/api/roadmap/request" method="post" data-request aria-labelledby="request-title">
      <div class="field">
        <label for="request-title-input">What should rotli do?</label>
        <p class="field-hint" id="request-title-hint">
          A short title, {REQUEST_LIMITS.title.min} to {REQUEST_LIMITS.title.max} characters.
        </p>
        <input
          id="request-title-input"
          name="title"
          type="text"
          required
          minlength={REQUEST_LIMITS.title.min}
          maxlength={REQUEST_LIMITS.title.max}
          autocomplete="off"
          aria-describedby="request-title-hint request-title-error"
        />
        <p class="field-error" id="request-title-error" data-error-for="title"></p>
      </div>
      <div class="field">
        <label for="request-description">Tell us more</label>
        <p class="field-hint" id="request-description-hint">
          What would you use it for? What do you do today instead?
        </p>
        <textarea
          id="request-description"
          name="description"
          rows="5"
          required
          minlength={REQUEST_LIMITS.description.min}
          maxlength={REQUEST_LIMITS.description.max}
          aria-describedby="request-description-hint request-description-error"></textarea>
        <p class="field-error" id="request-description-error" data-error-for="description"></p>
      </div>
      <div class="field">
        <label for="request-email">Email <span class="optional">(optional)</span></label>
        <p class="field-hint" id="request-email-hint">
          Not needed. Only if you’d like a reply about this request; it doesn’t join any list.
        </p>
        <input
          id="request-email"
          name="email"
          type="email"
          maxlength="254"
          autocomplete="email"
          aria-describedby="request-email-hint request-email-error"
        />
        <p class="field-error" id="request-email-error" data-error-for="email"></p>
      </div>
      <div class="trap" aria-hidden="true">
        <label>Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>
      <p class="consent" id="request-consent">
        By sending, you agree that we keep what you typed (and your email, if you gave one) so we can read it and
        reply. It isn’t shared or published.
      </p>
      <div class="form-foot">
        <button class="button primary" type="submit" aria-describedby="request-consent">Send request</button>
        <p class="form-status" role="status" data-request-status></p>
      </div>
    </form>
  </div>

  <aside class="request-notes" aria-labelledby="request-notes-title">
    <h3 id="request-notes-title">What happens to a request</h3>
    <ul>
      <li>
        <b>Kept:</b> the title, the description, an email only if you give one, and when it arrived. No
        cookies, no account.
      </li>
      <li>
        <b>Against spam:</b> the site briefly holds a scrambled key made from your IP address and the day, never
        the address itself, in the server’s memory only.
      </li>
      <li><b>Where:</b> a small database on our host, Railway, read only by the person building rotli.</li>
      <li>
        <b>Never published.</b> If an idea makes the roadmap, it’s written here in our own words. Your email is
        never added to the site’s email list.
      </li>
      <li><b>Deleting it:</b> send another request saying so.</li>
    </ul>
    <a href="/privacy/#website">How the site handles it</a>
  </aside>
</div>

<script>
  import { REQUEST_LIMITS } from '../../roadmap';

  // The request form's states (see the component's header). The page's probe calls
  // `roadmap:live` on the document with { live } once it knows whether the sidecar is on.
  const form = document.querySelector<HTMLFormElement>('[data-request]');
  const status = form?.querySelector<HTMLElement>('[data-request-status]') ?? null;
  const done = document.querySelector<HTMLElement>('[data-request-done]');
  const again = document.querySelector<HTMLAnchorElement>('[data-request-again]');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]') ?? null;
  const FAILED = 'That did not go through. Try again in a moment.';

  type Field = HTMLInputElement | HTMLTextAreaElement;
  const messages: Record<string, (field: Field) => string> = {
    title: (field) =>
      field.value.trim().length === 0
        ? 'Give it a short title.'
        : `A short title, ${REQUEST_LIMITS.title.min} to ${REQUEST_LIMITS.title.max} characters.`,
    description: (field) =>
      field.value.trim().length === 0
        ? 'Say a little more about it.'
        : `A little more, please: at least ${field.minLength} characters.`,
    email: () => 'That email address does not look right.',
  };

  function setState(state: 'off' | 'ready' | 'sending' | 'done' | 'error', text = '') {
    if (!form) return;
    form.setAttribute('data-state', state);
    if (status) status.textContent = text;
  }

  function showError(name: string, text: string) {
    if (!form) return;
    const field = form.elements.namedItem(name) as Field | null;
    const slot = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
    if (slot) slot.textContent = text;
    field?.setAttribute('aria-invalid', text ? 'true' : 'false');
  }

  function check(): boolean {
    if (!form) return false;
    let first: Field | null = null;
    for (const name of ['title', 'description', 'email']) {
      const field = form.elements.namedItem(name) as Field;
      const value = field.value.trim();
      const bad =
        (field.required && value.length === 0) ||
        (value.length > 0 && field.minLength > 0 && value.length < field.minLength) ||
        (field.type === 'email' && value.length > 0 && !field.checkValidity());
      showError(name, bad ? messages[name](field) : '');
      if (bad && !first) first = field;
    }
    first?.focus();
    return first === null;
  }

  function showForm() {
    if (!form || !done) return;
    done.classList.remove('is-shown');
    form.hidden = false;
    setState('ready');
  }

  document.addEventListener('roadmap:live', (event) => {
    if (!form) return;
    const live = (event as CustomEvent<{ live: boolean }>).detail.live;
    for (const control of form.elements) (control as HTMLInputElement).disabled = !live;
    setState(live ? 'ready' : 'off', live ? '' : 'Requests open soon.');
  });

  // Once a field has said what's wrong, it clears as soon as it's right.
  form?.addEventListener('input', (event) => {
    const field = event.target as Field;
    if (field.getAttribute('aria-invalid') !== 'true') return;
    const value = field.value.trim();
    const fixed =
      value.length >= (field.minLength > 0 ? field.minLength : 1) &&
      (field.type !== 'email' || field.checkValidity());
    if (fixed || (field.type === 'email' && value.length === 0)) showError(field.name, '');
  });

  again?.addEventListener('click', (event) => {
    event.preventDefault();
    showForm();
    form?.querySelector<HTMLInputElement>('input[name="title"]')?.focus();
  });

  if (form) {
    form.noValidate = true;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (form.getAttribute('data-state') === 'sending' || !check()) return;
      const fields = Object.fromEntries(
        [...new FormData(form)].filter((entry): entry is [string, string] => typeof entry[1] === 'string'),
      );
      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Sending…';
      }
      setState('sending');
      try {
        const res = await fetch('/api/roadmap/request', {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify(fields),
        });
        const body = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string; field?: string };
        if (!res.ok || body.ok !== true) {
          if (body.field) showError(body.field, body.error ?? '');
          throw new Error(body.error || FAILED);
        }
        form.reset();
        form.hidden = true;
        setState('done', 'Thanks. Your request is in.');
        done?.classList.add('is-shown');
        done?.focus();
      } catch (error) {
        setState('error', error instanceof Error ? error.message : FAILED);
      } finally {
        if (submit) {
          submit.disabled = false;
          submit.textContent = 'Send request';
        }
      }
    });
  }
</script>

<style>
  .request-layout {
    display: grid;
    gap: 2rem clamp(2rem, 4vw, 3.5rem);
  }
  @media (min-width: 900px) {
    .request-layout {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      align-items: start;
    }
  }
  .request-form {
    display: grid;
    gap: 1.2rem;
  }
  .request-form[hidden] {
    display: none;
  }
  .field label {
    display: block;
    font-weight: 600;
  }
  .optional {
    color: var(--text-muted);
    font-weight: 400;
  }
  .field-hint {
    margin: 0.15rem 0 0;
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  .field input,
  .field textarea {
    display: block;
    width: 100%;
    min-height: 44px;
    margin-top: 0.45rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--border-strong);
    border-radius: 0.6rem;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
  }
  .field textarea {
    min-height: 8.5rem;
    resize: vertical;
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 1px;
  }
  .field [aria-invalid='true'] {
    border-color: var(--accent-text);
    border-width: 2px;
  }
  .field input:disabled,
  .field textarea:disabled {
    border-style: dashed;
    background: var(--surface-2);
    color: var(--text-muted);
    cursor: not-allowed;
  }
  .field-error {
    display: flex;
    gap: 0.4rem;
    margin: 0.4rem 0 0;
    color: var(--accent-text);
    font-size: 0.92rem;
    font-weight: 600;
  }
  .field-error::before {
    content: '!';
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.1rem;
    border-radius: 50%;
    background: var(--accent-text);
    color: var(--on-accent);
    font-size: 0.75rem;
    line-height: 1;
  }
  .field-error:empty {
    display: none;
  }
  .trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .consent {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .form-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }
  .form-foot .button {
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .form-foot .button:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }
  .form-status {
    margin: 0;
    color: var(--text-muted);
  }
  .request-form[data-state='error'] .form-status {
    color: var(--accent-text);
    font-weight: 600;
  }
  .request-form[data-state='sending'] .form-status {
    color: var(--text);
  }

  /* The thank-you block: shown after a send (script) or on #request-sent (no script). */
  .request-sent {
    display: none;
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--accent-text);
    border-radius: var(--radius-frame);
    background: var(--tint);
  }
  .request-sent:target,
  .request-sent.is-shown {
    display: block;
  }
  .request-sent:focus {
    outline: 2px solid var(--accent-text);
    outline-offset: 2px;
  }
  .request-sent p {
    margin: 0 0 0.75rem;
    line-height: 1.55;
  }
  .request-sent .sent-title {
    margin-bottom: 0.35rem;
    font-size: 1.08rem;
    font-weight: 600;
  }
  .request-sent a,
  .request-notes a {
    color: var(--accent-text);
    font-weight: 600;
    text-underline-offset: 0.2em;
  }

  /* Beside the form: the privacy page's promise for requests, as a short list on a rule. */
  .request-notes {
    padding-left: clamp(0rem, 2vw, 1.5rem);
    border-left: 1px solid var(--border);
    font-size: 0.94rem;
  }
  .request-notes h3 {
    margin: 0 0 0.75rem;
    font-size: 1rem;
    font-weight: 600;
  }
  .request-notes ul {
    display: grid;
    gap: 0.6rem;
    margin: 0 0 1rem;
    padding: 0;
    color: var(--text-muted);
    line-height: 1.5;
    list-style: none;
  }
  .request-notes b {
    color: var(--text);
    font-weight: 600;
  }
  @media (max-width: 899px) {
    .request-notes {
      padding: 1.25rem 0 0;
      border-top: 1px solid var(--border);
      border-left: 0;
    }
  }
  @media (pointer: coarse) {
    .request-notes a,
    .request-sent a {
      display: inline-block;
      padding-block: 0.7rem;
      margin-block: -0.45rem;
    }
  }
</style>
