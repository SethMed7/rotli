---
// The roadmap's picture, beside its title (RoadmapHead.astro), drawn like a blog post's cover
// (scripts/brand-images/scenes.mjs: the island by day, the app's quokka, the post's props) at
// the cover's own shape, 1300 × 900, so the head reads like a post's. On the beach: the quokka
// with its magnifying glass, a map on the left whose dotted route runs through a done stop, a
// stop being reached, and an open one, and a signpost on the right pointing three ways (what's
// being built, what's planned, what's still an idea). Drawn in SVG with the site's tokens and
// the quokka's own art, so nothing is fetched and it follows the theme's ground. Decorative:
// the words beside it say what the page is, so it is hidden from assistive technology.
// Below 1000px it runs the page's width in a wider frame, like a post's banner (the owner,
// 2026-10-09: at about 960 it sat at half the width): the drawing stays whole in the middle,
// standing on the frame's floor, and its sky, sea, dunes, and sand run on past its edges.
import searching from '../../../../src/assets/characters/filled/cocoa/searching.webp';
---

<div class="scene" aria-hidden="true" data-roadmap-art>
  <svg viewBox="0 0 1300 900" preserveAspectRatio="xMidYMax meet" role="presentation" focusable="false">
    <rect class="sky" x="-1300" width="3900" height="900" />

    <g class="cloud">
      <ellipse cx="560" cy="150" rx="96" ry="26" />
      <ellipse cx="506" cy="156" rx="54" ry="20" />
      <ellipse cx="604" cy="138" rx="60" ry="26" />
      <path class="rim" d="M456 176q90 12 220 2" />
    </g>
    <g class="cloud">
      <ellipse cx="1090" cy="96" rx="70" ry="20" />
      <ellipse cx="1052" cy="100" rx="40" ry="15" />
      <ellipse cx="1122" cy="88" rx="44" ry="19" />
      <path class="rim" d="M1014 114q66 9 160 1" />
    </g>

    <!-- the far islet and its lighthouse, on the horizon -->
    <path class="islet" d="M90 474C130 446 190 430 240 430S340 446 380 474Z" />
    <g class="lighthouse">
      <path class="tower" d="M230 434l5-96h18l5 96z" />
      <rect class="gallery" x="226" y="332" width="36" height="7" />
      <rect class="lantern" x="234" y="310" width="20" height="22" />
      <path class="cap" d="M231 310q13-17 26 0z" />
    </g>

    <!-- the bay -->
    <rect class="sea" x="-1300" y="470" width="3900" height="260" />
    <rect class="sea-edge" x="-1300" y="470" width="3900" height="16" />
    <path class="waves" d="M90 540q16-8 32 0M330 600q16-8 32 0M760 560q16-8 32 0M1150 620q16-8 32 0M560 650q14-7 28 0" />

    <!-- the dunes and the sand -->
    <path class="dune" d="M-1310 702C-1080 690 -860 714 -650 700S-220 688 -10 700C200 684 420 712 650 698S1080 686 1310 704C1540 716 1760 690 1980 700S2400 712 2610 702V910H-1310Z" />
    <ellipse class="scrub" cx="120" cy="702" rx="64" ry="20" />
    <ellipse class="scrub" cx="1230" cy="700" rx="52" ry="17" />
    <path class="sand" d="M-1310 792C-1080 780 -840 798 -600 788S-210 776 -10 790C230 776 470 800 700 786S1090 774 1310 792C1540 804 1770 782 2000 790S2400 800 2610 792V910H-1310Z" />

    <!-- the map: a route through a stop that's done, one being reached, and one still open -->
    <g class="map" transform="rotate(-7 190 760)">
      <path class="paper" d="M70 640l80-14 80 14 80-14v222l-80 14-80-14-80 14z" />
      <path class="fold" d="M150 626v222M230 640v222" />
      <path class="route" d="M104 818C130 760 170 790 196 740S270 700 284 668" />
      <circle class="stop done" cx="104" cy="818" r="15" />
      <path class="tick" d="M97 818l5 6 10-12" />
      <circle class="stop now" cx="196" cy="740" r="15" />
      <path class="half" d="M196 725a15 15 0 0 1 0 30z" />
      <circle class="stop open" cx="284" cy="668" r="15" />
    </g>

    <!-- the signpost: three ways -->
    <g class="post">
      <ellipse class="mound" cx="1046" cy="852" rx="70" ry="12" />
      <rect class="pole" x="1036" y="392" width="20" height="460" rx="5" />
      <path class="board b1" d="M940 420h190l34 30-34 30H940z" />
      <path class="board b2" d="M1150 512H966l-34 30 34 30h184z" />
      <path class="board b3" d="M940 604h170l34 30-34 30H940z" />
      <path class="board-lines" d="M968 444h104M968 460h68M994 536h126M1008 552h80M968 628h92M968 644h58" />
    </g>

    <image class="quokka" href={searching.src} x="330" y="290" width="600" height="600" />
  </svg>
</div>

<style>
  .scene {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-frame);
    background: var(--surface-2);
    aspect-ratio: 1300 / 900;
  }
  svg {
    display: block;
    width: 100%;
    height: 100%;
    /* The bands drawn past the viewBox show in a wider frame; the frame clips them. */
    overflow: visible;
  }
  /* Below 1000px, the page's width in a banner's frame; on a phone, its own shape again. */
  @media (max-width: 999px) {
    .scene {
      aspect-ratio: 2 / 1;
    }
  }
  @media (max-width: 560px) {
    .scene {
      aspect-ratio: 1300 / 900;
    }
  }
  .sky {
    fill: var(--surface-2);
  }
  .cloud ellipse {
    fill: var(--surface);
  }
  .rim {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 4;
    stroke-linecap: round;
    opacity: 0.45;
  }
  .islet,
  .tower,
  .gallery,
  .lantern,
  .cap,
  .dune,
  .sand,
  .scrub {
    stroke: var(--ink);
    stroke-width: 4.5;
    stroke-linejoin: round;
  }
  .islet,
  .dune {
    fill: var(--limestone);
  }
  .tower {
    fill: var(--capture-ground);
  }
  .gallery,
  .cap {
    fill: var(--ink);
  }
  .lantern {
    fill: var(--lantern);
  }
  .sea {
    fill: var(--sea);
  }
  .sea-edge {
    fill: var(--sea-deep);
  }
  .waves {
    fill: none;
    stroke: var(--sea-line);
    stroke-width: 5;
    stroke-linecap: round;
  }
  .scrub {
    fill: var(--olive);
  }
  .sand {
    fill: var(--sand);
  }
  .paper,
  .stop,
  .pole,
  .board,
  .mound {
    stroke: var(--ink);
    stroke-width: 8;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .paper {
    fill: var(--capture-ground);
  }
  .fold {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 4;
  }
  .route {
    fill: none;
    stroke: var(--accent);
    stroke-width: 8;
    stroke-linecap: round;
    stroke-dasharray: 0.1 22;
  }
  .stop {
    fill: var(--capture-ground);
    stroke-width: 6;
  }
  .stop.done {
    fill: var(--accent);
  }
  .tick {
    fill: none;
    stroke: var(--capture-ground);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .half {
    fill: var(--accent);
  }
  .pole {
    fill: var(--wood);
    stroke-width: 7;
  }
  .board {
    stroke-width: 7;
  }
  .b1 {
    fill: var(--accent);
  }
  .b2 {
    fill: var(--lantern);
  }
  .b3 {
    fill: var(--olive-bright);
  }
  .board-lines {
    fill: none;
    stroke: var(--capture-ground);
    stroke-width: 7;
    stroke-linecap: round;
  }
  .mound {
    fill: var(--limestone);
    stroke-width: 5;
  }
</style>
