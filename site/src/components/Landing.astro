---
// The launch page, in the order of docs/design/landing-layout-2026-10-05.md. The hero (the
// product film) says what rotli is; the StatBand says why it exists, in figures (the AI you
// already pay for is mostly waiting; the owner, 2026-10-06, moved it up from third); the
// Overview tells what it does as one story (write in your view, the Librarian files it in the
// vault without touching your words, ask and the AI reads only what it needs; it absorbed the
// former TwoKinds section, 2026-10-06) and ends on the one link to /features/; then make it
// yours, privacy in brief, questions (Rotli Web and the Helper are answered there, while
// WEB_APP_ENABLED), and one closing panel that asks for a first note, right above the footer's
// quokka beach. The "A closer look." tour between the Overview and the theme studio was removed
// (the owner, 2026-10-06: redundant with Features and the story above it). Grounds alternate
// plain and warm, with the privacy night between. Base.astro owns the tokens and the section
// grammar.
import { landingGraph } from '../agents';
import { ogImage } from '../og';
import Base from '../layouts/Base.astro';
import { site } from '../site';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import Closing from './landing/Closing.astro';
import Experiments from './landing/Experiments.astro';
import Faq from './landing/Faq.astro';
import Hero from './landing/Hero.astro';
import Overview from './landing/Overview.astro';
import StatBand from './landing/StatBand.astro';
import Personal from './landing/Personal.astro';
import PrivacyBrief from './landing/PrivacyBrief.astro';
---

<Base noindex={!site.indexable} structuredData={landingGraph()} markdownPath="/index.md" {...ogImage('home')}>
  <SiteHeader current="product" />
  <main id="content">
    <Hero />
    <StatBand />
    <Overview />
    <Experiments />
    <Personal />
    <PrivacyBrief />
    <Faq />
    <Closing />
  </main>
  <SiteFooter />
</Base>
