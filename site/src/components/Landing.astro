---
// The launch page: the product film in the hero (the app itself, at work) and
// the footer's quokka beach to close on. Between them, in order: what rotli does
// (three steps, the full tour and the 30-second episodes are /features/), why the
// Librarian exists (two kinds of notes, the AI you already pay for), privacy in
// brief, the ways in, make it yours, and questions, which run straight into the
// footer (the closing invitation was cut on 2026-10-05: it repeated the hero). Base.astro owns the tokens
// and the section grammar.
import { landingGraph } from '../agents';
import { ogImage } from '../og';
import Base from '../layouts/Base.astro';
import { site } from '../site';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import Everywhere from './landing/Everywhere.astro';
import Experiments from './landing/Experiments.astro';
import Faq from './landing/Faq.astro';
import Hero from './landing/Hero.astro';
import Overview from './landing/Overview.astro';
import StatBand from './landing/StatBand.astro';
import TwoKinds from './landing/TwoKinds.astro';
import Personal from './landing/Personal.astro';
import PrivacyBrief from './landing/PrivacyBrief.astro';
---

<Base noindex={!site.indexable} structuredData={landingGraph()} markdownPath="/index.md" {...ogImage('home')}>
  <SiteHeader current="product" />
  <main id="content">
    <Hero />
    <Overview />
    <TwoKinds />
    <StatBand />
    <Experiments />
    <PrivacyBrief />
    <Everywhere />
    <Personal />
    <Faq />
  </main>
  <SiteFooter />
</Base>
