---
// The launch page, bookended like the studio's story film: the film itself in
// the hero, a sunset to close on. Between them, in order: what rotli does (three
// steps, the full tour and the 30-second episodes are /features/), privacy in
// brief, the ways in, make it yours, and questions. Base.astro owns the tokens
// and the section grammar.
import Base from '../layouts/Base.astro';
import { site } from '../site';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import Everywhere from './landing/Everywhere.astro';
import Experiments from './landing/Experiments.astro';
import Faq from './landing/Faq.astro';
import FinalCta from './landing/FinalCta.astro';
import Hero from './landing/Hero.astro';
import Overview from './landing/Overview.astro';
import Personal from './landing/Personal.astro';
import PrivacyBrief from './landing/PrivacyBrief.astro';
---

<Base noindex={!site.indexable}>
  <SiteHeader current="product" />
  <main id="content">
    <Hero />
    <Overview />
    <Experiments />
    <PrivacyBrief />
    <Everywhere />
    <Personal />
    <Faq />
    <FinalCta />
  </main>
  <SiteFooter />
</Base>
