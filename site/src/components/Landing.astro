  <script>
    // Hero film: muted autoplay with an explicit sound toggle. Reduced motion
    // keeps the poster until the visitor starts playback themselves.
    const player = document.querySelector<HTMLVideoElement>('#hero-player');
    const sound = document.querySelector<HTMLButtonElement>('.hero-sound');
    const error = document.querySelector<HTMLElement>('.hero-film-error');
    const mutedIcon = sound?.querySelector<SVGElement>('.icon-muted');
    const soundIcon = sound?.querySelector<SVGElement>('.icon-sound');
    const soundLabel = sound?.querySelector<HTMLElement>('.sound-label');
    const showError = () => { if (error) error.hidden = false; };
    const syncSoundUi = () => {
      if (!player || !sound) return;
      const on = !player.muted;
      sound.setAttribute('aria-pressed', String(on));
      sound.setAttribute('aria-label', on ? 'Turn sound off' : 'Turn sound on');
      if (mutedIcon) mutedIcon.classList.toggle('is-hidden', on);
      if (soundIcon) soundIcon.classList.toggle('is-hidden', !on);
      if (soundLabel) soundLabel.textContent = on ? 'Sound on' : 'Sound off';
    };
    player?.addEventListener('error', showError);
    player?.querySelector('source')?.addEventListener('error', showError);
    player?.addEventListener('playing', () => { if (error) error.hidden = true; });
    if (player && typeof player.canPlayType === 'function' && player.canPlayType('video/mp4')) {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      player.muted = true;
      if (reduceMotion) {
        player.removeAttribute('autoplay');
        player.pause();
      } else {
        // A refused or interrupted autoplay is not a broken file: keep the
        // poster and stay quiet. Real media errors surface through `error`.
        void player.play().catch(() => {});
      }
      sound?.addEventListener('click', () => {
        player.muted = !player.muted;
        if (!player.muted && player.paused) {
          void player.play().catch(showError);
        }
        syncSoundUi();
      });
      syncSoundUi();
    }
  </script>
</Base>
