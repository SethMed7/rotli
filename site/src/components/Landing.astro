  <script>
    type ThemeStop = {
      id: string;
      familyId: string;
      familyName: string;
      mode: 'light' | 'dark';
      environment: string;
      screenshot: string;
    };

    const themePreviewImage = document.querySelector<HTMLImageElement>('#theme-preview-image');
    const themePreviewCaption = document.querySelector<HTMLElement>('#theme-preview-caption');
    const themePreviewFamily = document.querySelector<HTMLElement>('#theme-preview-family');
    const stopButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-stop]')];
    const tour: ThemeStop[] = (() => {
      const node = document.querySelector('#theme-tour-data');
      try {
        return JSON.parse(node?.textContent || '[]') as ThemeStop[];
      } catch {
        return [];
      }
    })();

    let tourIndex = 0;
    let timer: number | null = null;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const INTERVAL_MS = 3800;

    const showStop = (index: number) => {
      if (!tour.length) return;
      tourIndex = ((index % tour.length) + tour.length) % tour.length;
      const stop = tour[tourIndex];
      if (themePreviewImage) {
        themePreviewImage.src = stop.screenshot;
        themePreviewImage.alt = `Rotli workspace in the ${stop.environment} environment`;
      }
      if (themePreviewFamily) themePreviewFamily.textContent = stop.familyName;
      if (themePreviewCaption) themePreviewCaption.textContent = stop.environment;
      stopButtons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.themeStop === stop.id));
      });
    };

    const stopTour = () => {
      if (timer !== null) {
        window.clearInterval(timer);
        timer = null;
      }
    };

    const startTour = () => {
      stopTour();
      if (reduceMotion || tour.length < 2) return;
      timer = window.setInterval(() => showStop(tourIndex + 1), INTERVAL_MS);
    };

    stopButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const next = tour.findIndex((stop) => stop.id === button.dataset.themeStop);
        if (next >= 0) showStop(next);
        startTour();
      });
    });

    showStop(0);
    startTour();

    // Companion carousel: crossfades through poses, pauses while the visitor
    // hovers or focuses it, and never auto-advances under reduced motion.
    const companionArt = document.querySelector<HTMLElement>('#companion-art');
    const companionSlides = [...document.querySelectorAll<HTMLButtonElement>('.companion-slide')];
    const companionDots = [...document.querySelectorAll<HTMLButtonElement>('.companion-dot')];
    const companionCaption = document.querySelector<HTMLElement>('#companion-caption');
    let companionIndex = 0;
    let companionTimer: number | null = null;
    let companionPaused = false;
    const COMPANION_MS = 3000;

    const showCompanion = (index: number) => {
      const count = companionSlides.length;
      if (!count) return;
      companionIndex = ((index % count) + count) % count;
      const prev = (companionIndex - 1 + count) % count;
      const next = (companionIndex + 1) % count;
      companionSlides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === companionIndex);
        slide.classList.toggle('is-prev', i === prev && count > 1);
        slide.classList.toggle('is-next', i === next && count > 2);
      });
      companionDots.forEach((dot, i) => dot.setAttribute('aria-pressed', String(i === companionIndex)));
      const label = companionDots[companionIndex]?.getAttribute('aria-label');
      if (companionCaption && label) companionCaption.textContent = label;
    };

    companionSlides.forEach((slide) => {
      slide.addEventListener('click', () => {
        const target = Number(slide.dataset.companionIndex);
        if (Number.isFinite(target) && target !== companionIndex) {
          showCompanion(target);
          startCompanion();
        }
      });
    });

    const stopCompanion = () => {
      if (companionTimer !== null) {
        window.clearInterval(companionTimer);
        companionTimer = null;
      }
    };

    const startCompanion = () => {
      stopCompanion();
      if (reduceMotion || companionPaused || companionSlides.length < 2) return;
      companionTimer = window.setInterval(() => showCompanion(companionIndex + 1), COMPANION_MS);
    };

    companionDots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        showCompanion(i);
        startCompanion();
      });
    });

    companionArt?.addEventListener('mouseenter', () => { companionPaused = true; stopCompanion(); });
    companionArt?.addEventListener('mouseleave', () => { companionPaused = false; startCompanion(); });
    companionArt?.addEventListener('focusin', () => { companionPaused = true; stopCompanion(); });
    companionArt?.addEventListener('focusout', (event) => {
      if (companionArt.contains(event.relatedTarget as Node | null)) return;
      companionPaused = false;
      startCompanion();
    });

    showCompanion(0);
    startCompanion();

    // Scroll reveal. Anything already on screen shows at once; the rest rises
    // in as it enters. Reduced motion shows everything immediately.
    const revealTargets = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
    if (reduceMotion || !('IntersectionObserver' in window)) {
      revealTargets.forEach((target) => target.classList.add('is-visible'));
    } else {
      const revealer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            revealer.unobserve(entry.target);
          });
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.08 },
      );
      revealTargets.forEach((target) => revealer.observe(target));
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopTour();
        stopCompanion();
      } else {
        startTour();
        startCompanion();
      }
    });
  </script>

