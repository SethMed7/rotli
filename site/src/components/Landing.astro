---
import Base from '../layouts/Base.astro';
import mark from '../../../src/assets/characters/_logo.svg?raw';
import staysLocal from '../assets/characters/cocoa/stays_local.webp';
import celebrating from '../assets/characters/cocoa/celebrating.webp';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import PlaygroundStory from './PlaygroundStory.astro';
import PromoFilm from './PromoFilm.astro';
import { GITHUB_URL, PRIVACY_URL, RELEASES_URL, ROADMAP_URL, site } from '../site';

// Secondary calls to action fall back to local anchors while the source
// repository is private (site.sourcePublic is false by default).
const secondaryAction = site.sourcePublic
  ? { href: GITHUB_URL, label: 'Explore the source', external: true }
  : site.promo.enabled
    ? { href: '#film', label: 'Watch the film', external: false }
    : { href: '#workspace', label: 'See the workspace', external: false };

const finalAction = site.sourcePublic
  ? { href: GITHUB_URL, label: 'View on GitHub', external: true }
  : site.promo.enabled
    ? { href: '#film', label: 'Watch the film', external: false }
    : { href: '#privacy', label: 'How privacy works', external: false };

const footerLinks = [
  ...(site.sourcePublic ? [{ href: GITHUB_URL, label: 'GitHub' }] : []),
  ...(site.downloadsEnabled ? [{ href: RELEASES_URL, label: 'Releases' }] : []),
  { href: '#workspace', label: 'Workspace' },
  { href: '#playground', label: 'Playground' },
  ...(site.showsExperiments ? [{ href: '/mcp/', label: 'MCP guide' }] : []),
  { href: site.sourcePublic ? PRIVACY_URL : '#privacy', label: 'Privacy' },
  ...(site.sourcePublic ? [{ href: ROADMAP_URL, label: 'Roadmap' }] : []),
];

const footerTagline = site.sourcePublic
  ? 'Local-first, free, and open source under the MIT license.'
  : 'Local-first and free. One folder you own, no account required.';

const themeFamilies = [
  { id: 'rotli', name: 'Rotli', environment: 'Warm Light', screenshot: '/rotli-app-warm-light@3x.png' },
  { id: 'paper', name: 'Paper & Charcoal', environment: 'Paper', screenshot: '/rotli-app-paper@3x.png' },
  { id: 'ocean', name: 'Ocean', environment: 'Ocean Light', screenshot: '/rotli-app-ocean-light@3x.png' },
  { id: 'grove', name: 'Grove', environment: 'Grove Dark', screenshot: '/rotli-app-grove-dark@3x.png' },
  { id: 'iris', name: 'Iris', environment: 'Iris Light', screenshot: '/rotli-app-iris-light@3x.png' },
  { id: 'midnight', name: 'Midnight', environment: 'Midnight', screenshot: '/rotli-app-midnight@3x.png' },
];

// The beta scope: what the launch site may promise. Anything beyond this list
// appears only on the dev site, under the experiments label below.
const surfaces = [
  {
    name: 'Markdown, first',
    detail: 'Hybrid editing keeps syntax quiet until you need it. Headings, lists, tables, embeds, and Mermaid diagrams stay readable files on disk, with the source one switch away.',
    proof: 'Plain .md · live preview · source view',
  },
  {
    name: 'Tasks that stay text',
    detail: 'Check a box and the note changes on disk. Tasks, choices, toggles, and results are portable Markdown notation, so they travel with the file into any other editor.',
    proof: 'One notation · readable anywhere',
  },
  {
    name: 'Links and finding',
    detail: 'Wikilinks connect notes to each other. ⌘K searches titles and text across the whole vault, and Main and named views arrange the same files without copying them.',
    proof: 'Wikilinks · ⌘K · views, not copies',
  },
  {
    name: 'Chat with context',
    detail: 'Optional. Use an on-device model or connect the model tools you already trust. Chat can work from the active vault, and each conversation is a Markdown transcript in your folder.',
    proof: 'Local or connected · transcripts are files',
  },
];

// Features under development. Shown only when site.showsExperiments, always
// labeled, never on the launch site. Keep this list honest about status.
const experiments = [
  { name: 'Local CLI + MCP', status: 'A bounded JSON CLI and local stdio MCP server; being refined before release.' },
  { name: 'DOCX and spreadsheets', status: 'Editable surfaces under review for round-trip fidelity.' },
  { name: 'Excalidraw boards', status: 'Boards beside notes; native save and reopen still being verified.' },
  { name: 'Mermaid visual editing', status: 'A visual editor over the text source. View and Code stay in the beta.' },
  { name: 'Breve routines', status: 'Scheduled briefs and watchlists written as vault Markdown.' },
  { name: 'Remote agents', status: 'Cloud MCP clients through a stateless relay; no hosted relay is launched.' },
];
---

<Base noindex={!site.indexable}>
  <SiteHeader
    nav={[
      { href: '#why-local', label: 'Why local' },
      { href: '#workspace', label: 'Workspace' },
      { href: '#personal', label: 'Personalize' },
      ...(site.showsExperiments
        ? [
            { href: '#beyond-the-app', label: 'More than an app' },
            { href: '/mcp/', label: 'MCP' },
          ]
        : []),
    ]}
  />

  <main id="content">
    <section class="hero-shell" aria-labelledby="hero-title">
      <img class="hero-backdrop" src="/coastline.webp" alt="" width="941" height="1672" aria-hidden="true" />
      <div class="hero">
        <div class="hero-copy">
          <p class="hero-kicker">A local-first workspace for macOS</p>
          <h1 id="hero-title">Room to think.<br />Files you keep.</h1>
          <p class="hero-lede">
            Rotli turns one folder on your Mac into a calm workspace for notes, tasks, links,
            and optional AI conversations—without turning your work into an export from a service.
          </p>
          <div class="hero-actions">
            {site.downloadsEnabled ? (
              <a class="button primary" href={RELEASES_URL} rel="noopener">Download for Mac</a>
            ) : (
              <span class="button primary pending" aria-disabled="true">Mac beta coming soon</span>
            )}
            <a class="button secondary" href={secondaryAction.href} rel={secondaryAction.external ? 'noopener' : undefined}>
              {secondaryAction.label}
            </a>
          </div>
          <p class="release-note">Free · Apple silicon · {site.downloadsEnabled ? 'Mac beta' : 'Beta in preparation'} · no account</p>
        </div>

        <figure class="product-figure">
          <div class="product-shot">
            <img
              src="/rotli-app-paper@3x.png"
              width="1280"
              height="800"
              alt="Rotli's browser demo workspace in the Paper environment"
            />
          </div>
          <figcaption><span>Real browser demo</span> Paper · seeded local corpus</figcaption>
        </figure>
      </div>
    </section>

    <PromoFilm />

    <div class="proof-strip" aria-label="Rotli essentials">
      <span><b>⌥Space</b> summon from anywhere</span>
      <span><b>One folder</b> is the durable truth</span>
      <span><b>Offline</b> remains useful without AI</span>
      <span><b>Local-first</b> is the architecture</span>
    </div>

    <section class="folder-story" id="why-local" aria-labelledby="folder-title">
      <div class="section-copy">
        <p class="section-label">Not a cloud account with an export button</p>
        <h2 id="folder-title">One folder. Every path out stays open.</h2>
        <p>
          Your vault is an ordinary directory you choose. Markdown stays Markdown, and chat
          transcripts are Markdown too. Rotli’s hidden metadata is rebuildable structure—not a
          second content store.
        </p>
        <ul class="plain-promises">
          <li>
            <span>01</span>
            <p><b>Open your work in other apps.</b> Rotli never becomes the only door.</p>
          </li>
          <li>
            <span>02</span>
            <p><b>Back up the folder your way.</b> No proprietary export ritual.</p>
          </li>
          <li>
            <span>03</span>
            <p><b>Turn intelligence off.</b> A raw vault is still a complete workspace.</p>
          </li>
        </ul>
      </div>
      <div class="vault-anatomy" aria-label="Example Rotli vault structure">
        <div class="vault-heading"><span>~/Documents/Field Notes</span><span>Local folder</span></div>
        <ul class="file-tree">
          <li><span class="folder-icon">⌄</span><b>wiki/</b><small>your knowledge</small></li>
          <li class="nested"><span>◇</span>launch-notes.md<small>plain Markdown</small></li>
          <li class="nested"><span>◇</span>reading-list.md<small>plain Markdown</small></li>
          <li class="nested"><span class="folder-icon">⌄</span><b>_inbox/</b><small>quick captures</small></li>
          {site.showsExperiments && (
            <>
              <li><span class="folder-icon">⌄</span><b>storage/</b><small>experiments · dev preview</small></li>
              <li class="nested"><span>□</span>project-brief.docx<small>Word document</small></li>
              <li class="nested"><span>▦</span>forecast.xlsx<small>spreadsheet</small></li>
              <li class="nested"><span>✣</span>system-map.excalidraw<small>board</small></li>
            </>
          )}
          <li><span class="folder-icon">⌄</span><b>chats/</b><small>portable transcripts</small></li>
          <li class="nested"><span>◇</span>planning-with-claude.md<small>Markdown transcript</small></li>
          <li><span class="folder-icon">·</span><b>.rotli/</b><small>rebuildable projections</small></li>
        </ul>
        <p class="anatomy-note">Delete the app and the work still makes sense.</p>
      </div>
    </section>

    <section class="workspace-story" id="workspace" aria-labelledby="workspace-title">
      <div class="workspace-intro">
        <p class="section-label">A workspace, not a preview catalog</p>
        <h2 id="workspace-title">Work on the file. Don’t stare at a thumbnail of it.</h2>
        <p>
          Markdown is the knowledge surface, and the beta stays close to what it does well.
          Rotli only calls a format supported when you can actually edit it here.
        </p>
      </div>
      <div class="surface-list">
        {surfaces.map((surface) => (
          <article class="surface-row">
            <h3>{surface.name}</h3>
            <p>{surface.detail}</p>
            <span>{surface.proof}</span>
          </article>
        ))}
      </div>
      {site.showsExperiments && (
        <aside class="experiments" aria-labelledby="experiments-title">
          <p class="experiment-tag">Experiment · dev preview</p>
          <h3 id="experiments-title">Also in development, outside the beta scope</h3>
          <p>
            These features are under review and are not promised for the Mac beta.
            Breve and Mermaid visual editing are restricted to development builds.
          </p>
          <ul>
            {experiments.map((experiment) => (
              <li><b>{experiment.name}</b> {experiment.status}</li>
            ))}
          </ul>
        </aside>
      )}
      <div class="workflow-ribbon" aria-label="Rotli capture workflow">
        <span><b>Capture</b><small>⌥C from anywhere</small></span>
        <i aria-hidden="true">→</i>
        <span><b>Arrange</b><small>Main and named views</small></span>
        <i aria-hidden="true">→</i>
        <span><b>Find</b><small>⌘K across the vault</small></span>
        <i aria-hidden="true">→</i>
        <span><b>Use</b><small>write, plan, chat, build</small></span>
      </div>
    </section>

    <PlaygroundStory />

    <section class="privacy-story" id="privacy" aria-labelledby="privacy-title">
      <div class="privacy-visual">
        <img src={staysLocal.src} width="400" height="400" alt="The Rotli quokka holding a privacy shield" loading="lazy" />
        <p>Rotli excludes notes marked Secure from its remote model context. Locked notes remain readable, and AI edits are refused.</p>
      </div>
      <div class="privacy-copy">
        <p class="section-label">Intelligence with a boundary</p>
        <h2 id="privacy-title">AI is invited into your workspace. It does not own the house.</h2>
        <p>
          Start with an on-device model, connect Claude Code or Codex, or use Cursor for code chat.
          You can also use no model at all. Connected providers are optional; their own data policies apply.
        </p>
        <dl class="boundary-list">
          <div><dt>On-device</dt><dd>Private by default and usable without a network.</dd></div>
          <div><dt>Connected</dt><dd>Your existing model tools, explicitly labeled as remote.</dd></div>
          <div><dt>Secure</dt><dd>Protected notes are excluded from Rotli's remote context. This is an AI access policy, not disk encryption.</dd></div>
          <div><dt>Locked</dt><dd>Every model may read; no model may edit.</dd></div>
        </dl>
      </div>
    </section>

    <section class="personal-story" id="personal" aria-labelledby="personal-title">
      <div class="personal-heading">
        <div>
          <p class="section-label">A workspace that can feel like yours</p>
          <h2 id="personal-title">Six families. Twelve tuned environments. One calm grammar.</h2>
        </div>
        <p>
          Light, Dark, and System are separate from the family you choose. Every environment
          keeps content readable; accent hue and an optional companion add personality without
          taking over the work.
        </p>
      </div>

      <div class="theme-studio">
        <div class="theme-choices" role="group" aria-label="Preview a Rotli theme family">
          {themeFamilies.map((family, index) => (
            <button
              class="theme-choice"
              type="button"
              data-theme-family={family.id}
              data-theme-name={family.name}
              data-theme-screenshot={family.screenshot}
              data-theme-environment={family.environment}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              <span class={`theme-pair theme-pair-${family.id}`} aria-hidden="true"><i></i><i></i></span>
              <span>{family.name}</span>
            </button>
          ))}
        </div>
        <figure class="theme-capture">
          <div class="theme-capture-frame">
            <img
              id="theme-preview-image"
              src={themeFamilies[0].screenshot}
              width="1280"
              height="800"
              alt={`Rotli's browser demo workspace in the ${themeFamilies[0].environment} environment`}
              loading="lazy"
            />
          </div>
          <figcaption>
            <span>Captured from Rotli’s browser demo</span>
            <b id="theme-preview-caption">{themeFamilies[0].name} · {themeFamilies[0].environment}</b>
          </figcaption>
        </figure>
        <div class="companion-preview">
          <div class="companion-art">
            <img src={celebrating.src} width="400" height="400" alt="A filled cocoa Rotli quokka celebrating" loading="lazy" />
          </div>
          <div class="companion-copy">
            <span>Optional companion</span>
            <h3>Your quokka, when you want one.</h3>
            <p>
              Choose body color, black or white linework, idle mood, pose, and independently
              colored glasses or a bucket hat. Turn the companion off and it
              stays in onboarding only.
            </p>
            <ul aria-label="Companion customization options">
              <li>7 body presets + custom hue</li>
              <li>2 accessories + custom color</li>
              <li>semantic poses for empty states</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {site.showsExperiments && (
    <section class="beyond-story" id="beyond-the-app" aria-labelledby="beyond-title">
      <div class="beyond-heading">
        <p class="section-label">The folder is useful beyond the window</p>
        <h2 id="beyond-title">Your vault can work with the agents you already run.</h2>
      </div>
      <div class="beyond-lanes">
        <article class="experiment-lane">
          <div class="lane-title">
            <span>CLI + MCP <i class="experiment-tag">Experiment · dev preview</i></span>
            <b>Local agents, through Rotli’s own policy</b>
          </div>
          <p>
            The installed Rotli binary exposes a bounded JSON CLI and a local stdio MCP server, so
            Claude Code, Codex, and Cursor can read and write notes through the same rules the app
            uses. The stdio connection opens no network listener.
          </p>
          <p class="lane-proof">
            <span>Stdio stays local · one policy engine · being refined before release</span>
            <a href="/mcp/">Read the MCP guide <span aria-hidden="true">→</span></a>
          </p>
        </article>
            <article class="experiment-lane">
              <div class="lane-title">
                <span>Breve <i class="experiment-tag">Experiment · dev preview</i></span>
                <b>Quiet routines, owned by Rotli</b>
              </div>
              <p>
                Morning briefs, watchlists, reminders, delivery, and scheduler health in one managed
                runtime. Generated briefs are ordinary vault Markdown. Not part of the beta scope.
              </p>
              <p class="lane-proof">Vault-owned configuration · development builds only</p>
            </article>
            <article class="experiment-lane">
              <div class="lane-title">
                <span>Remote agents <i class="experiment-tag">Experiment · dev preview</i></span>
                <b>Cloud MCP clients through a stateless relay</b>
              </div>
              <p>
                Opt-in sessions let a cloud client reach your running Mac through a relay you operate,
                without moving the vault into the cloud. No hosted relay is launched.
              </p>
              <p class="lane-proof">Session opt-in · same policy engine · outside beta scope</p>
            </article>
      </div>
    </section>
    )}

    <section class="final-cta" aria-labelledby="final-title">
      <span class="final-mark" set:html={mark} aria-hidden="true"></span>
      <div>
        <h2 id="final-title">A durable place for the work you want to keep.</h2>
        <p>Warm enough to return to. Quiet enough to disappear. Local enough to remain yours.</p>
      </div>
      <div class="final-actions">
        {site.downloadsEnabled ? (
          <a class="button final-button" href={RELEASES_URL} rel="noopener">Download the Mac beta</a>
        ) : (
          <span class="button final-button pending" aria-disabled="true">Mac beta coming soon</span>
        )}
        <a class="button final-link" href={finalAction.href} rel={finalAction.external ? 'noopener' : undefined}>
          {finalAction.label}
        </a>
      </div>
    </section>
  </main>

  <SiteFooter tagline={footerTagline} links={footerLinks} />

  <script>
    let previewFamily = "rotli";
    const familyButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-family]')];
    const themePreviewImage = document.querySelector<HTMLImageElement>('#theme-preview-image');
    const themePreviewCaption = document.querySelector<HTMLElement>('#theme-preview-caption');

    const syncFamily = () => {
      familyButtons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.themeFamily === previewFamily));
      });

      const activeButton = familyButtons.find((button) => button.dataset.themeFamily === previewFamily);
      const screenshot = activeButton?.dataset.themeScreenshot;
      const environment = activeButton?.dataset.themeEnvironment;
      const familyName = activeButton?.dataset.themeName;
      if (themePreviewImage && screenshot && environment) {
        themePreviewImage.src = screenshot;
        themePreviewImage.alt = `Rotli's browser demo workspace in the ${environment} environment`;
      }
      if (themePreviewCaption && familyName && environment) {
        themePreviewCaption.textContent = `${familyName} · ${environment}`;
      }
    };

    familyButtons.forEach((button) => {
      button.addEventListener('click', () => {
        previewFamily = button.dataset.themeFamily || 'rotli';
        syncFamily();
      });
    });

    syncFamily();
  </script>

  <style>
    main > section,
    .proof-strip {
      width: min(100% - 3rem, var(--page-max));
      margin-inline: auto;
    }

    main > .hero-shell {
      width: 100%;
      max-width: none;
    }

    .hero-shell {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      background: var(--hero-ground);
      color: var(--hero-text);
    }

    .hero {
      position: relative;
      z-index: 3;
      width: min(100% - 3rem, var(--page-max));
      margin-inline: auto;
      display: grid;
      grid-template-columns: minmax(20rem, 0.76fr) minmax(36rem, 1.24fr);
      gap: clamp(2.5rem, 5vw, 5rem);
      align-items: center;
      min-height: calc(100vh - 76px);
      padding-block: clamp(5rem, 9vw, 8rem);
    }

    .hero-backdrop {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 34%;
      opacity: 0.1;
      pointer-events: none;
    }

    .hero-copy {
      max-width: 34rem;
    }

    .hero-kicker,
    .section-label {
      margin: 0 0 1.1rem;
      color: var(--accent-text);
      font-size: 0.88rem;
      font-weight: 600;
      letter-spacing: 0.02em;
    }

    .hero-kicker {
      color: var(--hero-accent);
    }

    h1 {
      margin: 0;
      font-size: clamp(3.4rem, 6.4vw, 5.8rem);
      line-height: 0.96;
      letter-spacing: -0.04em;
      font-weight: 600;
    }

    .hero-lede {
      max-width: 34rem;
      margin: 1.6rem 0 0;
      color: var(--hero-copy);
      font-size: clamp(1.08rem, 1.7vw, 1.3rem);
      line-height: 1.55;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 2rem;
    }

    .release-note {
      margin: 0.85rem 0 0;
      color: var(--hero-muted);
      font-size: 0.86rem;
    }

    .hero .button.primary {
      border-color: var(--hero-text);
      background: var(--hero-text);
      color: var(--hero-action-text);
    }

    .hero .button.primary:hover {
      border-color: var(--hero-action);
      background: var(--hero-action);
      color: var(--hero-action-text);
    }

    .hero .button.secondary {
      border-color: var(--hero-border);
      color: var(--hero-text);
    }

    .hero .button.secondary:hover {
      border-color: var(--hero-text);
      background: var(--hero-hover-wash);
    }

    .product-figure {
      min-width: 0;
      margin: 0;
    }

    .product-shot {
      overflow: hidden;
      border: 1px solid var(--hero-shot-border);
      border-radius: 0.85rem;
      background: var(--hero-shot);
    }

    .product-shot img {
      display: block;
      width: 100%;
      height: auto;
    }

    .product-figure figcaption {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      margin-top: 0.85rem;
      color: var(--hero-caption);
      font-size: 0.78rem;
    }

    .product-figure figcaption span {
      color: var(--hero-text);
      font-weight: 600;
    }

    .proof-strip {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }

    .proof-strip span {
      min-height: 5.8rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 0.18rem;
      padding: 1rem clamp(0.8rem, 2vw, 1.6rem);
      border-right: 1px solid var(--border);
      color: var(--text-muted);
      font-size: 0.88rem;
    }

    .proof-strip span:last-child {
      border-right: 0;
    }

    .proof-strip b {
      color: var(--text);
      font-size: 0.98rem;
    }

    .folder-story {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      gap: clamp(3rem, 8vw, 8rem);
      align-items: start;
      padding-block: clamp(7rem, 12vw, 11rem);
    }

    .section-copy h2,
    .workspace-intro h2,
    .privacy-copy h2,
    .personal-heading h2,
    .beyond-heading h2,
    .final-cta h2 {
      margin: 0;
      font-size: clamp(2.35rem, 4.5vw, 4.4rem);
      line-height: 1.04;
      letter-spacing: -0.035em;
      font-weight: 600;
    }

    .section-copy > p:not(.section-label),
    .workspace-intro > p:not(.section-label),
    .privacy-copy > p:not(.section-label) {
      margin: 1.5rem 0 0;
      color: var(--text-muted);
      font-size: 1.08rem;
    }

    .plain-promises {
      list-style: none;
      padding: 0;
      margin: 2.2rem 0 0;
      border-top: 1px solid var(--border);
    }

    .plain-promises li {
      display: grid;
      grid-template-columns: 2.5rem 1fr;
      padding-block: 1rem;
      border-bottom: 1px solid var(--border);
      color: var(--text-muted);
    }

    .plain-promises li span {
      color: var(--accent-text);
      font-size: 0.78rem;
    }

    .plain-promises li p {
      margin: 0;
    }

    .plain-promises li b {
