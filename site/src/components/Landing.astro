---
import Base from '../layouts/Base.astro';
import mark from '../../../src/assets/characters/_logo.svg?raw';
import staysLocal from '../assets/characters/cocoa/stays_local.webp';
import showcaseManifest from '../assets/characters/showcase/showcase.json';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import PlaygroundStory from './PlaygroundStory.astro';
import { DOWNLOAD_URL, GITHUB_URL, PRIVACY_URL, RELEASES_URL, ROADMAP_URL, site } from '../site';

// Hero leads with the full promo (falls back to the teaser if the full cut
// is missing). The same clip is never stacked twice below.
const heroFilm = site.promo.full.enabled
  ? { ...site.promo.full, kind: 'full' as const }
  : site.promo.teaser.enabled
    ? { ...site.promo.teaser, kind: 'teaser' as const }
    : null;

// Secondary calls to action fall back to local anchors while the source
// repository is private (site.sourcePublic is false by default).
const secondaryAction = site.sourcePublic
  ? { href: GITHUB_URL, label: 'Explore the source', external: true }
  : { href: '#organize', label: 'How organization works', external: false };

const finalAction = site.sourcePublic
  ? { href: GITHUB_URL, label: 'View on GitHub', external: true }
  : { href: '#organize', label: 'How organization works', external: false };

const footerLinks = [
  ...(site.sourcePublic ? [{ href: GITHUB_URL, label: 'GitHub' }] : []),
  ...(site.downloadsEnabled ? [{ href: RELEASES_URL, label: 'Releases' }] : []),
  { href: '#workspace', label: 'Workspace' },
  { href: '#playground', label: 'Playground' },
  ...(site.showsExperiments ? [{ href: '/mcp/', label: 'MCP guide' }] : []),
  { href: site.sourcePublic ? PRIVACY_URL : '#privacy', label: 'Privacy' },
  ...(site.sourcePublic ? [{ href: ROADMAP_URL, label: 'Roadmap' }] : []),
];

const footerTagline = site.sourcePublic
  ? 'Local-first, free, and open source under the MIT license.'
  : 'Local-first and free. One folder you own, no account required.';

// Orb colors read the site swatch layer (Base.astro), which mirrors the app's
// per-environment ground and accent tokens.
const themeFamilies = [
  {
    id: 'rotli',
    name: 'Rotli',
    light: { environment: 'Warm Light', screenshot: '/themes/rotli-warm-light@2x.webp' },
    dark: { environment: 'Warm Dark', screenshot: '/themes/rotli-warm-dark@2x.webp' },
  },
  {
    id: 'paper',
    name: 'Paper & Charcoal',
    light: { environment: 'Paper', screenshot: '/themes/paper@2x.webp' },
    dark: { environment: 'Charcoal', screenshot: '/themes/charcoal@2x.webp' },
  },
  {
    id: 'ocean',
    name: 'Ocean',
    light: { environment: 'Ocean Light', screenshot: '/themes/ocean-light@2x.webp' },
    dark: { environment: 'Ocean Dark', screenshot: '/themes/ocean-dark@2x.webp' },
  },
  {
    id: 'grove',
    name: 'Grove',
    light: { environment: 'Grove Light', screenshot: '/themes/grove-light@2x.webp' },
    dark: { environment: 'Grove Dark', screenshot: '/themes/grove-dark@2x.webp' },
  },
  {
    id: 'iris',
    name: 'Iris',
    light: { environment: 'Iris Light', screenshot: '/themes/iris-light@2x.webp' },
    dark: { environment: 'Iris Dark', screenshot: '/themes/iris-dark@2x.webp' },
  },
  {
    id: 'midnight',
    name: 'Midnight',
    light: { environment: 'Midnight Light', screenshot: '/themes/midnight-light@2x.webp' },
    dark: { environment: 'Midnight', screenshot: '/themes/midnight@2x.webp' },
  },
];

const themeTour = themeFamilies.flatMap((family) => ([
  {
    id: `${family.id}:light`,
    familyId: family.id,
    familyName: family.name,
    mode: 'light' as const,
    environment: family.light.environment,
    screenshot: family.light.screenshot,
  },
  {
    id: `${family.id}:dark`,
    familyId: family.id,
    familyName: family.name,
    mode: 'dark' as const,
    environment: family.dark.environment,
    screenshot: family.dark.screenshot,
  },
]));

const orbStyle = (familyId: string, mode: 'light' | 'dark') =>
  `--orb-ground: var(--swatch-${familyId}-${mode}); --orb-accent: var(--swatch-${familyId}-${mode}-accent);`;

// Companion carousel: real, selectable combinations (body preset or line
// drawing × accessory × line color × pose) rendered by
// scripts/build-companion-showcase.ts with the app's own placement rules.
const showcaseImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/characters/showcase/*.webp',
  { eager: true },
);
const companions = showcaseManifest.map((entry) => {
  const image = showcaseImages[`../assets/characters/showcase/${entry.slug}.webp`];
  if (!image) throw new Error(`Missing companion render for ${entry.slug}; run bun scripts/build-companion-showcase.ts`);
  return { ...entry, src: image.default };
});

const defaultTheme = themeFamilies[0];
const defaultThemeShot = defaultTheme.light;

// The alpha scope: what the launch site may promise. Anything beyond this list
// appears only on the dev site, under the experiments label below.
const surfaces = [
  {
    name: 'Markdown, first',
    detail: 'Hybrid editing keeps syntax quiet until you need it. Headings, lists, tables, embeds, and Mermaid diagrams stay readable files on disk, with the source one switch away.',
    proof: 'Plain .md · live preview · source view',
  },
  {
    name: 'Tasks that stay text',
    detail: 'Check a box and the note changes on disk. Tasks, choices, toggles, and results are portable Markdown notation, so they travel with the file into any other editor.',
    proof: 'One notation · readable anywhere',
  },
  {
    name: 'Links and finding',
    detail: 'Wikilinks connect notes to each other. ⌘K searches titles and text across the whole vault. With the Librarian on, Main and named views keep the same files arranged without copying them.',
    proof: 'Wikilinks · ⌘K · views, not copies',
  },
  {
    name: 'Chat with context',
    detail: 'Optional. Use an on-device model or connect the model tools you already trust. Chat can work from the active vault, and each conversation is a Markdown transcript in your folder.',
    proof: 'Local or connected · transcripts are files',
  },
];

// Features under development. Shown only when site.showsExperiments, always
// labeled, never on the launch site. Keep this list honest about status.
const experiments = [
  { name: 'Local CLI + MCP', status: 'A bounded JSON CLI and local stdio MCP server; being refined before release.' },
  { name: 'DOCX documents', status: 'An editable surface under review for round-trip fidelity.' },
  { name: 'Spreadsheets', status: 'Coming soon. XLSX workbooks are in development builds only; CSV editing is in the alpha.' },
  { name: 'Mermaid diagram tabs', status: 'Coming soon. A Mermaid fence in any note already renders.' },
  { name: 'Read aloud', status: 'Coming soon. On-device voice for chat replies.' },
  { name: 'Excalidraw boards', status: 'Boards beside notes; native save and reopen still being verified.' },
  { name: 'Mermaid visual editing', status: 'A visual editor over the text source. View and Code stay in the alpha.' },
  { name: 'Breve routines', status: 'Scheduled briefs and watchlists written as vault Markdown.' },
  { name: 'Remote agents', status: 'Cloud MCP clients through a stateless relay; no hosted relay is launched.' },
];
---

<Base noindex={!site.indexable}>
  <SiteHeader
    nav={[
      { href: '#why-local', label: 'Why local' },
      { href: '#organize', label: 'Organize' },
      { href: '#workspace', label: 'Workspace' },
      { href: '#personal', label: 'Themes' },
      ...(site.showsExperiments
        ? [
            { href: '#beyond-the-app', label: 'More than an app' },
            { href: '/mcp/', label: 'MCP' },
          ]
        : []),
    ]}
  />

  <main id="content">
    <section class="hero-shell" aria-labelledby="hero-title">
      <div class="hero">
        <div class="hero-copy">
          <h1 id="hero-title">Room to think.<br />Files you keep.</h1>
          <p class="hero-lede">
            Rotli turns one folder on your Mac into a calm workspace for notes, tasks, links,
            and optional AI conversations—without turning your work into an export from a service.
          </p>
          <div class="hero-actions">
            {site.downloadsEnabled ? (
              <a class="button primary" href={DOWNLOAD_URL} rel="noopener">Download for Mac</a>
            ) : (
              <span class="button primary pending" aria-disabled="true">Mac alpha coming soon</span>
            )}
            <a class="button secondary" href={secondaryAction.href} rel={secondaryAction.external ? 'noopener' : undefined}>
              {secondaryAction.label}
            </a>
          </div>
          <p class="release-note">Free · Apple silicon · {site.downloadsEnabled ? 'Mac alpha' : 'Alpha in preparation'} · no account</p>
        </div>

        {heroFilm ? (
          <figure class="hero-film" id="hero-film">
            <div class="hero-film-frame">
              <video
                id="hero-player"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                poster={heroFilm.poster}
                width="1920"
                height="1080"
                aria-label={heroFilm.kind === 'teaser' ? 'Rotli teaser' : 'Rotli launch film'}
              >
                <source src={heroFilm.video} type="video/mp4" />
                {heroFilm.captions && (
                  <track kind="captions" src={heroFilm.captions} srclang="en" label="English" />
                )}
                <p class="hero-film-fallback">
                  Your browser cannot play this video here.{' '}
                  <a href={heroFilm.video}>Download the clip (MP4)</a>.
                </p>
              </video>
              <div class="hero-film-controls">
                <button class="hero-sound" type="button" aria-pressed="false" aria-label="Turn sound on">
                  <svg class="icon-muted" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M11 5 6 9H3v6h3l5 4V5z" />
                    <path d="m16 9 5 5M21 9l-5 5" />
                  </svg>
                  <svg class="icon-sound is-hidden" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M11 5 6 9H3v6h3l5 4V5z" />
                    <path d="M15.5 8.5a5 5 0 0 1 0 7" />
                    <path d="M18.5 5.5a9 9 0 0 1 0 13" />
                  </svg>
                  <span class="sound-label">Sound off</span>
                </button>
              </div>
            </div>
            <figcaption>
              <span>{heroFilm.kind === 'teaser' ? 'Teaser' : 'In motion'}</span>
              Plays muted · turn sound on when you want it
            </figcaption>
            <p class="hero-film-error" role="status" hidden>
              Playback could not start. <a href={heroFilm.video}>Open the clip directly</a>.
            </p>
          </figure>
        ) : (
          <figure class="product-figure">
            <div class="product-shot">
              <img
                src="/themes/paper@2x.webp"
                width="2376"
                height="1485"
                alt="Rotli's browser demo workspace in the Paper environment"
              />
            </div>
            <figcaption><span>Real browser demo</span> Paper · seeded local corpus</figcaption>
          </figure>
        )}
      </div>
    </section>

    <div class="proof-strip" aria-label="Rotli essentials" data-reveal>
      <span><b>⌥Space</b> summon from anywhere</span>
      <span><b>One folder</b> is the durable truth</span>
      <span><b>Offline</b> remains useful without AI</span>
      <span><b>Local-first</b> is the architecture</span>
    </div>

    <section class="folder-story" id="why-local" aria-labelledby="folder-title" data-reveal>
      <div class="section-copy">
        <h2 id="folder-title">One folder. Every path out stays open.</h2>
        <p>
          Your vault is an ordinary directory you choose. Markdown stays Markdown, and chat
          transcripts are Markdown too. Rotli’s hidden metadata is rebuildable structure—not a
          second content store.
        </p>
        <ul class="plain-promises">
          <li>
            <span>01</span>
            <p><b>Open your work in other apps.</b> Rotli never becomes the only door.</p>
          </li>
          <li>
            <span>02</span>
            <p><b>Back up the folder your way.</b> No proprietary export ritual.</p>
          </li>
          <li>
            <span>03</span>
            <p><b>Turn intelligence off.</b> A raw vault is still a complete workspace.</p>
          </li>
        </ul>
      </div>
      <div class="vault-anatomy" aria-label="Example Rotli vault structure">
        <div class="vault-heading"><span>~/Documents/Field Notes</span><span>Local folder</span></div>
        <ul class="file-tree">
          <li><span class="folder-icon">⌄</span><b>wiki/</b><small>your knowledge</small></li>
          <li class="nested"><span>◇</span>launch-notes.md<small>plain Markdown</small></li>
          <li class="nested"><span>◇</span>reading-list.md<small>plain Markdown</small></li>
          <li class="nested"><span class="folder-icon">⌄</span><b>_inbox/</b><small>quick captures</small></li>
          {site.showsExperiments && (
            <>
              <li><span class="folder-icon">⌄</span><b>storage/</b><small>experiments · dev preview</small></li>
              <li class="nested"><span>□</span>project-brief.docx<small>Word document</small></li>
              <li class="nested"><span>▦</span>forecast.xlsx<small>spreadsheet · coming soon</small></li>
              <li class="nested"><span>✣</span>system-map.excalidraw<small>board</small></li>
            </>
          )}
          <li><span class="folder-icon">⌄</span><b>chats/</b><small>portable transcripts</small></li>
          <li class="nested"><span>◇</span>planning-with-claude.md<small>Markdown transcript</small></li>
          <li><span class="folder-icon">·</span><b>.rotli/</b><small>rebuildable projections</small></li>
        </ul>
        <p class="anatomy-note">Delete the app and the work still makes sense.</p>
      </div>
    </section>

    <section class="organize-story" id="organize" aria-labelledby="organize-title" data-reveal>
      <div class="organize-copy">
        <h2 id="organize-title">Turn on the Librarian.<br />Work in a view.</h2>
        <p>
          That is the whole idea. With the Librarian on, you stay in Main or a named view while
          Rotli keeps Library and areas filed underneath. Views arrange the same files—they are
          not a second vault, and they are not a copy.
        </p>
        <ul class="organize-points">
          <li>
            <b>You work in a view</b>
            <span>Main and named views are the calm surface for today. Switch views when the job changes; leave the files where they live.</span>
          </li>
          <li>
            <b>The Librarian organizes underneath</b>
            <span>New notes stage for filing. Areas and summaries stay rebuildable metadata over ordinary Markdown.</span>
          </li>
          <li>
            <b>Organization without lock-in</b>
            <span>Turn the Librarian off and the folder remains a complete workspace. The files never depended on the projection.</span>
          </li>
        </ul>
      </div>
      <figure class="organize-figure">
        <div class="organize-shot">
          <img
            src="/themes/rotli-warm-light@2x.webp"
            width="2376"
            height="1485"
            alt="Rotli Home with Main, Welcome lessons, and Library in the sidebar"
            loading="lazy"
          />
        </div>
        <figcaption>
          <span>Main · the view you work in</span>
          Library stays organized underneath · lessons are ordinary notes
        </figcaption>
      </figure>
    </section>

    <section class="workspace-story" id="workspace" aria-labelledby="workspace-title" data-reveal>
      <div class="workspace-intro">
        <h2 id="workspace-title">Notes, tasks, links, and chat. All ordinary files.</h2>
        <p>
          Everything you edit in Rotli is a plain file in your folder. Nothing here is a
          preview of something you would need another app to change.
        </p>
      </div>
      <div class="surface-list">
        {surfaces.map((surface) => (
          <article class="surface-row">
            <h3>{surface.name}</h3>
            <div>
              <p>{surface.detail}</p>
              <span>{surface.proof}</span>
            </div>
          </article>
        ))}
      </div>
      {site.showsExperiments && (
        <aside class="experiments" aria-labelledby="experiments-title">
          <p class="experiment-tag">Experiment · dev preview</p>
          <h3 id="experiments-title">Also in development, outside the alpha scope</h3>
          <p>
            These features are under review and are not promised for the Mac alpha.
            Breve, spreadsheets, Mermaid diagram tabs and visual editing, read-aloud, and agent integrations are
            restricted to development builds.
          </p>
          <ul>
            {experiments.map((experiment) => (
              <li><b>{experiment.name}</b> {experiment.status}</li>
            ))}
          </ul>
        </aside>
      )}
    </section>

    <PlaygroundStory />

    <section class="privacy-story" id="privacy" aria-labelledby="privacy-title" data-reveal>
      <div class="privacy-visual">
        <img src={staysLocal.src} width="280" height="280" alt="The Rotli quokka holding a privacy shield" loading="lazy" />
        <p>Rotli excludes notes marked Secure from its remote model context. Locked notes remain readable, and AI edits are refused.</p>
      </div>
      <div class="privacy-copy">
        <h2 id="privacy-title">AI is invited into your workspace. It does not own the house.</h2>
        <p>
          Start with an on-device model, connect Claude Code or Codex, or use Cursor for code chat.
          You can also use no model at all. Connected providers are optional; their own data policies apply.
        </p>
        <dl class="boundary-list">
          <div><dt>On-device</dt><dd>Private by default and usable without a network.</dd></div>
          <div><dt>Connected</dt><dd>Your existing model tools, explicitly labeled as remote.</dd></div>
          <div><dt>Secure</dt><dd>Protected notes are excluded from Rotli's remote context. This is an AI access policy, not disk encryption.</dd></div>
          <div><dt>Locked</dt><dd>Every model may read; no model may edit.</dd></div>
        </dl>
      </div>
    </section>

    <section class="personal-story" id="personal" aria-labelledby="personal-title">
      <div class="personal-heading" data-reveal>
        <div>
          <h2 id="personal-title">Same workspace. The light that fits you.</h2>
        </div>
        <p>
          Six families, each with a light and dark environment. Click a family or let them
          cycle—the calm grammar around your notes stays the same.
        </p>
      </div>

      <div class="theme-studio" data-reveal>
        <figure class="theme-capture">
          <img
            id="theme-preview-image"
            src={defaultThemeShot.screenshot}
            width="2376"
            height="1485"
            alt={`Rotli workspace in the ${defaultThemeShot.environment} environment`}
            loading="lazy"
          />
          <script is:inline id="theme-tour-data" type="application/json" set:html={JSON.stringify(themeTour)} />
          <figcaption>
            <span id="theme-preview-family">{defaultTheme.name}</span>
            <b id="theme-preview-caption">{defaultThemeShot.environment}</b>
          </figcaption>
        </figure>

        <aside class="theme-picker" aria-label="Theme environments">
          <div class="theme-grid" role="group" aria-label="Preview a Rotli environment">
            <span class="theme-grid-head">Light</span>
            <span class="theme-grid-head">Dark</span>
            {themeFamilies.map((family, index) => (
              <>
                <button
                  class="theme-orb-button"
                  type="button"
                  data-theme-stop={`${family.id}:light`}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                  aria-label={family.light.environment}
                  title={family.light.environment}
                >
                  <span class="theme-orb" style={orbStyle(family.id, 'light')} aria-hidden="true"></span>
                </button>
                <button
                  class="theme-orb-button"
                  type="button"
                  data-theme-stop={`${family.id}:dark`}
                  aria-pressed="false"
                  aria-label={family.dark.environment}
                  title={family.dark.environment}
                >
                  <span class="theme-orb" style={orbStyle(family.id, 'dark')} aria-hidden="true"></span>
                </button>
                <span class="theme-row-label">{family.id === 'paper' ? 'Paper' : family.name}</span>
              </>
            ))}
          </div>
        </aside>
      </div>

      <div class="companion-preview" data-reveal>
        <div class="companion-art" id="companion-art">
          <div class="companion-stage" aria-live="polite">
            {companions.map((companion, index) => (
              <button
                class:list={[
                  'companion-slide',
                  { 'is-active': index === 0, 'is-next': index === 1, 'is-prev': index === companions.length - 1 },
                ]}
                type="button"
                data-companion-index={index}
                aria-label={`Show ${companion.label}`}
                tabindex="-1"
              >
                <img
                  src={companion.src.src}
                  width="400"
                  height="400"
                  alt={companion.alt}
                  loading="lazy"
                  decoding="async"
                />
              </button>
            ))}
          </div>
          <div class="companion-dots" role="group" aria-label="Choose a quokka pose">
            {companions.map((companion, index) => (
              <button
                class="companion-dot"
                type="button"
                data-companion-index={index}
                aria-pressed={index === 0 ? 'true' : 'false'}
                aria-label={companion.label}
                title={companion.label}
              ></button>
            ))}
          </div>
          <p class="companion-caption" id="companion-caption">{companions[0].label}</p>
        </div>
        <div class="companion-copy">
          <h3>Your quokka, when you want one.</h3>
          <p>
            Choose body color, black or white linework, idle mood, pose, and independently
            colored glasses or a bucket hat. Turn the companion off and it
            stays in onboarding only.
          </p>
          <ul aria-label="Companion customization options">
            <li>7 body presets + custom hue</li>
            <li>2 accessories + custom color</li>
            <li>semantic poses for empty states</li>
          </ul>
        </div>
      </div>
    </section>

    {site.showsExperiments && (
    <section class="beyond-story" id="beyond-the-app" aria-labelledby="beyond-title" data-reveal>
      <div class="beyond-heading">
        <h2 id="beyond-title">Your vault can work with the agents you already run.</h2>
      </div>
      <div class="beyond-lanes">
        <article class="experiment-lane">
          <div class="lane-title">
            <span>CLI + MCP <i class="experiment-tag">Experiment · dev preview</i></span>
            <b>Local agents, through Rotli’s own policy</b>
          </div>
          <p>
            The installed Rotli binary exposes a bounded JSON CLI and a local stdio MCP server, so
            Claude Code, Codex, and Cursor can read and write notes through the same rules the app
            uses. The stdio connection opens no network listener.
          </p>
          <p class="lane-proof">
            <span>Stdio stays local · one policy engine · being refined before release</span>
            <a href="/mcp/">Read the MCP guide <span aria-hidden="true">→</span></a>
          </p>
        </article>
            <article class="experiment-lane">
              <div class="lane-title">
                <span>Breve <i class="experiment-tag">Experiment · dev preview</i></span>
                <b>Quiet routines, owned by Rotli</b>
              </div>
              <p>
                Morning briefs, watchlists, reminders, delivery, and scheduler health in one managed
                runtime. Generated briefs are ordinary vault Markdown. Not part of the alpha scope.
              </p>
              <p class="lane-proof">Vault-owned configuration · development builds only</p>
            </article>
            <article class="experiment-lane">
              <div class="lane-title">
                <span>Remote agents <i class="experiment-tag">Experiment · dev preview</i></span>
                <b>Cloud MCP clients through a stateless relay</b>
              </div>
              <p>
                Opt-in sessions let a cloud client reach your running Mac through a relay you operate,
                without moving the vault into the cloud. No hosted relay is launched.
              </p>
              <p class="lane-proof">Session opt-in · same policy engine · outside alpha scope</p>
            </article>
      </div>
    </section>
    )}

    <section class="final-cta" aria-labelledby="final-title" data-reveal>
      <span class="final-mark" set:html={mark} aria-hidden="true"></span>
      <div>
        <h2 id="final-title">A durable place for the work you want to keep.</h2>
        <p>Warm enough to return to. Quiet enough to disappear. Local enough to remain yours.</p>
      </div>
      <div class="final-actions">
        {site.downloadsEnabled ? (
          <a class="button final-button" href={DOWNLOAD_URL} rel="noopener">Download the Mac alpha</a>
        ) : (
          <span class="button final-button pending" aria-disabled="true">Mac alpha coming soon</span>
        )}
        <a class="button final-link" href={finalAction.href} rel={finalAction.external ? 'noopener' : undefined}>
          {finalAction.label}
        </a>
      </div>
    </section>
  </main>

