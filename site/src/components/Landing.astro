---
// The launch page, in the order of docs/design/landing-layout-2026-10-05.md. The hero (the
// product film) says what rotli is; three cards say what it does (write, keep, ask); the
// StatBand and TwoKinds say why the Librarian exists (the AI you already pay for is idle, and
// it can file your notes without touching your words); the tour shows each part up close and
// holds Rotli Web and the Helper; then make it yours, privacy in brief, questions, and one
// closing panel that asks for a first note, right above the footer's quokka beach. Grounds
// alternate plain and warm, with the privacy night between. Base.astro owns the tokens and
// the section grammar.
import { landingGraph } from '../agents';
import { ogImage } from '../og';
import Base from '../layouts/Base.astro';
import { site } from '../site';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import Closing from './landing/Closing.astro';
import Experiments from './landing/Experiments.astro';
import Faq from './landing/Faq.astro';
import Hero from './landing/Hero.astro';
import Overview from './landing/Overview.astro';
import StatBand from './landing/StatBand.astro';
import TwoKinds from './landing/TwoKinds.astro';
import Personal from './landing/Personal.astro';
import PrivacyBrief from './landing/PrivacyBrief.astro';
import Tour from './landing/Tour.astro';
---

<Base noindex={!site.indexable} structuredData={landingGraph()} markdownPath="/index.md" {...ogImage('home')}>
  <SiteHeader current="product" />
  <main id="content">
    <Hero />
    <Overview />
    <StatBand />
    <TwoKinds />
    <Tour />
    <Experiments />
    <Personal />
    <PrivacyBrief />
    <Faq />
    <Closing />
  </main>
  <SiteFooter />
</Base>
