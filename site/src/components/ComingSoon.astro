---
// The rotli.co holding page stays in Rotli Light, with no download or account.
// Keep the compact mobile introduction before the real product preview. The
// launch film follows the introduction when its artifacts exist; a GitHub call
// to action appears only once the source repository is public.
import Base from '../layouts/Base.astro';
import PromoFilm from './PromoFilm.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import { GITHUB_URL, site } from '../site';

const promises = [
  { title: 'One ordinary folder.', detail: 'Your notes and files stay on your Mac, ready to open in other apps.' },
  { title: 'A useful first minute.', detail: 'Nine welcome lessons help you try the real editor. They are your own notes: edit them, or delete the folder.' },
  { title: 'AI when you want it.', detail: 'Use an on-device model, connect your own tools, or write without AI.' },
];

const action = site.sourcePublic
  ? { href: GITHUB_URL, label: 'Follow development on GitHub', glyph: '↗', external: true }
  : site.promo.enabled
    ? { href: '#film', label: 'Watch the film', glyph: '↓', external: false }
    : null;
---

<Base
  title="Rotli — coming soon"
  description="A local-first Mac workspace for notes, tasks, links, and ideas. Start with the Welcome folder. Keep your work in one ordinary folder. Mac alpha coming soon."
  canonicalPath="/"
>
  <SiteHeader minimal />

  <main id="content">
    <div class="soon">
      <section class="soon-copy" aria-labelledby="soon-title">
        <p class="kicker">Coming soon for macOS</p>
        <h1 id="soon-title">Room to think.<br />Files you keep.</h1>
        <p class="lede">
          A calm place for notes, tasks, links, and ideas.
          Rotli brings them together in one folder you own, with no account required.
        </p>
        <p class="status">
          <span class="status-mark" aria-hidden="true"></span>
          Mac alpha in preparation · Free · Apple silicon
        </p>
        {action && (
          <a
            class="button primary development-link"
            href={action.href}
            rel={action.external ? 'noopener' : undefined}
          >
            {action.label} <span aria-hidden="true">{action.glyph}</span>
          </a>
        )}
        <ul class="promises">
          {promises.map((promise) => (
            <li><b>{promise.title}</b> {promise.detail}</li>
          ))}
        </ul>
      </section>

      <figure class="soon-preview">
        <img
          src="/rotli-playground@3x.png"
          width="1440"
          height="900"
          alt="Rotli's Tasks and progress lesson from the Welcome folder in Main, in Rotli Light"
          fetchpriority="high"
        />
        <figcaption>Actual browser preview · Practice stays in the app until you choose to save.</figcaption>
      </figure>
    </div>

    <PromoFilm />
  </main>

  <SiteFooter tagline="A local-first workspace for your Mac. © 2026 Rotli" links={[]} />

  <style>
    .soon {
      width: min(100% - 2rem, var(--page-max));
      margin-inline: auto;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
      padding-block: 2rem 3.5rem;
    }

    .soon-copy { max-width: 38rem; }

    .kicker {
      margin: 0 0 0.9rem;
      color: var(--accent-text);
      font-size: 0.88rem;
      font-weight: 600;
    }

    h1 {
      margin: 0;
      font-size: clamp(2.6rem, 8vw, 5rem);
      line-height: 1;
      letter-spacing: -0.04em;
      font-weight: 600;
      text-wrap: balance;
    }

    .lede {
      max-width: 34rem;
      margin: 1.25rem 0 0;
      color: var(--text-muted);
      font-size: clamp(1.02rem, 1.6vw, 1.2rem);
      line-height: 1.55;
    }

    .promises {
      display: grid;
      gap: 0.85rem;
      margin: 2rem 0 0;
      padding: 0;
      list-style: none;
    }

    .promises li {
      padding-top: 0.85rem;
      border-top: 1px solid var(--border);
      color: var(--text-muted);
      font-size: 0.96rem;
    }

    .promises b { color: var(--text); font-weight: 600; }

    .status {
      display: flex;
      align-items: flex-start;
      gap: 0.6rem;
      margin: 1.75rem 0 0;
      color: var(--text-muted);
      font-size: 0.88rem;
      line-height: 1.5;
    }

    .status-mark {
      flex: none;
      width: 0.6rem;
      height: 0.6rem;
      margin-top: 0.4rem;
      border-radius: 50%;
      border: 1px solid var(--accent-text);
      background: var(--accent);
    }

    .development-link { margin-top: 1.1rem; }
    .soon-preview { min-width: 0; margin: 0; }

    .soon-preview img {
      display: block;
      width: 100%;
      height: auto;
      border: 1px solid var(--border);
      border-radius: 0.85rem;
    }

    figcaption {
      margin-top: 1rem;
      color: var(--text-muted);
      font-size: 0.85rem;
      line-height: 1.5;
    }

    @media (min-width: 640px) {
      .soon { width: min(100% - 3rem, var(--page-max)); padding-block: 3rem 4rem; }
    }

    @media (min-width: 960px) {
      .soon {
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
        gap: clamp(2.5rem, 5vw, 5rem);
        align-items: center;
        min-height: calc(100svh - 76px - 8rem);
      }
    }
  </style>
</Base>
