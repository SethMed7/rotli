---
// The frame every subpage shares: the site header and footer around a page
// head (breadcrumb, title, lede, metadata line) and a body, all on the site
// grid so the title lines up with the header's brand. Long pages pass `toc`
// and read as an article: a sticky "On this page" tree beside a reading
// column (about 70 characters), with the section in view highlighted and a
// slim rail that fills as you read; below 900px the tree folds into an
// "On this page" disclosure above the text. The highlight and the rail are
// script (progressive enhancement); without it the tree is plain links.
// Pages that pass `progress` (resource articles, blog posts, /privacy/) also get a reading meter pinned under the
// header on every width: a bar and "N% through", measured over the article alone
// (src/reading.ts, the same measure that fills the tree's rail). It shows only when the
// article is longer than the window, and it is a position, never a record: nothing is kept.
// Blog posts and /privacy/ open on a banner (`banner`, or the `banner` slot for a
// drawn scene): a full-width picture under the header that takes most of the first
// window, held in place while the page rises over it. The head becomes a panel on the
// page's own ground that overlaps the banner's lower left, where the art is kept open, so
// the title, date, and reading time are read on the ground, never on the picture. Phones
// get a shorter crop with the panel just below it.
// Rendered Markdown arrives as children, so its typography is styled with
// :global() in .prose.
import Base from '../layouts/Base.astro';
import type { NavSection } from '../nav';
import type { Banner } from '../og';
import { site } from '../site';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  /** Which header section to mark current; none for pages outside the nav. */
  section?: NavSection;
  /** A trail back up, e.g. [{ href: '/resources/', label: 'Resources' }]. */
  crumbs?: { href: string; label: string }[];
  /** Small line above the headline: a draft label or a section name. */
  kicker?: string;
  heading: string;
  lede?: string;
  /** The metadata line under the lede: a date, "Updated …", a reading time. */
  meta?: string[];
  /** Headings for the "On this page" column (depth-2 headings only). */
  toc?: { slug: string; text: string }[];
  /** Let the body use the full page width (index pages, choosers). */
  wide?: boolean;
  /** Center the head and the reading column on the page (About). */
  center?: boolean;
  /** Pin a reading meter under the header (resource articles, blog posts, /privacy/). */
  progress?: boolean;
  /** A full-width picture above the head (a blog post's banner, src/og.ts); the `banner` slot takes a drawn one. */
  banner?: Banner;
  /** Passed through to Base: JSON-LD facts, the Markdown twin, and the link card (src/og.ts). */
  structuredData?: Record<string, unknown>[];
  markdownPath?: string;
  image?: string;
  imageAlt?: string;
}

const {
  title,
  description,
  canonicalPath,
  section,
  crumbs = [],
  kicker,
  heading,
  lede,
  meta = [],
  toc = [],
  wide = false,
  center = false,
  progress = false,
  banner,
  structuredData,
  markdownPath,
  image,
  imageAlt,
} = Astro.props;
const hasToc = toc.length > 1;
const hasBanner = banner !== undefined || Astro.slots.has('banner');
---

<Base
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  noindex={!site.indexable}
  structuredData={structuredData}
  markdownPath={markdownPath}
  image={image}
  imageAlt={imageAlt}
>
  <SiteHeader current={section} />
  {
    hasBanner && (
      <div class:list={['article-banner', { drawn: !banner }]} data-article-banner>
        {banner ? (
          <picture class="banner-art">
            <source
              media="(max-width: 900px)"
              srcset={banner.mobile}
              width={banner.mobileWidth}
              height={banner.mobileHeight}
            />
            <img
              src={banner.src}
              srcset={banner.srcset}
              sizes="100vw"
              width={banner.width}
              height={banner.height}
              alt={banner.alt}
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        ) : (
          <slot name="banner" />
        )}
      </div>
    )
  }
  <div class:list={{ sheet: hasBanner }}>
  <main id="content" class:list={['wrap writing', { center, 'has-progress': progress, 'has-banner': hasBanner }]}>
    <header class="writing-head">
      <div class="head-copy">
        {
          crumbs.length > 0 && (
            <nav class="crumbs" aria-label="Breadcrumb">
              {crumbs.map((crumb) => (
                <>
                  <a href={crumb.href}>{crumb.label}</a>
                  <span aria-hidden="true">/</span>
                </>
              ))}
            </nav>
          )
        }
        {kicker && <p class="kicker">{kicker}</p>}
        <h1>{heading}</h1>
        {/* Under a banner the date and reading time sit with the title, inside the panel's first lines. */}
        {hasBanner && (
          meta.length > 0 && (
            <p class="meta">
              {meta.map((part, index) => (
                <>
                  {index > 0 && <span aria-hidden="true">·</span>}
                  <span>{part}</span>
                </>
              ))}
            </p>
          )
        )}
        {lede && <p class="lede">{lede}</p>}
        {!hasBanner && (
          meta.length > 0 && (
            <p class="meta">
              {meta.map((part, index) => (
                <>
                  {index > 0 && <span aria-hidden="true">·</span>}
                  <span>{part}</span>
                </>
              ))}
            </p>
          )
        )}
      </div>
    </header>
    <slot name="scene" />
    {
      progress && (
        <div
          class="read-progress"
          data-read-progress
          role="progressbar"
          aria-label="Position in this article"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          hidden
        >
          <span class="read-track" aria-hidden="true">
            <span class="read-fill" data-read-fill />
          </span>
          <span class="read-label" aria-hidden="true">
            <b data-read-percent>0%</b> through
          </span>
        </div>
      )
    }
    <div class:list={['writing-body', { 'has-toc': hasToc, wide }]}>
      {
        hasToc && (
          <>
            <details class="toc-compact">
              <summary>On this page</summary>
              <ul>
                {toc.map((item) => (
                  <li>
                    <a href={`#${item.slug}`}>{item.text}</a>
                  </li>
                ))}
              </ul>
            </details>
            <nav class="toc" aria-label="On this page" data-toc>
              <p>On this page</p>
              <div class="toc-tree">
                <span class="toc-rail" aria-hidden="true"><span class="toc-progress" data-toc-progress></span></span>
                <ul>
                  {toc.map((item) => (
                    <li>
                      <a href={`#${item.slug}`}>{item.text}</a>
                    </li>
                  ))}
                </ul>
              </div>
            </nav>
          </>
        )
      }
      <div class="prose" data-prose>
        <slot />
      </div>
    </div>
    <slot name="after" />
  </main>
  <SiteFooter />
  </div>
</Base>

<script>
  import { readingProgress } from '../reading';

  // The article tree and the reading meter: highlight the section being read (the last
  // heading that has passed under the pinned header), and fill the tree's rail and the meter
  // with how far through the article the window is (one measure, src/reading.ts). Scroll
  // work is batched into one frame. The compact disclosure closes once a heading is chosen.
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  const prose = document.querySelector<HTMLElement>('[data-prose]');
  const rail = document.querySelector<HTMLElement>('[data-toc-progress]');
  const meter = document.querySelector<HTMLElement>('[data-read-progress]');
  const fill = meter?.querySelector<HTMLElement>('[data-read-fill]') ?? null;
  const percentLabel = meter?.querySelector<HTMLElement>('[data-read-percent]') ?? null;
  if (prose && (toc || meter)) {
    const links = toc ? [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')] : [];
    const targets = links
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((target): target is HTMLElement => target !== null);
    let frame = 0;
    let shown = -1;
    const update = () => {
      frame = 0;
      const header = document.querySelector('.site-header-bar')?.getBoundingClientRect().bottom ?? 0;
      // The meter covers the top of the reading area while it is pinned, so it counts as header.
      const top = meter && !meter.hidden ? Math.max(header, meter.getBoundingClientRect().bottom) : header;
      const line = top + window.innerHeight * 0.2;
      let active = -1;
      targets.forEach((target, index) => {
        if (target.getBoundingClientRect().top <= line) active = index;
      });
      links.forEach((link, index) => {
        if (index === active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      const box = prose.getBoundingClientRect();
      const reading = readingProgress({ top: box.top, height: box.height }, window.innerHeight, top);
      if (rail) rail.style.transform = `scaleY(${reading.fraction})`;
      if (meter && fill && percentLabel) {
        meter.hidden = reading.fits;
        fill.style.transform = `scaleX(${reading.fraction})`;
        if (reading.percent !== shown) {
          shown = reading.percent;
          percentLabel.textContent = `${reading.percent}%`;
          meter.setAttribute('aria-valuenow', String(reading.percent));
        }
      }
    };
    const schedule = () => {
      if (frame === 0) frame = requestAnimationFrame(update);
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    // Images and fonts change the article's height after load; measure again when they do.
    new ResizeObserver(schedule).observe(prose);
    toc?.classList.add('is-live');
    update();
  }
  document.querySelectorAll<HTMLDetailsElement>('.toc-compact').forEach((details) => {
    details.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => (details.open = false)));
  });
</script>

<style>
  /* What is pinned over the top of an article: the header, and on pages with a reading meter
     the meter under it (its height is fixed so everything below can clear it). The tree and
     every jump target sit below that, with the same breathing room. */
  .writing {
    --meter-height: 0px;
    --pinned: calc(var(--header-height) + 1px + var(--meter-height));
    padding-block: clamp(3rem, 7vw, 5rem) var(--section-space);
  }
  .writing.has-progress {
    --meter-height: 2.5rem;
  }
  .writing :global([id]) {
    scroll-margin-top: calc(var(--pinned) + 1.5rem);
  }
  /* The banner: under the pinned header, most of the first window tall (enough of the window
     is left for the title and the date), and held in place while the sheet below (the article
     and the footer, on the page's own ground) scrolls up over it. Phones get the shorter crop. */
  .article-banner {
    --banner-height: clamp(20rem, calc(100svh - var(--header-height) - 12rem), 54rem);
    position: sticky;
    top: calc(var(--header-height) + 1px);
    z-index: 0;
    height: var(--banner-height);
    overflow: hidden;
    background: var(--surface-2);
  }
  .banner-art,
  .banner-art img {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* The picture keeps its quokka and props (its right half) and its sand in view at every width:
     the scenes (scripts/brand-images/scenes.mjs, `wide`) keep the lower left open for the panel. */
  .banner-art img {
    object-fit: cover;
    object-position: 100% 100%;
    transform-origin: 80% 100%;
  }
  /* flow-root: the head's pull upward stays inside the sheet instead of collapsing through
     it, so the sheet's ground starts at the banner's bottom edge and only the panel overlaps. */
  .sheet {
    position: relative;
    z-index: 1;
    display: flow-root;
    background: var(--ground);
  }
  /* The head is a panel on the ground that rises over the banner's lower left, where the art
     is open sea and sand: the title and the date are read on the ground, at full contrast. */
  .article-banner,
  .writing.has-banner {
    --banner-overlap: 7rem;
  }
  .writing.has-banner {
    --panel-pad: clamp(1.25rem, 2.5vw, 2.5rem);
    padding-top: 0;
  }
  .has-banner .writing-head {
    margin-top: calc(-1 * var(--banner-overlap));
  }
  .has-banner .head-copy {
    position: relative;
    max-width: 36rem;
    margin-inline-start: calc(-1 * var(--panel-pad));
    padding: clamp(1.5rem, 3vw, 2.25rem) var(--panel-pad) 0;
    border-radius: var(--radius-frame) var(--radius-frame) 0 0;
    background: var(--ground);
  }
  .has-banner h1 {
    font-size: clamp(2.2rem, 4vw, 3.25rem);
  }
  .has-banner .meta {
    margin-top: 1rem;
  }
  .has-banner .lede {
    margin-top: 1.25rem;
  }
  @media (max-width: 900px) {
    .article-banner {
      --banner-height: min(calc(100vw * 900 / 1300), 55svh);
    }
    .banner-art img {
      object-position: 50% 100%;
    }
    .article-banner,
    .writing.has-banner {
      --banner-overlap: 1.5rem;
    }
    /* A drawn banner (the slot) sizes to its scene and words on a phone. */
    .article-banner.drawn {
      height: auto;
    }
    .has-banner .head-copy {
      max-width: none;
      margin-inline: calc(-1 * var(--panel-pad));
    }
  }
  /* A slow settle as the page rises over it: the art grows a few percent toward its sand.
     Scroll-driven, so it is CSS only; still where reduced motion is asked for or unsupported. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      /* Longhands, never the shorthand: the minifier folds a following animation-timeline into
         `animation`, which does not accept a timeline, and the whole declaration is dropped. */
      .banner-art img {
        animation-name: banner-settle;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 0 80svh;
      }
    }
  }
  @keyframes banner-settle {
    to {
      transform: scale(1.06);
    }
  }
  /* The rule under the head spans the page; the words keep a reading width. */
  .head-copy {
    max-width: 48rem;
  }
  .writing-head {
    padding-bottom: clamp(2rem, 4vw, 3rem);
    margin-bottom: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--border-strong);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .crumbs a {
    color: var(--text-muted);
    text-underline-offset: 0.2em;
  }
  .crumbs a:hover {
    color: var(--text);
  }
  /* On touch the trail's links get a 44px-tall hit area; the text does not move. */
  @media (pointer: coarse) {
    .crumbs a {
      display: inline-block;
      padding: 0.7rem 0;
      margin: -0.7rem 0;
    }
  }
  .kicker {
    margin: 0 0 0.9rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.4rem, 5vw, 3.75rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .lede {
    max-width: 40rem;
    margin: 1.1rem 0 0;
    color: var(--text-muted);
    font-size: var(--step-lede);
    line-height: 1.55;
    text-wrap: pretty;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.55rem;
    margin: 1.25rem 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  /* The reading meter: pinned just under the header while the article scrolls by, on the
     page's own ground so the text passes beneath it. A bar and a plain number. */
  .read-progress {
    position: sticky;
    top: calc(var(--header-height) + 1px);
    z-index: 20;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    box-sizing: border-box;
    height: var(--meter-height);
    margin: calc(-1 * clamp(1.25rem, 3vw, 2rem)) 0 clamp(1.25rem, 3vw, 2rem);
    background: var(--ground);
  }
  .read-progress[hidden] {
    display: none;
  }
  .read-track {
    height: 4px;
    border-radius: 2px;
    background: var(--border);
    overflow: hidden;
  }
  .read-fill {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  .read-label {
    min-width: 7.5ch;
    color: var(--text-muted);
    font-size: 0.84rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .read-label b {
    color: var(--text);
    font-weight: 600;
  }
  /* The body sits on the grid's left edge; with a table of contents it gets
     a narrow first column that stays in view while reading. */
  .writing-body {
    display: grid;
    grid-template-columns: minmax(0, 44rem);
  }
  .writing-body.wide {
    grid-template-columns: minmax(0, 1fr);
  }
  .writing-body.has-toc {
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
  }
  /* The reading column: about 70 characters of body text. */
  .writing-body.has-toc .prose {
    max-width: 70ch;
  }
  .toc {
    position: sticky;
    top: calc(var(--pinned) + 1.5rem);
    align-self: start;
    max-height: calc(100dvh - var(--pinned) - 3rem);
    overflow-y: auto;
    font-size: 0.9rem;
  }
  .toc p {
    margin: 0 0 0.75rem;
    font-size: 0.84rem;
    font-weight: 600;
  }
  /* A tree: one rail down the left, each heading branching off it. The rail
     fills with the share of the page read (script); the heading in view takes
     the accent mark and full-strength text. */
  .toc-tree {
    position: relative;
  }
  .toc-rail {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    border-radius: 1px;
    background: var(--border);
    overflow: hidden;
  }
  .toc-progress {
    display: block;
    height: 100%;
    background: var(--border-strong);
    transform: scaleY(0);
    transform-origin: top;
  }
  .toc ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .toc li {
    position: relative;
  }
  .toc li::before {
    content: '';
    position: absolute;
    top: 1.05em;
    left: 2px;
    width: 0.55rem;
    border-top: 1px solid var(--border);
  }
  .toc a {
    position: relative;
    display: block;
    padding: 0.38rem 0 0.38rem 1.1rem;
    color: var(--text-muted);
    line-height: 1.35;
    text-decoration: none;
    transition: color 140ms ease-out;
  }
  .toc a:hover,
  .toc a[aria-current='location'] {
    color: var(--text);
  }
  .toc a[aria-current='location'] {
    font-weight: 600;
  }
  .toc a[aria-current='location']::before {
    content: '';
    position: absolute;
    top: 0.3rem;
    bottom: 0.3rem;
    left: 0;
    width: 2px;
    border-radius: 1px;
    background: var(--accent-text);
  }
  .toc a:focus-visible {
    outline-offset: 1px;
  }
  /* Narrow screens: the same headings in a disclosure above the text. */
  .toc-compact {
    display: none;
    margin-bottom: 2rem;
    border-block: 1px solid var(--border-strong);
  }
  .toc-compact summary {
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .toc-compact summary::-webkit-details-marker {
    display: none;
  }
  .toc-compact summary::after {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.3rem;
    border-right: 1.5px solid var(--text-muted);
    border-bottom: 1.5px solid var(--text-muted);
    transform: translateY(-25%) rotate(45deg);
    transition: transform 140ms ease-out;
  }
  .toc-compact[open] summary::after {
    transform: translateY(25%) rotate(-135deg);
  }
  .toc-compact ul {
    margin: 0 0 1rem;
    padding: 0 0 0 0.9rem;
    list-style: none;
    border-left: 2px solid var(--border);
  }
  .toc-compact a {
    min-height: 40px;
    display: flex;
    align-items: center;
    color: var(--text-muted);
    text-decoration: none;
  }
  .toc-compact a:hover {
    color: var(--text);
  }
  @media (max-width: 900px) {
    .writing-body.has-toc {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .toc {
      display: none;
    }
    .toc-compact {
      display: block;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .toc a,
    .toc-compact summary::after {
      transition: none;
    }
  }
  .prose {
    font-size: 1.06rem;
    line-height: 1.7;
  }
  .prose > :global(:first-child) {
    margin-top: 0;
  }
  .prose :global(h2) {
    margin: 2.8rem 0 0.8rem;
    font-size: 1.45rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    scroll-margin-top: calc(var(--pinned) + 1.5rem);
  }
  .prose :global(h3) {
    margin: 2rem 0 0.6rem;
    font-size: 1.15rem;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.1rem;
    text-wrap: pretty;
  }
  .prose :global(li + li) {
    margin-top: 0.35rem;
  }
  /* Buttons and list entries keep their own colours; only running-text links take the accent. */
  .prose :global(a:not(.button, .plain-link)) {
    color: var(--accent-text);
    text-underline-offset: 0.2em;
  }
  .prose :global(code) {
    padding: 0.1em 0.35em;
    border-radius: 0.35rem;
    background: var(--surface-2);
    font-size: 0.92em;
    /* A long identifier breaks inside the column on a phone instead of widening the page. */
    overflow-wrap: anywhere;
  }
  /* Long shell lines (the Helper's install command) wrap at their spaces
     inside the box instead of running past it; newlines are kept. */
  .prose :global(pre) {
    overflow-x: auto;
    white-space: pre-wrap;
    overflow-wrap: break-word;
    padding: 1rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: 0.7rem;
    background: var(--surface);
  }
  .prose :global(pre code) {
    padding: 0;
    background: none;
  }
  .prose :global(table) {
    width: 100%;
    margin: 0 0 1.4rem;
    border-collapse: collapse;
    font-size: 0.98rem;
  }
