---
// The frame every subpage shares: the site header and footer around a page
// head (breadcrumb, title, lede) and a body, all on the site grid so the
// title lines up with the header's brand. Long pages pass `toc` and get an
// "On this page" column beside the body on wide screens. Rendered Markdown
// arrives as children, so its typography is styled with :global() in .prose.
import Base from '../layouts/Base.astro';
import type { NavSection } from '../nav';
import { site } from '../site';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  /** Which header section to mark current; none for pages outside the nav. */
  section?: NavSection;
  /** A trail back up, e.g. [{ href: '/resources/', label: 'Resources' }]. */
  crumbs?: { href: string; label: string }[];
  /** Small line above the headline: a date or a draft label. */
  kicker?: string;
  heading: string;
  lede?: string;
  /** Headings for the "On this page" column (depth-2 headings only). */
  toc?: { slug: string; text: string }[];
  /** Let the body use the full page width (index pages, choosers). */
  wide?: boolean;
  /** Center the head and the reading column on the page (About). */
  center?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  section,
  crumbs = [],
  kicker,
  heading,
  lede,
  toc = [],
  wide = false,
  center = false,
} = Astro.props;
const hasToc = toc.length > 1;
---

<Base title={title} description={description} canonicalPath={canonicalPath} noindex={!site.indexable}>
  <SiteHeader current={section} />
  <main id="content" class:list={['wrap writing', { center }]}>
    <header class="writing-head">
      {
        crumbs.length > 0 && (
          <nav class="crumbs" aria-label="Breadcrumb">
            {crumbs.map((crumb) => (
              <>
                <a href={crumb.href}>{crumb.label}</a>
                <span aria-hidden="true">/</span>
              </>
            ))}
          </nav>
        )
      }
      {kicker && <p class="kicker">{kicker}</p>}
      <h1>{heading}</h1>
      {lede && <p class="lede">{lede}</p>}
    </header>
    <slot name="scene" />
    <div class:list={['writing-body', { 'has-toc': hasToc, wide }]}>
      {
        hasToc && (
          <nav class="toc" aria-label="On this page">
            <p>On this page</p>
            <ul>
              {toc.map((item) => (
                <li>
                  <a href={`#${item.slug}`}>{item.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      <div class="prose">
        <slot />
      </div>
    </div>
    <slot name="after" />
  </main>
  <SiteFooter />
</Base>

<style>
  .writing {
    padding-block: clamp(3rem, 7vw, 5rem) var(--section-space);
  }
  /* The rule under the head spans the page; the words keep a reading width. */
  .writing-head > * {
    max-width: 48rem;
  }
  .writing-head {
    padding-bottom: clamp(2rem, 4vw, 3rem);
    margin-bottom: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--border-strong);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .crumbs a {
    color: var(--text-muted);
    text-underline-offset: 0.2em;
  }
  .crumbs a:hover {
    color: var(--text);
  }
  .kicker {
    margin: 0 0 0.9rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.4rem, 5vw, 3.75rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .lede {
    max-width: 40rem;
    margin: 1.1rem 0 0;
    color: var(--text-muted);
    font-size: var(--step-lede);
    line-height: 1.55;
    text-wrap: pretty;
  }
  /* The body sits on the grid's left edge; with a table of contents it gets
     a narrow first column that stays in view while reading. */
  .writing-body {
    display: grid;
    grid-template-columns: minmax(0, 44rem);
  }
  .writing-body.wide {
    grid-template-columns: minmax(0, 1fr);
  }
  .writing-body.has-toc {
    grid-template-columns: 13rem minmax(0, 44rem);
    gap: clamp(2rem, 5vw, 4.5rem);
  }
  .toc {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
    align-self: start;
    font-size: 0.92rem;
  }
  .toc p {
    margin: 0 0 0.6rem;
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 600;
  }
  .toc ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--border-strong);
  }
  .toc a {
    display: block;
    padding: 0.4rem 0 0.4rem 0.9rem;
    color: var(--text-muted);
    line-height: 1.35;
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--text);
  }
  @media (max-width: 900px) {
    .writing-body.has-toc {
      grid-template-columns: minmax(0, 1fr);
    }
    .toc {
      display: none;
    }
  }
  .prose {
    font-size: 1.06rem;
    line-height: 1.7;
  }
  .prose > :global(:first-child) {
    margin-top: 0;
  }
  .prose :global(h2) {
    margin: 2.8rem 0 0.8rem;
    font-size: 1.45rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
  }
  .prose :global(h3) {
    margin: 2rem 0 0.6rem;
    font-size: 1.15rem;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.1rem;
    text-wrap: pretty;
  }
  .prose :global(li + li) {
    margin-top: 0.35rem;
  }
  /* Buttons and list entries keep their own colours; only running-text links take the accent. */
  .prose :global(a:not(.button, .plain-link)) {
    color: var(--accent-text);
    text-underline-offset: 0.2em;
  }
  .prose :global(code) {
    padding: 0.1em 0.35em;
    border-radius: 0.35rem;
    background: var(--surface-2);
    font-size: 0.92em;
  }
  .prose :global(pre) {
    overflow-x: auto;
    padding: 1rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: 0.7rem;
    background: var(--surface);
  }
  .prose :global(pre code) {
    padding: 0;
    background: none;
  }
  .prose :global(table) {
    width: 100%;
    margin: 0 0 1.4rem;
    border-collapse: collapse;
    font-size: 0.98rem;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 0.7rem 0.75rem 0.7rem 0;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) {
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 600;
  }
  .prose :global(blockquote) {
    margin: 1.6rem 0;
    padding-left: 1.1rem;
    border-left: 3px solid var(--accent);
    color: var(--text-muted);
  }
  /* Centered pages: the head, the scene, and one reading column share the page's middle. */
  .center .writing-head {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .center .writing-head .lede {
    margin-inline: auto;
  }
  .center .writing-body {
    justify-content: center;
  }
</style>
