---
// The frame every subpage shares: the site header and footer around a page
// head (breadcrumb, title, lede, metadata line) and a body, all on the site
// grid so the title lines up with the header's brand. Long pages pass `toc`
// and read as an article: a sticky "On this page" tree beside a reading
// column (about 70 characters), with the section in view highlighted and a
// slim rail that fills as you read; below 900px the tree folds into an
// "On this page" disclosure above the text. The highlight and the rail are
// script (progressive enhancement); without it the tree is plain links.
// Pages that pass `progress` also get a reading meter: a bar and "N% through" pinned under the
// header, measured over the article alone (src/reading.ts, the same measure that fills the tree's
// rail). It shows only when the article is longer than the window, and it is a position, never a
// record: nothing is kept. An `article` carries the same measure in its rail and, narrow, as a
// slim bar.
// Blog posts and /privacy/ pass `article` (opt-in), on the site's one 76rem page, so the head has
// the header's edges: the banner straight across the window above the page (blog/ArticleBanner.astro,
// or a drawing through the `cover` slot), the head under it on the reading column
// (blog/ArticleCover.astro), then two columns on named
// tracks (--article-tracks, `.longform` in blog/article.css: the left rail, its gap, then the
// reading column of about 66 characters on one left edge, wide blocks running on to the page's
// right edge). The rail has the short title, the tree, the meter
// as a percent, Sources, and Share, pinned only when it fits the window (blog/ArticleRail.astro). After the article, "More from rotli": more posts and
// rotli's own spots (blog/ArticleAside.astro), which take the place of the article's own Sources
// list where the rail shows the sources. Under 901px the tree is the disclosure, the meter a slim
// bar under the header, the article keeps its Sources list, and Share follows the article, all on
// the text's edges.
// Rendered Markdown arrives as children, so its typography is styled with
// :global() in .prose.
import type { TocItem } from '../blog';
import Base from '../layouts/Base.astro';
import type { NavSection } from '../nav';
import type { Banner } from '../og';
import type { Promo } from '../promos';
import type { Source } from '../sources';
import { site } from '../site';
import ArticleAside, { type MorePost } from './blog/ArticleAside.astro';
import ArticleBanner from './blog/ArticleBanner.astro';
import ArticleCover from './blog/ArticleCover.astro';
import ArticleRail from './blog/ArticleRail.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  /** Which header section to mark current; none for pages outside the nav. */
  section?: NavSection;
  /** A trail back up, e.g. [{ href: '/blog/', label: 'Blog' }]. */
  crumbs?: { href: string; label: string }[];
  /** Small line above the headline: a draft label or a section name. */
  kicker?: string;
  heading: string;
  lede?: string;
  /** The metadata line under the lede: a date, "Updated …", a reading time. */
  meta?: string[];
  /** Headings for the "On this page" column: depth 2, and depth 3 under them in an article's tree. */
  toc?: (Omit<TocItem, 'depth'> & { depth?: number })[];
  /** Let the body use the full page width (index pages, choosers). */
  wide?: boolean;
  /** Center the head and the reading column on the page (About). */
  center?: boolean;
  /** Pin a reading meter under the header (blog posts, /privacy/). */
  progress?: boolean;
  /** The article layout (blog posts, /privacy/): the contained picture beside the words, the left
   * rail, the reading column, "More from rotli". A drawn picture comes through the `cover` slot. */
  article?: {
    cover?: Banner;
    /** The byline's name and mark; without it the meta line stands alone (/privacy/). */
    author?: string;
    tags?: string[];
    /** The page's absolute address, for Share. */
    url: string;
    /** The page's Markdown twin, for Copy Markdown (only with `share: 'all'`). */
    markdown?: string;
    /** The post's `## Sources`, parsed at build time (src/sources.ts), for the rail. */
    sources?: Source[];
    /** What Share calls the page (X's text, Email's subject) when the heading alone is too short. */
    shareTitle?: string;
    /** Every way to share, or Copy link alone. */
    share?: 'all' | 'link';
    /** What the rail calls the page in its labels: "About this post", "Position in this page". */
    noun?: 'post' | 'page';
    /** Other posts and rotli's own spots, after the article ("More from rotli"). */
    more: MorePost[];
    promos: Promo[];
  };
  /** Passed through to Base: JSON-LD facts, the Markdown twin, and the link card (src/og.ts). */
  structuredData?: Record<string, unknown>[];
  markdownPath?: string;
  image?: string;
  imageAlt?: string;
}

const {
  title,
  description,
  canonicalPath,
  section,
  crumbs = [],
  kicker,
  heading,
  lede,
  meta = [],
  toc = [],
  wide = false,
  center = false,
  progress = false,
  article,
  structuredData,
  markdownPath,
  image,
  imageAlt,
} = Astro.props;
const items: TocItem[] = toc.map((item) => ({ ...item, depth: item.depth ?? 2 }));
// The plain tree lists `##` headings; an article's also its `###`.
const flatToc = article ? items : items.filter((item) => item.depth === 2);
const hasToc = flatToc.filter((item) => item.depth === 2).length > 1;
const sources = article?.sources ?? [];
const drawnCover = article !== undefined && Astro.slots.has('cover');
---

<Base
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  noindex={!site.indexable}
  structuredData={structuredData}
  markdownPath={markdownPath}
  image={image}
  imageAlt={imageAlt}
>
  <SiteHeader current={section} />
  {
    article && (article.cover || drawnCover) && (
      <ArticleBanner cover={article.cover} drawn={drawnCover}>
        {drawnCover && <slot name="cover" />}
      </ArticleBanner>
    )
  }
  <main
    id="content"
    class:list={[
      'wrap writing',
      {
        center,
        'has-progress': progress,
        'is-article longform': article,
        // The rail lists the sources, so on a wide screen the article's own list gives way (article.css).
        'has-rail-sources': sources.length > 0,
      },
    ]}
  >
    {article ? (
      <ArticleCover
        crumbs={crumbs}
        kicker={kicker}
        heading={heading}
        lede={lede}
        author={article.author}
        meta={meta}
        tags={article.tags ?? []}
      />
    ) : (
    <header class="writing-head">
      <div class="head-copy">
        {
          crumbs.length > 0 && (
            <nav class="crumbs" aria-label="Breadcrumb">
              {crumbs.map((crumb) => (
                <>
                  <a href={crumb.href}>{crumb.label}</a>
                  <span aria-hidden="true">/</span>
                </>
              ))}
            </nav>
          )
        }
        {kicker && <p class="kicker">{kicker}</p>}
        <h1>{heading}</h1>
        {lede && <p class="lede">{lede}</p>}
        {
          meta.length > 0 && (
            <p class="meta">
              {meta.map((part, index) => (
                <>
                  {index > 0 && <span aria-hidden="true">·</span>}
                  <span>{part}</span>
                </>
              ))}
            </p>
          )
        }
      </div>
    </header>
    )}
    <slot name="scene" />
    {
      progress && (
        <div
          class:list={['read-progress', { slim: article }]}
          data-read-progress="bar"
          role="progressbar"
          aria-label="Position in this article"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          hidden
        >
          <span class="read-track" aria-hidden="true">
            <span class="read-fill" data-read-fill />
          </span>
          <span class="read-label" aria-hidden="true">
            <b data-read-percent>0%</b> through
          </span>
        </div>
      )
    }
    <div class:list={['writing-body', { 'has-toc': hasToc && !article, 'has-rail': article, wide }]}>
      {
        hasToc && (
          <details class="toc-compact">
            <summary>On this page</summary>
            <ul>
              {flatToc.map((item) => (
                <li class:list={{ sub: item.depth === 3 }}>
                  <a href={`#${item.slug}`}>{item.text}</a>
                </li>
              ))}
            </ul>
          </details>
        )
      }
      {
        article ? (
          <ArticleRail
            title={heading}
            toc={flatToc}
            sources={sources}
            noun={article.noun}
            share={{
              url: article.url,
              title: article.shareTitle ?? heading,
              text: description,
              markdown: article.markdown,
              mode: article.share,
            }}
          />
        ) : (
          hasToc && (
            <nav class="toc" aria-label="On this page" data-toc>
              <p>On this page</p>
              <div class="toc-tree">
                <span class="toc-rail" aria-hidden="true"><span class="toc-progress" data-toc-progress></span></span>
                <ul>
                  {flatToc.map((item) => (
                    <li>
                      <a href={`#${item.slug}`}>{item.text}</a>
                    </li>
                  ))}
                </ul>
              </div>
            </nav>
          )
        )
      }
      <div class="prose" data-prose>
        <slot />
      </div>
    </div>
    {
      article && (
        <div class="article-after">
          <ArticleAside posts={article.more} promos={article.promos} />
        </div>
      )
    }
    <slot name="after" />
  </main>
  <SiteFooter />
</Base>

<script>
  import { readingProgress } from '../reading';

  // The article tree and the reading meter: highlight the section being read (the last
  // heading that has passed under the pinned header), and fill the tree's rail and the meter
  // with how far through the article the window is (one measure, src/reading.ts). Scroll
  // work is batched into one frame. The compact disclosure closes once a heading is chosen.
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  const prose = document.querySelector<HTMLElement>('[data-prose]');
  const rail = document.querySelector<HTMLElement>('[data-toc-progress]');
  // The meters: the bar pinned under the header, and on a blog post the rail's percent too
  // (only one of them shows at a width; both follow the same measure).
  const meters = [...document.querySelectorAll<HTMLElement>('[data-read-progress]')].map((meter) => ({
    meter,
    fill: meter.querySelector<HTMLElement>('[data-read-fill]'),
    label: meter.querySelector<HTMLElement>('[data-read-percent]'),
  }));
  const pinnedBar = document.querySelector<HTMLElement>('[data-read-progress="bar"]');
  if (prose && (toc || meters.length > 0)) {
    const links = toc ? [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')] : [];
    const targets = links
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((target): target is HTMLElement => target !== null);
    let frame = 0;
    let shown = -1;
    const update = () => {
      frame = 0;
      const header = document.querySelector('.site-header-bar')?.getBoundingClientRect().bottom ?? 0;
      // The pinned bar covers the top of the reading area while it shows, so it counts as header.
      const barBottom = pinnedBar && !pinnedBar.hidden ? pinnedBar.getBoundingClientRect().bottom : 0;
      const top = Math.max(header, barBottom);
      const line = top + window.innerHeight * 0.2;
      let active = -1;
      targets.forEach((target, index) => {
        if (target.getBoundingClientRect().top <= line) active = index;
      });
      links.forEach((link, index) => {
        if (index === active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      const box = prose.getBoundingClientRect();
      const reading = readingProgress({ top: box.top, height: box.height }, window.innerHeight, top);
      if (rail) rail.style.transform = `scaleY(${reading.fraction})`;
      const changed = reading.percent !== shown;
      shown = reading.percent;
      for (const { meter, fill, label } of meters) {
        meter.hidden = reading.fits;
        if (fill) fill.style.transform = `scaleX(${reading.fraction})`;
        if (changed) {
          if (label) label.textContent = `${reading.percent}%`;
          meter.setAttribute('aria-valuenow', String(reading.percent));
        }
      }
    };
    const schedule = () => {
      if (frame === 0) frame = requestAnimationFrame(update);
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    // Images and fonts change the article's height after load; measure again when they do.
    new ResizeObserver(schedule).observe(prose);
    toc?.classList.add('is-live');
    update();
  }
  document.querySelectorAll<HTMLDetailsElement>('.toc-compact').forEach((details) => {
    details.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => (details.open = false)));
  });
</script>

<style>
  /* What is pinned over the top of an article: the header, and on pages with a reading meter
     the meter under it (its height is fixed so everything below can clear it). The tree and
     every jump target sit below that, with the same breathing room. */
  .writing {
    --meter-height: 0px;
    --pinned: calc(var(--header-height) + 1px + var(--meter-height));
    padding-block: clamp(3rem, 7vw, 5rem) var(--section-space);
  }
  .writing.has-progress {
    --meter-height: 2.5rem;
  }
  .writing :global([id]) {
    scroll-margin-top: calc(var(--pinned) + 1.5rem);
  }
  /* The rule under the head spans the page; the words keep a reading width. */
  .head-copy {
    max-width: 48rem;
  }
  .writing-head {
    padding-bottom: clamp(2rem, 4vw, 3rem);
    margin-bottom: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--border-strong);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .crumbs a {
    color: var(--text-muted);
    text-underline-offset: 0.2em;
  }
  .crumbs a:hover {
    color: var(--text);
  }
  /* On touch the trail's links get a 44px-tall hit area; the text does not move. */
  @media (pointer: coarse) {
    .crumbs a {
      display: inline-block;
      padding: 0.7rem 0;
      margin: -0.7rem 0;
    }
  }
  .kicker {
    margin: 0 0 0.9rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.4rem, 5vw, 3.75rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .lede {
    max-width: 40rem;
    margin: 1.1rem 0 0;
    color: var(--text-muted);
    font-size: var(--step-lede);
    line-height: 1.55;
    text-wrap: pretty;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.55rem;
    margin: 1.25rem 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  /* The reading meter: pinned just under the header while the article scrolls by, on the
     page's own ground so the text passes beneath it. A bar and a plain number. */
  .read-progress {
    position: sticky;
    top: calc(var(--header-height) + 1px);
    z-index: 20;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    box-sizing: border-box;
    height: var(--meter-height);
    margin: calc(-1 * clamp(1.25rem, 3vw, 2rem)) 0 clamp(1.25rem, 3vw, 2rem);
    background: var(--ground);
  }
  .read-progress[hidden] {
    display: none;
  }
  .read-track {
    height: 4px;
    border-radius: 2px;
    background: var(--border);
    overflow: hidden;
  }
  .read-fill {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  .read-label {
    min-width: 7.5ch;
    color: var(--text-muted);
    font-size: 0.84rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .read-label b {
    color: var(--text);
    font-weight: 600;
  }
  /* A blog post (`article`): no pinned meter on a wide screen (the rail carries it), a slim
     bar under the header below 900px; the rail beside the reading column, Share after it on
     narrow screens. The column's type and the figures are blog/article.css. */
  .writing.is-article {
    padding-top: clamp(2rem, 4vw, 3.25rem);
  }
  .writing.is-article.has-progress {
    --meter-height: 0px;
  }
  .read-progress.slim {
    display: none;
  }
  /* The article's grid: the long-form tracks (`.longform`, blog/article.css, shared with
     /roadmap/): the rail, its gap, then the reading column starting on one left edge with the
     wide room to its right. Below 901px it is one column (the rail's Share and "More from rotli"
     follow the article, on the text's edges). */
  .writing-body.has-rail {
    grid-template-columns: var(--article-tracks);
    gap: 0;
  }
  /* The "On this page" disclosure (below 901px) is a bar across the page, on the picture's edges. */
  .writing-body.has-rail > .toc-compact {
    grid-column: main;
  }
  .writing-body.has-rail > .prose {
    grid-column: main;
  }
  .writing-body.has-rail > :global(.rail) {
    grid-column: text;
  }
  @media (min-width: 901px) {
    .writing-body.has-rail > :global(.rail) {
      grid-column: rail;
      grid-row: 1;
    }
    .writing-body.has-rail > .prose {
      grid-row: 1;
    }
  }
  /* After the article, "More from rotli" on the text's edges, outside the rail's grid: the pinned
     rail stops at the article's end, so it never reaches this section or the footer. */
  .article-after {
    display: grid;
    grid-template-columns: var(--article-tracks);
  }
  .article-after > :global([data-article-more]) {
    grid-column: text;
  }
  @media (max-width: 900px) {
    .writing.is-article.has-progress {
      --meter-height: 3px;
    }
    .read-progress.slim {
      display: block;
      height: var(--meter-height);
      margin: 0 0 1.75rem;
      background: none;
    }
    .read-progress.slim[hidden] {
      display: none;
    }
    /* Only the fill shows: at the top of the post the bar is not there at all. */
    .read-progress.slim .read-track {
      display: block;
      height: 100%;
      border-radius: 0;
      background: none;
    }
    .read-progress.slim .read-label {
      display: none;
    }
    .writing-body.has-rail > :global(.rail) {
      order: 2;
    }
  }
  .toc-compact li.sub {
    padding-left: 1rem;
  }
  /* The body sits on the grid's left edge; with a table of contents it gets
     a narrow first column that stays in view while reading. */
  .writing-body {
    display: grid;
    grid-template-columns: minmax(0, 44rem);
  }
  .writing-body.wide {
    grid-template-columns: minmax(0, 1fr);
  }
  .writing-body.has-toc {
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
  }
  /* The reading column: about 70 characters of body text. */
  .writing-body.has-toc .prose {
    max-width: 70ch;
  }
  .toc {
    position: sticky;
    top: calc(var(--pinned) + 1.5rem);
    align-self: start;
    max-height: calc(100dvh - var(--pinned) - 3rem);
    overflow-y: auto;
    font-size: 0.9rem;
  }
  .toc p {
    margin: 0 0 0.75rem;
    font-size: 0.84rem;
    font-weight: 600;
  }
  /* A tree: one rail down the left, each heading branching off it. The rail
     fills with the share of the page read (script); the heading in view takes
     the accent mark and full-strength text. */
  .toc-tree {
    position: relative;
  }
  .toc-rail {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    border-radius: 1px;
    background: var(--border);
    overflow: hidden;
  }
  .toc-progress {
    display: block;
    height: 100%;
    background: var(--border-strong);
    transform: scaleY(0);
    transform-origin: top;
  }
  .toc ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .toc li {
    position: relative;
  }
  .toc li::before {
    content: '';
    position: absolute;
    top: 1.05em;
    left: 2px;
    width: 0.55rem;
    border-top: 1px solid var(--border);
  }
  .toc a {
    position: relative;
    display: block;
    padding: 0.38rem 0 0.38rem 1.1rem;
    color: var(--text-muted);
    line-height: 1.35;
    text-decoration: none;
    transition: color 140ms ease-out;
  }
  .toc a:hover,
  .toc a[aria-current='location'] {
    color: var(--text);
  }
  .toc a[aria-current='location'] {
    font-weight: 600;
  }
  .toc a[aria-current='location']::before {
    content: '';
    position: absolute;
    top: 0.3rem;
    bottom: 0.3rem;
    left: 0;
    width: 2px;
    border-radius: 1px;
    background: var(--accent-text);
  }
  .toc a:focus-visible {
    outline-offset: 1px;
  }
  /* Narrow screens: the same headings in a disclosure above the text. */
  .toc-compact {
    display: none;
    margin-bottom: 2rem;
    border-block: 1px solid var(--border-strong);
  }
  .toc-compact summary {
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .toc-compact summary::-webkit-details-marker {
    display: none;
  }
  .toc-compact summary::after {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.3rem;
    border-right: 1.5px solid var(--text-muted);
    border-bottom: 1.5px solid var(--text-muted);
    transform: translateY(-25%) rotate(45deg);
    transition: transform 140ms ease-out;
  }
  .toc-compact[open] summary::after {
    transform: translateY(25%) rotate(-135deg);
  }
  .toc-compact ul {
    margin: 0 0 1rem;
    padding: 0 0 0 0.9rem;
    list-style: none;
    border-left: 2px solid var(--border);
  }
  .toc-compact a {
    min-height: 40px;
    display: flex;
    align-items: center;
    color: var(--text-muted);
    text-decoration: none;
  }
  .toc-compact a:hover {
    color: var(--text);
  }
  @media (max-width: 900px) {
    .writing-body.has-toc {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .toc {
      display: none;
    }
    .toc-compact {
      display: block;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .toc a,
    .toc-compact summary::after {
      transition: none;
    }
  }
  .prose {
    font-size: 1.06rem;
    line-height: 1.7;
  }
  .prose > :global(:first-child) {
    margin-top: 0;
  }
  .prose :global(h2) {
    margin: 2.8rem 0 0.8rem;
    font-size: 1.45rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    scroll-margin-top: calc(var(--pinned) + 1.5rem);
  }
  .prose :global(h3) {
    margin: 2rem 0 0.6rem;
    font-size: 1.15rem;
  }
  .prose :global(p),
  .prose :global(ul),
