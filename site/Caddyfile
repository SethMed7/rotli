# Serves the static Astro build on Railway. This file is the one home for the
# site's browser-security and cache headers (the former Cloudflare _headers).
{
	admin off
	auto_https off
	persist_config off
}

(security) {
	header {
		Content-Security-Policy "default-src 'self'; base-uri 'none'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: https://tools.launchllama.co; media-src 'self'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self'; upgrade-insecure-requests"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Rotli Web: the app bundle (built with ROTLI_WEB_BASE=/app/) served from
	# /app/ on the same origin with ITS OWN headers. The site policy below sets
	# `style-src 'self'`, which the app cannot live under (CodeMirror,
	# Excalidraw, and Univer inject styles at runtime), so the two are
	# mutually exclusive `handle` blocks rather than one header stacked on
	# another. `connect-src` names 127.0.0.1 alone: the browser refuses
	# every other request, so a note cannot leave the computer. Unknown
	# /app/ paths fall back to the app's index.html (client routing); hashed
	# assets are immutable.
	handle /app/* {
		header {
			# connect-src: 127.0.0.1 ONLY — Rotli Helper on the user's own computer
			# (the vault it serves, and chat through the AI tools installed there).
			# Nothing else, not even this site: notes never leave the computer
			# (scripts/check-web-privacy.mjs keeps it so). No upgrade-insecure-requests
			# here: it would rewrite http://127.0.0.1 to https and the helper speaks
			# plain http on loopback (the site block above still redirects to https).
			Content-Security-Policy "default-src 'self'; base-uri 'none'; connect-src http://127.0.0.1:*; font-src 'self' data:; form-action 'none'; frame-ancestors 'none'; img-src 'self' blob: data:; media-src 'self' blob: data:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
			Cross-Origin-Opener-Policy "same-origin"
			Cross-Origin-Resource-Policy "same-origin"
			Permissions-Policy "camera=(), geolocation=(), microphone=()"
			Referrer-Policy "strict-origin-when-cross-origin"
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			X-Robots-Tag "noindex, nofollow"
			-Server
		}
		@appAssets path /app/assets/*
		header @appAssets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /app/index.html
		file_server
	}

	# The Bun sidecar on loopback (site/server/main.ts, started by
	# site/entrypoint.sh) answers /api/: the "coming soon" list (2026-10-02,
	# /api/subscribe) and the roadmap's votes and requests (2026-10-05,
	# /api/roadmap/*). The site's own headers apply; the pages reach it under
	# connect-src 'self' (probes and JSON posts) and form-action 'self' (plain
	# form posts without JavaScript). Nothing under /api/ is ever cached.
	handle /api/* {
		import security
		# Deferred (>), so it replaces whatever the sidecar sends instead of adding to it.
		header >Cache-Control "no-store"
		reverse_proxy 127.0.0.1:{$SUBSCRIBE_PORT:8787}
	}

	# The marketing site: everything that is not /app/ or /api/.
	# The MCP guide moved under Resources on 2026-09-18 and became part of the
	# developer page on 2026-10-02; old links go straight there in one hop.
	redir /mcp /resources/developers/ permanent
	redir /mcp/ /resources/developers/ permanent
	# The guides joined the blog as posts tagged Guide on 2026-10-06: each old
	# address, its Markdown twin, and the bare path go to the post in one hop.
	# The slugs match MOVED_GUIDES in astro.config.mjs (whose refresh pages are
	# the fallback on any other host).
	@movedGuide path_regexp movedGuide ^/resources/(getting-started|why-local|ai-and-your-notes|rotli-helper|web-and-mac)(/.*)?$
	redir @movedGuide /blog/{re.movedGuide.1}{re.movedGuide.2} permanent
	# The feature catalog was condensed on 2026-10-06: an entry folded into another
	# goes to its section on the surviving page (its old id is the anchor), or to
	# the top where its words now lead the page. The same map as `movedFrom` in
	# src/features.ts, whose refresh pages are the fallback on any other host
	# (scripts/site-features.test.ts holds the two together).
	redir /features/themes /features/make-it-yours/ permanent
	redir /features/themes/ /features/make-it-yours/ permanent
	@foldMarkdown path_regexp foldMarkdown ^/features/(tables-code-math|diagrams)/?$
	redir @foldMarkdown "/features/markdown/#{re.foldMarkdown.1}" permanent
	@foldSearch path_regexp foldSearch ^/features/(links)/?$
	redir @foldSearch "/features/search/#{re.foldSearch.1}" permanent
	@foldTemplates path_regexp foldTemplates ^/features/(slash-commands)/?$
	redir @foldTemplates "/features/templates/#{re.foldTemplates.1}" permanent
	@foldMakeItYours path_regexp foldMakeItYours ^/features/(panes-and-keys)/?$
	redir @foldMakeItYours "/features/make-it-yours/#{re.foldMakeItYours.1}" permanent
	@foldLibrarian path_regexp foldLibrarian ^/features/(ask-the-librarian)/?$
	redir @foldLibrarian "/features/librarian/#{re.foldLibrarian.1}" permanent
	@foldConnectedAi path_regexp foldConnectedAi ^/features/(on-device-ai)/?$
	redir @foldConnectedAi "/features/connected-ai/#{re.foldConnectedAi.1}" permanent
	@foldDocs path_regexp foldDocs ^/features/(sheets)/?$
	redir @foldDocs "/features/docs/#{re.foldDocs.1}" permanent
	@foldBoards path_regexp foldBoards ^/features/(pictures-and-files)/?$
	redir @foldBoards "/features/boards/#{re.foldBoards.1}" permanent
	@foldYourFolder path_regexp foldYourFolder ^/features/(open-a-folder)/?$
	redir @foldYourFolder "/features/your-folder/#{re.foldYourFolder.1}" permanent
	@foldSecureNotes path_regexp foldSecureNotes ^/features/(what-ai-may-change)/?$
	redir @foldSecureNotes "/features/secure-notes/#{re.foldSecureNotes.1}" permanent
	@foldRotliWeb path_regexp foldRotliWeb ^/features/(rotli-helper)/?$
	redir @foldRotliWeb "/features/rotli-web/#{re.foldRotliWeb.1}" permanent
	# The motion studio lives on its own subdomain; people type the path.
	redir /studio https://studio.rotli.co/ permanent
	redir /studio/ https://studio.rotli.co/ permanent
	# The Mac app's update check (2026-10-01): /update/<version>/<target>/<arch>/
	# latest.json answers with the signed feed on GitHub, so the request line
	# counts installs by version (Cloudflare's aggregate traffic, no logs kept
	# here). No account, vault, or note data rides in it; the app falls back to
	# GitHub directly when this is unreachable (tauri.conf.json endpoints).
	@updateCheck path_regexp ^/update/[0-9][0-9A-Za-z.+%-]{0,31}/[a-z0-9_-]{1,32}/[a-z0-9_-]{1,16}/latest\.json$
	redir @updateCheck https://github.com/SethMed7/rotli-releases/releases/latest/download/latest.json 302

	handle {
		import security

		@immutable path /_astro/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		@fonts path /fonts/*
		header @fonts Cache-Control "public, max-age=604800, stale-while-revalidate=86400"

		@captures path /rotli-app-*.png /rotli-playground*.png
		header @captures Cache-Control "public, max-age=86400, stale-while-revalidate=86400"

		# The films (same-origin only; CSP media-src 'self'): the holding page's
		# launch film in /media/ and the studio's story film and episodes in
		# /media/story/. The caddy:alpine image ships no /etc/mime.types; Go's
		# built-in table knows .mp4 but not .vtt, and with X-Content-Type-Options:
		# nosniff a captions track that is not text/vtt is refused by browsers, so
		# both types are explicit. A path matcher's middle `*` never crosses a `/`,
		# hence one pattern per folder. file_server answers Range requests, which
		# native <video> controls need for seeking.
		@media path /media/*
		header @media Cache-Control "public, max-age=86400, stale-while-revalidate=86400"
		@mp4 path /media/*.mp4 /media/story/*.mp4
		header @mp4 Content-Type "video/mp4"
		@vtt path /media/*.vtt /media/story/*.vtt
		header @vtt Content-Type "text/vtt; charset=utf-8"

		# Agents (src/agents.ts). A request that asks for Markdown gets the page's
		# Markdown twin when one exists (writing pages, and / as the llms.txt
		# summary); every other request gets HTML. Header matchers see the request
		# as it arrived, so the Markdown type is set here on the same matcher the
		# rewrite uses. Vary keeps a cache from handing one to the other. Types are
		# explicit because caddy:alpine has no /etc/mime.types (Go would sniff .md
		# as text/plain). llms.txt stays text/plain so a browser shows it inline.
		@markdown {
			header Accept *text/markdown*
			file {path}index.md
		}
		header @markdown Content-Type "text/markdown; charset=utf-8"
		rewrite @markdown {file_match.relative}
		@markdownFile path *.md
		header @markdownFile Content-Type "text/markdown; charset=utf-8"
		@llms path /llms.txt
		header @llms Content-Type "text/plain; charset=utf-8"
		header Vary Accept
		# Crawlers ask for /sitemap.xml by habit; @astrojs/sitemap writes an index.
		rewrite /sitemap.xml /sitemap-index.xml

		# The dev site is never indexed; the build already emits noindex meta and a
		# Disallow robots.txt, this is the HTTP-layer twin (SITE_MODE is a runtime
		# variable on Railway as well as a build arg).
		@dev expression `{env.SITE_MODE} == "dev"`
		header @dev X-Robots-Tag "noindex, nofollow"

		file_server
	}

	# Astro's directory format: /about/ -> /about/index.html. Caddy redirects a bare
	# /about to /about/ on its own. Unknown paths fall through to the 404 page.
	handle_errors {
		import security
		# An error is never cached: the route's own Cache-Control (a day for /media/*) would
		# otherwise ride on the 404 page, and Cloudflare's edge kept one for a day when the hero
		# film's path went live before the new site did (2026-10-10).
		header Cache-Control "no-store"
		# The sidecar is down (or still starting): the list and the roadmap's
		# voting read as closed. The pages' probes see a non-200 (the footer's
		# submit says the list isn't open yet, the roadmap says voting opens soon); a plain form post gets
		# this line instead of the site's 404 page.
		@api path /api/*
		handle @api {
			header Cache-Control "no-store"
			respond "This is not open right now. Try again later." 503
		}
		@notfound expression {http.error.status_code} == 404
		rewrite @notfound /404.html
		file_server
	}
}
