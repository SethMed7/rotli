     "text": "Same files underneath. Nothing moves."
    }
   ]
  },
  {
   "beat": "write",
   "kicker": "Write",
   "captions": [
    {
     "text": "Plain Markdown that renders as you type."
    }
   ]
  },
  {
   "beat": "secure",
   "kicker": "Secure notes",
   "captions": [
    {
     "text": "Mark a note secure."
    },
    {
     "from": "secure-location",
     "text": "Cloud AI never sees it. Not even the title."
    }
   ]
  },
  {
   "beat": "chat",
   "kicker": "Chat",
   "captions": [
    {
     "text": "Chat with the AI you already pay for."
    },
    {
     "from": "reply",
     "text": "It answers from your notes."
    }
   ]
  },
  {
   "beat": "files",
   "kicker": "Files",
   "captions": [
    {
     "text": "Browse your vault like you browse Finder."
    }
   ]
  },
  {
   "beat": "remove",
   "kicker": "Your views",
   "captions": [
    {
     "text": "Remove a note from a view."
    },
    {
     "from": "still-there",
     "text": "It stays in your vault."
    }
   ]
  },
  {
   "beat": "trash",
   "kicker": "Trash",
   "captions": [
    {
     "text": "Delete moves it to Trash."
    },
    {
     "from": "in-trash",
     "text": "Rotli never erases a file."
    }
   ]
  }
